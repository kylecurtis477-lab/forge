# Forge prelude: library code written in Forge and compiled into every program.
# Unreferenced functions are dropped from the output. A user function with the same name replaces a public one here.
# Internals use only __-prefixed helpers so user code cannot change their behaviour.

class BaseException:
    def __init__(self, msg=""):
        self.__msg = msg
        self.__rt = 0

    def __str__(self):
        return __str(self.__msg)

    def __repr__(self):
        if __tag(self.__msg) == 1 and __aux(self.__msg) == 0:
            return concat(__clsname(self), "()")
        return concat(concat(concat(__clsname(self), "("), __repr(self.__msg)), ")")


class Exception(BaseException):
    pass


class ArithmeticError(Exception):
    pass


class ZeroDivisionError(ArithmeticError):
    pass


class OverflowError(ArithmeticError):
    pass


class LookupError(Exception):
    pass


class IndexError(LookupError):
    pass


class KeyError(LookupError):
    def __str__(self):
        return __repr(self.__msg)


class ValueError(Exception):
    pass


class TypeError(Exception):
    pass


class RuntimeError(Exception):
    pass


class NotImplementedError(RuntimeError):
    pass


class RecursionError(RuntimeError):
    pass


class AssertionError(Exception):
    pass


class AttributeError(Exception):
    pass


class NameError(Exception):
    pass


class StopIteration(Exception):
    pass


def __has(msg, p) -> int:
    return __find(msg, p, 0) >= 0

def __sw(msg, p) -> int:
    return __find(msg, p, 0) == 0

def __rtexc(msg):
    if __sw(msg, "list index"):
        return IndexError("list index out of range")
    if __sw(msg, "list assignment index"):
        return IndexError("list assignment index out of range")
    if __has(msg, "index out of range") or __sw(msg, "pop from empty"):
        return IndexError(msg)
    if __has(msg, "division by zero"):
        return ZeroDivisionError(msg)
    if __has(msg, "could not convert") or __has(msg, "invalid literal") or __has(msg, "not in list") or __has(msg, "math domain") or __has(msg, "empty separator") or __has(msg, "must not be zero"):
        return ValueError(msg)
    if __has(msg, "no such method"):
        return AttributeError(msg)
    if __has(msg, "unsupported operand") or __has(msg, "not supported") or __has(msg, "not indexable") or __has(msg, "not iterable") or __has(msg, "does not support") or __has(msg, "cannot be sliced") or __has(msg, "cannot be raised") or __has(msg, "not callable") or __has(msg, "positional arguments"):
        return TypeError(msg)
    return RuntimeError(msg)

def __raise_rt(e, line, msg):
    e.__rt = msg
    __raise(e, line)

def __err(line, msg0):
    msg: str = concat(msg0, "")
    __raise_rt(__rtexc(msg), line, msg)

def __aerr(line, msg):
    __raise_rt(AssertionError(msg), line, __str(msg))

def __uncaught(e, line):
    msg = ""
    if isinstance(e, BaseException) and e.__rt != 0:
        msg = e.__rt
    else:
        s: str = __str(e)
        msg = __clsname(e)
        if __aux(s) > 0:
            msg = concat(concat(msg, ": "), s)
    eputs(concat(concat(concat("error: line ", __itos(line)), ": "), msg))
    exit(1)

def __lst(xs: list, i: int):
    return __ld(__ld(xs, 2), i)

def __grow(xs, need: int):
    cap: int = __ld(xs, 1)
    if need <= cap:
        return 0
    nc: int = cap * 2
    if nc < need:
        nc = need
    d = __new(nc * 8, 4, nc * 8)
    __copy(d, __ld(xs, 2), __ld(xs, 0) * 8)
    __st(xs, 2, d)
    __st(xs, 1, nc)
    return 0

def append(xs, v):
    n: int = __ld(xs, 0)
    if n >= __ld(xs, 1):
        __grow(xs, n + 1)
    __st(__ld(xs, 2), n, v)
    __st(xs, 0, n + 1)
    return 0

def pop(xs):
    n: int = __ld(xs, 0) - 1
    if n < 0:
        __err(0, "pop from empty list")
    __st(xs, 0, n)
    d = __ld(xs, 2)
    v = __ld(d, n)
    __st(d, n, 0)
    return v

def insert(xs, i: int, v):
    n: int = __ld(xs, 0)
    if i < 0:
        i = i + n
    if i < 0:
        i = 0
    if i > n:
        i = n
    append(xs, 0)
    d = __ld(xs, 2)
    j: int = n
    while j > i:
        __st(d, j, __ld(d, j - 1))
        j -= 1
    __st(d, i, v)
    return 0

def __list_add(a, b):
    na: int = __ld(a, 0)
    nb: int = __ld(b, 0)
    r = list(na + nb)
    __copy(__ld(r, 2), __ld(a, 2), na * 8)
    __copy(__ld(r, 2) + na * 8, __ld(b, 2), nb * 8)
    return r

def __list_mul(a, k: int):
    n: int = __ld(a, 0)
    if k < 0:
        k = 0
    r = list(n * k)
    d = __ld(r, 2)
    s = __ld(a, 2)
    i: int = 0
    while i < k:
        __copy(d + i * n * 8, s, n * 8)
        i += 1
    return r

def __itos(x) -> str:
    return __itos_raw(x)

def __str(x) -> str:
    t: int = __tag(x)
    if t == 1:
        return x
    if t < 0:
        return __itos_raw(x)
    if t == 2:
        return x.__str__()
    if t == 12:
        return __bigstr(x)
    return __repr(x)

def __brepr(x) -> str:
    v: int = x
    if v & 1:
        return "True"
    return "False"

def __srepr(x) -> str:
    q = "'"
    if __find(x, "'", 0) >= 0 and __find(x, chr(34), 0) < 0:
        q = chr(34)
    n: int = len(x)
    i: int = 0
    plain: int = 1
    while i < n:
        c: int = ord(x[i])
        if c < 32 or c == 92 or c == 127 or c == ord(q):
            plain = 0
            break
        i += 1
    if plain == 1:
        return concat(concat(q, x), q)
    parts = [q]
    i = 0
    while i < n:
        ch = x[i]
        c: int = ord(ch)
        if c == 10:
            append(parts, "\\n")
        elif c == 9:
            append(parts, "\\t")
        elif c == 13:
            append(parts, "\\r")
        elif c == 92:
            append(parts, "\\\\")
        elif ch == q:
            append(parts, concat("\\", q))
        elif c < 32 or c == 127:
            h = hex(c)
            if c < 16:
                append(parts, concat("\\x0", substr(h, 2, 3)))
            else:
                append(parts, concat("\\x", substr(h, 2, 4)))
        else:
            append(parts, ch)
        i += 1
    append(parts, q)
    return join(parts, len(parts))

def __repr(x) -> str:
    t: int = __tag(x)
    if t == 1:
        return __srepr(x)
    if t < 0:
        return __itos_raw(x)
    if t == 6:
        return __brepr(x)
    if t == 7:
        return "None"
    if t == 8:
        return "<function>"
    if t == 12:
        return __bigstr(x)
    if t == 5:
        return __frepr(x)
    parts = []
    if t == 9:
        n: int = __ld(x, 0)
        append(parts, "(")
        i: int = 0
        while i < n:
            if i > 0:
                append(parts, ", ")
            append(parts, __repr(__lst(x, i)))
            i += 1
        if n == 1:
            append(parts, ",")
        append(parts, ")")
    elif t == 0:
        n: int = __ld(x, 0)
        append(parts, "[")
        i: int = 0
        while i < n:
            if i > 0:
                append(parts, ", ")
            append(parts, __repr(__lst(x, i)))
            i += 1
        append(parts, "]")
    elif t == 10:
        ks = __ld(x, 5)
        n: int = __ld(ks, 0)
        if n == 0:
            return "set()"
        append(parts, "{")
        i: int = 0
        while i < n:
            if i > 0:
                append(parts, ", ")
            append(parts, __repr(__lst(ks, i)))
            i += 1
        append(parts, "}")
    elif t == 3:
        ks = __ld(x, 5)
        n: int = __ld(ks, 0)
        append(parts, "{")
        i: int = 0
        while i < n:
            if i > 0:
                append(parts, ", ")
            k = __lst(ks, i)
            append(parts, __repr(k))
            append(parts, ": ")
            append(parts, __repr(__dget(x, k, 0)))
            i += 1
        append(parts, "}")
    else:
        return x.__repr__()
    return join(parts, __ld(parts, 0))

def __typeid(x) -> int:
# class index + 1 for objects; -1 int, -2 str, -3 list, -4 dict, -5 float, -6 bool
    t: int = __tag(x)
    if t < 0:
        return -1
    if t == 2:
        return __aux(x)
    if t == 1:
        return -2
    if t == 0:
        return -3
    if t == 3:
        return -4
    if t == 5:
        return -5
    if t == 6:
        return -6
    if t == 12:
        return -1
    return -7

def __m___str__(o) -> str:
    return o.__repr__()

def __m___repr__(o) -> str:
    return "<object>"

def repr(x) -> str:
    return __repr(x)

def __pr(x):
    t: int = __tag(x)
    if t == 1:
        __writes(x)
    elif t < 0:
        __wint(x)
    else:
        __writes(__str(x))
    return 0

def __isnum(x) -> int:
    t: int = __tag(x)
    return t < 0 or t == 5 or t == 6

def __binop(a, b, op: int, line):
    ta0: int = __tag(a)
    tb0: int = __tag(b)
    if (ta0 == 12 and (tb0 < 0 or tb0 == 12 or tb0 == 6)) or (tb0 == 12 and (ta0 < 0 or ta0 == 6)):
        return __bigop(__bnorm(a), __bnorm(b), op, line)
    if (ta0 == 12 and tb0 == 5) or (tb0 == 12 and ta0 == 5):
        x = float(a)
        y = float(b)
        if op == 0:
            return x + y
        if op == 1:
            return x - y
        if op == 2:
            return x * y
        if op == 3:
            return x / y
        if op == 4:
            return x // y
        return x % y
    if op == 1 and __tag(a) == 10 and __tag(b) == 10:
        return __sop(a, b, 3)
    if op == 2:
        ta: int = __tag(a)
        tb: int = __tag(b)
        if ta == 1 and __isnum(b):
            return __strmul(a, int(b))
        if tb == 1 and __isnum(a):
            return __strmul(b, int(a))
        if ta == 0 and __isnum(b):
            return __list_mul(a, int(b))
        if tb == 0 and __isnum(a):
            return __list_mul(b, int(a))
        if ta == 9 and __isnum(b):
            return __tup(__list_mul(a, int(b)))
        if tb == 9 and __isnum(a):
            return __tup(__list_mul(b, int(a)))
    if op == 5 and __tag(a) == 1:
        return __pctfmt(a, b, line)
    names = ["+", "-", "*", "/", "//", "%"]
    __err(line, concat(concat("unsupported operand type(s) for ", __lst(names, op)), ""))

def __cmpop(a, b, op: int) -> int:
    if op >= 12 and __tag(a) == 10 and __tag(b) == 10:
        if op == 12:
            return __lt(a, b)
        if op == 13:
            return __lt(b, a)
        if op == 14:
            return issubset(a, b)
        return issuperset(a, b)
    if op == 10:
        return __eq(a, b)
    if op == 11:
        return __eq(a, b) == 0
    if op == 12:
        return __lt(a, b)
    if op == 13:
        return __lt(b, a)
    if op == 14:
        return __lt(b, a) == 0
    return __lt(a, b) == 0

def __neg(x):
    if __tag(x) == 12:
        return __bigmk(0 - __lst(x, 0), __lst(x, 1))
    if __tag(x) < 0:
        v: int = x
        if v == -9223372036854775807 - 1:
            return __bigop(0, x, 1, 0)
    if __tag(x) == 5:
        return __ffrombits(__fbits(x) ^ (1 << 63))
    return 0 - x

def __ffloordiv(a, b):
    return __math(a / b, 1)

# ---- arbitrary-precision naturals (little-endian base 2^32 limbs) for exact float<->decimal ----
def __bn_norm(a):
    while len(a) > 0 and a[len(a) - 1] == 0:
        pop(a)
    return a

def __bn(v: int):
    a = []
    while v > 0:
        append(a, v & 4294967295)
        v = v >> 32
    return a

def __bn_muls(a, m: int):
    r = []
    c: int = 0
    n: int = len(a)
    i: int = 0
    while i < n:
        x: int = a[i]
        t: int = x * m + c
        append(r, t & 4294967295)
        c = t >> 32
        i += 1
    while c > 0:
        append(r, c & 4294967295)
        c = c >> 32
    return r

def __bn_add(a, b):
    na: int = len(a)
    nb: int = len(b)
    r = []
    c: int = 0
    i: int = 0
    while i < na or i < nb:
        t: int = c
        if i < na:
            x: int = a[i]
            t = t + x
        if i < nb:
            y: int = b[i]
            t = t + y
        append(r, t & 4294967295)
        c = t >> 32
        i += 1
    if c > 0:
        append(r, c)
    return r

def __bn_sub(a, b):
# a - b, a >= b
    na: int = len(a)
    nb: int = len(b)
    r = []
    c: int = 0
    i: int = 0
    while i < na:
        x: int = a[i]
        t: int = x - c
        if i < nb:
            y: int = b[i]
            t = t - y
        c = 0
        if t < 0:
            t = t + 4294967296
            c = 1
        append(r, t)
        i += 1
    return __bn_norm(r)

def __bn_cmp(a, b) -> int:
    na: int = len(a)
    nb: int = len(b)
    if na != nb:
        if na < nb:
            return -1
        return 1
    i: int = na - 1
    while i >= 0:
        x: int = a[i]
        y: int = b[i]
        if x != y:
            if x < y:
                return -1
            return 1
        i -= 1
    return 0

def __bn_shl(a, k: int):
    if len(a) == 0:
        return []
    r = []
    w: int = k >> 5
    b: int = k & 31
    i: int = 0
    while i < w:
        append(r, 0)
        i += 1
    c: int = 0
    n: int = len(a)
    i = 0
    while i < n:
        x: int = a[i]
        t: int = (x << b) | c
        append(r, t & 4294967295)
        c = t >> 32
        i += 1
    if c > 0:
        append(r, c)
    return r

def __bn_bitlen(a) -> int:
    n: int = len(a)
    if n == 0:
        return 0
    x: int = a[n - 1]
    b: int = 0
    while x > 0:
        b += 1
        x = x >> 1
    return (n - 1) * 32 + b

def __bn_pow10(k: int):
    r = [1]
    while k >= 9:
        r = __bn_muls(r, 1000000000)
        k -= 9
    while k > 0:
        r = __bn_muls(r, 10)
        k -= 1
    return r

def __bn_toint(a) -> int:
    v: int = 0
    i: int = len(a) - 1
    while i >= 0:
        x: int = a[i]
        v = (v << 32) | x
        i -= 1
    return v

def __frepr(x) -> str:
    bits: int = __fbits(x)
    neg: int = (bits >> 63) & 1
    er: int = (bits >> 52) & 2047
    f: int = bits & 4503599627370495
    if er == 2047:
        if f != 0:
            return "nan"
        if neg:
            return "-inf"
        return "inf"
    if er == 0 and f == 0:
        if neg:
            return "-0.0"
        return "0.0"
    if er >= 1023 and er < 1023 + 53:
        iv: int = __ftoi(x, 0)
        if iv < 10000000000000000 and iv > -10000000000000000 and __itof(iv) == x:
            return concat(str(iv), ".0")
    m: int = f
    e: int = -1074
    if er > 0:
        m = f | 4503599627370496
        e = er - 1075
    big: int = 0
    if m == 4503599627370496 and er > 1:
        big = 1
    if e >= 0:
        r = __bn_shl(__bn(m), e + 1 + big)
        s = __bn(2 << big)
        mp = __bn_shl([1], e + big)
        mm = __bn_shl([1], e)
    else:
        r = __bn(m << (1 + big))
        s = __bn_shl([1], 1 + big - e)
        mp = __bn(1 << big)
        mm = [1]
    even: int = (m & 1) == 0
    k: int = 0
    while True:
        c: int = __bn_cmp(__bn_add(r, mp), s)
        if c > 0 or (c == 0 and even):
            s = __bn_muls(s, 10)
            k += 1
        else:
            break
    while True:
        c = __bn_cmp(__bn_muls(__bn_add(r, mp), 10), s)
        if c < 0 or (c == 0 and not even):
            r = __bn_muls(r, 10)
            mp = __bn_muls(mp, 10)
            mm = __bn_muls(mm, 10)
            k -= 1
        else:
            break
    ds = []
    while True:
        r = __bn_muls(r, 10)
        mp = __bn_muls(mp, 10)
        mm = __bn_muls(mm, 10)
        d: int = 0
        while __bn_cmp(r, s) >= 0:
            r = __bn_sub(r, s)
            d += 1
        c1: int = __bn_cmp(r, mm)
        lo: int = c1 < 0 or (c1 == 0 and even)
        c2: int = __bn_cmp(__bn_add(r, mp), s)
        hi: int = c2 > 0 or (c2 == 0 and even)
        if not lo and not hi:
            append(ds, d)
        else:
            if hi and not lo:
                d += 1
            elif hi and lo:
                c3: int = __bn_cmp(__bn_shl(r, 1), s)
                if c3 > 0 or (c3 == 0 and (d & 1) == 1):
                    d += 1
            append(ds, d)
            break
    n: int = len(ds)
    parts = []
    if neg:
        append(parts, "-")
    x10: int = k - 1
    i: int = 0
    if x10 >= -5 + 1 and x10 < 16:
        if k <= 0:
            append(parts, "0.")
            i = 0
            while i < 0 - k:
                append(parts, "0")
                i += 1
            i = 0
            while i < n:
                append(parts, chr(48 + ds[i]))
                i += 1
        else:
            while i < n or i < k:
                if i == k:
                    append(parts, ".")
                if i < n:
                    append(parts, chr(48 + ds[i]))
                else:
                    append(parts, "0")
                i += 1
            if n <= k:
                append(parts, ".0")
    else:
        append(parts, chr(48 + ds[0]))
        if n > 1:
            append(parts, ".")
            i = 1
            while i < n:
                append(parts, chr(48 + ds[i]))
                i += 1
        append(parts, "e")
        if x10 < 0:
            append(parts, "-")
            x10 = 0 - x10
        else:
            append(parts, "+")
        if x10 < 10:
            append(parts, "0")
        append(parts, str(x10))
    return join(parts, len(parts))

def __bn_ratio_bits(num, den) -> int:
# correctly rounded double nearest num/den (both > 0)
    e: int = __bn_bitlen(num) - __bn_bitlen(den) - 53
    q: int = 0
    rem = []
    d2 = []
    while True:
        if e < -1074:
            e = -1074
        if e >= 0:
            n2 = num
            d2 = __bn_shl(den, e)
        else:
            n2 = __bn_shl(num, 0 - e)
            d2 = den
        q = 0
        b: int = 56
        while b >= 0:
            t = __bn_shl(d2, b)
            if __bn_cmp(n2, t) >= 0:
                n2 = __bn_sub(n2, t)
                q = q | (1 << b)
            b -= 1
        rem = n2
        if q >= 9007199254740992:
            e += 1
        elif q < 4503599627370496 and e > -1074:
            e -= 1
        else:
            break
    c: int = __bn_cmp(__bn_shl(rem, 1), d2)
    if c > 0 or (c == 0 and (q & 1) == 1):
        q += 1
        if q == 9007199254740992:
            q = q >> 1
            e += 1
    if e + 1075 >= 2047:
        return 9218868437227405312
    return ((e + 1074) << 52) + q

def __fparse(s0, line):
    s = lower(strip(s0))
    n: int = len(s)
    i: int = 0
    neg: int = 0
    if n > 0 and (char_at(s, 0) == 45 or char_at(s, 0) == 43):
        neg = char_at(s, 0) == 45
        i = 1
    rest = substr(s, i, n)
    bits: int = 0
    if str_eq(rest, "inf") or str_eq(rest, "infinity"):
        bits = 9218868437227405312
    elif str_eq(rest, "nan"):
        bits = 9221120237041090560
    else:
        mant = []
        mi: int = 0
        nd: int = 0
        e10: int = 0
        seen: int = 0
        dot: int = 0
        while i < n:
            c: int = char_at(s, i)
            if c >= 48 and c <= 57:
                mant = __bn_add(__bn_muls(mant, 10), __bn(c - 48))
                if len(mant) > 0:
                    nd += 1
                    if nd <= 18:
                        mi = mi * 10 + c - 48
                if dot:
                    e10 -= 1
                seen = 1
            elif c == 46 and not dot:
                dot = 1
            elif c == 95 and seen:
                pass
            else:
                break
            i += 1
        if i < n and char_at(s, i) == 101 and seen:
            i += 1
            en: int = 0
            if i < n and (char_at(s, i) == 45 or char_at(s, i) == 43):
                en = char_at(s, i) == 45
                i += 1
            ev: int = 0
            sd: int = 0
            while i < n and char_at(s, i) >= 48 and char_at(s, i) <= 57:
                if ev < 100000:
                    ev = ev * 10 + char_at(s, i) - 48
                sd = 1
                i += 1
            if not sd:
                seen = 0
            if en:
                ev = 0 - ev
            e10 += ev
        if not seen or i != n:
            __err(line, concat(concat("could not convert string to float: ", __repr(s0)), ""))
        if len(mant) == 0:
            bits = 0
        elif nd <= 15 and e10 >= -22 and e10 <= 22:
        # Clinger's fast path: both operands exact, one correctly rounded op
            fm = __itof(mi)
            if e10 >= 0:
                fm = fm * __fpow10(e10)
            else:
                fm = fm / __fpow10(0 - e10)
            bits = __fbits(fm)
        elif nd + e10 > 310:
            bits = 9218868437227405312
        elif nd + e10 < -330:
            bits = 0
        elif e10 >= 0:
            bits = __bn_ratio_bits(__bn_mulpow(mant, e10), [1])
        else:
            bits = __bn_ratio_bits(mant, __bn_pow10(0 - e10))
    if neg:
        bits = bits | (1 << 63)
    return __ffrombits(bits)

def __fpow10(k: int):
    if k <= 18:
        return __itof(__ipow(10, k))
    return __itof(__ipow(10, 18)) * __itof(__ipow(10, k - 18))

def __bn_mulpow(a, k: int):
    while k >= 9:
        a = __bn_muls(a, 1000000000)
        k -= 9
    while k > 0:
        a = __bn_muls(a, 10)
        k -= 1
    return a

# ---- arbitrary-precision ints (tag 12): [sign, limbs] with little-endian base 2^32 magnitude ----
def __bigmk(sg: int, m):
    m = __bn_norm(m)
    n: int = len(m)
    if n == 0:
        return 0
    if n <= 2:
        hi: int = 0
        if n == 2:
            hi = m[1]
        lo: int = m[0]
        if hi < 2147483648 and not (sg > 0 and hi == 1073741824 and lo <= 3):
        # 2**62 .. 2**62+3 would alias the bool/None encodings, so keep them boxed
            v: int = (hi << 32) | lo
            if sg < 0:
                return 0 - v
            return v
        if sg < 0 and hi == 2147483648 and lo == 0:
            return -9223372036854775807 - 1
    r = [sg, m]
    set_byte(r, -1, 12)
    return r

def __bigsg(x) -> int:
    if __tag(x) == 12:
        return __lst(x, 0)
    v: int = x
    if v < 0:
        return -1
    return 1

def __bigmag(x):
    if __tag(x) == 12:
        return __lst(x, 1)
    v: int = x
    if v < 0:
        v = 0 - v
    m = []
    append(m, v & 4294967295)
    append(m, (v >> 32) & 4294967295)
    return __bn_norm(m)

def __bn_mul(a, b):
    r = []
    nb: int = len(b)
    j: int = 0
    while j < nb:
        y: int = b[j]
        if y != 0:
            p = __bn_add(__bn_muls(a, y & 65535), __bn_shl(__bn_muls(a, y >> 16), 16))
            r = __bn_add(r, __bn_shl(p, 32 * j))
        j += 1
    return __bn_norm(r)

def __bigaddm(sa: int, ma, sb: int, mb):
    if sa == sb:
        return __bigmk(sa, __bn_add(ma, mb))
    c: int = __bn_cmp(ma, mb)
    if c == 0:
        return 0
    if c > 0:
        return __bigmk(sa, __bn_sub(ma, mb))
    return __bigmk(sb, __bn_sub(mb, ma))

def __bigop(a, b, op: int, line):
# a, b: ints or bigints; op 0 + 1 - 2 * 4 // 5 % 3 /
    if op == 3:
        return __bigtof(a) / __bigtof(b)
    sa: int = __bigsg(a)
    sb: int = __bigsg(b)
    ma = __bigmag(a)
    mb = __bigmag(b)
    if op == 0:
        return __bigaddm(sa, ma, sb, mb)
    if op == 1:
        return __bigaddm(sa, ma, 0 - sb, mb)
    if op == 2:
        return __bigmk(sa * sb, __bn_mul(ma, mb))
    if len(mb) == 0:
        __raise_rt(ZeroDivisionError("integer division or modulo by zero"), line, "integer division or modulo by zero")
    qr = __bn_divmod(ma, mb)
    q = __bigmk(sa * sb, qr[0])
    r = __bigmk(sa, qr[1])
    if len(__bn_norm(qr[1])) != 0 and sa != sb:
        q = __bigop(q, 1, 1, line)
        r = __bigop(r, b, 0, line)
    if op == 4:
        return q
    return r

def __bigtof(x):
    if __tag(x) != 12:
        return float(x)
    m = __lst(x, 1)
    f = __itof(0)
    i: int = len(m) - 1
    while i >= 0:
        f = f * __itof(4294967296) + __itof(m[i])
        i -= 1
    if __lst(x, 0) < 0:
        return 0 - f
    return f

def __bigstr(x) -> str:
    m = __lst(x, 1)
    parts = []
    while len(m) > 0:
        qr = __bn_divs(m, 1000000000)
        m = qr[0]
        append(parts, qr[1])
    out = []
    if __lst(x, 0) < 0:
        append(out, "-")
    i: int = len(parts) - 1
    append(out, __itos_raw(parts[i]))
    i -= 1
    while i >= 0:
        s = __itos_raw(parts[i])
        append(out, "000000000"[:9 - len(s)])
        append(out, s)
        i -= 1
    return join(out, len(out))

def __bigcmp(a, b) -> int:
    sa: int = __bigsg(a)
    sb: int = __bigsg(b)
    if __tag(a) != 12 and __tag(b) != 12:
        x: int = a
        y: int = b
        if x < y:
            return -1
        if x > y:
            return 1
        return 0
    if sa != sb:
        return sa
    return __bn_cmp(__bigmag(a), __bigmag(b)) * sa

def __bigparse(s):
    i: int = 0
    sg: int = 1
    if len(s) > 0 and s[0] == "-":
        sg = -1
        i = 1
    elif len(s) > 0 and s[0] == "+":
        i = 1
    m = []
    n: int = len(s)
    while i < n:
        c: int = ord(s[i]) - 48
        if c >= 0 and c <= 9:
            m = __bn_add(__bn_muls(m, 10), __bn(c))
        elif c != 47:
            __err(0, concat("invalid literal for int(): ", __repr(s)))
        i += 1
    return __bigmk(sg, m)

def __bigpow(a, b: int):
    r = 1
    while b > 0:
        if b & 1:
            r = __bigop(r, a, 2, 0)
        b = b >> 1
        if b > 0:
            a = __bigop(a, a, 2, 0)
    return r

def __callv(f, vals, np: int, kwn, line):
# slow path for calling a function value: defaults and keyword arguments
    if __tag(f) != 8 or __ld(f, 0) == 0:
        __err(line, "object is not callable")
    na: int = __ld(f, 1)
    names = __ld(f, 3)
    defs = __ld(f, 4)
    nd: int = 0
    if defs != 0:
        nd = len(defs)
    if np > na:
        __raise_rt(TypeError("too many positional arguments"), line, concat(concat(concat(concat("function takes ", str(na)), " positional arguments but "), str(np)), " were given"))
    pn = []
    if names != 0 and len(names) > 0:
        pn = names.split(",")
    args = [None] * na
    have = [False] * na
    i: int = 0
    while i < np:
        args[i] = vals[i]
        have[i] = True
        i += 1
    if len(kwn) > 0:
        ks = kwn.split(",")
        j: int = 0
        while j < len(ks):
            k = ks[j]
            if k not in pn:
                __raise_rt(TypeError("unexpected keyword argument"), line, concat(concat("function got an unexpected keyword argument '", k), "'"))
            x: int = pn.index(k)
            if have[x]:
                __raise_rt(TypeError("multiple values"), line, concat(concat("function got multiple values for argument '", k), "'"))
            args[x] = vals[np + j]
            have[x] = True
            j += 1
    i = 0
    while i < na:
        if not have[i]:
            if i >= na - nd:
                args[i] = defs[i - (na - nd)]
            else:
                __raise_rt(TypeError("missing argument"), line, concat(concat("function missing required argument '", pn[i]), "'"))
        i += 1
    return __apply(f, args)

def __bnorm(x):
    if __tag(x) == 6:
        return int(x)
    return x

def __iovf(line):
    __raise_rt(OverflowError("integer overflow in 64-bit int arithmetic"), line, "integer overflow in 64-bit int arithmetic (value was inferred or declared int; bigints only promote in dynamic code)")

def float(x):
    t: int = __tag(x)
    if t == 5:
        return x
    if t == 1:
        return __fparse(x, 0)
    if t == 6:
        v: int = x
        return __itof(v & 1)
    if t == 12:
        return __bigtof(x)
    return __itof(x)

def __add(a, b, line):
    ta: int = __tag(a)
    tb: int = __tag(b)
    if ta == 12 or tb == 12:
        return __binop(a, b, 0, line)
    if ta < 0 and tb < 0:
        return a - (0 - b)
    if ta == 1 and tb == 1:
        return concat(a, b)
    if ta == 0 and tb == 0:
        return __list_add(a, b)
    if ta == 9 and tb == 9:
        return __tup(__list_add(a, b))
    __err(line, "unsupported operand types for +")

def __eq(a, b) -> int:
    x: int = a
    y: int = b
    if x == y:
        return 1
    ta: int = __tag(a)
    tb: int = __tag(b)
    if ta == 1 and tb == 1:
        return str_eq(a, b)
    if ta == 12 or tb == 12:
        if ta == 5 or tb == 5:
            return __bigtof(a) == __bigtof(b)
        if (ta < 0 or ta == 12 or ta == 6) and (tb < 0 or tb == 12 or tb == 6):
            return __bigcmp(__bnorm(a), __bnorm(b)) == 0
        return 0
    if __isnum(a) and __isnum(b):
        return a == b
    if (ta == 10 and tb == 10) or (ta == 3 and tb == 3):
        if __ld(a, 0) != __ld(b, 0):
            return 0
        for k in __ld(a, 5):
            i: int = __dfind(b, k, __hash(k))
            if __ld(__ld(b, 2), i) == 0:
                return 0
            if ta == 3 and not __eq(__ld(__ld(a, 4), __dfind(a, k, __hash(k))), __ld(__ld(b, 4), i)):
                return 0
        return 1
    if (ta == 0 and tb == 0) or (ta == 9 and tb == 9):
        n: int = __ld(a, 0)
        if n != __ld(b, 0):
            return 0
        i: int = 0
        while i < n:
            if not __eq(__lst(a, i), __lst(b, i)):
                return 0
            i += 1
        return 1
    return 0

def __lt(a, b) -> int:
    ta: int = __tag(a)
    tb: int = __tag(b)
    if ta == 1 and tb == 1:
        return __strcmp(a, b) < 0
    if ta == 12 or tb == 12:
        if ta == 5 or tb == 5:
            return __bigtof(a) < __bigtof(b)
        return __bigcmp(__bnorm(a), __bnorm(b)) < 0
    if __isnum(a) and __isnum(b):
        return a < b
    if ta == 10 and tb == 10:
        return __ld(a, 0) < __ld(b, 0) and issubset(a, b)
    if (ta == 0 and tb == 0) or (ta == 9 and tb == 9):
        na: int = __ld(a, 0)
        nb: int = __ld(b, 0)
        i: int = 0
        while i < na and i < nb:
            x = __lst(a, i)
            y = __lst(b, i)
            if not __eq(x, y):
                return __lt(x, y)
            i += 1
        return na < nb
    __err(0, "'<' not supported between these types")
    return 0

def __strcmp(a, b):
    na: int = __aux(a)
    nb: int = __aux(b)
    i: int = 0
    while i < na and i < nb:
        d: int = char_at(a, i) - char_at(b, i)
        if d != 0:
            return d
        i += 1
    return na - nb

def __getidx(o, i: int, line):
    t: int = __tag(o)
    if t == 0 or t == 9:
        n: int = __ld(o, 0)
        j: int = i
        if j < 0:
            j = j + n
        if j < 0 or j >= n:
            __err(line, concat(concat(concat("list index ", __itos_raw(i)), " out of range for length "), __itos_raw(n)))
        return __lst(o, j)
    if t == 1:
        n: int = __aux(o)
        j: int = i
        if j < 0:
            j = j + n
        if j < 0 or j >= n:
            __err(line, "string index out of range")
        return chr(char_at(o, j))
    if t == 3:
        return __dget(o, i, line)
    __err(line, "value is not indexable")

def __setidx(o, i: int, v, line):
    t: int = __tag(o)
    if t == 0:
        n: int = __ld(o, 0)
        j: int = i
        if j < 0:
            j = j + n
        if j < 0 or j >= n:
            __err(line, concat(concat(concat("list assignment index ", __itos_raw(i)), " out of range for length "), __itos_raw(n)))
        __st(__ld(o, 2), j, v)
        return 0
    if t == 3:
        __dset(o, i, v)
        return 0
    __err(line, "value does not support item assignment")

def __slice(o, a: int, b: int, line):
    t: int = __tag(o)
    n: int = 0
    if t == 0 or t == 9:
        n = __ld(o, 0)
    elif t == 1:
        n = __aux(o)
    else:
        __err(line, "value cannot be sliced")
    if a < 0:
        a = a + n
    if b < 0:
        b = b + n
    if a < 0:
        a = 0
    if b > n:
        b = n
    if b < a:
        b = a
    if t == 1:
        return substr(o, a, b)
    r = list(b - a)
    __copy(__ld(r, 2), __ld(o, 2) + a * 8, (b - a) * 8)
    if t == 9:
        set_byte(r, -1, 9)
    return r

def __tup(r):
    set_byte(r, -1, 9)
    return r

def tuple(x=None):
    if x is None:
        return __tup([])
    if __tag(x) == 9:
        return x
    return __tup(__listof(x))

def __iter(x, line):
    t: int = __tag(x)
    if t == 0 or t == 9:
        return x
    if t == 3 or t == 10:
        return __ld(x, 5)
    if t == 1:
        n: int = __aux(x)
        r = list(n)
        i: int = 0
        while i < n:
            __st(__ld(r, 2), i, chr(char_at(x, i)))
            i += 1
        return r
    if t == 2:
        return __drain(x)
    __err(line, "value is not iterable")

def __contains(c, x):
    t: int = __tag(c)
    if t == 3 or t == 10:
        i: int = __dfind(c, x, __hash(x))
        return __ld(__ld(c, 2), i) != 0
    if t == 0 or t == 9:
        n: int = __ld(c, 0)
        i: int = 0
        while i < n:
            if __eq(__lst(c, i), x):
                return 1
            i += 1
        return 0
    if t == 1:
        return __find(c, x, 0) >= 0
    if t == 2:
        return __contains(__drain(c), x)
    return 0

# ---- dict: open addressing, insertion-ordered keys ----
# layout: [count, cap, hashes, keys, values, order(list of keys)]
def __zeros(n: int):
    p = __new(n * 8, 4, n * 8)
    i: int = 0
    while i < n:
        __st(p, i, 0)
        i += 1
    return p

def __dict():
    d = __new(56, 3, 0)
    __st(d, 6, 0)
    __st(d, 0, 0)
    __st(d, 1, 8)
    __st(d, 2, __zeros(8))
    __st(d, 3, __zeros(8))
    __st(d, 4, __zeros(8))
    __st(d, 5, list(0))
    return d

def __hash(k) -> int:
    h: int = 0
    t: int = __tag(k)
    if t == 6:
        k = int(k)
    elif t == 5:
        if __math(k, 1) == k and __math(k, 10) < __itof(1000000000000000000):
            k = int(k)
        else:
            k = __fbits(k)
    if t == 1:
        h = 5381
        n: int = __aux(k)
        i: int = 0
        while i < n:
            h = h * 33 + char_at(k, i)
            i += 1
    elif t == 9:
        h = 3430008
        n: int = __ld(k, 0)
        i: int = 0
        while i < n:
            h = (h ^ __hash(__lst(k, i))) * 1000003
            i += 1
    elif t == 12:
        h = __lst(k, 0)
        ws = __lst(k, 1)
        nw: int = len(ws)
        j: int = 0
        while j < nw:
            wv: int = __lst(ws, j)
            h = (h ^ wv) * 1000003
            j += 1
    elif t == 0 or t == 3 or t == 10:
        __err(0, "unhashable type")
    else:
        kv: int = k
        h = kv * -7046029254386353131
        h = h ^ (h >> 29)
    return h | 1

def __dfind(d, k, h: int) -> int:
    m: int = __ld(d, 1) - 1
    hs = __ld(d, 2)
    ks = __ld(d, 3)
    i: int = h & m
    while 1:
        x: int = __ld(hs, i)
        if x == 0:
            return i
        if x == h and __eq(__ld(ks, i), k):
            return i
        i = (i + 1) & m

def __dget(d, k, line):
    i: int = __dfind(d, k, __hash(k))
    if __ld(__ld(d, 2), i) == 0:
        __raise_rt(KeyError(k), line, concat("key not found: ", __repr(k)))
    return __ld(__ld(d, 4), i)

def get(d, k, dflt):
    i: int = __dfind(d, k, __hash(k))
    if __ld(__ld(d, 2), i) == 0:
        return dflt
    return __ld(__ld(d, 4), i)

def __dset(d, k, v):
    if (__ld(d, 0) + __ld(d, 6) + 1) * 4 > __ld(d, 1) * 3:
        __dresize(d)
    h: int = __hash(k)
    i: int = __dfind(d, k, h)
    hs = __ld(d, 2)
    if __ld(hs, i) == 0:
        __st(hs, i, h)
        __st(__ld(d, 3), i, k)
        __st(d, 0, __ld(d, 0) + 1)
        append(__ld(d, 5), k)
    __st(__ld(d, 4), i, v)
    return 0

def __dresize(d):
    oc: int = __ld(d, 1)
    ohs = __ld(d, 2)
    oks = __ld(d, 3)
    ovs = __ld(d, 4)
    nc: int = oc
    if (__ld(d, 0) + 1) * 2 > oc:
        nc = oc * 2
    __st(d, 6, 0)
    __st(d, 1, nc)
    __st(d, 2, __zeros(nc))
    __st(d, 3, __zeros(nc))
    __st(d, 4, __zeros(nc))
    j: int = 0
    while j < oc:
        h: int = __ld(ohs, j)
        if h != 0 and h != 2:
            k = __ld(oks, j)
            i: int = __dfind(d, k, h)
            __st(__ld(d, 2), i, h)
            __st(__ld(d, 3), i, k)
            __st(__ld(d, 4), i, __ld(ovs, j))
        j += 1
    return 0

def __ddel(d, k, line) -> int:
# remove k; returns 1 if it was present
    i: int = __dfind(d, k, __hash(k))
    hs = __ld(d, 2)
    if __ld(hs, i) == 0:
        return 0
    __st(hs, i, 2)
    __st(__ld(d, 3), i, 0)
    __st(__ld(d, 4), i, 0)
    __st(d, 0, __ld(d, 0) - 1)
    __st(d, 6, __ld(d, 6) + 1)
    ks = __ld(d, 5)
    n: int = __ld(ks, 0)
    kd: int = __ld(ks, 2)
    j: int = n - 1
    while j >= 0:
        x = __ld(kd, j)
        if __eq(x, k):
            __copy(kd + j * 8, kd + j * 8 + 8, (n - 1 - j) * 8)
            __st(kd, n - 1, 0)
            __st(ks, 0, n - 1)
            return 1
        j -= 1
    return 1

def __delidx(o, k, line):
    t: int = __tag(o)
    if t == 3:
        if not __ddel(o, k, line):
            raise KeyError(k)
        return 0
    if t == 0:
        n: int = __ld(o, 0)
        if __tag(k) == 0:
            return 0
        j: int = k
        if j < 0:
            j = j + n
        if j < 0 or j >= n:
            raise IndexError("list assignment index out of range")
        d: int = __ld(o, 2)
        __copy(d + j * 8, d + j * 8 + 8, (n - 1 - j) * 8)
        __st(d, n - 1, 0)
        __st(o, 0, n - 1)
        return 0
    __err(line, "object does not support item deletion")

def __delslice(o, a: int, b: int, line):
    n: int = __ld(o, 0)
    if a < 0:
        a = a + n
    if b < 0:
        b = b + n
    if a < 0:
        a = 0
    if b > n:
        b = n
    if b <= a:
        return 0
    d: int = __ld(o, 2)
    __copy(d + a * 8, d + b * 8, (n - b) * 8)
    j: int = n - (b - a)
    while j < n:
        __st(d, j, 0)
        j += 1
    __st(o, 0, n - (b - a))
    return 0

def clear(o):
    t: int = __tag(o)
    if t == 0:
        d: int = __ld(o, 2)
        j: int = __ld(o, 0)
        while j > 0:
            j -= 1
            __st(d, j, 0)
        __st(o, 0, 0)
        return None
    __st(o, 0, 0)
    __st(o, 1, 8)
    __st(o, 2, __zeros(8))
    __st(o, 3, __zeros(8))
    __st(o, 4, __zeros(8))
    __st(o, 5, list(0))
    __st(o, 6, 0)
    return None

def copy(o):
    t: int = __tag(o)
    if t == 0:
        return __listof(o)
    r = __dict()
    if t == 10:
        set_byte(r, -1, 10)
    for k in __ld(o, 5):
        __dset(r, k, __dget(o, k, 0))
    return r

def update(d, o):
    if __tag(d) == 10:
        for k in __iter(o, 0):
            __dset(d, k, 1)
        return None
    for k in __ld(o, 5):
        __dset(d, k, __dget(o, k, 0))
    return None

def setdefault(d, k, v=None):
    i: int = __dfind(d, k, __hash(k))
    if __ld(__ld(d, 2), i) != 0:
        return __ld(__ld(d, 4), i)
    __dset(d, k, v)
    return v

def pop__2(d, k):
    if __tag(d) == 0:
        n: int = __ld(d, 0)
        j: int = k
        if j < 0:
            j = j + n
        if j < 0 or j >= n:
            raise IndexError("pop index out of range")
        v = __lst(d, j)
        __delidx(d, j, 0)
        return v
    i: int = __dfind(d, k, __hash(k))
    if __ld(__ld(d, 2), i) == 0:
        raise KeyError(k)
    v = __ld(__ld(d, 4), i)
    __ddel(d, k, 0)
    return v

def pop__3(d, k, dflt):
    i: int = __dfind(d, k, __hash(k))
    if __ld(__ld(d, 2), i) == 0:
        return dflt
    v = __ld(__ld(d, 4), i)
    __ddel(d, k, 0)
    return v

# ---- sets: dicts tagged 10 whose values are unused ----
def set(xs=None):
    r = __dict()
    set_byte(r, -1, 10)
    if xs is not None:
        for x in __iter(xs, 0):
            __dset(r, x, 1)
    return r

def frozenset(xs=None):
    return set(xs)

def add(s, x):
    __dset(s, x, 1)
    return None

def discard(s, x):
    __ddel(s, x, 0)
    return None

def remove(s, x):
    if __tag(s) == 0:
        n: int = __ld(s, 0)
        i: int = 0
        while i < n:
            if __eq(__lst(s, i), x):
                __delidx(s, i, 0)
                return None
            i += 1
        raise ValueError("list.remove(x): x not in list")
    if not __ddel(s, x, 0):
        raise KeyError(x)
    return None

def __sop(a, b, op: int):
# 0 & 1 | 2 ^ 3 -
    r = set()
    if op == 1:
        for x in __ld(a, 5):
            __dset(r, x, 1)
        for x in __iter(b, 0):
            __dset(r, x, 1)
    elif op == 0:
        for x in __ld(a, 5):
            if __contains(b, x):
                __dset(r, x, 1)
    elif op == 3:
        for x in __ld(a, 5):
            if not __contains(b, x):
                __dset(r, x, 1)
    else:
        for x in __ld(a, 5):
            if not __contains(b, x):
                __dset(r, x, 1)
        for x in __iter(b, 0):
            if not __contains(a, x):
                __dset(r, x, 1)
    return r

def union(a, b):
    return __sop(a, set(b), 1)

def intersection(a, b):
    return __sop(a, set(b), 0)

def difference(a, b):
    return __sop(a, set(b), 3)

def symmetric_difference(a, b):
    return __sop(a, set(b), 2)

def issubset(a, b) -> bool:
    for x in __ld(a, 5):
        if not __contains(b, x):
            return False
    return True

def issuperset(a, b) -> bool:
    for x in __iter(b, 0):
        if not __contains(a, x):
            return False
    return True

def isdisjoint(a, b) -> bool:
    for x in __iter(b, 0):
        if __contains(a, x):
            return False
    return True

def __bitop(a, b, op: int):
    ta: int = __tag(a)
    tb: int = __tag(b)
    if ta == 10 and tb == 10:
        return __sop(a, b, op)
    if ta == 3 and tb == 3 and op == 1:
        r = copy(a)
        update(r, b)
        return r
    if ta == 6 and tb == 6:
        x: int = int(a)
        y: int = int(b)
        if op == 0:
            return bool(x & y)
        if op == 1:
            return bool(x | y)
        return bool(x ^ y)
    if (ta < 0 or ta == 6) and (tb < 0 or tb == 6):
        x: int = int(a)
        y: int = int(b)
        if op == 0:
            return x & y
        if op == 1:
            return x | y
        return x ^ y
    names = ["&", "|", "^"]
    raise TypeError(concat("unsupported operand type(s) for ", __lst(names, op)))

def keys(d):
    return __slice(__ld(d, 5), 0, __ld(__ld(d, 5), 0), 0)

def values(d):
    ks = __ld(d, 5)
    n: int = __ld(ks, 0)
    r = list(n)
    i: int = 0
    while i < n:
        __st(__ld(r, 2), i, __dget(d, __lst(ks, i), 0))
        i += 1
    return r

def items(d):
    ks = __ld(d, 5)
    n: int = __ld(ks, 0)
    r = list(n)
    i: int = 0
    while i < n:
        k = __lst(ks, i)
        __st(__ld(r, 2), i, __tup([k, __dget(d, k, 0)]))
        i += 1
    return r

# ---- strings ----
def __find(s, sub, start: int) -> int:
    n: int = __aux(s)
    m: int = __aux(sub)
    i: int = start
    while i + m <= n:
        j: int = 0
        while j < m and char_at(s, i + j) == char_at(sub, j):
            j += 1
        if j == m:
            return i
        i += 1
    return -1

def find(s, sub, start=0) -> int:
    if start < 0:
        start = start + __aux(s)
        if start < 0:
            start = 0
    return __find(s, sub, start)

def rfind(s, sub) -> int:
    n: int = __aux(s)
    m: int = __aux(sub)
    i: int = n - m
    while i >= 0:
        j: int = 0
        while j < m and char_at(s, i + j) == char_at(sub, j):
            j += 1
        if j == m:
            return i
        i -= 1
    return -1

def rindex(s, sub) -> int:
    i: int = rfind(s, sub)
    if i < 0:
        raise ValueError("substring not found")
    return i

def partition(s, sep):
    i: int = __find(s, sep, 0)
    if i < 0:
        return __tup([s, "", ""])
    return __tup([substr(s, 0, i), sep, substr(s, i + __aux(sep), __aux(s))])

def rpartition(s, sep):
    i: int = rfind(s, sep)
    if i < 0:
        return __tup(["", "", s])
    return __tup([substr(s, 0, i), sep, substr(s, i + __aux(sep), __aux(s))])

def __pad(s, w: int, fill, mode: int) -> str:
    n: int = __aux(s)
    if w <= n:
        return s
    k: int = w - n
    if mode == 0:
        return concat(s, __strmul(fill, k))
    if mode == 1:
        return concat(__strmul(fill, k), s)
    left: int = k // 2
    if k % 2 == 1 and w % 2 == 1:
        left += 1
    return concat(concat(__strmul(fill, left), s), __strmul(fill, k - left))

def ljust(s, w, fill=" ") -> str:
    return __pad(s, w, fill, 0)

def rjust(s, w, fill=" ") -> str:
    return __pad(s, w, fill, 1)

def center(s, w, fill=" ") -> str:
    return __pad(s, w, fill, 2)

def zfill(s, w) -> str:
    n: int = __aux(s)
    if w <= n:
        return s
    if n > 0 and (char_at(s, 0) == 45 or char_at(s, 0) == 43):
        return concat(concat(substr(s, 0, 1), __strmul("0", w - n)), substr(s, 1, n))
    return concat(__strmul("0", w - n), s)

def __isup(c: int) -> int:
    return c >= 65 and c <= 90

def __islo(c: int) -> int:
    return c >= 97 and c <= 122

def __chcase(s, mode: int) -> str:
# 0 title, 1 capitalize, 2 swapcase
    n: int = __aux(s)
    r = substr(s, 0, n)
    prev: int = 0
    i: int = 0
    while i < n:
        c: int = char_at(r, i)
        up: int = 0
        lo: int = 0
        if mode == 0:
            up = not prev
            lo = prev
        elif mode == 1:
            up = i == 0
            lo = i > 0
        else:
            up = __islo(c)
            lo = __isup(c)
        if up and __islo(c):
            set_byte(r, i, c - 32)
        elif lo and __isup(c):
            set_byte(r, i, c + 32)
        prev = __isup(c) or __islo(c)
        i += 1
    return r

def title(s) -> str:
    return __chcase(s, 0)

def capitalize(s) -> str:
    return __chcase(s, 1)

def swapcase(s) -> str:
    return __chcase(s, 2)

def __allc(s, k: int) -> int:
    n: int = __aux(s)
    if n == 0:
        return 0
    cased: int = 0
    i: int = 0
    while i < n:
        c: int = char_at(s, i)
        if k == 0:
            if not (__isup(c) or __islo(c) or (c >= 48 and c <= 57)):
                return 0
        elif k == 1:
            if not (__isspace(c) or c == 11 or c == 12):
                return 0
        elif k == 2:
            if __islo(c):
                return 0
            if __isup(c):
                cased = 1
        else:
            if __isup(c):
                return 0
            if __islo(c):
                cased = 1
        i += 1
    if k >= 2:
        return cased
    return 1

def isalnum(s) -> bool:
    return __allc(s, 0) == 1

def isspace(s) -> bool:
    return __allc(s, 1) == 1

def isupper(s) -> bool:
    return __allc(s, 2) == 1

def islower(s) -> bool:
    return __allc(s, 3) == 1

def removeprefix(s, p) -> str:
    if startswith(s, p):
        return substr(s, __aux(p), __aux(s))
    return s

def removesuffix(s, p) -> str:
    if __aux(p) > 0 and endswith(s, p):
        return substr(s, 0, __aux(s) - __aux(p))
    return s

def splitlines(s):
    r = []
    n: int = __aux(s)
    a: int = 0
    i: int = 0
    while i < n:
        c: int = char_at(s, i)
        if c == 10 or c == 13:
            append(r, substr(s, a, i))
            if c == 13 and i + 1 < n and char_at(s, i + 1) == 10:
                i += 1
            a = i + 1
        i += 1
    if a < n:
        append(r, substr(s, a, n))
    return r

def rsplit(s, sep=None, maxsplit=-1):
    if sep is None:
        return split__1(s)
    parts = split(s, sep)
    k: int = len(parts) - 1 - maxsplit
    if maxsplit < 0 or k <= 0:
        return parts
    head = __m_join(sep, __slice(parts, 0, k + 1, 0))
    r = [head]
    extend(r, __slice(parts, k + 1, len(parts), 0))
    return r

def __sfmt(s, args) -> str:
# str.format: args = [key-or-0, value, ...]
    pos = []
    kw = {}
    i: int = 0
    while i < len(args):
        k = args[i]
        if __tag(k) == 1:
            kw[k] = args[i + 1]
        else:
            append(pos, args[i + 1])
        i += 2
    out = []
    n: int = __aux(s)
    auto: int = 0
    i = 0
    a: int = 0
    while i < n:
        c: int = char_at(s, i)
        if c == 123 or c == 125:
            if i + 1 < n and char_at(s, i + 1) == c:
                append(out, substr(s, a, i + 1))
                i += 2
                a = i
                continue
            if c == 125:
                raise ValueError("Single '}' encountered in format string")
            append(out, substr(s, a, i))
            j: int = __find(s, "}", i)
            if j < 0:
                raise ValueError("Single '{' encountered in format string")
            field = substr(s, i + 1, j)
            spec = ""
            conv: int = 0
            ci: int = __find(field, ":", 0)
            if ci >= 0:
                spec = substr(field, ci + 1, __aux(field))
                field = substr(field, 0, ci)
            bi: int = __find(field, "!", 0)
            if bi >= 0:
                conv = char_at(field, bi + 1)
                field = substr(field, 0, bi)
            v = None
            if __aux(field) == 0:
                v = pos[auto]
                auto += 1
            elif isdigit(field):
                v = pos[int(field)]
            else:
                v = kw[field]
            if conv == 114:
                v = repr(v)
            elif conv == 115:
                v = __str(v)
            append(out, __format(v, spec))
            i = j + 1
            a = i
        else:
            i += 1
    append(out, substr(s, a, n))
    return __m_join("", out)

def startswith(s, p) -> bool:
    m: int = __aux(p)
    if m > __aux(s):
        return False
    i: int = 0
    while i < m:
        if char_at(s, i) != char_at(p, i):
            return False
        i += 1
    return True

def endswith(s, p) -> bool:
    m: int = __aux(p)
    o: int = __aux(s) - m
    if o < 0:
        return False
    i: int = 0
    while i < m:
        if char_at(s, o + i) != char_at(p, i):
            return False
        i += 1
    return True

def __isspace(c: int) -> int:
    return c == 32 or c == 10 or c == 9 or c == 13

def __instr(c: int, chars) -> int:
    if chars is None:
        return __isspace(c) or c == 11 or c == 12
    n: int = __aux(chars)
    i: int = 0
    while i < n:
        if char_at(chars, i) == c:
            return 1
        i += 1
    return 0

def __strip(s, chars, mode: int) -> str:
    a: int = 0
    b: int = __aux(s)
    if mode & 1:
        while a < b and __instr(char_at(s, a), chars):
            a += 1
    if mode & 2:
        while b > a and __instr(char_at(s, b - 1), chars):
            b -= 1
    return substr(s, a, b)

def strip(s, chars=None) -> str:
    return __strip(s, chars, 3)

def lstrip(s, chars=None) -> str:
    return __strip(s, chars, 1)

def rstrip(s, chars=None) -> str:
    return __strip(s, chars, 2)

def split(s, sep):
    r = []
    n: int = __aux(s)
    m: int = __aux(sep)
    if m == 0:
        __err(0, "empty separator")
    a: int = 0
    i: int = __find(s, sep, 0)
    while i >= 0:
        append(r, substr(s, a, i))
        a = i + m
        i = __find(s, sep, a)
    append(r, substr(s, a, n))
    return r

def split__1(s):
    r = []
    n: int = __aux(s)
    i: int = 0
    while i < n:
        while i < n and __isspace(char_at(s, i)):
            i += 1
        if i >= n:
            break
        a: int = i
        while i < n and not __isspace(char_at(s, i)):
            i += 1
        append(r, substr(s, a, i))
    return r

def __m_join(sep, xs) -> str:
    if __tag(xs) != 0 and __tag(xs) != 9:
        xs = __iter(xs, 0)
    n: int = __ld(xs, 0)
    if n == 0:
        return ""
    parts = list(2 * n - 1)
    pd = __ld(parts, 2)
    i: int = 0
    while i < n:
        if i > 0:
            __st(pd, 2 * i - 1, sep)
        __st(pd, 2 * i, __str(__lst(xs, i)))
        i += 1
    return join(parts, 2 * n - 1)

def replace(s, a, b) -> str:
    return __m_join(b, split(s, a))

def __mapcase(s, lo: int, hi: int, d: int) -> str:
    n: int = __aux(s)
    r = substr(s, 0, n)
    i: int = 0
    while i < n:
        c: int = char_at(r, i)
        if c >= lo and c <= hi:
            set_byte(r, i, c + d)
        i += 1
    return r

def upper(s) -> str:
    return __mapcase(s, 97, 122, -32)

def lower(s) -> str:
    return __mapcase(s, 65, 90, 32)

def isdigit(s) -> bool:
    n: int = __aux(s)
    i: int = 0
    while i < n:
        c: int = char_at(s, i)
        if c < 48 or c > 57:
            return False
        i += 1
    return n > 0

def isalpha(s) -> bool:
    n: int = __aux(s)
    i: int = 0
    while i < n:
        c: int = char_at(s, i) | 32
        if c < 97 or c > 122:
            return False
        i += 1
    return n > 0

def int(x) -> int:
    t: int = __tag(x)
    if t == 12:
        __iovf(0)
    if t == 6:
        v: int = x
        return v & 1
    if t == 5:
        f: int = __ftoi(x, 0)
        if (f >> 2) == 1152921504606846976:
            __iovf(0)
        return f
    if t != 1:
        return x
    s = strip(x)
    n: int = __aux(s)
    i: int = 0
    neg: int = 0
    if n > 0 and char_at(s, 0) == 45:
        neg = 1
        i = 1
    v: int = 0
    if i >= n:
        __err(0, concat("invalid literal for int(): ", __repr(x)))
    while i < n:
        c: int = char_at(s, i) - 48
        if c < 0 or c > 9:
            __err(0, concat("invalid literal for int(): ", __repr(x)))
        if v < -922337203685477580 or (v == -922337203685477580 and c > 8):
            __iovf(0)
        v = v * 10 - c
        i += 1
    if neg:
        return v
    if v == -9223372036854775807 - 1:
        __iovf(0)
    v = 0 - v
    if (v >> 2) == 1152921504606846976:
    # 2**62 .. 2**62+3 alias the bool/None encodings
        __iovf(0)
    return v

# ---- numbers and lists ----
def abs(x):
    t: int = __tag(x)
    if t == 5:
        return __math(x, 10)
    if t == 12:
        return __bigmk(1, __lst(x, 1))
    v: int = int(x)
    if v < 0:
        return 0 - v
    return v

def min(a, b):
    if __lt(b, a):
        return b
    return a

def max(a, b):
    if __lt(a, b):
        return b
    return a

def min__1(xs, key=None):
    xs = __iter(xs, 0)
    if __ld(xs, 0) == 0:
        raise ValueError("min() arg is an empty sequence")
    m = __lst(xs, 0)
    if key is not None:
        km = key(m)
        for x in xs:
            kx = key(x)
            if __lt(kx, km):
                m = x
                km = kx
        return m
    for x in xs:
        if __lt(x, m):
            m = x
    return m

def max__1(xs, key=None):
    xs = __iter(xs, 0)
    if __ld(xs, 0) == 0:
        raise ValueError("max() arg is an empty sequence")
    m = __lst(xs, 0)
    if key is not None:
        km = key(m)
        for x in xs:
            kx = key(x)
            if __lt(km, kx):
                m = x
                km = kx
        return m
    for x in xs:
        if __lt(m, x):
            m = x
    return m

def sum(xs):
    if __tag(xs) != 0 and __tag(xs) != 9:
        xs = __iter(xs, 0)
    s: int = 0
    n: int = __ld(xs, 0)
    d = __ld(xs, 2)
    i: int = 0
    while i < n:
        v = __ld(d, i)
        vi: int = v
        t: int = s + vi
        if __tag(v) >= 0 or (vi >= 0 and t < s) or (vi < 0 and t >= s):
            acc = __add(s, 0, 0)
            while i < n:
                acc = acc + __ld(d, i)
                i += 1
            return acc
        s = t
        i += 1
    return s

def __pow(a, b):
    ta: int = __tag(a)
    tb: int = __tag(b)
    if ta == 12 and tb != 5:
        return __bigpow(a, int(b))
    if ta != 5 and tb != 5:
        ia: int = int(a)
        ib: int = int(b)
        if ib >= 0:
            if __powfits(ia, ib):
                return __ipow(ia, ib)
            return __bigpow(ia, ib)
        return __itof(1) / __ipow(ia, 0 - ib)
    if b == 2:
        return a * a
    if a == 0:
        if b < 0:
            __err(0, "0.0 cannot be raised to a negative power")
        if b == 0:
            return __itof(1)
        return __itof(0)
    if a > 0:
        return __math2(b, a, 1)
    if __math(b, 1) != b:
        __err(0, "negative number cannot be raised to a fractional power")
    r = __math2(b, 0 - a, 1)
    if __math(b / 2, 1) != b / 2:
        return 0 - r
    return r

def __ipow(a: int, b: int) -> int:
    if b > 2 or a > 3037000499 or a < -3037000499:
        if not __powfits(a, b):
            __iovf(0)
    r: int = 1
    while b > 0:
        if b & 1:
            r = r * a
        b = b >> 1
        if b > 0:
            a = a * a
    return r

def __powfits(a: int, b: int) -> int:
    if a < 0:
        a = 0 - a
    if a <= 1:
        return 1
    k: int = 0
    while a > 0:
        k += 1
        a = a >> 1
    return k * b <= 62

def __msort(d, t, lo: int, hi: int):
    if hi - lo < 2:
        return 0
    mid: int = (lo + hi) // 2
    __msort(d, t, lo, mid)
    __msort(d, t, mid, hi)
    i: int = lo
    j: int = mid
    k: int = lo
    while k < hi:
        if j >= hi or (i < mid and not __lt(__ld(d, j), __ld(d, i))):
            __st(t, k, __ld(d, i))
            i += 1
        else:
            __st(t, k, __ld(d, j))
            j += 1
        k += 1
    __copy(d + lo * 8, t + lo * 8, (hi - lo) * 8)
    return 0

def sort(xs, key=None, reverse=False):
    n: int = __ld(xs, 0)
    if key is None and not reverse:
        __msort(__ld(xs, 2), __new(n * 8 + 8, 4, n * 8), 0, n)
        return None
    ps = []
    i: int = 0
    while i < n:
        x = __ld(__ld(xs, 2), i)
        k = x
        if key is not None:
            k = key(x)
        if reverse:
            append(ps, [k, 0 - i, x])
        else:
            append(ps, [k, i, x])
        i += 1
    __msort(__ld(ps, 2), __new(n * 8 + 8, 4, n * 8), 0, n)
    i = 0
    while i < n:
        j: int = i
        if reverse:
            j = n - 1 - i
        __st(__ld(xs, 2), i, ps[j][2])
        i += 1
    return None

def sorted(xs, key=None, reverse=False):
    r = __listof(xs)
    sort(r, key, reverse)
    return r

def map(f, xs):
    r = []
    for x in xs:
        append(r, f(x))
    return r

def filter(f, xs):
    r = []
    for x in xs:
        if f is None:
            if x:
                append(r, x)
        elif f(x):
            append(r, x)
    return r

def __fv_str(x):
    return str(x)

def __fv_len(x):
    return len(x)

def __fv_chr(x):
    return chr(x)

def reverse(xs):
    d = __ld(xs, 2)
    i: int = 0
    j: int = __ld(xs, 0) - 1
    while i < j:
        t = __ld(d, i)
        __st(d, i, __ld(d, j))
        __st(d, j, t)
        i += 1
        j -= 1
    return 0

def extend(xs, ys):
    for y in ys:
        append(xs, y)
    return 0

def range(n: int):
    return range__3(0, n, 1)

def range__2(a: int, b: int):
    return range__3(a, b, 1)

def range__3(a: int, b: int, s: int):
    if s == 0:
        __err(0, "range() step must not be zero")
    r = []
    i: int = a
    if s > 0:
        while i < b:
            append(r, i)
            i += s
    else:
        while i > b:
            append(r, i)
            i += s
    return r

# ---- helpers the code generator calls ----
def __truth(x) -> int:
    t: int = __tag(x)
    if t < 0:
        v: int = x
        return v != 0
    if t == 6:
        w: int = x
        return w & 1
    if t == 7:
        return 0
    if t == 5:
        return (__fbits(x) << 1) != 0
    if t == 1:
        return __aux(x) != 0
    if t == 0 or t == 3 or t == 9 or t == 10:
        return __ld(x, 0) != 0
    return 1

def __cmp(a, b) -> int:
    if __lt(a, b):
        return -1
    if __lt(b, a):
        return 1
    return 0

def __strmul(s, k: int) -> str:
    if k <= 0:
        return ""
    parts = list(k)
    d = __ld(parts, 2)
    i: int = 0
    while i < k:
        __st(d, i, s)
        i += 1
    return join(parts, k)

def __listof(x):
    if __tag(x) < 0:
        n: int = x
        return list(n)
    it = __iter(x, 0)
    r = __slice(it, 0, __ld(it, 0), 0)
    set_byte(r, -1, 0)
    return r

def get__2(d, k):
    return get(d, k, None)

def count(xs, x) -> int:
    c: int = 0
    if __tag(xs) == 1:
        m: int = __aux(x)
        if m == 0:
            return __aux(xs) + 1
        i: int = __find(xs, x, 0)
        while i >= 0:
            c += 1
            i = __find(xs, x, i + m)
        return c
    for y in xs:
        if __eq(y, x):
            c += 1
    return c

def index(xs, x) -> int:
    i: int = 0
    if __tag(xs) == 1:
        i = __find(xs, x, 0)
        if i < 0:
            raise ValueError("substring not found")
        return i
    for y in xs:
        if __eq(y, x):
            return i
        i += 1
    __err(0, "value not in list")

# ---- float formatting: exact decimal conversion via bignums ----
def __bn_shr(a, k: int):
    w: int = k >> 5
    b: int = k & 31
    n: int = len(a)
    r = []
    i: int = w
    while i < n:
        x: int = a[i]
        t: int = x >> b
        if i + 1 < n and b > 0:
            y: int = a[i + 1]
            t = t | ((y << (32 - b)) & 4294967295)
        append(r, t)
        i += 1
    return __bn_norm(r)

def __bn_divs(a, d: int):
    n: int = len(a)
    q = __list_mul([0], n)
    r: int = 0
    i: int = n - 1
    while i >= 0:
        x: int = a[i]
        cur: int = (r << 32) | x
        q[i] = cur // d
        r = cur % d
        i -= 1
    return [__bn_norm(q), r]

def __bn_divmod(a, b):
    if __bn_cmp(a, b) < 0:
        return [[], a]
    if len(b) == 1:
        y: int = b[0]
        if y < 2147483648:
            qr = __bn_divs(a, y)
            return [qr[0], __bn(qr[1])]
    nbits: int = __bn_bitlen(a)
    r = []
    q = __list_mul([0], len(a))
    i: int = nbits - 1
    while i >= 0:
        r = __bn_shl(r, 1)
        x: int = a[i >> 5]
        if (x >> (i & 31)) & 1:
            if len(r) == 0:
                r = [1]
            else:
                z: int = r[0]
                r[0] = z | 1
        if __bn_cmp(r, b) >= 0:
            r = __bn_sub(r, b)
            w: int = q[i >> 5]
            q[i >> 5] = w | (1 << (i & 31))
        i -= 1
    return [__bn_norm(q), r]

def __bn_str(a) -> str:
    if len(a) == 0:
        return "0"
    parts = []
    while len(a) > 0:
        qr = __bn_divs(a, 1000000000)
        a = qr[0]
        s: str = __itos(qr[1])
        if len(a) > 0:
            s = concat(__strmul("0", 9 - len(s)), s)
        append(parts, s)
    out: str = ""
    i: int = len(parts) - 1
    while i >= 0:
        out = concat(out, parts[i])
        i -= 1
    return out

def __fscaled(x, k: int):
# round-half-even of |x| * 10**k as a bignum
    bits: int = __fbits(x)
    er: int = (bits >> 52) & 2047
    m: int = bits & 4503599627370495
    e: int = -1074
    if er > 0:
        m = m | 4503599627370496
        e = er - 1075
    num = __bn(m)
    den = [1]
    if e >= 0:
        num = __bn_shl(num, e)
    else:
        den = __bn_shl(den, 0 - e)
    if k >= 0:
        num = __bn_mulpow(num, k)
    else:
        den = __bn_mulpow(den, 0 - k)
    if len(num) == 0:
        return []
    if e < 0 and k >= 0:
        q = __bn_shr(num, 0 - e)
        r = __bn_sub(num, __bn_shl(q, 0 - e))
    else:
        qr = __bn_divmod(num, den)
        q = qr[0]
        r = qr[1]
    c: int = __bn_cmp(__bn_shl(r, 1), den)
    if len(r) == 0:
        c = -1
    if c > 0 or (c == 0 and len(q) > 0 and (__lst(q, 0) & 1)):
        q = __bn_add(q, [1])
    return q

def __fspecial(x) -> int:
    return ((__fbits(x) >> 52) & 2047) == 2047

def __ffix(x, p: int) -> str:
    if __fspecial(x):
        return __frepr(__math(x, 10))
    d: str = __bn_str(__fscaled(x, p))
    if p == 0:
        return d
    if len(d) <= p:
        d = concat(__strmul("0", p + 1 - len(d)), d)
    n: int = len(d)
    return concat(concat(substr(d, 0, n - p), "."), substr(d, n - p, n))

def __fexpd(x, p: int):
# [digits (p+1 of them), exponent]
    if __fbits(x) << 1 == 0:
        return [__strmul("0", p + 1), 0]
    ex: int = __ftoi(__math(__math(__math(x, 10), 9), 1), 0)
    while True:
        q: str = __bn_str(__fscaled(x, p - ex))
        if len(q) > p + 1:
            ex += 1
        elif len(q) < p + 1:
            ex -= 1
        else:
            return [q, ex]

def __fexp(x, p: int, alt: int, up: int) -> str:
    if __fspecial(x):
        return __frepr(__math(x, 10))
    de = __fexpd(x, p)
    q: str = de[0]
    ex: int = de[1]
    s: str = substr(q, 0, 1)
    if p > 0 or alt:
        s = concat(concat(s, "."), substr(q, 1, len(q)))
    return concat(s, __fexps(ex, up))

def __fexps(ex: int, up: int) -> str:
    s: str = "e"
    if up:
        s = "E"
    if ex < 0:
        s = concat(s, "-")
        ex = 0 - ex
    else:
        s = concat(s, "+")
    if ex < 10:
        s = concat(s, "0")
    return concat(s, __itos(ex))

def __strip0(s: str) -> str:
    if __find(s, ".", 0) < 0:
        return s
    n: int = len(s)
    while n > 0 and char_at(s, n - 1) == 48:
        n -= 1
    if n > 0 and char_at(s, n - 1) == 46:
        n -= 1
    return substr(s, 0, n)

def __fgen(x, p: int, alt: int, up: int) -> str:
    if __fspecial(x):
        return __frepr(__math(x, 10))
    if p == 0:
        p = 1
    de = __fexpd(x, p - 1)
    ex: int = de[1]
    if ex >= -4 and ex < p:
        s: str = __ffix(x, p - 1 - ex)
        if alt:
            return s
        return __strip0(s)
    q: str = de[0]
    m: str = substr(q, 0, 1)
    if len(q) > 1:
        m = concat(concat(m, "."), substr(q, 1, len(q)))
    if not alt:
        m = __strip0(m)
    return concat(m, __fexps(ex, up))

def round(x):
    if __tag(x) == 5:
        return __ftoi(x, 2)
    return int(x)

def round__2(x, n: int):
    if __tag(x) == 5:
        if __fspecial(x) or n > 300:
            return x
        if n < -308:
            return __ffrombits(__fbits(x) & (1 << 63))
        neg: int = __fbits(x) < 0
        s: str = "0"
        if n >= 0:
            s = __ffix(x, n)
        else:
            s = concat(__bn_str(__fscaled(x, n)), __strmul("0", 0 - n))
        v = __fparse(s, 0)
        if neg:
            return __neg(v)
        return v
    v: int = int(x)
    if n >= 0:
        return v
    p: int = __ipow(10, 0 - n)
    r: int = v % p
    b: int = v - r
    if r * 2 > p or (r * 2 == p and (b // p) % 2 == 1):
        b += p
    return b

def __grp(s: str, sep: str) -> str:
    n: int = len(s)
    out: str = ""
    i: int = 0
    while i < n:
        if i > 0 and (n - i) % 3 == 0:
            out = concat(out, sep)
        out = concat(out, substr(s, i, i + 1))
        i += 1
    return out

def __radix(v: int, b: int, up: int) -> str:
    if v == 0:
        return "0"
    dg: str = "0123456789abcdef"
    if up:
        dg = "0123456789ABCDEF"
    s: str = ""
    while v > 0:
        s = concat(substr(dg, v % b, v % b + 1), s)
        v = v // b
    return s

def __isdig(c: int) -> int:
    return c >= 48 and c <= 57

def format(x):
    return __str(x)

def format__2(x, spec):
    return __format(x, spec)

def __format(x, spec) -> str:
    n: int = len(spec)
    if n == 0:
        return __str(x)
    fill: str = " "
    align: int = 0
    sign: int = 45
    alt: int = 0
    width: int = 0
    grp: str = ""
    prec: int = -1
    typ: int = 0
    i: int = 0
    if n >= 2 and __find("<>^=", substr(spec, 1, 2), 0) >= 0:
        fill = substr(spec, 0, 1)
        align = char_at(spec, 1)
        i = 2
    elif __find("<>^=", substr(spec, 0, 1), 0) >= 0:
        align = char_at(spec, 0)
        i = 1
    if i < n and (char_at(spec, i) == 43 or char_at(spec, i) == 45 or char_at(spec, i) == 32):
        sign = char_at(spec, i)
        i += 1
    if i < n and char_at(spec, i) == 35:
        alt = 1
        i += 1
    if i < n and char_at(spec, i) == 48:
        if align == 0:
            fill = "0"
            align = 61
        i += 1
    while i < n and __isdig(char_at(spec, i)):
        width = width * 10 + char_at(spec, i) - 48
        i += 1
    if i < n and (char_at(spec, i) == 44 or char_at(spec, i) == 95):
        grp = substr(spec, i, i + 1)
        i += 1
    if i < n and char_at(spec, i) == 46:
        i += 1
        prec = 0
        while i < n and __isdig(char_at(spec, i)):
            prec = prec * 10 + char_at(spec, i) - 48
            i += 1
    if i < n:
        typ = char_at(spec, i)
    t: int = __tag(x)
    neg: int = 0
    body: str = ""
    numeric: int = 1
    if t == 1 or (typ == 0 and t != 5 and t >= 0) or typ == 115:
        numeric = 0
        body = __str(x)
        if prec >= 0:
            body = substr(body, 0, prec)
    elif t == 5 or typ == 102 or typ == 70 or typ == 101 or typ == 69 or typ == 103 or typ == 71 or typ == 37:
        f = float(x)
        neg = __fbits(f) < 0
        a = __math(f, 10)
        if typ == 102 or typ == 70:
            if prec < 0:
                prec = 6
            body = __ffix(a, prec)
            if alt and prec == 0:
                body = concat(body, ".")
        elif typ == 101 or typ == 69:
            if prec < 0:
                prec = 6
            body = __fexp(a, prec, alt, typ == 69)
        elif typ == 37:
            if prec < 0:
                prec = 6
            body = concat(__ffix(a * 100.0, prec), "%")
        elif typ == 103 or typ == 71:
            if prec < 0:
                prec = 6
            body = __fgen(a, prec, alt, typ == 71)
        elif prec >= 0:
            body = __fgen(a, prec, alt, 0)
            if __find(body, ".", 0) < 0 and __find(body, "e", 0) < 0 and __find(body, "n", 0) < 0:
                body = concat(body, ".0")
        else:
            body = __frepr(a)
        if typ == 70 or typ == 69 or typ == 71:
            body = upper(body)
        if grp != "":
            k: int = __find(body, ".", 0)
            if k < 0:
                k = __find(body, "e", 0)
            if k < 0:
                k = len(body)
            if __isdig(char_at(body, 0)):
                body = concat(__grp(substr(body, 0, k), grp), substr(body, k, len(body)))
    else:
        v: int = int(x)
        if v < 0:
            neg = 1
            v = 0 - v
        if typ == 120 or typ == 88:
            body = __radix(v, 16, typ == 88)
            if alt:
                body = concat(concat("0", substr(spec, n - 1, n)), body)
        elif typ == 111:
            body = __radix(v, 8, 0)
            if alt:
                body = concat("0o", body)
        elif typ == 98:
            body = __radix(v, 2, 0)
            if alt:
                body = concat("0b", body)
        elif typ == 99:
            body = chr(v)
        else:
            body = __itos(v)
            if grp != "":
                body = __grp(body, grp)
    pre: str = ""
    if numeric:
        if neg:
            pre = "-"
        elif sign == 43:
            pre = "+"
        elif sign == 32:
            pre = " "
    if align == 0:
        align = 60
        if numeric:
            align = 62
    pad: int = width - len(pre) - len(body)
    if pad <= 0:
        return concat(pre, body)
    if align == 60:
        return concat(concat(pre, body), __strmul(fill, pad))
    if align == 62:
        return concat(__strmul(fill, pad), concat(pre, body))
    if align == 94:
        return concat(concat(__strmul(fill, pad // 2), concat(pre, body)), __strmul(fill, pad - pad // 2))
    return concat(concat(pre, __strmul(fill, pad)), body)

def __pctfmt(s, args, line) -> str:
    if __tag(args) != 9 and __tag(args) != 0:
        args = [args]
    out: str = ""
    n: int = len(s)
    i: int = 0
    j: int = 0
    while i < n:
        c: int = char_at(s, i)
        if c != 37:
            k: int = __find(s, "%", i)
            if k < 0:
                k = n
            out = concat(out, substr(s, i, k))
            i = k
            continue
        i += 1
        if i < n and char_at(s, i) == 37:
            out = concat(out, "%")
            i += 1
            continue
        st: int = i
        while i < n and __find("-+ #0123456789.", substr(s, i, i + 1), 0) >= 0:
            i += 1
        fl: str = substr(s, st, i)
        ty: int = char_at(s, i)
        i += 1
        if j >= len(args):
            __err(line, "not enough arguments for format string")
        a = args[j]
        j += 1
        if __find(fl, "-", 0) >= 0:
            fl = concat("<", replace(fl, "-", ""))
        if ty == 115:
            out = concat(out, __format(__str(a), fl))
        elif ty == 114:
            out = concat(out, __format(__repr(a), fl))
        elif ty == 100 or ty == 105 or ty == 117:
            out = concat(out, __format(int(a), concat(fl, "d")))
        else:
            out = concat(out, __format(a, concat(fl, chr(ty))))
    if j < len(args):
        __err(line, "not all arguments converted during string formatting")
    return out

# ---- math module (math.f / from math import f map to __math_f) ----
def __fl(x):
    if __tag(x) == 5:
        return x
    return float(x)

def __math_sqrt(x):
    f = __fl(x)
    if f < 0.0:
        raise ValueError("math domain error")
    return __math(f, 0)

def __math_floor(x) -> int:
    if __tag(x) != 5:
        return int(x)
    return __ftoi(x, 1)

def __math_ceil(x) -> int:
    if __tag(x) != 5:
        return int(x)
    return 0 - __ftoi(__neg(x), 1)

def __math_trunc(x) -> int:
    return int(x)

def __math_sin(x):
    return __math(__fl(x), 2)

def __math_cos(x):
    return __math(__fl(x), 3)

def __math_tan(x):
    return __math(__fl(x), 4)

def __math_atan(x):
    return __math(__fl(x), 5)

def __math_atan2(y, x):
    return __math2(__fl(y), __fl(x), 0)

def __math_exp(x):
    return __math(__fl(x), 6)

def __math_log(x):
    f = __fl(x)
    if f <= 0.0:
        raise ValueError("math domain error")
    return __math(f, 7)

def __math_log__2(x, b):
    return __math_log(x) / __math_log(b)

def __math_log2(x):
    f = __fl(x)
    if f <= 0.0:
        raise ValueError("math domain error")
    return __math(f, 8)

def __math_log10(x):
    f = __fl(x)
    if f <= 0.0:
        raise ValueError("math domain error")
    return __math(f, 9)

def __math_fabs(x):
    return __math(__fl(x), 10)

def __math_pow(x, y):
    return __fl(__pow(__fl(x), __fl(y)))

def __math_hypot(x, y):
    a = __fl(x)
    b = __fl(y)
    return __math(a * a + b * b, 0)

def __math_isnan(x) -> bool:
    f = __fl(x)
    return f != f

def __math_isinf(x) -> bool:
    return __fspecial(__fl(x)) and (__fbits(__fl(x)) & 4503599627370495) == 0

def __math_isfinite(x) -> bool:
    return not __fspecial(__fl(x))

def __math_nan():
    return __ffrombits(9221120237041090560)

def __math_gcd(a: int, b: int) -> int:
    if a < 0:
        a = 0 - a
    if b < 0:
        b = 0 - b
    while b != 0:
        t: int = a % b
        a = b
        b = t
    return a

def bool(x) -> bool:
    return __truth(x) != 0

def hash(x) -> int:
    return __hash(x)

# ---- iteration protocol, generators ----
class generator:
    def __init__(self, f):
        h = __new(80, 4, 80)
        i: int = 0
        while i < 10:
            __st(h, i, 0)
            i += 1
        __st(h, 0, f)
        __st(h, 1, __new(65536, 4, 65536))
        self.h = h

    def __iter__(self):
        return self

    def __next__(self):
        return __gnext(self.h, None)

    def send(self, v):
        return __gnext(self.h, v)

    def close(self):
        __st(self.h, 3, 3)
        __st(self.h, 1, 0)
        return None

def __mkgen(f):
    g = generator(f)
    if __tag(f) == 99:
        __gstart(g)
    return g

def __gstart(h):
    r = None
    try:
        f = __ld(h, 0)
        r = f()
    except:
        __st(h, 4, __excval())
        __st(h, 9, __excline())
        __gfin(None, 4)
    __gfin(r, 3)

def __gnext(h, v):
    s: int = __ld(h, 3)
    if s >= 3:
        raise StopIteration()
    if s == 2:
        raise ValueError("generator already executing")
    r = __gresume(h, v)
    s = __ld(h, 3)
    if s == 3:
        __st(h, 1, 0)
        raise StopIteration()
    if s == 4:
        __st(h, 1, 0)
        __st(h, 3, 3)
        __raise(__ld(h, 4), __ld(h, 9))
    return r

def __yfrom(it):
    for x in it:
        __gyield(x)
    return None

class __listiter:
    def __init__(self, xs):
        self.xs = xs
        self.i = 0

    def __iter__(self):
        return self

    def __next__(self):
        i: int = self.i
        if i >= len(self.xs):
            raise StopIteration()
        self.i = i + 1
        return self.xs[i]

def iter(x):
    if __tag(x) == 2:
        return x.__iter__()
    return __listiter(__iter(x, 0))

def next__1(it):
    if isinstance(it, generator):
        return __gnext(it.h, None)
    return it.__next__()

def next__2(it, dflt):
    try:
        return next__1(it)
    except StopIteration:
        return dflt

def __forit(x, line):
    if __tag(x) == 2:
        b = [None, x.__iter__()]
        __st(b, 0, 0)
        set_byte(b, -1, 11)
        return b
    return __iter(x, line)

def __inext(b) -> int:
    if __tag(b) != 11:
        return 0
    d = __ld(b, 2)
    it = __ld(d, 1)
    r = None
    if isinstance(it, generator):
        h = it.h
        s: int = __ld(h, 3)
        if s >= 3:
            return 0
        r = __gresume(h, None)
        s = __ld(h, 3)
        if s == 3:
            __st(h, 1, 0)
            return 0
        if s == 4:
            __st(h, 1, 0)
            __st(h, 3, 3)
            __raise(__ld(h, 4), __ld(h, 9))
    else:
        try:
            r = it.__next__()
        except StopIteration:
            return 0
    __st(d, 0, r)
    __st(b, 0, 1)
    return 1

def __drain(x):
    b = __forit(x, 0)
    r = []
    while __inext(b):
        append(r, __lst(b, 0))
    return r

# ---- files ----
class OSError(Exception):
    pass
class FileNotFoundError(OSError):
    pass

class __File:
    def __init__(self, path, mode):
        self.path = path
        self.mode = mode
        self.data = ""
        self.pos = 0
        self.parts = []
        self.closed = False
        self.w = __find(mode, "w", 0) >= 0 or __find(mode, "a", 0) >= 0

    def read(self, n=-1):
        p: int = self.pos
        m: int = __aux(self.data)
        if n < 0 or p + n > m:
            n = m - p
        self.pos = p + n
        return substr(self.data, p, p + n)

    def readline(self):
        p: int = self.pos
        m: int = __aux(self.data)
        q: int = __find(self.data, "\n", p)
        if q < 0:
            q = m
        else:
            q += 1
        self.pos = q
        return substr(self.data, p, q)

    def readlines(self):
        r = []
        while self.pos < __aux(self.data):
            append(r, self.readline())
        return r

    def write(self, s):
        append(self.parts, s)
        return len(s)

    def writelines(self, xs):
        for s in xs:
            append(self.parts, s)
        return None

    def flush(self):
        return None

    def close(self):
        if not self.closed and self.w:
            if not write_file(self.path, join(self.parts, len(self.parts))):
                raise OSError(concat("cannot write ", self.path))
        self.closed = True
        return None

    def __iter__(self):
        return self

    def __next__(self):
        if self.pos >= __aux(self.data):
            raise StopIteration()
        return self.readline()

    def __enter__(self):
        return self

    def __exit__(self, t, v, tb):
        self.close()
        return False

def open(path, mode="r", encoding=None):
    f = __File(path, mode)
    if __find(mode, "w", 0) >= 0:
        return f
    if __syscall(21, path, 4, 0) != 0:
        if __find(mode, "a", 0) >= 0:
            return f
        raise FileNotFoundError(concat("No such file or directory: ", __repr(path)))
    s = read_file(path)
    if __find(mode, "a", 0) >= 0:
        append(f.parts, s)
    else:
        f.data = s
    return f

# ---- sys / os / time ----
class __Stream:
    def __init__(self, fd):
        self.fd = fd

    def write(self, s):
        if self.fd == 2:
            __flushout()
            __syscall(1, 2, s, __aux(s))
        else:
            __writes(s)
        return len(s)

    def flush(self):
        return None

    def read(self, n=-1):
        parts = []
        buf = alloc(65536)
        while True:
            n: int = __syscall(0, 0, buf, 65536)
            if n <= 0:
                break
            append(parts, substr(buf, 0, n))
        return join(parts, len(parts))

    def readline(self):
    # unbuffered so that no state is needed; the kernel keeps the position
        parts = []
        buf = alloc(8)
        while True:
            n: int = __syscall(0, 0, buf, 1)
            if n <= 0:
                break
            c = substr(buf, 0, 1)
            append(parts, c)
            if char_at(buf, 0) == 10:
                break
        return join(parts, len(parts))

    def readlines(self):
        r = []
        while True:
            l = self.readline()
            if __aux(l) == 0:
                return r
            append(r, l)

    def __iter__(self):
        return self

    def __next__(self):
        l = self.readline()
        if __aux(l) == 0:
            raise StopIteration()
        return l

def __sys_stdout():
    return __Stream(1)

def __sys_stderr():
    return __Stream(2)

def __sys_stdin():
    return __Stream(0)

def __sys_argv():
    return __mkargv()

def __flushout():
    __flush()

def __mkargv():
    r = []
    i: int = 0
    while i < argc():
        append(r, argv(i))
        i += 1
    return r

def __sys_exit(code=0):
    if __tag(code) == 1:
        eputs(code)
        exit(1)
    if code is None:
        exit(0)
    exit(code)

def __sys_setrecursionlimit(n):
    return None

def __sys_getrecursionlimit():
    return 1000

def __os_getenv(name, dflt=None):
    i: int = 0
    while True:
        e = __env(i)
        if __tag(e) != 1:
            return dflt
        if startswith(e, name) and char_at(e, __aux(name)) == 61:
            return substr(e, __aux(name) + 1, __aux(e))
        i += 1

def __os_path_exists(p) -> bool:
    return __syscall(21, p, 0, 0) == 0

def __os_path_join(a, b):
    if startswith(b, "/"):
        return b
    if __aux(a) == 0 or endswith(a, "/"):
        return concat(a, b)
    return concat(concat(a, "/"), b)

def __os_path_basename(p):
    i: int = rfind(p, "/")
    return substr(p, i + 1, __aux(p))

def __os_path_dirname(p):
    i: int = rfind(p, "/")
    if i < 0:
        return ""
    if i == 0:
        return "/"
    return substr(p, 0, i)

def __os_remove(p):
    if __syscall(87, p, 0, 0) != 0:
        raise FileNotFoundError(concat("No such file or directory: ", __repr(p)))
    return None

def __os_getcwd():
    buf = alloc(4096)
    n: int = __syscall(79, buf, 4096, 0)
    if n <= 0:
        return "."
    return substr(buf, 0, __find(buf, chr(0), 0))

def __time_time():
    return __clock(0) / 1000000000

def __time_time_ns() -> int:
    return __clock(0)

def __time_perf_counter():
    return __clock(1) / 1000000000

def __time_perf_counter_ns() -> int:
    return __clock(1)

def __time_monotonic():
    return __clock(1) / 1000000000

def __time_sleep(s):
    ns: int = int(s * 1000000000)
    ts = __new(16, 4, 16)
    __st(ts, 0, ns // 1000000000)
    __st(ts, 1, ns % 1000000000)
    __syscall(35, ts, 0, 0)
    return None

def __exctype():
    return __excval()

def dict(xs=None):
    r = __dict()
    if xs is None:
        return r
    if __tag(xs) == 3:
        for k in __ld(xs, 5):
            __dset(r, k, xs[k])
        return r
    for p in xs:
        __dset(r, p[0], p[1])
    return r

def zip__2(a, b):
    a = __iter(a, 0)
    b = __iter(b, 0)
    n: int = min(len(a), len(b))
    r = list(n)
    i: int = 0
    while i < n:
        r[i] = (a[i], b[i])
        i += 1
    return r

def zip__3(a, b, c):
    a = __iter(a, 0)
    b = __iter(b, 0)
    c = __iter(c, 0)
    n: int = min(min(len(a), len(b)), len(c))
    r = list(n)
    i: int = 0
    while i < n:
        r[i] = (a[i], b[i], c[i])
        i += 1
    return r

def enumerate__1(xs):
    return enumerate__2(xs, 0)

def enumerate__2(xs, start):
    xs = __iter(xs, 0)
    n: int = len(xs)
    r = list(n)
    i: int = 0
    while i < n:
        r[i] = (i + start, xs[i])
        i += 1
    return r

def reversed(xs):
    xs = __iter(xs, 0)
    n: int = len(xs)
    r = list(n)
    i: int = 0
    while i < n:
        r[i] = xs[n - 1 - i]
        i += 1
    return r

def any(xs) -> bool:
    for x in xs:
        if x:
            return True
    return False

def all(xs) -> bool:
    for x in xs:
        if not x:
            return False
    return True

def divmod(a, b):
    return (a // b, a % b)

def __radixp(x, base: int, pre):
    if x < 0:
        return concat(concat("-", pre), __radix(-x, base, 0))
    return concat(pre, __radix(x, base, 0))

def hex(x):
    return __radixp(x, 16, "0x")

def bin(x):
    return __radixp(x, 2, "0b")

def oct(x):
    return __radixp(x, 8, "0o")

def pow__2(a, b):
    return a ** b

def pow__3(a, b, m):
    r = 1
    a = a % m
    while b > 0:
        if b & 1:
            r = r * a % m
        a = a * a % m
        b = b >> 1
    return r

def input__0():
    return input__1("")

def input__1(prompt):
    if __aux(prompt) > 0:
        __writes(prompt)
    __flush()
    l = __Stream(0).readline()
    if endswith(l, "\n"):
        return substr(l, 0, __aux(l) - 1)
    if __aux(l) == 0:
        raise EOFError("EOF when reading a line")
    return l

class EOFError(Exception):
    pass
