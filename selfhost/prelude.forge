# Forge prelude: library code written in Forge and compiled into every program.
# Unreferenced functions are dropped from the output. A user function with the same name replaces a public one here.
# Internals use only __-prefixed helpers so user code cannot change their behaviour.

def __err(line, msg):
    eputs(concat(concat(concat("error: line ", __itos(line)), ": "), msg))
    exit(1)

def __lst(xs: list, i: int):
    return __ld(__ld(xs, 2), i)

def __grow(xs, need: int):
    cap: int = __ld(xs, 1)
    if need <= cap:
        return 0
    nc: int = cap * 2
    if nc < need:
        nc = need
    d = __new(nc * 8, 4, nc * 8)
    __copy(d, __ld(xs, 2), __ld(xs, 0) * 8)
    __st(xs, 2, d)
    __st(xs, 1, nc)
    return 0

def append(xs, v):
    n: int = __ld(xs, 0)
    if n >= __ld(xs, 1):
        __grow(xs, n + 1)
    __st(__ld(xs, 2), n, v)
    __st(xs, 0, n + 1)
    return 0

def pop(xs):
    n: int = __ld(xs, 0) - 1
    if n < 0:
        __err(0, "pop from empty list")
    __st(xs, 0, n)
    return __ld(__ld(xs, 2), n)

def insert(xs, i: int, v):
    n: int = __ld(xs, 0)
    if i < 0:
        i = i + n
    if i < 0:
        i = 0
    if i > n:
        i = n
    append(xs, 0)
    d = __ld(xs, 2)
    j: int = n
    while j > i:
        __st(d, j, __ld(d, j - 1))
        j -= 1
    __st(d, i, v)
    return 0

def __list_add(a, b):
    na: int = __ld(a, 0)
    nb: int = __ld(b, 0)
    r = list(na + nb)
    __copy(__ld(r, 2), __ld(a, 2), na * 8)
    __copy(__ld(r, 2) + na * 8, __ld(b, 2), nb * 8)
    return r

def __list_mul(a, k: int):
    n: int = __ld(a, 0)
    if k < 0:
        k = 0
    r = list(n * k)
    d = __ld(r, 2)
    s = __ld(a, 2)
    i: int = 0
    while i < k:
        __copy(d + i * n * 8, s, n * 8)
        i += 1
    return r

def __itos(x) -> str:
    return __itos_raw(x)

def __str(x) -> str:
    t: int = __tag(x)
    if t == 1:
        return x
    if t < 0:
        return __itos_raw(x)
    if t == 2:
        return x.__str__()
    return __repr(x)

def __brepr(x) -> str:
    v: int = x
    if v & 1:
        return "True"
    return "False"

def __repr(x) -> str:
    t: int = __tag(x)
    if t == 1:
        return concat(concat("'", x), "'")
    if t < 0:
        return __itos_raw(x)
    if t == 6:
        return __brepr(x)
    if t == 5:
        return __frepr(x)
    parts = []
    if t == 0:
        n: int = __ld(x, 0)
        append(parts, "[")
        i: int = 0
        while i < n:
            if i > 0:
                append(parts, ", ")
            append(parts, __repr(__lst(x, i)))
            i += 1
        append(parts, "]")
    elif t == 3:
        ks = __ld(x, 5)
        n: int = __ld(ks, 0)
        append(parts, "{")
        i: int = 0
        while i < n:
            if i > 0:
                append(parts, ", ")
            k = __lst(ks, i)
            append(parts, __repr(k))
            append(parts, ": ")
            append(parts, __repr(__dget(x, k, 0)))
            i += 1
        append(parts, "}")
    else:
        return x.__repr__()
    return join(parts, __ld(parts, 0))

def __typeid(x) -> int:
    # class index + 1 for objects; -1 int, -2 str, -3 list, -4 dict, -5 float, -6 bool
    t: int = __tag(x)
    if t < 0:
        return -1
    if t == 2:
        return __aux(x)
    if t == 1:
        return -2
    if t == 0:
        return -3
    if t == 3:
        return -4
    if t == 5:
        return -5
    if t == 6:
        return -6
    return -7

def __m___str__(o) -> str:
    return o.__repr__()

def __m___repr__(o) -> str:
    return "<object>"

def __pr(x):
    t: int = __tag(x)
    if t == 1:
        __writes(x)
    elif t < 0:
        __wint(x)
    else:
        __writes(__str(x))
    return 0

def __isnum(x) -> int:
    t: int = __tag(x)
    return t < 0 or t == 5 or t == 6

def __binop(a, b, op: int, line):
    if op == 2:
        ta: int = __tag(a)
        tb: int = __tag(b)
        if ta == 1 and __isnum(b):
            return __strmul(a, int(b))
        if tb == 1 and __isnum(a):
            return __strmul(b, int(a))
        if ta == 0 and __isnum(b):
            return __list_mul(a, int(b))
        if tb == 0 and __isnum(a):
            return __list_mul(b, int(a))
    names = ["+", "-", "*", "/", "//", "%"]
    __err(line, concat(concat("unsupported operand type(s) for ", __lst(names, op)), ""))

def __cmpop(a, b, op: int) -> int:
    if op == 10:
        return __eq(a, b)
    if op == 11:
        return __eq(a, b) == 0
    if op == 12:
        return __lt(a, b)
    if op == 13:
        return __lt(b, a)
    if op == 14:
        return __lt(b, a) == 0
    return __lt(a, b) == 0

def __neg(x):
    if __tag(x) == 5:
        return __ffrombits(__fbits(x) ^ (1 << 63))
    return 0 - x

def __ffloordiv(a, b):
    return __math(a / b, 1)

# ---- arbitrary-precision naturals (little-endian base 2^32 limbs) for exact float<->decimal ----
def __bn_norm(a):
    while len(a) > 0 and a[len(a) - 1] == 0:
        pop(a)
    return a

def __bn(v: int):
    a = []
    while v > 0:
        append(a, v & 4294967295)
        v = v >> 32
    return a

def __bn_muls(a, m: int):
    r = []
    c: int = 0
    n: int = len(a)
    i: int = 0
    while i < n:
        x: int = a[i]
        t: int = x * m + c
        append(r, t & 4294967295)
        c = t >> 32
        i += 1
    while c > 0:
        append(r, c & 4294967295)
        c = c >> 32
    return r

def __bn_add(a, b):
    na: int = len(a)
    nb: int = len(b)
    r = []
    c: int = 0
    i: int = 0
    while i < na or i < nb:
        t: int = c
        if i < na:
            x: int = a[i]
            t = t + x
        if i < nb:
            y: int = b[i]
            t = t + y
        append(r, t & 4294967295)
        c = t >> 32
        i += 1
    if c > 0:
        append(r, c)
    return r

def __bn_sub(a, b):
    # a - b, a >= b
    na: int = len(a)
    nb: int = len(b)
    r = []
    c: int = 0
    i: int = 0
    while i < na:
        x: int = a[i]
        t: int = x - c
        if i < nb:
            y: int = b[i]
            t = t - y
        c = 0
        if t < 0:
            t = t + 4294967296
            c = 1
        append(r, t)
        i += 1
    return __bn_norm(r)

def __bn_cmp(a, b) -> int:
    na: int = len(a)
    nb: int = len(b)
    if na != nb:
        if na < nb:
            return -1
        return 1
    i: int = na - 1
    while i >= 0:
        x: int = a[i]
        y: int = b[i]
        if x != y:
            if x < y:
                return -1
            return 1
        i -= 1
    return 0

def __bn_shl(a, k: int):
    if len(a) == 0:
        return []
    r = []
    w: int = k >> 5
    b: int = k & 31
    i: int = 0
    while i < w:
        append(r, 0)
        i += 1
    c: int = 0
    n: int = len(a)
    i = 0
    while i < n:
        x: int = a[i]
        t: int = (x << b) | c
        append(r, t & 4294967295)
        c = t >> 32
        i += 1
    if c > 0:
        append(r, c)
    return r

def __bn_bitlen(a) -> int:
    n: int = len(a)
    if n == 0:
        return 0
    x: int = a[n - 1]
    b: int = 0
    while x > 0:
        b += 1
        x = x >> 1
    return (n - 1) * 32 + b

def __bn_pow10(k: int):
    r = [1]
    while k >= 9:
        r = __bn_muls(r, 1000000000)
        k -= 9
    while k > 0:
        r = __bn_muls(r, 10)
        k -= 1
    return r

def __bn_toint(a) -> int:
    v: int = 0
    i: int = len(a) - 1
    while i >= 0:
        x: int = a[i]
        v = (v << 32) | x
        i -= 1
    return v

def __frepr(x) -> str:
    bits: int = __fbits(x)
    neg: int = (bits >> 63) & 1
    er: int = (bits >> 52) & 2047
    f: int = bits & 4503599627370495
    if er == 2047:
        if f != 0:
            return "nan"
        if neg:
            return "-inf"
        return "inf"
    if er == 0 and f == 0:
        if neg:
            return "-0.0"
        return "0.0"
    if er >= 1023 and er < 1023 + 53:
        iv: int = __ftoi(x, 0)
        if iv < 10000000000000000 and iv > -10000000000000000 and __itof(iv) == x:
            return concat(str(iv), ".0")
    m: int = f
    e: int = -1074
    if er > 0:
        m = f | 4503599627370496
        e = er - 1075
    big: int = 0
    if m == 4503599627370496 and er > 1:
        big = 1
    if e >= 0:
        r = __bn_shl(__bn(m), e + 1 + big)
        s = __bn(2 << big)
        mp = __bn_shl([1], e + big)
        mm = __bn_shl([1], e)
    else:
        r = __bn(m << (1 + big))
        s = __bn_shl([1], 1 + big - e)
        mp = __bn(1 << big)
        mm = [1]
    even: int = (m & 1) == 0
    k: int = 0
    while True:
        c: int = __bn_cmp(__bn_add(r, mp), s)
        if c > 0 or (c == 0 and even):
            s = __bn_muls(s, 10)
            k += 1
        else:
            break
    while True:
        c = __bn_cmp(__bn_muls(__bn_add(r, mp), 10), s)
        if c < 0 or (c == 0 and not even):
            r = __bn_muls(r, 10)
            mp = __bn_muls(mp, 10)
            mm = __bn_muls(mm, 10)
            k -= 1
        else:
            break
    ds = []
    while True:
        r = __bn_muls(r, 10)
        mp = __bn_muls(mp, 10)
        mm = __bn_muls(mm, 10)
        d: int = 0
        while __bn_cmp(r, s) >= 0:
            r = __bn_sub(r, s)
            d += 1
        c1: int = __bn_cmp(r, mm)
        lo: int = c1 < 0 or (c1 == 0 and even)
        c2: int = __bn_cmp(__bn_add(r, mp), s)
        hi: int = c2 > 0 or (c2 == 0 and even)
        if not lo and not hi:
            append(ds, d)
        else:
            if hi and not lo:
                d += 1
            elif hi and lo:
                c3: int = __bn_cmp(__bn_shl(r, 1), s)
                if c3 > 0 or (c3 == 0 and (d & 1) == 1):
                    d += 1
            append(ds, d)
            break
    n: int = len(ds)
    parts = []
    if neg:
        append(parts, "-")
    x10: int = k - 1
    i: int = 0
    if x10 >= -5 + 1 and x10 < 16:
        if k <= 0:
            append(parts, "0.")
            i = 0
            while i < 0 - k:
                append(parts, "0")
                i += 1
            i = 0
            while i < n:
                append(parts, chr(48 + ds[i]))
                i += 1
        else:
            while i < n or i < k:
                if i == k:
                    append(parts, ".")
                if i < n:
                    append(parts, chr(48 + ds[i]))
                else:
                    append(parts, "0")
                i += 1
            if n <= k:
                append(parts, ".0")
    else:
        append(parts, chr(48 + ds[0]))
        if n > 1:
            append(parts, ".")
            i = 1
            while i < n:
                append(parts, chr(48 + ds[i]))
                i += 1
        append(parts, "e")
        if x10 < 0:
            append(parts, "-")
            x10 = 0 - x10
        else:
            append(parts, "+")
        if x10 < 10:
            append(parts, "0")
        append(parts, str(x10))
    return join(parts, len(parts))

def __bn_ratio_bits(num, den) -> int:
    # correctly rounded double nearest num/den (both > 0)
    e: int = __bn_bitlen(num) - __bn_bitlen(den) - 53
    q: int = 0
    rem = []
    d2 = []
    while True:
        if e < -1074:
            e = -1074
        if e >= 0:
            n2 = num
            d2 = __bn_shl(den, e)
        else:
            n2 = __bn_shl(num, 0 - e)
            d2 = den
        q = 0
        b: int = 56
        while b >= 0:
            t = __bn_shl(d2, b)
            if __bn_cmp(n2, t) >= 0:
                n2 = __bn_sub(n2, t)
                q = q | (1 << b)
            b -= 1
        rem = n2
        if q >= 9007199254740992:
            e += 1
        elif q < 4503599627370496 and e > -1074:
            e -= 1
        else:
            break
    c: int = __bn_cmp(__bn_shl(rem, 1), d2)
    if c > 0 or (c == 0 and (q & 1) == 1):
        q += 1
        if q == 9007199254740992:
            q = q >> 1
            e += 1
    if e + 1075 >= 2047:
        return 9218868437227405312
    return ((e + 1074) << 52) + q

def __fparse(s0, line):
    s = lower(strip(s0))
    n: int = len(s)
    i: int = 0
    neg: int = 0
    if n > 0 and (char_at(s, 0) == 45 or char_at(s, 0) == 43):
        neg = char_at(s, 0) == 45
        i = 1
    rest = substr(s, i, n)
    bits: int = 0
    if str_eq(rest, "inf") or str_eq(rest, "infinity"):
        bits = 9218868437227405312
    elif str_eq(rest, "nan"):
        bits = 9221120237041090560
    else:
        mant = []
        mi: int = 0
        nd: int = 0
        e10: int = 0
        seen: int = 0
        dot: int = 0
        while i < n:
            c: int = char_at(s, i)
            if c >= 48 and c <= 57:
                mant = __bn_add(__bn_muls(mant, 10), __bn(c - 48))
                if len(mant) > 0:
                    nd += 1
                    if nd <= 18:
                        mi = mi * 10 + c - 48
                if dot:
                    e10 -= 1
                seen = 1
            elif c == 46 and not dot:
                dot = 1
            elif c == 95 and seen:
                pass
            else:
                break
            i += 1
        if i < n and char_at(s, i) == 101 and seen:
            i += 1
            en: int = 0
            if i < n and (char_at(s, i) == 45 or char_at(s, i) == 43):
                en = char_at(s, i) == 45
                i += 1
            ev: int = 0
            sd: int = 0
            while i < n and char_at(s, i) >= 48 and char_at(s, i) <= 57:
                if ev < 100000:
                    ev = ev * 10 + char_at(s, i) - 48
                sd = 1
                i += 1
            if not sd:
                seen = 0
            if en:
                ev = 0 - ev
            e10 += ev
        if not seen or i != n:
            __err(line, concat(concat("could not convert string to float: ", __repr(s0)), ""))
        if len(mant) == 0:
            bits = 0
        elif nd <= 15 and e10 >= -22 and e10 <= 22:
            # Clinger's fast path: both operands exact, one correctly rounded op
            fm = __itof(mi)
            if e10 >= 0:
                fm = fm * __fpow10(e10)
            else:
                fm = fm / __fpow10(0 - e10)
            bits = __fbits(fm)
        elif nd + e10 > 310:
            bits = 9218868437227405312
        elif nd + e10 < -330:
            bits = 0
        elif e10 >= 0:
            bits = __bn_ratio_bits(__bn_mulpow(mant, e10), [1])
        else:
            bits = __bn_ratio_bits(mant, __bn_pow10(0 - e10))
    if neg:
        bits = bits | (1 << 63)
    return __ffrombits(bits)

def __fpow10(k: int):
    if k <= 18:
        return __itof(__ipow(10, k))
    return __itof(__ipow(10, 18)) * __itof(__ipow(10, k - 18))

def __bn_mulpow(a, k: int):
    while k >= 9:
        a = __bn_muls(a, 1000000000)
        k -= 9
    while k > 0:
        a = __bn_muls(a, 10)
        k -= 1
    return a

def float(x):
    t: int = __tag(x)
    if t == 5:
        return x
    if t == 1:
        return __fparse(x, 0)
    if t == 6:
        v: int = x
        return __itof(v & 1)
    return __itof(x)

def __add(a, b, line):
    ta: int = __tag(a)
    tb: int = __tag(b)
    if ta < 0 and tb < 0:
        return a - (0 - b)
    if ta == 1 and tb == 1:
        return concat(a, b)
    if ta == 0 and tb == 0:
        return __list_add(a, b)
    __err(line, "unsupported operand types for +")

def __eq(a, b) -> int:
    x: int = a
    y: int = b
    if x == y:
        return 1
    ta: int = __tag(a)
    tb: int = __tag(b)
    if ta == 1 and tb == 1:
        return str_eq(a, b)
    if __isnum(a) and __isnum(b):
        return a == b
    if ta == 0 and tb == 0:
        n: int = __ld(a, 0)
        if n != __ld(b, 0):
            return 0
        i: int = 0
        while i < n:
            if not __eq(__lst(a, i), __lst(b, i)):
                return 0
            i += 1
        return 1
    return 0

def __lt(a, b) -> int:
    ta: int = __tag(a)
    tb: int = __tag(b)
    if ta == 1 and tb == 1:
        return __strcmp(a, b) < 0
    if __isnum(a) and __isnum(b):
        return a < b
    if ta == 0 and tb == 0:
        na: int = __ld(a, 0)
        nb: int = __ld(b, 0)
        i: int = 0
        while i < na and i < nb:
            x = __lst(a, i)
            y = __lst(b, i)
            if not __eq(x, y):
                return __lt(x, y)
            i += 1
        return na < nb
    __err(0, "'<' not supported between these types")
    return 0

def __strcmp(a, b):
    na: int = __aux(a)
    nb: int = __aux(b)
    i: int = 0
    while i < na and i < nb:
        d: int = char_at(a, i) - char_at(b, i)
        if d != 0:
            return d
        i += 1
    return na - nb

def __getidx(o, i: int, line):
    t: int = __tag(o)
    if t == 0:
        n: int = __ld(o, 0)
        j: int = i
        if j < 0:
            j = j + n
        if j < 0 or j >= n:
            __err(line, concat(concat(concat("list index ", __itos_raw(i)), " out of range for length "), __itos_raw(n)))
        return __lst(o, j)
    if t == 1:
        n: int = __aux(o)
        j: int = i
        if j < 0:
            j = j + n
        if j < 0 or j >= n:
            __err(line, "string index out of range")
        return chr(char_at(o, j))
    if t == 3:
        return __dget(o, i, line)
    __err(line, "value is not indexable")

def __setidx(o, i: int, v, line):
    t: int = __tag(o)
    if t == 0:
        n: int = __ld(o, 0)
        j: int = i
        if j < 0:
            j = j + n
        if j < 0 or j >= n:
            __err(line, concat(concat(concat("list assignment index ", __itos_raw(i)), " out of range for length "), __itos_raw(n)))
        __st(__ld(o, 2), j, v)
        return 0
    if t == 3:
        __dset(o, i, v)
        return 0
    __err(line, "value does not support item assignment")

def __slice(o, a: int, b: int, line):
    t: int = __tag(o)
    n: int = 0
    if t == 0:
        n = __ld(o, 0)
    elif t == 1:
        n = __aux(o)
    else:
        __err(line, "value cannot be sliced")
    if a < 0:
        a = a + n
    if b < 0:
        b = b + n
    if a < 0:
        a = 0
    if b > n:
        b = n
    if b < a:
        b = a
    if t == 1:
        return substr(o, a, b)
    r = list(b - a)
    __copy(__ld(r, 2), __ld(o, 2) + a * 8, (b - a) * 8)
    return r

def __iter(x, line):
    t: int = __tag(x)
    if t == 0:
        return x
    if t == 3:
        return __ld(x, 5)
    if t == 1:
        n: int = __aux(x)
        r = list(n)
        i: int = 0
        while i < n:
            __st(__ld(r, 2), i, chr(char_at(x, i)))
            i += 1
        return r
    __err(line, "value is not iterable")

def __contains(c, x):
    t: int = __tag(c)
    if t == 3:
        i: int = __dfind(c, x, __hash(x))
        return __ld(__ld(c, 2), i) != 0
    if t == 0:
        n: int = __ld(c, 0)
        i: int = 0
        while i < n:
            if __eq(__lst(c, i), x):
                return 1
            i += 1
        return 0
    if t == 1:
        return __find(c, x, 0) >= 0
    return 0

# ---- dict: open addressing, insertion-ordered keys ----
# layout: [count, cap, hashes, keys, values, order(list of keys)]
def __zeros(n: int):
    p = __new(n * 8, 4, n * 8)
    i: int = 0
    while i < n:
        __st(p, i, 0)
        i += 1
    return p

def __dict():
    d = __new(48, 3, 0)
    __st(d, 0, 0)
    __st(d, 1, 8)
    __st(d, 2, __zeros(8))
    __st(d, 3, __zeros(8))
    __st(d, 4, __zeros(8))
    __st(d, 5, list(0))
    return d

def __hash(k) -> int:
    h: int = 0
    t: int = __tag(k)
    if t == 6:
        k = int(k)
    elif t == 5:
        if __math(k, 1) == k and __math(k, 10) < __itof(1000000000000000000):
            k = int(k)
        else:
            k = __fbits(k)
    if t == 1:
        h = 5381
        n: int = __aux(k)
        i: int = 0
        while i < n:
            h = h * 33 + char_at(k, i)
            i += 1
    else:
        h = k * -7046029254386353131
        h = h ^ (h >> 29)
    return h | 1

def __dfind(d, k, h: int) -> int:
    m: int = __ld(d, 1) - 1
    hs = __ld(d, 2)
    ks = __ld(d, 3)
    i: int = h & m
    while 1:
        x: int = __ld(hs, i)
        if x == 0:
            return i
        if x == h and __eq(__ld(ks, i), k):
            return i
        i = (i + 1) & m

def __dget(d, k, line):
    i: int = __dfind(d, k, __hash(k))
    if __ld(__ld(d, 2), i) == 0:
        __err(line, concat("key not found: ", __repr(k)))
    return __ld(__ld(d, 4), i)

def get(d, k, dflt):
    i: int = __dfind(d, k, __hash(k))
    if __ld(__ld(d, 2), i) == 0:
        return dflt
    return __ld(__ld(d, 4), i)

def __dset(d, k, v):
    if (__ld(d, 0) + 1) * 4 > __ld(d, 1) * 3:
        __dresize(d)
    h: int = __hash(k)
    i: int = __dfind(d, k, h)
    hs = __ld(d, 2)
    if __ld(hs, i) == 0:
        __st(hs, i, h)
        __st(__ld(d, 3), i, k)
        __st(d, 0, __ld(d, 0) + 1)
        append(__ld(d, 5), k)
    __st(__ld(d, 4), i, v)
    return 0

def __dresize(d):
    oc: int = __ld(d, 1)
    ohs = __ld(d, 2)
    oks = __ld(d, 3)
    ovs = __ld(d, 4)
    nc: int = oc * 2
    __st(d, 1, nc)
    __st(d, 2, __zeros(nc))
    __st(d, 3, __zeros(nc))
    __st(d, 4, __zeros(nc))
    j: int = 0
    while j < oc:
        h: int = __ld(ohs, j)
        if h != 0:
            k = __ld(oks, j)
            i: int = __dfind(d, k, h)
            __st(__ld(d, 2), i, h)
            __st(__ld(d, 3), i, k)
            __st(__ld(d, 4), i, __ld(ovs, j))
        j += 1
    return 0

def keys(d):
    return __slice(__ld(d, 5), 0, __ld(__ld(d, 5), 0), 0)

def values(d):
    ks = __ld(d, 5)
    n: int = __ld(ks, 0)
    r = list(n)
    i: int = 0
    while i < n:
        __st(__ld(r, 2), i, __dget(d, __lst(ks, i), 0))
        i += 1
    return r

def items(d):
    ks = __ld(d, 5)
    n: int = __ld(ks, 0)
    r = list(n)
    i: int = 0
    while i < n:
        k = __lst(ks, i)
        __st(__ld(r, 2), i, [k, __dget(d, k, 0)])
        i += 1
    return r

# ---- strings ----
def __find(s, sub, start: int) -> int:
    n: int = __aux(s)
    m: int = __aux(sub)
    i: int = start
    while i + m <= n:
        j: int = 0
        while j < m and char_at(s, i + j) == char_at(sub, j):
            j += 1
        if j == m:
            return i
        i += 1
    return -1

def find(s, sub) -> int:
    return __find(s, sub, 0)

def startswith(s, p) -> int:
    m: int = __aux(p)
    if m > __aux(s):
        return 0
    i: int = 0
    while i < m:
        if char_at(s, i) != char_at(p, i):
            return 0
        i += 1
    return 1

def endswith(s, p) -> int:
    m: int = __aux(p)
    o: int = __aux(s) - m
    if o < 0:
        return 0
    i: int = 0
    while i < m:
        if char_at(s, o + i) != char_at(p, i):
            return 0
        i += 1
    return 1

def __isspace(c: int) -> int:
    return c == 32 or c == 10 or c == 9 or c == 13

def strip(s) -> str:
    a: int = 0
    b: int = __aux(s)
    while a < b and __isspace(char_at(s, a)):
        a += 1
    while b > a and __isspace(char_at(s, b - 1)):
        b -= 1
    return substr(s, a, b)

def split(s, sep):
    r = []
    n: int = __aux(s)
    m: int = __aux(sep)
    if m == 0:
        __err(0, "empty separator")
    a: int = 0
    i: int = __find(s, sep, 0)
    while i >= 0:
        append(r, substr(s, a, i))
        a = i + m
        i = __find(s, sep, a)
    append(r, substr(s, a, n))
    return r

def split__1(s):
    r = []
    n: int = __aux(s)
    i: int = 0
    while i < n:
        while i < n and __isspace(char_at(s, i)):
            i += 1
        if i >= n:
            break
        a: int = i
        while i < n and not __isspace(char_at(s, i)):
            i += 1
        append(r, substr(s, a, i))
    return r

def __m_join(sep, xs) -> str:
    n: int = __ld(xs, 0)
    if n == 0:
        return ""
    parts = list(2 * n - 1)
    pd = __ld(parts, 2)
    i: int = 0
    while i < n:
        if i > 0:
            __st(pd, 2 * i - 1, sep)
        __st(pd, 2 * i, __str(__lst(xs, i)))
        i += 1
    return join(parts, 2 * n - 1)

def replace(s, a, b) -> str:
    return __m_join(b, split(s, a))

def __mapcase(s, lo: int, hi: int, d: int) -> str:
    n: int = __aux(s)
    r = substr(s, 0, n)
    i: int = 0
    while i < n:
        c: int = char_at(r, i)
        if c >= lo and c <= hi:
            set_byte(r, i, c + d)
        i += 1
    return r

def upper(s) -> str:
    return __mapcase(s, 97, 122, -32)

def lower(s) -> str:
    return __mapcase(s, 65, 90, 32)

def isdigit(s) -> int:
    n: int = __aux(s)
    i: int = 0
    while i < n:
        c: int = char_at(s, i)
        if c < 48 or c > 57:
            return 0
        i += 1
    return n > 0

def isalpha(s) -> int:
    n: int = __aux(s)
    i: int = 0
    while i < n:
        c: int = char_at(s, i) | 32
        if c < 97 or c > 122:
            return 0
        i += 1
    return n > 0

def int(x) -> int:
    t: int = __tag(x)
    if t == 6:
        v: int = x
        return v & 1
    if t == 5:
        return __ftoi(x, 0)
    if t != 1:
        return x
    s = strip(x)
    n: int = __aux(s)
    i: int = 0
    neg: int = 0
    if n > 0 and char_at(s, 0) == 45:
        neg = 1
        i = 1
    v: int = 0
    if i >= n:
        __err(0, concat("invalid literal for int(): ", __repr(x)))
    while i < n:
        c: int = char_at(s, i) - 48
        if c < 0 or c > 9:
            __err(0, concat("invalid literal for int(): ", __repr(x)))
        v = v * 10 + c
        i += 1
    if neg:
        return 0 - v
    return v

# ---- numbers and lists ----
def abs(x):
    t: int = __tag(x)
    if t == 5:
        return __math(x, 10)
    v: int = int(x)
    if v < 0:
        return 0 - v
    return v

def min(a, b):
    if __lt(b, a):
        return b
    return a

def max(a, b):
    if __lt(a, b):
        return b
    return a

def min__1(xs):
    m = __lst(xs, 0)
    for x in xs:
        if __lt(x, m):
            m = x
    return m

def max__1(xs):
    m = __lst(xs, 0)
    for x in xs:
        if __lt(m, x):
            m = x
    return m

def sum(xs):
    s: int = 0
    n: int = __ld(xs, 0)
    d = __ld(xs, 2)
    i: int = 0
    while i < n:
        v = __ld(d, i)
        if __tag(v) >= 0:
            acc = s
            while i < n:
                acc = acc + __ld(d, i)
                i += 1
            return acc
        s += v
        i += 1
    return s

def __pow(a, b):
    ta: int = __tag(a)
    tb: int = __tag(b)
    if ta != 5 and tb != 5:
        ia: int = int(a)
        ib: int = int(b)
        if ib >= 0:
            return __ipow(ia, ib)
        return __itof(1) / __ipow(ia, 0 - ib)
    if a == 0:
        if b < 0:
            __err(0, "0.0 cannot be raised to a negative power")
        if b == 0:
            return __itof(1)
        return __itof(0)
    if a > 0:
        return __math2(b, a, 1)
    if __math(b, 1) != b:
        __err(0, "negative number cannot be raised to a fractional power")
    r = __math2(b, 0 - a, 1)
    if __math(b / 2, 1) != b / 2:
        return 0 - r
    return r

def __ipow(a: int, b: int) -> int:
    r: int = 1
    while b > 0:
        if b & 1:
            r = r * a
        a = a * a
        b = b >> 1
    return r

def __msort(d, t, lo: int, hi: int):
    if hi - lo < 2:
        return 0
    mid: int = (lo + hi) // 2
    __msort(d, t, lo, mid)
    __msort(d, t, mid, hi)
    i: int = lo
    j: int = mid
    k: int = lo
    while k < hi:
        if j >= hi or (i < mid and not __lt(__ld(d, j), __ld(d, i))):
            __st(t, k, __ld(d, i))
            i += 1
        else:
            __st(t, k, __ld(d, j))
            j += 1
        k += 1
    __copy(d + lo * 8, t + lo * 8, (hi - lo) * 8)
    return 0

def sort(xs):
    n: int = __ld(xs, 0)
    __msort(__ld(xs, 2), __new(n * 8 + 8, 4, n * 8), 0, n)
    return 0

def sorted(xs):
    r = __slice(xs, 0, __ld(xs, 0), 0)
    sort(r)
    return r

def reverse(xs):
    d = __ld(xs, 2)
    i: int = 0
    j: int = __ld(xs, 0) - 1
    while i < j:
        t = __ld(d, i)
        __st(d, i, __ld(d, j))
        __st(d, j, t)
        i += 1
        j -= 1
    return 0

def extend(xs, ys):
    for y in ys:
        append(xs, y)
    return 0

def range(n: int):
    return range__3(0, n, 1)

def range__2(a: int, b: int):
    return range__3(a, b, 1)

def range__3(a: int, b: int, s: int):
    if s == 0:
        __err(0, "range() step must not be zero")
    r = []
    i: int = a
    if s > 0:
        while i < b:
            append(r, i)
            i += s
    else:
        while i > b:
            append(r, i)
            i += s
    return r

# ---- helpers the code generator calls ----
def __truth(x) -> int:
    t: int = __tag(x)
    if t < 0:
        v: int = x
        return v != 0
    if t == 6:
        w: int = x
        return w & 1
    if t == 5:
        return (__fbits(x) << 1) != 0
    if t == 1:
        return __aux(x) != 0
    if t == 0 or t == 3:
        return __ld(x, 0) != 0
    return 1

def __cmp(a, b) -> int:
    if __lt(a, b):
        return -1
    if __lt(b, a):
        return 1
    return 0

def __strmul(s, k: int) -> str:
    if k <= 0:
        return ""
    parts = list(k)
    d = __ld(parts, 2)
    i: int = 0
    while i < k:
        __st(d, i, s)
        i += 1
    return join(parts, k)

def __listof(x):
    if __tag(x) < 0:
        n: int = x
        return list(n)
    it = __iter(x, 0)
    return __slice(it, 0, __ld(it, 0), 0)

def get__2(d, k):
    return get(d, k, 0)

def count(xs, x) -> int:
    c: int = 0
    for y in xs:
        if __eq(y, x):
            c += 1
    return c

def index(xs, x) -> int:
    i: int = 0
    for y in xs:
        if __eq(y, x):
            return i
        i += 1
    __err(0, "value not in list")
