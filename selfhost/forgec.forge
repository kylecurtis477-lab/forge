sion by zero\"):\n        return ZeroDivisionError(msg)\n    if __has(msg, \"could not convert\") or __has(msg, \"invalid literal\") or __has(msg, \"not in list\") or __has(msg, \"math domain\") or __has(msg, \"empty separator\") or __has(msg, \"must not be zero\"):\n        return ValueError(msg)\n    if __has(msg, \"no such method\"):\n        return AttributeError(msg)\n    if __has(msg, \"unsupported operand\") or __has(msg, \"not supported\") or __has(msg, \"not indexable\") or __has(msg, \"not iterable\") or __has(msg, \"does not support\") or __has(msg, \"cannot be sliced\") or __has(msg, \"cannot be raised\") or __has(msg, \"not callable\") or __has(msg, \"positional arguments\"):\n        return TypeError(msg)\n    return RuntimeError(msg)\n\ndef __raise_rt(e, line, msg):\n    e.__rt = msg\n    __raise(e, line)\n\ndef __err(line, msg0):\n    msg: str = concat(msg0, \"\")\n    __raise_rt(__rtexc(msg), line, msg)\n\ndef __aerr(line, msg):\n    __raise_rt(AssertionError(msg), line, __str(msg))\n\ndef __uncaught(e, line):\n    msg = \"\"\n    if isinstance(e, BaseException) and e.__rt != 0:\n        msg = e.__rt\n    else:\n        s: str = __str(e)\n        msg = __clsname(e)\n        if __aux(s) > 0:\n            msg = concat(concat(msg, \": \"), s)\n    eputs(concat(concat(concat(\"error: line \", __itos(line)), \": \"), msg))\n    exit(1)\n\ndef __lst(xs: list, i: int):\n    return __ld(__ld(xs, 2), i)\n\ndef __grow(xs, need: int):\n    cap: int = __ld(xs, 1)\n    if need <= cap:\n        return 0\n    nc: int = cap * 2\n    if nc < need:\n        nc = need\n    d = __new(nc * 8, 4, nc * 8)\n    __copy(d, __ld(xs, 2), __ld(xs, 0) * 8)\n    __st(xs, 2, d)\n    __st(xs, 1, nc)\n    return 0\n\ndef append(xs, v):\n    n: int = __ld(xs, 0)\n    if n >= __ld(xs, 1):\n        __grow(xs, n + 1)\n    __st(__ld(xs, 2), n, v)\n    __st(xs, 0, n + 1)\n    return 0\n\ndef pop(xs):\n    n: int = __ld(xs, 0) - 1\n    if n < 0:\n        __err(0, \"pop from empty list\")\n    __st(xs, 0, n)\n    return __ld(__ld(xs, 2), n)\n\ndef insert(xs, i: int, v):\n    n: int = __ld(xs, 0)\n    if i < 0:\n        i = i + n\n    if i < 0:\n        i = 0\n    if i > n:\n        i = n\n    append(xs, 0)\n    d = __ld(xs, 2)\n    j: int = n\n    while j > i:\n        __st(d, j, __ld(d, j - 1))\n        j -= 1\n    __st(d, i, v)\n    return 0\n\ndef __list_add(a, b):\n    na: int = __ld(a, 0)\n    nb: int = __ld(b, 0)\n    r = list(na + nb)\n    __copy(__ld(r, 2), __ld(a, 2), na * 8)\n    __copy(__ld(r, 2) + na * 8, __ld(b, 2), nb * 8)\n    return r\n\ndef __list_mul(a, k: int):\n    n: int = __ld(a, 0)\n    if k < 0:\n        k = 0\n    r = list(n * k)\n    d = __ld(r, 2)\n    s = __ld(a, 2)\n    i: int = 0\n    while i < k:\n        __copy(d + i * n * 8, s, n * 8)\n        i += 1\n    return r\n\ndef __itos(x) -> str:\n    return __itos_raw(x)\n\ndef __str(x) -> str:\n    t: int = __tag(x)\n    if t == 1:\n        return x\n    if t < 0:\n        return __itos_raw(x)\n    if t == 2:\n        return x.__str__()\n    return __repr(x)\n\ndef __brepr(x) -> str:\n    v: int = x\n    if v & 1:\n        return \"True\"\n    return \"False\"\n\ndef __repr(x) -> str:\n    t: int = __tag(x)\n    if t == 1:\n        return concat(concat(\"'\", x), \"'\")\n    if t < 0:\n        return __itos_raw(x)\n    if t == 6:\n        return __brepr(x)\n    if t == 7:\n        return \"None\"\n    if t == 8:\n        return \"<function>\"\n    if t == 5:\n        return __frepr(x)\n    parts = []\n    if t == 9:\n        n: int = __ld(x, 0)\n        append(parts, \"(\")\n        i: int = 0\n        while i < n:\n            if i > 0:\n                append(parts, \", \")\n            append(parts, __repr(__lst(x, i)))\n            i += 1\n        if n == 1:\n            append(parts, \",\")\n        append(parts, \")\")\n    elif t == 0:\n        n: int = __ld(x, 0)\n        append(parts, \"[\")\n        i: int = 0\n        while i < n:\n            if i > 0:\n                append(parts, \", \")\n            append(parts, __repr(__lst(x, i)))\n            i += 1\n        append(parts, \"]\")\n    elif t == 3:\n        ks = __ld(x, 5)\n        n: int = __ld(ks, 0)\n        append(parts, \"{\")\n        i: int = 0\n        while i < n:\n            if i > 0:\n                append(parts, \", \")\n            k = __lst(ks, i)\n            append(parts, __repr(k))\n            append(parts, \": \")\n            append(parts, __repr(__dget(x, k, 0)))\n            i += 1\n        append(parts, \"}\")\n    else:\n        return x.__repr__()\n    return join(parts, __ld(parts, 0))\n\ndef __typeid(x) -> int:\n    # class index + 1 for objects; -1 int, -2 str, -3 list, -4 dict, -5 float, -6 bool\n    t: int = __tag(x)\n    if t < 0:\n        return -1\n    if t == 2:\n        return __aux(x)\n    if t == 1:\n        return -2\n    if t == 0:\n        return -3\n    if t == 3:\n        return -4\n    if t == 5:\n        return -5\n    if t == 6:\n        return -6\n    return -7\n\ndef __m___str__(o) -> str:\n    return o.__repr__()\n\ndef __m___repr__(o) -> str:\n    return \"<object>\"\n\ndef repr(x) -> str:\n    return __repr(x)\n\ndef __pr(x):\n    t: int = __tag(x)\n    if t == 1:\n        __writes(x)\n    elif t < 0:\n        __wint(x)\n    else:\n        __writes(__str(x))\n    return 0\n\ndef __isnum(x) -> int:\n    t: int = __tag(x)\n    return t < 0 or t == 5 or t == 6\n\ndef __binop(a, b, op: int, line):\n    if op == 2:\n        ta: int = __tag(a)\n        tb: int = __tag(b)\n        if ta == 1 and __isnum(b):\n            return __strmul(a, int(b))\n        if tb == 1 and __isnum(a):\n            return __strmul(b, int(a))\n        if ta == 0 and __isnum(b):\n            return __list_mul(a, int(b))\n        if tb == 0 and __isnum(a):\n            return __list_mul(b, int(a))\n        if ta == 9 and __isnum(b):\n            return __tup(__list_mul(a, int(b)))\n        if tb == 9 and __isnum(a):\n            return __tup(__list_mul(b, int(a)))\n    if op == 5 and __tag(a) == 1:\n        return __pctfmt(a, b, line)\n    names = [\"+\", \"-\", \"*\", \"/\", \"//\", \"%\"]\n    __err(line, concat(concat(\"unsupported operand type(s) for \", __lst(names, op)), \"\"))\n\ndef __cmpop(a, b, op: int) -> int:\n    if op == 10:\n        return __eq(a, b)\n    if op == 11:\n        return __eq(a, b) == 0\n    if op == 12:\n        return __lt(a, b)\n    if op == 13:\n        return __lt(b, a)\n    if op == 14:\n        return __lt(b, a) == 0\n    return __lt(a, b) == 0\n\ndef __neg(x):\n    if __tag(x) == 5:\n        return __ffrombits(__fbits(x) ^ (1 << 63))\n    return 0 - x\n\ndef __ffloordiv(a, b):\n    return __math(a / b, 1)\n\n# ---- arbitrary-precision naturals (little-endian base 2^32 limbs) for exact float<->decimal ----\ndef __bn_norm(a):\n    while len(a) > 0 and a[len(a) - 1] == 0:\n        pop(a)\n    return a\n\ndef __bn(v: int):\n    a = []\n    while v > 0:\n        append(a, v & 4294967295)\n        v = v >> 32\n    return a\n\ndef __bn_muls(a, m: int):\n    r = []\n    c: int = 0\n    n: int = len(a)\n    i: int = 0\n    while i < n:\n        x: int = a[i]\n        t: int = x * m + c\n        append(r, t & 4294967295)\n        c = t >> 32\n        i += 1\n    while c > 0:\n        append(r, c & 4294967295)\n        c = c >> 32\n    return r\n\ndef __bn_add(a, b):\n    na: int = len(a)\n    nb: int = len(b)\n    r = []\n    c: int = 0\n    i: int = 0\n    while i < na or i < nb:\n        t: int = c\n        if i < na:\n            x: int = a[i]\n            t = t + x\n        if i < nb:\n            y: int = b[i]\n            t = t + y\n        append(r, t & 4294967295)\n        c = t >> 32\n        i += 1\n    if c > 0:\n        append(r, c)\n    return r\n\ndef __bn_sub(a, b):\n    # a - b, a >= b\n    na: int = len(a)\n    nb: int = len(b)\n    r = []\n    c: int = 0\n    i: int = 0\n    while i < na:\n        x: int = a[i]\n        t: int = x - c\n        if i < nb:\n            y: int = b[i]\n            t = t - y\n        c = 0\n        if t < 0:\n            t = t + 4294967296\n            c = 1\n        append(r, t)\n        i += 1\n    return __bn_norm(r)\n\ndef __bn_cmp(a, b) -> int:\n    na: int = len(a)\n    nb: int = len(b)\n    if na != nb:\n        if na < nb:\n            return -1\n        return 1\n    i: int = na - 1\n    while i >= 0:\n        x: int = a[i]\n        y: int = b[i]\n        if x != y:\n            if x < y:\n                return -1\n            return 1\n        i -= 1\n    return 0\n\ndef __bn_shl(a, k: int):\n    if len(a) == 0:\n        return []\n    r = []\n    w: int = k >> 5\n    b: int = k & 31\n    i: int = 0\n    while i < w:\n        append(r, 0)\n        i += 1\n    c: int = 0\n    n: int = len(a)\n    i = 0\n    while i < n:\n        x: int = a[i]\n        t: int = (x << b) | c\n        append(r, t & 4294967295)\n        c = t >> 32\n        i += 1\n    if c > 0:\n        append(r, c)\n    return r\n\ndef __bn_bitlen(a) -> int:\n    n: int = len(a)\n    if n == 0:\n        return 0\n    x: int = a[n - 1]\n    b: int = 0\n    while x > 0:\n        b += 1\n        x = x >> 1\n    return (n - 1) * 32 + b\n\ndef __bn_pow10(k: int):\n    r = [1]\n    while k >= 9:\n        r = __bn_muls(r, 1000000000)\n        k -= 9\n    while k > 0:\n        r = __bn_muls(r, 10)\n        k -= 1\n    return r\n\ndef __bn_toint(a) -> int:\n    v: int = 0\n    i: int = len(a) - 1\n    while i >= 0:\n        x: int = a[i]\n        v = (v << 32) | x\n        i -= 1\n    return v\n\ndef __frepr(x) -> str:\n    bits: int = __fbits(x)\n    neg: int = (bits >> 63) & 1\n    er: int = (bits >> 52) & 2047\n    f: int = bits & 4503599627370495\n    if er == 2047:\n        if f != 0:\n            return \"nan\"\n        if neg:\n            return \"-inf\"\n        return \"inf\"\n    if er == 0 and f == 0:\n        if neg:\n            return \"-0.0\"\n        return \"0.0\"\n    if er >= 1023 and er < 1023 + 53:\n        iv: int = __ftoi(x, 0)\n        if iv < 10000000000000000 and iv > -10000000000000000 and __itof(iv) == x:\n            return concat(str(iv), \".0\")\n    m: int = f\n    e: int = -1074\n    if er > 0:\n        m = f | 4503599627370496\n        e = er - 1075\n    big: int = 0\n    if m == 4503599627370496 and er > 1:\n        big = 1\n    if e >= 0:\n        r = __bn_shl(__bn(m), e + 1 + big)\n        s = __bn(2 << big)\n        mp = __bn_shl([1], e + big)\n        mm = __bn_shl([1], e)\n    else:\n        r = __bn(m << (1 + big))\n        s = __bn_shl([1], 1 + big - e)\n        mp = __bn(1 << big)\n        mm = [1]\n    even: int = (m & 1) == 0\n    k: int = 0\n    while True:\n        c: int = __bn_cmp(__bn_add(r, mp), s)\n        if c > 0 or (c == 0 and even):\n            s = __bn_muls(s, 10)\n            k += 1\n        else:\n            break\n    while True:\n        c = __bn_cmp(__bn_muls(__bn_add(r, mp), 10), s)\n        if c < 0 or (c == 0 and not even):\n            r = __bn_muls(r, 10)\n            mp = __bn_muls(mp, 10)\n            mm = __bn_muls(mm, 10)\n            k -= 1\n        else:\n            break\n    ds = []\n    while True:\n        r = __bn_muls(r, 10)\n        mp = __bn_muls(mp, 10)\n        mm = __bn_muls(mm, 10)\n        d: int = 0\n        while __bn_cmp(r, s) >= 0:\n            r = __bn_sub(r, s)\n            d += 1\n        c1: int = __bn_cmp(r, mm)\n        lo: int = c1 < 0 or (c1 == 0 and even)\n        c2: int = __bn_cmp(__bn_add(r, mp), s)\n        hi: int = c2 > 0 or (c2 == 0 and even)\n        if not lo and not hi:\n            append(ds, d)\n        else:\n            if hi and not lo:\n                d += 1\n            elif hi and lo:\n                c3: int = __bn_cmp(__bn_shl(r, 1), s)\n                if c3 > 0 or (c3 == 0 and (d & 1) == 1):\n                    d += 1\n            append(ds, d)\n            break\n    n: int = len(ds)\n    parts = []\n    if neg:\n        append(parts, \"-\")\n    x10: int = k - 1\n    i: int = 0\n    if x10 >= -5 + 1 and x10 < 16:\n        if k <= 0:\n            append(parts, \"0.\")\n            i = 0\n            while i < 0 - k:\n                append(parts, \"0\")\n                i += 1\n            i = 0\n            while i < n:\n                append(parts, chr(48 + ds[i]))\n                i += 1\n        else:\n            while i < n or i < k:\n                if i == k:\n                    append(parts, \".\")\n                if i < n:\n                    append(parts, chr(48 + ds[i]))\n                else:\n                    append(parts, \"0\")\n                i += 1\n            if n <= k:\n                append(parts, \".0\")\n    else:\n        append(parts, chr(48 + ds[0]))\n        if n > 1:\n            append(parts, \".\")\n            i = 1\n            while i < n:\n                append(parts, chr(48 + ds[i]))\n                i += 1\n        append(parts, \"e\")\n        if x10 < 0:\n            append(parts, \"-\")\n            x10 = 0 - x10\n        else:\n            append(parts, \"+\")\n        if x10 < 10:\n            append(parts, \"0\")\n        append(parts, str(x10))\n    return join(parts, len(parts))\n\ndef __bn_ratio_bits(num, den) -> int:\n    # correctly rounded double nearest num/den (both > 0)\n    e: int = __bn_bitlen(num) - __bn_bitlen(den) - 53\n    q: int = 0\n    rem = []\n    d2 = []\n    while True:\n        if e < -1074:\n            e = -1074\n        if e >= 0:\n            n2 = num\n            d2 = __bn_shl(den, e)\n        else:\n            n2 = __bn_shl(num, 0 - e)\n            d2 = den\n        q = 0\n        b: int = 56\n        while b >= 0:\n            t = __bn_shl(d2, b)\n            if __bn_cmp(n2, t) >= 0:\n                n2 = __bn_sub(n2, t)\n                q = q | (1 << b)\n            b -= 1\n        rem = n2\n        if q >= 9007199254740992:\n            e += 1\n        elif q < 4503599627370496 and e > -1074:\n            e -= 1\n        else:\n            break\n    c: int = __bn_cmp(__bn_shl(rem, 1), d2)\n    if c > 0 or (c == 0 and (q & 1) == 1):\n        q += 1\n        if q == 9007199254740992:\n            q = q >> 1\n            e += 1\n    if e + 1075 >= 2047:\n        return 9218868437227405312\n    return ((e + 1074) << 52) + q\n\ndef __fparse(s0, line):\n    s = lower(strip(s0))\n    n: int = len(s)\n    i: int = 0\n    neg: int = 0\n    if n > 0 and (char_at(s, 0) == 45 or char_at(s, 0) == 43):\n        neg = char_at(s, 0) == 45\n        i = 1\n    rest = substr(s, i, n)\n    bits: int = 0\n    if str_eq(rest, \"inf\") or str_eq(rest, \"infinity\"):\n        bits = 9218868437227405312\n    elif str_eq(rest, \"nan\"):\n        bits = 9221120237041090560\n    else:\n        mant = []\n        mi: int = 0\n        nd: int = 0\n        e10: int = 0\n        seen: int = 0\n        dot: int = 0\n        while i < n:\n            c: int = char_at(s, i)\n            if c >= 48 and c <= 57:\n                mant = __bn_add(__bn_muls(mant, 10), __bn(c - 48))\n                if len(mant) > 0:\n                    nd += 1\n                    if nd <= 18:\n                        mi = mi * 10 + c - 48\n                if dot:\n                    e10 -= 1\n                seen = 1\n            elif c == 46 and not dot:\n                dot = 1\n            elif c == 95 and seen:\n                pass\n            else:\n                break\n            i += 1\n        if i < n and char_at(s, i) == 101 and seen:\n            i += 1\n            en: int = 0\n            if i < n and (char_at(s, i) == 45 or char_at(s, i) == 43):\n                en = char_at(s, i) == 45\n                i += 1\n            ev: int = 0\n            sd: int = 0\n            while i < n and char_at(s, i) >= 48 and char_at(s, i) <= 57:\n                if ev < 100000:\n                    ev = ev * 10 + char_at(s, i) - 48\n                sd = 1\n                i += 1\n            if not sd:\n                seen = 0\n            if en:\n                ev = 0 - ev\n            e10 += ev\n        if not seen or i != n:\n            __err(line, concat(concat(\"could not convert string to float: \", __repr(s0)), \"\"))\n        if len(mant) == 0:\n            bits = 0\n        elif nd <= 15 and e10 >= -22 and e10 <= 22:\n            # Clinger's fast path: both operands exact, one correctly rounded op\n            fm = __itof(mi)\n            if e10 >= 0:\n                fm = fm * __fpow10(e10)\n            else:\n                fm = fm / __fpow10(0 - e10)\n            bits = __fbits(fm)\n        elif nd + e10 > 310:\n            bits = 9218868437227405312\n        elif nd + e10 < -330:\n            bits = 0\n        elif e10 >= 0:\n            bits = __bn_ratio_bits(__bn_mulpow(mant, e10), [1])\n        else:\n            bits = __bn_ratio_bits(mant, __bn_pow10(0 - e10))\n    if neg:\n        bits = bits | (1 << 63)\n    return __ffrombits(bits)\n\ndef __fpow10(k: int):\n    if k <= 18:\n        return __itof(__ipow(10, k))\n    return __itof(__ipow(10, 18)) * __itof(__ipow(10, k - 18))\n\ndef __bn_mulpow(a, k: int):\n    while k >= 9:\n        a = __bn_muls(a, 1000000000)\n        k -= 9\n    while k > 0:\n        a = __bn_muls(a, 10)\n        k -= 1\n    return a\n\ndef float(x):\n    t: int = __tag(x)\n    if t == 5:\n        return x\n    if t == 1:\n        return __fparse(x, 0)\n    if t == 6:\n        v: int = x\n        return __itof(v & 1)\n    return __itof(x)\n\ndef __add(a, b, line):\n    ta: int = __tag(a)\n    tb: int = __tag(b)\n    if ta < 0 and tb < 0:\n        return a - (0 - b)\n    if ta == 1 and tb == 1:\n        return concat(a, b)\n    if ta == 0 and tb == 0:\n        return __list_add(a, b)\n    if ta == 9 and tb == 9:\n        return __tup(__list_add(a, b))\n    __err(line, \"unsupported operand types for +\")\n\ndef __eq(a, b) -> int:\n    x: int = a\n    y: int = b\n    if x == y:\n        return 1\n    ta: int = __tag(a)\n    tb: int = __tag(b)\n    if ta == 1 and tb == 1:\n        return str_eq(a, b)\n    if __isnum(a) and __isnum(b):\n        return a == b\n    if (ta == 0 and tb == 0) or (ta == 9 and tb == 9):\n        n: int = __ld(a, 0)\n        if n != __ld(b, 0):\n            return 0\n        i: int = 0\n        while i < n:\n            if not __eq(__lst(a, i), __lst(b, i)):\n                return 0\n            i += 1\n        return 1\n    return 0\n\ndef __lt(a, b) -> int:\n    ta: int = __tag(a)\n    tb: int = __tag(b)\n    if ta == 1 and tb == 1:\n        return __strcmp(a, b) < 0\n    if __isnum(a) and __isnum(b):\n        return a < b\n    if (ta == 0 and tb == 0) or (ta == 9 and tb == 9):\n        na: int = __ld(a, 0)\n        nb: int = __ld(b, 0)\n        i: int = 0\n        while i < na and i < nb:\n            x = __lst(a, i)\n            y = __lst(b, i)\n            if not __eq(x, y):\n                return __lt(x, y)\n            i += 1\n        return na < nb\n    __err(0, \"'<' not supported between these types\")\n    return 0\n\ndef __strcmp(a, b):\n    na: int = __aux(a)\n    nb: int = __aux(b)\n    i: int = 0\n    while i < na and i < nb:\n        d: int = char_at(a, i) - char_at(b, i)\n        if d != 0:\n            return d\n        i += 1\n    return na - nb\n\ndef __getidx(o, i: int, line):\n    t: int = __tag(o)\n    if t == 0 or t == 9:\n        n: int = __ld(o, 0)\n        j: int = i\n        if j < 0:\n            j = j + n\n        if j < 0 or j >= n:\n            __err(line, concat(concat(concat(\"list index \", __itos_raw(i)), \" out of range for length \"), __itos_raw(n)))\n        return __lst(o, j)\n    if t == 1:\n        n: int = __aux(o)\n        j: int = i\n        if j < 0:\n            j = j + n\n        if j < 0 or j >= n:\n            __err(line, \"string index out of range\")\n        return chr(char_at(o, j))\n    if t == 3:\n        return __dget(o, i, line)\n    __err(line, \"value is not indexable\")\n\ndef __setidx(o, i: int, v, line):\n    t: int = __tag(o)\n    if t == 0:\n        n: int = __ld(o, 0)\n        j: int = i\n        if j < 0:\n            j = j + n\n        if j < 0 or j >= n:\n            __err(line, concat(concat(concat(\"list assignment index \", __itos_raw(i)), \" out of range for length \"), __itos_raw(n)))\n        __st(__ld(o, 2), j, v)\n        return 0\n    if t == 3:\n        __dset(o, i, v)\n        return 0\n    __err(line, \"value does not support item assignment\")\n\ndef __slice(o, a: int, b: int, line):\n    t: int = __tag(o)\n    n: int = 0\n    if t == 0 or t == 9:\n        n = __ld(o, 0)\n    elif t == 1:\n        n = __aux(o)\n    else:\n        __err(line, \"value cannot be sliced\")\n    if a < 0:\n        a = a + n\n    if b < 0:\n        b = b + n\n    if a < 0:\n        a = 0\n    if b > n:\n        b = n\n    if b < a:\n        b = a\n    if t == 1:\n        return substr(o, a, b)\n    r = list(b - a)\n    __copy(__ld(r, 2), __ld(o, 2) + a * 8, (b - a) * 8)\n    if t == 9:\n        set_byte(r, -1, 9)\n    return r\n\ndef __tup(r):\n    set_byte(r, -1, 9)\n    return r\n\ndef tuple(x=None):\n    if x is None:\n        return __tup([])\n    if __tag(x) == 9:\n        return x\n    return __tup(__listof(x))\n\ndef __iter(x, line):\n    t: int = __tag(x)\n    if t == 0 or t == 9:\n        return x\n    if t == 3:\n        return __ld(x, 5)\n    if t == 1:\n        n: int = __aux(x)\n        r = list(n)\n        i: int = 0\n        while i < n:\n            __st(__ld(r, 2), i, chr(char_at(x, i)))\n            i += 1\n        return r\n    __err(line, \"value is not iterable\")\n\ndef __contains(c, x):\n    t: int = __tag(c)\n    if t == 3:\n        i: int = __dfind(c, x, __hash(x))\n        return __ld(__ld(c, 2), i) != 0\n    if t == 0 or t == 9:\n        n: int = __ld(c, 0)\n        i: int = 0\n        while i < n:\n            if __eq(__lst(c, i), x):\n                return 1\n            i += 1\n        return 0\n    if t == 1:\n        return __find(c, x, 0) >= 0\n    return 0\n\n# ---- dict: open addressing, insertion-ordered keys ----\n# layout: [count, cap, hashes, keys, values, order(list of keys)]\ndef __zeros(n: int):\n    p = __new(n * 8, 4, n * 8)\n    i: int = 0\n    while i < n:\n        __st(p, i, 0)\n        i += 1\n    return p\n\ndef __dict():\n    d = __new(48, 3, 0)\n    __st(d, 0, 0)\n    __st(d, 1, 8)\n    __st(d, 2, __zeros(8))\n    __st(d, 3, __zeros(8))\n    __st(d, 4, __zeros(8))\n    __st(d, 5, list(0))\n    return d\n\ndef __hash(k) -> int:\n    h: int = 0\n    t: int = __tag(k)\n    if t == 6:\n        k = int(k)\n    elif t == 5:\n        if __math(k, 1) == k and __math(k, 10) < __itof(1000000000000000000):\n            k = int(k)\n        else:\n            k = __fbits(k)\n    if t == 1:\n        h = 5381\n        n: int = __aux(k)\n        i: int = 0\n        while i < n:\n            h = h * 33 + char_at(k, i)\n            i += 1\n    elif t == 9:\n        h = 3430008\n        n: int = __ld(k, 0)\n        i: int = 0\n        while i < n:\n            h = (h ^ __hash(__lst(k, i))) * 1000003\n            i += 1\n    elif t == 0 or t == 3:\n        __err(0, \"unhashable type\")\n    else:\n        h = k * -7046029254386353131\n        h = h ^ (h >> 29)\n    return h | 1\n\ndef __dfind(d, k, h: int) -> int:\n    m: int = __ld(d, 1) - 1\n    hs = __ld(d, 2)\n    ks = __ld(d, 3)\n    i: int = h & m\n    while 1:\n        x: int = __ld(hs, i)\n        if x == 0:\n            return i\n        if x == h and __eq(__ld(ks, i), k):\n            return i\n        i = (i + 1) & m\n\ndef __dget(d, k, line):\n    i: int = __dfind(d, k, __hash(k))\n    if __ld(__ld(d, 2), i) == 0:\n        __raise_rt(KeyError(k), line, concat(\"key not found: \", __repr(k)))\n    return __ld(__ld(d, 4), i)\n\ndef get(d, k, dflt):\n    i: int = __dfind(d, k, __hash(k))\n    if __ld(__ld(d, 2), i) == 0:\n        return dflt\n    return __ld(__ld(d, 4), i)\n\ndef __dset(d, k, v):\n    if (__ld(d, 0) + 1) * 4 > __ld(d, 1) * 3:\n        __dresize(d)\n    h: int = __hash(k)\n    i: int = __dfind(d, k, h)\n    hs = __ld(d, 2)\n    if __ld(hs, i) == 0:\n        __st(hs, i, h)\n        __st(__ld(d, 3), i, k)\n        __st(d, 0, __ld(d, 0) + 1)\n        append(__ld(d, 5), k)\n    __st(__ld(d, 4), i, v)\n    return 0\n\ndef __dresize(d):\n    oc: int = __ld(d, 1)\n    ohs = __ld(d, 2)\n    oks = __ld(d, 3)\n    ovs = __ld(d, 4)\n    nc: int = oc * 2\n    __st(d, 1, nc)\n    __st(d, 2, __zeros(nc))\n    __st(d, 3, __zeros(nc))\n    __st(d, 4, __zeros(nc))\n    j: int = 0\n    while j < oc:\n        h: int = __ld(ohs, j)\n        if h != 0:\n            k = __ld(oks, j)\n            i: int = __dfind(d, k, h)\n            __st(__ld(d, 2), i, h)\n            __st(__ld(d, 3), i, k)\n            __st(__ld(d, 4), i, __ld(ovs, j))\n        j += 1\n    return 0\n\ndef keys(d):\n    return __slice(__ld(d, 5), 0, __ld(__ld(d, 5), 0), 0)\n\ndef values(d):\n    ks = __ld(d, 5)\n    n: int = __ld(ks, 0)\n    r = list(n)\n    i: int = 0\n    while i < n:\n        __st(__ld(r, 2), i, __dget(d, __lst(ks, i), 0))\n        i += 1\n    return r\n\ndef items(d):\n    ks = __ld(d, 5)\n    n: int = __ld(ks, 0)\n    r = list(n)\n    i: int = 0\n    while i < n:\n        k = __lst(ks, i)\n        __st(__ld(r, 2), i, __tup([k, __dget(d, k, 0)]))\n        i += 1\n    return r\n\n# ---- strings ----\ndef __find(s, sub, start: int) -> int:\n    n: int = __aux(s)\n    m: int = __aux(sub)\n    i: int = start\n    while i + m <= n:\n        j: int = 0\n        while j < m and char_at(s, i + j) == char_at(sub, j):\n            j += 1\n        if j == m:\n            return i\n        i += 1\n    return -1\n\ndef find(s, sub, start=0) -> int:\n    if start < 0:\n        start = start + __aux(s)\n        if start < 0:\n            start = 0\n    return __find(s, sub, start)\n\ndef rfind(s, sub) -> int:\n    n: int = __aux(s)\n    m: int = __aux(sub)\n    i: int = n - m\n    while i >= 0:\n        j: int = 0\n        while j < m and char_at(s, i + j) == char_at(sub, j):\n            j += 1\n        if j == m:\n            return i\n        i -= 1\n    return -1\n\ndef rindex(s, sub) -> int:\n    i: int = rfind(s, sub)\n    if i < 0:\n        raise ValueError(\"substring not found\")\n    return i\n\ndef partition(s, sep):\n    i: int = __find(s, sep, 0)\n    if i < 0:\n        return __tup([s, \"\", \"\"])\n    return __tup([substr(s, 0, i), sep, substr(s, i + __aux(sep), __aux(s))])\n\ndef rpartition(s, sep):\n    i: int = rfind(s, sep)\n    if i < 0:\n        return __tup([\"\", \"\", s])\n    return __tup([substr(s, 0, i), sep, substr(s, i + __aux(sep), __aux(s))])\n\ndef __pad(s, w: int, fill, mode: int) -> str:\n    n: int = __aux(s)\n    if w <= n:\n        return s\n    k: int = w - n\n    if mode == 0:\n        return concat(s, __strmul(fill, k))\n    if mode == 1:\n        return concat(__strmul(fill, k), s)\n    left: int = k // 2\n    if k % 2 == 1 and w % 2 == 1:\n        left += 1\n    return concat(concat(__strmul(fill, left), s), __strmul(fill, k - left))\n\ndef ljust(s, w, fill=\" \") -> str:\n    return __pad(s, w, fill, 0)\n\ndef rjust(s, w, fill=\" \") -> str:\n    return __pad(s, w, fill, 1)\n\ndef center(s, w, fill=\" \") -> str:\n    return __pad(s, w, fill, 2)\n\ndef zfill(s, w) -> str:\n    n: int = __aux(s)\n    if w <= n:\n        return s\n    if n > 0 and (char_at(s, 0) == 45 or char_at(s, 0) == 43):\n        return concat(concat(substr(s, 0, 1), __strmul(\"0\", w - n)), substr(s, 1, n))\n    return concat(__strmul(\"0\", w - n), s)\n\ndef __isup(c: int) -> int:\n    return c >= 65 and c <= 90\n\ndef __islo(c: int) -> int:\n    return c >= 97 and c <= 122\n\ndef __chcase(s, mode: int) -> str:\n    # 0 title, 1 capitalize, 2 swapcase\n    n: int = __aux(s)\n    r = substr(s, 0, n)\n    prev: int = 0\n    i: int = 0\n    while i < n:\n        c: int = char_at(r, i)\n        up: int = 0\n        lo: int = 0\n        if mode == 0:\n            up = not prev\n            lo = prev\n        elif mode == 1:\n            up = i == 0\n            lo = i > 0\n        else:\n            up = __islo(c)\n            lo = __isup(c)\n        if up and __islo(c):\n            set_byte(r, i, c - 32)\n        elif lo and __isup(c):\n            set_byte(r, i, c + 32)\n        prev = __isup(c) or __islo(c)\n        i += 1\n    return r\n\ndef title(s) -> str:\n    return __chcase(s, 0)\n\ndef capitalize(s) -> str:\n    return __chcase(s, 1)\n\ndef swapcase(s) -> str:\n    return __chcase(s, 2)\n\ndef __allc(s, k: int) -> int:\n    n: int = __aux(s)\n    if n == 0:\n        return 0\n    cased: int = 0\n    i: int = 0\n    while i < n:\n        c: int = char_at(s, i)\n        if k == 0:\n            if not (__isup(c) or __islo(c) or (c >= 48 and c <= 57)):\n                return 0\n        elif k == 1:\n            if not (__isspace(c) or c == 11 or c == 12):\n                return 0\n        elif k == 2:\n            if __islo(c):\n                return 0\n            if __isup(c):\n                cased = 1\n        else:\n            if __isup(c):\n                return 0\n            if __islo(c):\n                cased = 1\n        i += 1\n    if k >= 2:\n        return cased\n    return 1\n\ndef isalnum(s) -> bool:\n    return __allc(s, 0) == 1\n\ndef isspace(s) -> bool:\n    return __allc(s, 1) == 1\n\ndef isupper(s) -> bool:\n    return __allc(s, 2) == 1\n\ndef islower(s) -> bool:\n    return __allc(s, 3) == 1\n\ndef removeprefix(s, p) -> str:\n    if startswith(s, p):\n        return substr(s, __aux(p), __aux(s))\n    return s\n\ndef removesuffix(s, p) -> str:\n    if __aux(p) > 0 and endswith(s, p):\n        return substr(s, 0, __aux(s) - __aux(p))\n    return s\n\ndef splitlines(s):\n    r = []\n    n: int = __aux(s)\n    a: int = 0\n    i: int = 0\n    while i < n:\n        c: int = char_at(s, i)\n        if c == 10 or c == 13:\n            append(r, substr(s, a, i))\n            if c == 13 and i + 1 < n and char_at(s, i + 1) == 10:\n                i += 1\n            a = i + 1\n        i += 1\n    if a < n:\n        append(r, substr(s, a, n))\n    return r\n\ndef rsplit(s, sep=None, maxsplit=-1):\n    if sep is None:\n        return split__1(s)\n    parts = split(s, sep)\n    k: int = len(parts) - 1 - maxsplit\n    if maxsplit < 0 or k <= 0:\n        return parts\n    head = __m_join(sep, __slice(parts, 0, k + 1, 0))\n    r = [head]\n    extend(r, __slice(parts, k + 1, len(parts), 0))\n    return r\n\ndef __sfmt(s, args) -> str:\n    # str.format: args = [key-or-0, value, ...]\n    pos = []\n    kw = {}\n    i: int = 0\n    while i < len(args):\n        k = args[i]\n        if __tag(k) == 1:\n            kw[k] = args[i + 1]\n        else:\n            append(pos, args[i + 1])\n        i += 2\n    out = []\n    n: int = __aux(s)\n    auto: int = 0\n    i = 0\n    a: int = 0\n    while i < n:\n        c: int = char_at(s, i)\n        if c == 123 or c == 125:\n            if i + 1 < n and char_at(s, i + 1) == c:\n                append(out, substr(s, a, i + 1))\n                i += 2\n                a = i\n                continue\n            if c == 125:\n                raise ValueError(\"Single '}' encountered in format string\")\n            append(out, substr(s, a, i))\n            j: int = __find(s, \"}\", i)\n            if j < 0:\n                raise ValueError(\"Single '{' encountered in format string\")\n            field = substr(s, i + 1, j)\n            spec = \"\"\n            conv: int = 0\n            ci: int = __find(field, \":\", 0)\n            if ci >= 0:\n                spec = substr(field, ci + 1, __aux(field))\n                field = substr(field, 0, ci)\n            bi: int = __find(field, \"!\", 0)\n            if bi >= 0:\n                conv = char_at(field, bi + 1)\n                field = substr(field, 0, bi)\n            v = None\n            if __aux(field) == 0:\n                v = pos[auto]\n                auto += 1\n            elif isdigit(field):\n                v = pos[int(field)]\n            else:\n                v = kw[field]\n            if conv == 114:\n                v = repr(v)\n            elif conv == 115:\n                v = __str(v)\n            append(out, __format(v, spec))\n            i = j + 1\n            a = i\n        else:\n            i += 1\n    append(out, substr(s, a, n))\n    return __m_join(\"\", out)\n\ndef startswith(s, p) -> bool:\n    m: int = __aux(p)\n    if m > __aux(s):\n        return False\n    i: int = 0\n    while i < m:\n        if char_at(s, i) != char_at(p, i):\n            return False\n        i += 1\n    return True\n\ndef endswith(s, p) -> bool:\n    m: int = __aux(p)\n    o: int = __aux(s) - m\n    if o < 0:\n        return False\n    i: int = 0\n    while i < m:\n        if char_at(s, o + i) != char_at(p, i):\n            return False\n        i += 1\n    return True\n\ndef __isspace(c: int) -> int:\n    return c == 32 or c == 10 or c == 9 or c == 13\n\ndef __instr(c: int, chars) -> int:\n    if chars is None:\n        return __isspace(c) or c == 11 or c == 12\n    n: int = __aux(chars)\n    i: int = 0\n    while i < n:\n        if char_at(chars, i) == c:\n            return 1\n        i += 1\n    return 0\n\ndef __strip(s, chars, mode: int) -> str:\n    a: int = 0\n    b: int = __aux(s)\n    if mode & 1:\n        while a < b and __instr(char_at(s, a), chars):\n            a += 1\n    if mode & 2:\n        while b > a and __instr(char_at(s, b - 1), chars):\n            b -= 1\n    return substr(s, a, b)\n\ndef strip(s, chars=None) -> str:\n    return __strip(s, chars, 3)\n\ndef lstrip(s, chars=None) -> str:\n    return __strip(s, chars, 1)\n\ndef rstrip(s, chars=None) -> str:\n    return __strip(s, chars, 2)\n\ndef split(s, sep):\n    r = []\n    n: int = __aux(s)\n    m: int = __aux(sep)\n    if m == 0:\n        __err(0, \"empty separator\")\n    a: int = 0\n    i: int = __find(s, sep, 0)\n    while i >= 0:\n        append(r, substr(s, a, i))\n        a = i + m\n        i = __find(s, sep, a)\n    append(r, substr(s, a, n))\n    return r\n\ndef split__1(s):\n    r = []\n    n: int = __aux(s)\n    i: int = 0\n    while i < n:\n        while i < n and __isspace(char_at(s, i)):\n            i += 1\n        if i >= n:\n            break\n        a: int = i\n        while i < n and not __isspace(char_at(s, i)):\n            i += 1\n        append(r, substr(s, a, i))\n    return r\n\ndef __m_join(sep, xs) -> str:\n    n: int = __ld(xs, 0)\n    if n == 0:\n        return \"\"\n    parts = list(2 * n - 1)\n    pd = __ld(parts, 2)\n    i: int = 0\n    while i < n:\n        if i > 0:\n            __st(pd, 2 * i - 1, sep)\n        __st(pd, 2 * i, __str(__lst(xs, i)))\n        i += 1\n    return join(parts, 2 * n - 1)\n\ndef replace(s, a, b) -> str:\n    return __m_join(b, split(s, a))\n\ndef __mapcase(s, lo: int, hi: int, d: int) -> str:\n    n: int = __aux(s)\n    r = substr(s, 0, n)\n    i: int = 0\n    while i < n:\n        c: int = char_at(r, i)\n        if c >= lo and c <= hi:\n            set_byte(r, i, c + d)\n        i += 1\n    return r\n\ndef upper(s) -> str:\n    return __mapcase(s, 97, 122, -32)\n\ndef lower(s) -> str:\n    return __mapcase(s, 65, 90, 32)\n\ndef isdigit(s) -> bool:\n    n: int = __aux(s)\n    i: int = 0\n    while i < n:\n        c: int = char_at(s, i)\n        if c < 48 or c > 57:\n            return False\n        i += 1\n    return n > 0\n\ndef isalpha(s) -> bool:\n    n: int = __aux(s)\n    i: int = 0\n    while i < n:\n        c: int = char_at(s, i) | 32\n        if c < 97 or c > 122:\n            return False\n        i += 1\n    return n > 0\n\ndef int(x) -> int:\n    t: int = __tag(x)\n    if t == 6:\n        v: int = x\n        return v & 1\n    if t == 5:\n        return __ftoi(x, 0)\n    if t != 1:\n        return x\n    s = strip(x)\n    n: int = __aux(s)\n    i: int = 0\n    neg: int = 0\n    if n > 0 and char_at(s, 0) == 45:\n        neg = 1\n        i = 1\n    v: int = 0\n    if i >= n:\n        __err(0, concat(\"invalid literal for int(): \", __repr(x)))\n    while i < n:\n        c: int = char_at(s, i) - 48\n        if c < 0 or c > 9:\n            __err(0, concat(\"invalid literal for int(): \", __repr(x)))\n        v = v * 10 + c\n        i += 1\n    if neg:\n        return 0 - v\n    return v\n\n# ---- numbers and lists ----\ndef abs(x):\n    t: int = __tag(x)\n    if t == 5:\n        return __math(x, 10)\n    v: int = int(x)\n    if v < 0:\n        return 0 - v\n    return v\n\ndef min(a, b):\n    if __lt(b, a):\n        return b\n    return a\n\ndef max(a, b):\n    if __lt(a, b):\n        return b\n    return a\n\ndef min__1(xs, key=None):\n    xs = __iter(xs, 0)\n    if __ld(xs, 0) == 0:\n        raise ValueError(\"min() arg is an empty sequence\")\n    m = __lst(xs, 0)\n    if key is not None:\n        km = key(m)\n        for x in xs:\n            kx = key(x)\n            if __lt(kx, km):\n                m = x\n                km = kx\n        return m\n    for x in xs:\n        if __lt(x, m):\n            m = x\n    return m\n\ndef max__1(xs, key=None):\n    xs = __iter(xs, 0)\n    if __ld(xs, 0) == 0:\n        raise ValueError(\"max() arg is an empty sequence\")\n    m = __lst(xs, 0)\n    if key is not None:\n        km = key(m)\n        for x in xs:\n            kx = key(x)\n            if __lt(km, kx):\n                m = x\n                km = kx\n        return m\n    for x in xs:\n        if __lt(m, x):\n            m = x\n    return m\n\ndef sum(xs):\n    s: int = 0\n    n: int = __ld(xs, 0)\n    d = __ld(xs, 2)\n    i: int = 0\n    while i < n:\n        v = __ld(d, i)\n        if __tag(v) >= 0:\n            acc = s\n            while i < n:\n                acc = acc + __ld(d, i)\n                i += 1\n            return acc\n        s += v\n        i += 1\n    return s\n\ndef __pow(a, b):\n    ta: int = __tag(a)\n    tb: int = __tag(b)\n    if ta != 5 and tb != 5:\n        ia: int = int(a)\n        ib: int = int(b)\n        if ib >= 0:\n            return __ipow(ia, ib)\n        return __itof(1) / __ipow(ia, 0 - ib)\n    if a == 0:\n        if b < 0:\n            __err(0, \"0.0 cannot be raised to a negative power\")\n        if b == 0:\n            return __itof(1)\n        return __itof(0)\n    if a > 0:\n        return __math2(b, a, 1)\n    if __math(b, 1) != b:\n        __err(0, \"negative number cannot be raised to a fractional power\")\n    r = __math2(b, 0 - a, 1)\n    if __math(b / 2, 1) != b / 2:\n        return 0 - r\n    return r\n\ndef __ipow(a: int, b: int) -> int:\n    r: int = 1\n    while b > 0:\n        if b & 1:\n            r = r * a\n        a = a * a\n        b = b >> 1\n    return r\n\ndef __msort(d, t, lo: int, hi: int):\n    if hi - lo < 2:\n        return 0\n    mid: int = (lo + hi) // 2\n    __msort(d, t, lo, mid)\n    __msort(d, t, mid, hi)\n    i: int = lo\n    j: int = mid\n    k: int = lo\n    while k < hi:\n        if j >= hi or (i < mid and not __lt(__ld(d, j), __ld(d, i))):\n            __st(t, k, __ld(d, i))\n            i += 1\n        else:\n            __st(t, k, __ld(d, j))\n            j += 1\n        k += 1\n    __copy(d + lo * 8, t + lo * 8, (hi - lo) * 8)\n    return 0\n\ndef sort(xs, key=None, reverse=False):\n    n: int = __ld(xs, 0)\n    if key is None and not reverse:\n        __msort(__ld(xs, 2), __new(n * 8 + 8, 4, n * 8), 0, n)\n        return None\n    ps = []\n    i: int = 0\n    while i < n:\n        x = __ld(__ld(xs, 2), i)\n        k = x\n        if key is not None:\n            k = key(x)\n        if reverse:\n            append(ps, [k, 0 - i, x])\n        else:\n            append(ps, [k, i, x])\n        i += 1\n    __msort(__ld(ps, 2), __new(n * 8 + 8, 4, n * 8), 0, n)\n    i = 0\n    while i < n:\n        j: int = i\n        if reverse:\n            j = n - 1 - i\n        __st(__ld(xs, 2), i, ps[j][2])\n        i += 1\n    return None\n\ndef sorted(xs, key=None, reverse=False):\n    r = __listof(xs)\n    sort(r, key, reverse)\n    return r\n\ndef map(f, xs):\n   