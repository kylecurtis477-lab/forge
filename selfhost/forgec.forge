tl = list(MAXT)
ntok = 0
PRE = 0
PRETOK = 0

out = list(8000000)
nout = 0
dat = list(1000000)
ndat = 0
nlabel = 0
nstr = 0
nflt = 0
flt_f = list(65536)
flt_s = list(65536)
pos = 0
ety = 0
vty = 0
vkind = 0
vidx = 0

