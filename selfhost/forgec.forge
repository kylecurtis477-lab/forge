at rt_dbuf+32 -> rsi=start, rdx=len\n    lea rt_dbuf+32(%rip), %rsi\n    mov %rsi, %r9\n    xor %r10d, %r10d\n    test %rax, %rax\n    jns 1f\n    neg %rax\n    mov $1, %r10d\n1:  mov $10, %ecx\n2:  xor %edx, %edx\n    div %rcx\n    add $48, %dl\n    dec %rsi\n    movb %dl, (%rsi)\n    test %rax, %rax\n    jnz 2b\n    test %r10d, %r10d\n    jz 3f\n    dec %rsi\n    movb $45, (%rsi)\n3:  mov %r9, %rdx\n    sub %rsi, %rdx\n    ret\nrt_wint:\n    mov 8(%rsp), %rax\n    call rt_digits_r\n    call rt_out_r\n    xor %eax, %eax\n    ret\nrt_print_int:\n    mov 8(%rsp), %rax\n    call rt_digits_r\n    call rt_out_r\n    jmp rt_nl\nrt_itos:\n    mov 8(%rsp), %rax\n    call rt_digits_r\n    mov %rsi, %r8\n    mov %rdx, %rdi\n    push %rdx\n    call rt_mkstr_r\n    pop %rcx\n    mov %rax, %rdi\n    mov %r8, %rsi\n    rep movsb\n    ret\nrt_concat:\n    mov 16(%rsp), %r10\n    mov 8(%rsp), %r11\n    mov -8(%r10), %r8\n    shl $8, %r8\n    shr $8, %r8\n    mov -8(%r11), %r9\n    shl $8, %r9\n    shr $8, %r9\n    lea (%r8,%r9), %rdi\n    call rt_mkstr_r\n    mov %rax, %rdi\n    mov %r10, %rsi\n    mov %r8, %rcx\n    rep movsb\n    mov %r11, %rsi\n    mov %r9, %rcx\n    rep movsb\n    ret\nrt_substr:\n    # (s, a, b) -> s[a:b] (caller guarantees 0 <= a, b <= len)\n    mov 16(%rsp), %r10\n    mov 8(%rsp), %r11\n    sub %r10, %r11\n    jge 1f\n    xor %r11d, %r11d\n1:  mov %r11, %rdi\n    call rt_mkstr_r\n    mov %rax, %rdi\n    mov 24(%rsp), %rsi\n    add %r10, %rsi\n    mov %r11, %rcx\n    rep movsb\n    ret\nrt_chr:\n    mov $1, %edi\n    call rt_mkstr_r\n    mov 8(%rsp), %rcx\n    movb %cl, (%rax)\n    ret\nrt_str_eq:\n    mov 16(%rsp), %rsi\n    mov 8(%rsp), %rdi\n    mov -8(%rsi), %rcx\n    cmp -8(%rdi), %rcx\n    jne 2f\n    shl $8, %rcx\n    shr $8, %rcx\n    repe cmpsb\n    jne 2f\n    mov $1, %eax\n    ret\n2:  xor %eax, %eax\n    ret\nrt_join:\n    # (list, n): concatenation of the first n strings\n    mov 16(%rsp), %r8\n    mov 16(%r8), %r8\n    mov 8(%rsp), %r9\n    xor