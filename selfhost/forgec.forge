10)\n        k -= 1\n    return a\n\n# ---- arbitrary-precision ints (tag 12): [sign, limbs] with little-endian base 2^32 magnitude ----\ndef __bigmk(sg: int, m):\n    m = __bn_norm(m)\n    n: int = len(m)\n    if n == 0:\n        return 0\n    if n <= 2:\n        hi: int = 0\n        if n == 2:\n            hi = m[1]\n        lo: int = m[0]\n        if hi < 2147483648 and not (sg > 0 and hi == 1073741824 and lo <= 3):\n            # 2**62 .. 2**62+3 would alias the bool/None encodings, so keep them boxed\n            v: int = (hi << 32) | lo\n            if sg < 0:\n                return 0 - v\n            return v\n        if sg < 0 and hi == 2147483648 and lo == 0:\n            return -9223372036854775807 - 1\n    r = [sg, m]\n    set_byte(r, -1, 12)\n    return r\n\ndef __bigsg(x) -> int:\n    if __tag(x) == 12:\n        return __lst(x, 0)\n    v: int = x\n    if v < 0:\n        return -1\n    return 1\n\ndef __bigmag(x):\n    if __tag(x) == 12:\n        return __lst(x, 1)\n    v: int = x\n    if v < 0:\n        v = 0 - v\n    m = []\n    append(m, v & 4294967295)\n    append(m, (v >> 32) & 4294967295)\n    return __bn_norm(m)\n\ndef __bn_mul(a, b):\n    r = []\n    nb: int = len(b)\n    j: int = 0\n    while j < nb:\n        y: int = b[j]\n        if y != 0:\n            p = __bn_add(__bn_muls(a, y & 65535), __bn_shl(__bn_muls(a, y >> 16), 16))\n            r = __bn_add(r, __bn_shl(p, 32 * j))\n        j += 1\n    return __bn_norm(r)\n\ndef __bigaddm(sa: int, ma, sb: int, mb):\n    if sa == sb:\n        return __bigmk(sa, __bn_add(ma, mb))\n    c: int = __bn_cmp(ma, mb)\n    if c == 0:\n        return 0\n    if c > 0:\n        return __bigmk(sa, __bn_sub(ma, mb))\n    return __bigmk(sb, __bn_sub(mb, ma))\n\ndef __bigop(a, b, op: int, line):\n    # a, b: ints or bigints; op 0 + 1 - 2 * 4 // 5 % 3 /\n    if op == 3:\n        return __bigtof(a) / __bigtof(b)\n    sa: int = __bigsg(a)\n    sb: int = __bigsg(b)\n    ma = __bigmag(a)\n    mb = __bigmag(b)\n    if op