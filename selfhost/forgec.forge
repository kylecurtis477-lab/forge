def prelude_text():
    return "# Forge prelude: library code written in Forge and compiled into every program.\n# Unreferenced functions are dropped from the output. A user function with the same name replaces a public one here.\n# Internals use only __-prefixed helpers so user code cannot change their behaviour.\n\nclass BaseException:\n    def __init__(self, msg=\"\"):\n        self.__msg = msg\n        self.__rt = 0\n\n    def __str__(self):\n        return __str(self.__msg)\n\n    def __repr__(self):\n        if __tag(self.__msg) == 1 and __aux(self.__msg) == 0:\n            return concat(__clsname(self), \"()\")\n        return concat(concat(concat(__clsname(self), \"(\"), __repr(self.__msg)), \")\")\n\n\nclass Exception(BaseException):\n    pass\n\n\nclass ArithmeticError(Exception):\n    pass\n\n\nclass ZeroDivisionError(ArithmeticError):\n    pass\n\n\nclass OverflowError(ArithmeticError):\n    pass\n\n\nclass LookupError(Exception):\n    pass\n\n\nclass IndexError(LookupError):\n    pass\n\n\nclass KeyError(LookupError):\n    def __str__(self):\n        return __repr(self.__msg)\n\n\nclass ValueError(Exception):\n    pass\n\n\nclass TypeError(Exception):\n    pass\n\n\nclass RuntimeError(Exception):\n    pass\n\n\nclass NotImplementedError(RuntimeError):\n    pass\n\n\nclass RecursionError(RuntimeError):\n    pass\n\n\nclass AssertionError(Exception):\n    pass\n\n\nclass AttributeError(Exception):\n    pass\n\n\nclass NameError(Exception):\n    pass\n\n\nclass StopIteration(Exception):\n    pass\n\n\ndef __has(msg, p) -> int:\n    return __find(msg, p, 0) >= 0\n\ndef __sw(msg, p) -> int:\n    return __find(msg, p, 0) == 0\n\ndef __rtexc(msg):\n    if __sw(msg, \"list index\"):\n        return IndexError(\"list index out of range\")\n    if __sw(msg, \"list assignment index\"):\n        return IndexError(\"list assignment index out of range\")\n    if __has(msg, \"index out of range\") or __sw(msg, \"pop from empty\"):\n        return IndexError(msg)\n    if __has(msg, \"division by zero\"):\n        return ZeroDivisionError(msg)\n    if __has(msg, \"could not convert\") or __has(msg, \"invalid literal\") or __has(msg, \"not in list\") or __has(msg, \"math domain\") or __has(msg, \"empty separator\") or __has(msg, \"must not be zero\"):\n        return ValueError(msg)\n    if __has(msg, \"no such method\"):\n        return AttributeError(msg)\n    if __has(msg, \"unsupported operand\") or __has(msg, \"not supported\") or __has(msg, \"not indexable\") or __has(msg, \"not iterable\") or __has(msg, \"does not support\") or __has(msg, \"cannot be sliced\") or __has(msg, \"cannot be raised\") or __has(msg, \"not callable\") or __has(msg, \"positional arguments\"):\n        return TypeError(msg)\n    return RuntimeError(msg)\n\ndef __raise_rt(e, line, msg):\n    e.__rt = msg\n    __raise(e, line)\n\ndef __err(line, msg0):\n    msg: str = concat(msg0, \"\")\n    __raise_rt(__rtexc(msg), line, msg)\n\ndef __aerr(line, msg):\n    __raise_rt(AssertionError(msg), line, __str(msg))\n\ndef __uncaught(e, line):\n    msg = \"\"\n    if isinstance(e, BaseException) and e.__rt != 0:\n        msg = e.__rt\n    else:\n        s: str = __str(e)\n        msg = __clsname(e)\n        if __aux(s) > 0:\n            msg = concat(concat(msg, \": \"), s)\n    eputs(concat(concat(concat(\"error: line \", __itos(line)), \": \"), msg))\n    exit(1)\n\ndef __lst(xs: list, i: int):\n    return __ld(__ld(xs, 2), i)\n\ndef __grow(xs, need: int):\n    cap: int = __ld(xs, 1)\n    if need <= cap:\n        return 0\n    nc: int = cap * 2\n    if nc < need:\n        nc = need\n    d = __new(nc * 8, 4, nc * 8)\n    __copy(d, __ld(xs, 2), __ld(xs, 0) * 8)\n    __st(xs, 2, d)\n    __st(xs, 1, nc)\n    return 0\n\ndef append(xs, v):\n    n: int = __ld(xs, 0)\n    if n >= __ld(xs, 1):\n        __grow(xs, n + 1)\n    __st(__ld(xs, 2), n, v)\n    __st(xs, 0, n + 1)\n    return 0\n\ndef pop(xs):\n    n: int = __ld(xs, 0) - 1\n    if n < 0:\n        __err(0, \"pop from empty list\")\n    __st(xs, 0, n)\n    d = __ld(xs, 2)\n    v = __ld(d, n)\n    __st(d, n, 0)\n    return v\n\ndef insert(xs, i: int, v):\n    n: int = __ld(xs, 0)\n    if i < 0:\n        i = i + n\n    if i < 0:\n        i = 0\n    if i > n:\n        i = n\n    append(xs, 0)\n    d = __ld(xs, 2)\n    j: int = n\n    while j > i:\n        __st(d, j, __ld(d, j - 1))\n        j -= 1\n    __st(d, i, v)\n    return 0\n\ndef __list_add(a, b):\n    na: int = __ld(a, 0)\n    nb: int = __ld(b, 0)\n    r = list(na + nb)\n    __copy(__ld(r, 2), __ld(a, 2), na * 8)\n    __copy(__ld(r, 2) + na * 8, __ld(b, 2), nb * 8)\n    return r\n\ndef __list_mul(a, k: int):\n    n: int = __ld(a, 0)\n    if k < 0:\n        k = 0\n    r = list(n * k)\n    d = __ld(r, 2)\n    s = __ld(a, 2)\n    i: int = 0\n    while i < k:\n        __copy(d + i * n * 8, s, n * 8)\n        i += 1\n    return r\n\ndef __itos(x) -> str:\n    return __itos_raw(x)\n\ndef __str(x) -> str:\n    t: int = __tag(x)\n    if t == 1:\n        return x\n    if t < 0:\n        return __itos_raw(x)\n    if t == 2:\n        return x.__str__()\n    if t == 12:\n        return __bigstr(x)\n    return __repr(x)\n\ndef __brepr(x) -> str:\n    v: int = x\n    if v & 1:\n        return \"True\"\n    return \"False\"\n\ndef __srepr(x) -> str:\n    q = \"'\"\n    if __find(x, \"'\", 0) >= 0 and __find(x, chr(34), 0) < 0:\n        q = chr(34)\n    n: int = len(x)\n    i: int = 0\n    plain: int = 1\n    while i < n:\n        c: int = ord(x[i])\n        if c < 32 or c == 92 or c == 127 or c == ord(q):\n            plain = 0\n            break\n        i += 1\n    if plain == 1:\n        return concat(concat(q, x), q)\n    parts = [q]\n    i = 0\n    while i < n:\n        ch = x[i]\n        c: int = ord(ch)\n        if c == 10:\n            append(parts, \"\\\\n\")\n        elif c == 9:\n            append(parts, \"\\\\t\")\n        elif c == 13:\n            append(parts, \"\\\\r\")\n        elif c == 92:\n            append(parts, \"\\\\\\\\\")\n        elif ch == q:\n            append(parts, concat(\"\\\\\", q))\n        elif c < 32 or c == 127:\n            h = hex(c)\n            if c < 16:\n                append(parts, concat(\"\\\\x0\", substr(h, 2, 3)))\n            else:\n                append(parts, concat(\"\\\\x\", substr(h, 2, 4)))\n        else:\n            append(parts, ch)\n        i += 1\n    append(parts, q)\n    return join(parts, len(parts))\n\ndef __repr(x) -> str:\n    t: int = __tag(x)\n    if t == 1:\n        return __srepr(x)\n    if t < 0:\n        return __itos_raw(x)\n    if t == 6:\n        return __brepr(x)\n    if t == 7:\n        return \"None\"\n    if t == 8:\n        return \"<function>\"\n    if t == 12:\n        return __bigstr(x)\n    if t == 5:\n        return __frepr(x)\n    parts = []\n    if t == 9:\n        n: int = __ld(x, 0)\n        append(parts, \"(\")\n        i: int = 0\n        while i < n:\n            if i > 0:\n                append(parts, \", \")\n            append(parts, __repr(__lst(x, i)))\n            i += 1\n        if n == 1:\n            append(parts, \",\")\n        append(parts, \")\")\n    elif t == 0:\n        n: int = __ld(x, 0)\n        append(parts, \"[\")\n        i: int = 0\n        while i < n:\n            if i > 0:\n                append(parts, \", \")\n            append(parts, __repr(__lst(x, i)))\n            i += 1\n        append(parts, \"]\")\n    elif t == 10:\n        ks = __ld(x, 5)\n        n: int = __ld(ks, 0)\n        if n == 0:\n            return \"set()\"\n        append(parts, \"{\")\n        i: int = 0\n        while i < n:\n            if i > 0:\n                append(parts, \", \")\n            append(parts, __repr(__lst(ks, i)))\n            i += 1\n        append(parts, \"}\")\n    elif t == 3:\n        ks = __ld(x, 5)\n        n: int = __ld(ks, 0)\n        append(parts, \"{\")\n        i: int = 0\n        while i < n:\n            if i > 0:\n                append(parts, \", \")\n            k = __lst(ks, i)\n            append(parts, __repr(k))\n            append(parts, \": \")\n            append(parts, __repr(__dget(x, k, 0)))\n            i += 1\n        append(parts, \"}\")\n    else:\n        return x.__repr__()\n    return join(parts, __ld(parts, 0))\n\ndef __typeid(x) -> int:\n    # class index + 1 for objects; -1 int, -2 str, -3 list, -4 dict, -5 float, -6 bool\n    t: int = __tag(x)\n    if t < 0:\n        return -1\n    if t == 2:\n        return __aux(x)\n    if t == 1:\n        return -2\n    if t == 0:\n        return -3\n    if t == 3:\n        return -4\n    if t == 5:\n        return -5\n    if t == 6:\n        return -6\n    if t == 12:\n        return -1\n    return -7\n\ndef __m___str__(o) -> str:\n    return o.__repr__()\n\ndef __m___repr__(o) -> str:\n    return \"<object>\"\n\ndef repr(x) -> str:\n    return __repr(x)\n\ndef __pr(x):\n    t: int = __tag(x)\n    if t == 1:\n        __writes(x)\n    elif t < 0:\n        __wint(x)\n    else:\n        __writes(__str(x))\n    return 0\n\ndef __isnum(x) -> int:\n    t: int = __tag(x)\n    return t < 0 or t == 5 or t == 6\n\ndef __binop(a, b, op: int, line):\n    ta0: int = __tag(a)\n    tb0: int = __tag(b)\n    if (ta0 == 12 and (tb0 < 0 or tb0 == 12 or tb0 == 6)) or (tb0 == 12 and (ta0 < 0 or ta0 == 6)):\n        return __bigop(__bnorm(a), __bnorm(b), op, line)\n    if (ta0 == 12 and tb0 == 5) or (tb0 == 12 and ta0 == 5):\n        x = float(a)\n        y = float(b)\n        if op == 0:\n            return x + y\n        if op == 1:\n            return x - y\n        if op == 2:\n            return x * y\n        if op == 3:\n            return x / y\n        if op == 4:\n            return x // y\n        return x % y\n    if op == 1 and __tag(a) == 10 and __tag(b) == 10:\n        return __sop(a, b, 3)\n    if op == 2:\n        ta: int = __tag(a)\n        tb: int = __tag(b)\n        if ta == 1 and __isnum(b):\n            return __strmul(a, int(b))\n        if tb == 1 and __isnum(a):\n            return __strmul(b, int(a))\n        if ta == 0 and __isnum(b):\n            return __list_mul(a, int(b))\n        if tb == 0 and __isnum(a):\n            return __list_mul(b, int(a))\n        if ta == 9 and __isnum(b):\n            return __tup(__list_mul(a, int(b)))\n        if tb == 9 and __isnum(a):\n            return __tup(__list_mul(b, int(a)))\n    if op == 5 and __tag(a) == 1:\n        return __pctfmt(a, b, line)\n    names = [\"+\", \"-\", \"*\", \"/\", \"//\", \"%\"]\n    __err(line, concat(concat(\"unsupported operand type(s) for \", __lst(names, op)), \"\"))\n\ndef __cmpop(a, b, op: int) -> int:\n    if op >= 12 and __tag(a) == 10 and __tag(b) == 10:\n        if op == 12:\n            return __lt(a, b)\n        if op == 13:\n            return __lt(b, a)\n        if op == 14:\n            return issubset(a, b)\n        return issuperset(a, b)\n    if op == 10:\n        return __eq(a, b)\n    if op == 11:\n        return __eq(a, b) == 0\n    if op == 12:\n        return __lt(a, b)\n    if op == 13:\n        return __lt(b, a)\n    if op == 14:\n        return __lt(b, a) == 0\n    return __lt(a, b) == 0\n\ndef __neg(x):\n    if __tag(x) == 12:\n        return __bigmk(0 - __lst(x, 0), __lst(x, 1))\n    if __tag(x) < 0:\n        v: int = x\n        if v == -9223372036854775807 - 1:\n            return __bigop(0, x, 1, 0)\n    if __tag(x) == 5:\n        return __ffrombits(__fbits(x) ^ (1 << 63))\n    return 0 - x\n\ndef __ffloordiv(a, b):\n    return __math(a / b, 1)\n\n# ---- arbitrary-precision naturals (little-endian base 2^32 limbs) for exact float<->decimal ----\ndef __bn_norm(a):\n    while len(a) > 0 and a[len(a) - 1] == 0:\n        pop(a)\n    return a\n\ndef __bn(v: int):\n    a = []\n    while v > 0:\n        append(a, v & 4294967295)\n        v = v >> 32\n    return a\n\ndef __bn_muls(a, m: int):\n    r = []\n    c: int = 0\n    n: int = len(a)\n    i: int = 0\n    while i < n:\n        x: int = a[i]\n        t: int = x * m + c\n        append(r, t & 4294