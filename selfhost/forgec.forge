i: int = 0\n        while i < na and i < nb:\n            x = __lst(a, i)\n            y = __lst(b, i)\n            if not __eq(x, y):\n                return __lt(x, y)\n            i += 1\n        return na < nb\n    __err(0, \"'<' not supported between these types\")\n    return 0\n\ndef __strcmp(a, b):\n    na: int = __aux(a)\n    nb: int = __aux(b)\n    i: int = 0\n    while i < na and i < nb:\n        d: int = char_at(a, i) - char_at(b, i)\n        if d != 0:\n            return d\n        i += 1\n    return na - nb\n\ndef __getidx(o, i: int, line):\n    t: int = __tag(o)\n    if t == 0 or t == 9:\n        n: int = __ld(o, 0)\n        j: int = i\n        if j < 0:\n            j = j + n\n        if j < 0 or j >= n:\n            __err(line, concat(concat(concat(\"list index \", __itos_raw(i)), \" out of range for length \"), __itos_raw(n)))\n        return __lst(o, j)\n    if t == 1:\n        n: int = __aux(o)\n        j: int = i\n        if j < 0:\n            j = j + n\n        if j < 0 or j >= n:\n            __err(line, \"string index out of range\")\n        return chr(char_at(o, j))\n    if t == 3:\n        return __dget(o, i, line)\n    __err(line, \"value is not indexable\")\n\ndef __setidx(o, i: int, v, line):\n    t: int = __tag(o)\n    if t == 0:\n        n: int = __ld(o, 0)\n        j: int = i\n        if j < 0:\n            j = j + n\n        if j < 0 or j >= n:\n            __err(line, concat(concat(concat(\"list assignment index \", __itos_raw(i)), \" out of range for length \"), __itos_raw(n)))\n        __st(__ld(o, 2), j, v)\n        return 0\n    if t == 3:\n        __dset(o, i, v)\n        return 0\n    __err(line, \"value does not support item assignment\")\n\ndef __slice(o, a: int, b: int, line):\n    t: int = __tag(o)\n    n: int = 0\n    if t == 0 or t == 9:\n        n = __ld(o, 0)\n    elif t == 1:\n        n = __aux(o)\n    else:\n        __err(line, \"value cannot be sliced\")\n    if a < 0:\n        a = a + n\n    if b < 0:\n        b = b + n\n    if a < 0:\n        a = 0\n    if b > n:\n        b = n\n    if b < a:\n        b = a\n    if t == 1:\n        return substr(o, a, b)\n    r = list(b - a)\n    __copy(__ld(r, 2), __ld(o, 2) + a * 8, (b - a) * 8)\n    if t == 9:\n        set_byte(r, -1, 9)\n    return r\n\ndef __tup(r):\n    set_byte(r, -1, 9)\n    return r\n\ndef tuple(x=None):\n    if x is None:\n        return __tup([])\n    if __tag(x) == 9:\n        return x\n    return __tup(__listof(x))\n\ndef __iter(x, line):\n    t: int = __tag(x)\n    if t == 0 or t == 9:\n        return x\n    if t == 3 or t == 10:\n        return __ld(x, 5)\n    if t == 1:\n        n: int = __aux(x)\n        r = list(n)\n        i: int = 0\n        while i < n:\n            __st(__ld(r, 2), i, chr(char_at(x, i)))\n            i += 1\n        return r\n    if t == 2:\n        return __drain(x)\n    __err(line, \"value is not iterable\")\n\ndef __contains(c, x):\n    t: int = __tag(c)\n    if t == 3 or t == 10:\n        i: int = __dfind(c, x, __hash(x))\n        return __ld(__ld(c, 2), i) != 0\n    if t == 0 or t == 9:\n        n: int = __ld(c, 0)\n        i: int = 0\n        while i < n:\n            if __eq(__lst(c, i), x):\n                return 1\n            i += 1\n        return 0\n    if t == 1:\n        return __find(c, x, 0) >= 0\n    if t == 2:\n        return __contains(__drain(c), x)\n    return 0\n\n# ---- dict: open addressing, insertion-ordered keys ----\n# layout: [count, cap, hashes, keys, values, order(list of keys)]\ndef __zeros(n: int):\n    p = __new(n * 8, 4, n * 8)\n    i: int = 0\n    while i < n:\n        __st(p, i, 0)\n        i += 1\n    return p\n\ndef __dict():\n    d = __new(56, 3, 0)\n    __st(d, 6, 0)\n    __st(d, 0, 0)\n    __st(d, 1, 8)\n    __st(d, 2, __zeros(8))\n    __st(d, 3, __zeros(8))\n    __st(d, 4, __zeros(8))\n    __st(d, 5, list(0))\n    return d\n\ndef __hash(k) -> int:\n    h: int = 0\n    t: int = __tag(k)\n    if t == 6:\n        k = int(k)\n    elif t == 5:\n        if __math(k, 1) == k and __math(k, 10) < __itof(1000000000000000000):\n            k = int(k)\n        else:\n            k = __fbits(k)\n    if t == 1:\n        h = 5381\n        n: int = __aux(k)\n        i: int = 0\n        while i < n:\n            h = h * 33 + char_at(k, i)\n            i += 1\n    elif t == 9:\n        h = 3430008\n        n: int = __ld(k, 0)\n        i: int = 0\n        while i < n:\n            h = (h ^ __hash(__lst(k, i))) * 1000003\n            i += 1\n    elif t == 12:\n        h = __lst(k, 0)\n        ws = __lst(k, 1)\n        nw: int = len(ws)\n        j: int = 0\n        while j < nw:\n            wv: int = __lst(ws, j)\n            h = (h ^ wv) * 1000003\n            j += 1\n    elif t == 0 or t == 3 or t == 10:\n        __err(0, \"unhashable type\")\n    else:\n        kv: int = k\n        h = kv * -7046029254386353131\n        h = h ^ (h >> 29)\n    return h | 1\n\ndef __dfind(d, k, h: int) -> int:\n    m: int = __ld(d, 1) - 1\n    hs = __ld(d, 2)\n    ks = __ld(d, 3)\n    i: int = h & m\n    while 1:\n        x: int = __ld(hs, i)\n        if x == 0:\n            return i\n        if x == h and __eq(__ld(ks, i), k):\n            return i\n        i = (i + 1) & m\n\ndef __dget(d, k, line):\n    i: int = __dfind(d, k, __hash(k))\n    if __ld(__ld(d, 2), i) == 0:\n        __raise_rt(KeyError(k), line, concat(\"key not found: \", __repr(k)))\n    return __ld(__ld(d, 4), i)\n\ndef get(d, k, dflt):\n    i: int = __dfind(d, k, __hash(k))\n    if __ld(__ld(d, 2), i) == 0:\n        return dflt\n    return __ld(__ld(d, 4), i)\n\ndef __dset(d, k, v):\n    if (__ld(d, 0) + __ld(d, 6) + 1) * 4 > __ld(d, 1) * 3:\n        __dresize(d)\n    h: int = __hash(k)\n    i: int = __dfind(d, k, h)\n    hs = __ld(d, 2)\n    if __ld(hs, i) == 0:\n        __st(hs, i, h)\n        __st(__ld(d, 3), i, k)\n        __st(d, 0, __ld(d, 0) + 1)\n        append(__ld(d, 5), k)\n    __st(__ld(d, 4), i, v)\n    return 0\n\ndef __dresize(d):\n    oc: int = __ld(d, 1)\n    ohs = __ld(d, 2)\n    oks = __ld(d, 3)\n    ovs = __ld(d, 4)\n    nc: int = oc\n    if (__ld(d, 0) + 1) * 2 > oc:\n        nc = oc * 2\n    __st(d, 6, 0)\n    __st(d, 1, nc)\n    __st(d, 2, __zeros(nc))\n    __st(d, 3, __zeros(nc))\n    __st(d, 4, __zeros(nc))\n    j: int = 0\n    while j < oc:\n        h: int = __ld(ohs, j)\n        if h != 0 and h != 2:\n            k = __ld(oks, j)\n            i: int = __dfind(d, k, h)\n            __st(__ld(d, 2), i, h)\n            __st(__ld(d, 3), i, k)\n            __st(__ld(d, 4), i, __ld(ovs, j))\n        j += 1\n    return 0\n\ndef __ddel(d, k, line) -> int:\n# remove k; returns 1 if it was present\n    i: int = __dfind(d, k, __hash(k))\n    hs = __ld(d, 2)\n    if __ld(hs, i) == 0:\n        return 0\n    __st(hs, i, 2)\n    __st(__ld(d, 3), i, 0)\n    __st(__ld(d, 4), i, 0)\n    __st(d, 0, __ld(d, 0) - 1)\n    __st(d, 6, __ld(d, 6) + 1)\n    ks = __ld(d, 5)\n    n: int = __ld(ks, 0)\n    kd: int = __ld(ks, 2)\n    j: int = n - 1\n    while j >= 0:\n        x = __ld(kd, j)\n        if __eq(x, k):\n            __copy(kd + j * 8, kd + j * 8 + 8, (n - 1 - j) * 8)\n            __st(kd, n - 1, 0)\n            __st(ks, 0, n - 1)\n            return 1\n        j -= 1\n    return 1\n\ndef __delidx(o, k, line):\n    t: int = __tag(o)\n    if t == 3:\n        if not __ddel(o, k, line):\n            raise KeyError(k)\n        return 0\n    if t == 0:\n        n: int = __ld(o, 0)\n        if __tag(k) == 0:\n            return 0\n        j: int = k\n        if j < 0:\n            j = j + n\n        if j < 0 or j >= n:\n            raise IndexError(\"list assignment index out of range\")\n        d: int = __ld(o, 2)\n        __copy(d + j * 8, d + j * 8 + 8, (n - 1 - j) * 8)\n        __st(d, n - 1, 0)\n        __st(o, 0, n - 1)\n        return 0\n    __err(line, \"object does not support item deletion\")\n\ndef __delslice(o, a: int, b: int, line):\n    n: int = __ld(o, 0)\n    if a < 0:\n        a = a + n\n    if b < 0:\n        b = b + n\n    if a < 0:\n        a = 0\n    if b > n:\n        b = n\n    if b <= a:\n        return 0\n    d: int = __ld(o, 2)\n    __copy(d + a * 8, d + b * 8, (n - b) * 8)\n    j: int = n - (b - a)\n    while j < n:\n        __st(d, j, 0)\n        j += 1\n    __st(o, 0, n - (b - a))\n    return 0\n\ndef clear(o):\n    t: int = __tag(o)\n    if t == 0:\n        d: int = __ld(o, 2)\n        j: int = __ld(o, 0)\n        while j > 0:\n            j -= 1\n            __st(d, j, 0)\n        __st(o, 0, 0)\n        return None\n    __st(o, 0, 0)\n    __st(o, 1, 8)\n    __st(o, 2, __zeros(8))\n    __st(o, 3, __zeros(8))\n    __st(o, 4, __zeros(8))\n    __st(o, 5, list(0))\n    __st(o, 6, 0)\n    return None\n\ndef copy(o):\n    t: int = __tag(o)\n    if t == 0:\n        return __listof(o)\n    r = __dict()\n    if t == 10:\n        set_byte(r, -1, 10)\n    for k in __ld(o, 5):\n        __dset(r, k, __dget(o, k, 0))\n    return r\n\ndef update(d, o):\n    if __tag(d) == 10:\n        for k in __iter(o, 0):\n            __dset(d, k, 1)\n        return None\n    for k in __ld(o, 5):\n        __dset(d, k, __dget(o, k, 0))\n    return None\n\ndef setdefault(d, k, v=None):\n    i: int = __dfind(d, k, __hash(k))\n    if __ld(__ld(d, 2), i) != 0:\n        return __ld(__ld(d, 4), i)\n    __dset(d, k, v)\n    return v\n\ndef pop__2(d, k):\n    if __tag(d) == 0:\n        n: int = __ld(d, 0)\n        j: int = k\n        if j < 0:\n            j = j + n\n        if j < 0 or j >= n:\n            raise IndexError(\"pop index out of range\")\n        v = __lst(d, j)\n        __delidx(d, j, 0)\n        return v\n    i: int = __dfind(d, k, __hash(k))\n    if __ld(__ld(d, 2), i) == 0:\n        raise KeyError(k)\n    v = __ld(__ld(d, 4), i)\n    __ddel(d, k, 0)\n    return v\n\ndef pop__3(d, k, dflt):\n    i: int = __dfind(d, k, __hash(k))\n    if __ld(__ld(d, 2), i) == 0:\n        return dflt\n    v = __ld(__ld(d, 4), i)\n    __ddel(d, k, 0)\n    return v\n\n# ---- sets: dicts tagged 10 whose values are unused ----\ndef set(xs=None):\n    r = __dict()\n    set_byte(r, -1, 10)\n    if xs is not None:\n        for x in __iter(xs, 0):\n            __dset(r, x, 1)\n    return r\n\ndef frozenset(xs=None):\n    return set(xs)\n\ndef add(s, x):\n    __dset(s, x, 1)\n    return None\n\ndef discard(s, x):\n    __ddel(s, x, 0)\n    return None\n\ndef remove(s, x):\n    if __tag(s) == 0:\n        n: int = __ld(s, 0)\n        i: int = 0\n        while i < n:\n            if __eq(__lst(s, i), x):\n                __delidx(s, i, 0)\n                return None\n            i += 1\n        raise ValueError(\"list.remove(x): x not in list\")\n    if not __ddel(s, x, 0):\n        raise KeyError(x)\n    return None\n\ndef __sop(a, b, op: int):\n# 0 & 1 | 2 ^ 3 -\n    r = set()\n    if op == 1:\n        for x in __ld(a, 5):\n            __dset(r, x, 1)\n        for x in __iter(b, 0):\n            __dset(r, x, 1)\n    elif op == 0:\n        for x in __ld(a, 5):\n            if __contains(b, x):\n                __dset(r, x, 1)\n    elif op == 3:\n        for x in __ld(a, 5):\n            if not __contains(b, x):\n                __dset(r, x, 1)\n    else:\n        for x in __ld(a, 5):\n            if not __contains(b, x):\n                __dset(r, x, 1)\n        for x in __iter(b, 0):\n            if not __contains(a, x):\n                __dset(r, x, 1)\n    return r\n\ndef union(a, b):\n    return __sop(a, set(b), 1)\n\ndef intersection(a, b):\n    return __sop(a, set(b), 0)\n\ndef difference(a, b):\n    return __sop(a, set(b), 3)\n\ndef symmetric_difference(a, b):\n    return __sop(a, set(b), 2)\n\ndef issubset(a, b) -> bool:\n    for x in __ld(a, 5):\n        if not __contains(b, x):\n            return False\n    return True\n\ndef issuperset(a, b) -> bool:\n    for x in __iter(b, 0):\n        if not __contains(a, x):\n            return False\n    return True\n\ndef isdisjoint(a, b) -> bool:\n    for x in __iter(b, 0):\n        if __contains(a, x):\n            return False\n    return True\n\ndef __bitop(a, b, op: int):\n    ta: int = __tag(a)\n    tb: int = __tag(b)\n    if ta == 10 and tb == 10:\n        return __sop(a, b, op)\n    if ta == 3 and tb == 3 and op == 1:\n        r = copy(a)\n        update(r, b)\n        return r\n    if ta == 6 and tb == 6:\n        x: int = int(a)\n        y: int = int(b)\n        if op == 0:\n            return bool(x & y)\n        if op == 1:\n            return bool(x | y)\n        return bool(x ^ y)\n    if (ta < 0 or ta == 6) and (tb < 0 or tb == 6):\n        x: int = int(a)\n        y: int = int(b)\n        if op == 0:\n            return __ibox(x & y)\n        if op == 1:\n            return __ibox(x | y)\n        return __ibox(x ^ y)\n    if (ta == 12 or ta < 0 or ta == 6) and (tb == 12 or tb < 0 or tb == 6):\n        return __bigbit(__bnorm(a), __bnorm(b), op)\n    names = [\"&\", \"|\", \"^\"]\n    raise TypeError(concat(\"unsupported operand type(s) for \", __lst(names, op)))\n\ndef keys(d):\n    return __slice(__ld(d, 5), 0, __ld(__ld(d, 5), 0), 0)\n\ndef values(d):\n    ks = __ld(d, 5)\n    n: int = __ld(ks, 0)\n    r = list(n)\n    i: int = 0\n    while i < n:\n        __st(__ld(r, 2), i, __dget(d, __lst(ks, i), 0))\n        i += 1\n    return r\n\ndef items(d):\n    ks = __ld(d, 5)\n    n: int = __ld(ks, 0)\n    r = list(n)\n    i: int = 0\n    while i < n:\n        k = __lst(ks, i)\n        __st(__ld(r, 2), i, __tup([k, __dget(d, k, 0)]))\n        i += 1\n    return r\n\n# ---- strings ----\ndef __find(s, sub, start: int) -> int:\n    n: int = __aux(s)\n    m: int = __aux(sub)\n    i: int = start\n    while i + m <= n:\n        j: int = 0\n        while j < m and char_at(s, i + j) == char_at(sub, j):\n            j += 1\n        if j == m:\n            return i\n        i += 1\n    return -1\n\ndef find(s, sub, start=0) -> int:\n    if start < 0:\n        start = start + __aux(s)\n        if start < 0:\n            start = 0\n    return __find(s, sub, start)\n\ndef rfind(s, sub) -> int:\n    n: int = __aux(s)\n    m: int = __aux(sub)\n    i: int = n - m\n    while i >= 0:\n        j: int = 0\n        while j < m and char_at(s, i + j) == char_at(sub, j):\n            j += 1\n        if j == m:\n            return i\n        i -= 1\n    return -1\n\ndef rindex(s, sub) -> int:\n    i: int = rfind(s, sub)\n    if i < 0:\n        raise ValueError(\"substring not found\")\n    return i\n\ndef partition(s, sep):\n    i: int = __find(s, sep, 0)\n    if i < 0:\n        return __tup([s, \"\", \"\"])\n    return __tup([substr(s, 0, i), sep, substr(s, i + __aux(sep), __aux(s))])\n\ndef rpartition(s, sep):\n    i: int = rfind(s, sep)\n    if i < 0:\n        return __tup([\"\", \"\", s])\n    return __tup([substr(s, 0, i), sep, substr(s, i + __aux(sep), __aux(s))])\n\ndef __pad(s, w: int, fill, mode: int) -> str:\n    n: int = __aux(s)\n    if w <= n:\n        return s\n    k: int = w - n\n    if mode == 0:\n        return concat(s, __strmul(fill, k))\n    if mode == 1:\n        return concat(__strmul(fill, k), s)\n    left: int = k // 2\n    if k % 2 == 1 and w % 2 == 1:\n        left += 1\n    return concat(concat(__strmul(fill, left), s), __strmul(fill, k - left))\n\ndef ljust(s, w, fill=\" \") -> str:\n    return __pad(s, w, fill, 0)\n\ndef rjust(s, w, fill=\" \") -> str:\n    return __pad(s, w, fill, 1)\n\ndef center(s, w, fill=\" \") -> str:\n    return __pad(s, w, fill, 2)\n\ndef zfill(s, w) -> str:\n    n: int = __aux(s)\n    if w <= n:\n        return s\n    if n > 0 and (char_at(s, 0) == 45 or char_at(s, 0) == 43):\n        return concat(concat(substr(s, 0, 1), __strmul(\"0\", w - n)), substr(s, 1, n))\n    return concat(__strmul(\"0\", w - n), s)\n\ndef __isup(c: int) -> int:\n    return c >= 65 and c <= 90\n\ndef __islo(c: int) -> int:\n    return c >= 97 and c <= 122\n\ndef __chcase(s, mode: int) -> str:\n# 0 title, 1 capitalize, 2 swapcase\n    n: int = __aux(s)\n    r = substr(s, 0, n)\n    prev: int = 0\n    i: int = 0\n    while i < n:\n        c: int = char_at(r, i)\n        up: int = 0\n        lo: int = 0\n        if mode == 0:\n            up = not prev\n            lo = prev\n        elif mode == 1:\n            up = i == 0\n            lo = i > 0\n        else:\n            up = __islo(c)\n            lo = __isup(c)\n        if up and __islo(c):\n            set_byte(r, i, c - 32)\n        elif lo and __isup(c):\n            set_byte(r, i, c + 32)\n        prev = __isup(c) or __islo(c)\n        i += 1\n    return r\n\ndef title(s) -> str:\n    return __chcase(s, 0)\n\ndef capitalize(s) -> str:\n    return __chcase(s, 1)\n\ndef swapcase(s) -> str:\n    return __chcase(s, 2)\n\ndef __allc(s, k: int) -> int:\n    n: int = __aux(s)\n    if n == 0:\n        return 0\n    cased: int = 0\n    i: int = 0\n    while i < n:\n        c: int = char_at(s, i)\n        if k == 0:\n            if not (__isup(c) or __islo(c) or (c >= 48 and c <= 57)):\n                return 0\n        elif k == 1:\n            if not (__isspace(c) or c == 11 or c == 12):\n                return 0\n        elif k == 2:\n            if __islo(c):\n                return 0\n            if __isup(c):\n                cased = 1\n        else:\n            if __isup(c):\n                return 0\n            if __islo(c):\n                cased = 1\n        i += 1\n    if k >= 2:\n        return cased\n    return 1\n\ndef isalnum(s) -> bool:\n    return __allc(s, 0) == 1\n\ndef isspace(s) -> bool:\n    return __allc(s, 1) == 1\n\ndef isupper(s) -> bool:\n    return __allc(s, 2) == 1\n\ndef islower(s) -> bool:\n    return __allc(s, 3) == 1\n\ndef removeprefix(s, p) -> str:\n    if startswith(s, p):\n        return substr(s, __aux(p), __aux(s))\n    return s\n\ndef removesuffix(s, p) -> str:\n    if __aux(p) > 0 and endswith(s, p):\n        return substr(s, 0, __aux(s) - __aux(p))\n    return s\n\ndef splitlines(s):\n    r = []\n    n: int = __aux(s)\n    a: int = 0\n    i: int = 0\n    while i < n:\n        c: int = char_at(s, i)\n        if c == 10 or c == 13:\n            append(r, substr(s, a, i))\n            if c == 13 and i + 1 < n and char_at(s, i + 1) == 10:\n                i += 1\n            a = i + 1\n        i += 1\n    if a < n:\n        append(r, substr(s, a, n))\n    return r\n\ndef rsplit(s, sep=None, maxsplit=-1):\n    if sep is None:\n        return split__1(s)\n    parts = split(s, sep)\n    k: int = len(parts) - 1 - maxsplit\n    if maxsplit < 0 or k <= 0:\n        return parts\n    head = __m_join(sep, __slice(parts, 0, k + 1, 0))\n    r = [head]\n    extend(r, __slice(parts, k + 1, len(parts), 0))\n    return r\n\ndef __sfmt(s, args) -> str:\n# str.format: args = [key-or-0, value, ...]\n    pos = []\n    kw = {}\n    i: int = 0\n    while i < len(args):\n        k = args[i]\n        if __tag(k) == 1:\n            kw[k] = args[i + 1]\n        else:\n            append(pos, args[i + 1])\n        i += 2\n    out = []\n    n: int = __aux(s)\n    auto: int = 0\n    i = 0\n    a: int = 0\n    while i < n:\n        c: int = char_at(s, i)\n        if c == 123 or c == 125:\n            if i + 1 < n and char_at(s, i + 1) == c:\n                append(out, substr(s, a, i + 1))\n                i += 2\n                a = i\n                continue\n            if c == 125:\n                raise ValueError(\"Single '}' encountered in format string\")\n            append(out, substr(s, a, i))\n            j: int = __find(s, \"}\", i)\n            if j < 0:\n                raise ValueError(\"Single '{' encountered in format string\")\n            field = substr(s, i + 1, j)\n            spec = \"\"\n            conv: int = 0\n            ci: int = __find(field, \":\", 0)\n            if ci >= 0:\n                spec = substr(field, ci + 1, __aux(field))\n                field = substr(field, 0, ci)\n            bi: int = __find(field, \"!\", 0)\n            if bi >= 0:\n                conv = char_at(field, bi + 1)\n                field = substr(field, 0, bi)\n            v = None\n            if __aux(field) == 0:\n                v = pos[auto]\n                auto += 1\n            elif isdigit(field):\n                v = pos[int(field)]\n            else:\n                v = kw[field]\n            if conv == 114:\n                v = repr(v)\n            elif conv == 115:\n                v = __str(v)\n            append(out, __format(v, spec))\n            i = j + 1\n            a = i\n        else:\n            i += 1\n    append(out, substr(s, a, n))\n    return __m_join(\"\", out)\n\ndef startswith(s, p) -> bool:\n    m: int = __aux(p)\n    if m > __aux(s):\n        return False\n    i: int = 0\n    while i < m:\n        if char_at(s, i) != char_at(p, i):\n            return False\n        i += 1\n    return True\n\ndef endswith(s, p) -> bool:\n    m: int = __aux(p)\n    o: int = __aux(s) - m\n    if o < 0:\n        return False\n    i: int = 0\n    while i < m:\n        if char_at(s, o + i) != char_at(p, i):\n            return False\n        i += 1\n    return True\n\ndef __isspace(c: int) -> int:\n    return c == 32 or c == 10 or c == 9 or c == 13\n\ndef __instr(c: int, chars) -> int:\n    if chars is None:\n        return __isspace(c) or c == 11 or c == 12\n    n: int = __aux(chars)\n    i: int = 0\n    while i < n:\n        if char_at(chars, i) == c:\n            return 1\n        i += 1\n    return 0\n\ndef __strip(s, chars, mode: int) -> str:\n    a: int = 0\n    b: int = __aux(s)\n    if mode & 1:\n        while a < b and __instr(char_at(s, a), chars):\n            a += 1\n    if mode & 2:\n        while b > a and __instr(char_at(s, b - 1), chars):\n            b -= 1\n    return substr(s, a, b)\n\ndef strip(s, chars=None) -> str:\n    return __strip(s, chars, 3)\n\ndef lstrip(s, chars=None) -> str:\n    return __strip(s, chars, 1)\n\ndef rstrip(s, chars=None) -> str:\n    return __strip(s, chars, 2)\n\ndef split(s, sep):\n    r = []\n    n: int = __aux(s)\n    m: int = __aux(sep)\n    if m == 0:\n        __err(0, \"empty separator\")\n    a: int = 0\n    i: int = __find(s, sep, 0)\n    while i >= 0:\n        append(r, substr(s, a, i))\n        a = i + m\n        i = __find(s, sep, a)\n    append(r, substr(s, a, n))\n    return r\n\ndef split__1(s):\n    r = []\n    n: int = __aux(s)\n    i: int = 0\n    while i < n:\n        while i < n and __isspace(char_at(s, i)):\n            i += 1\n        if i >= n:\n            break\n        a: int = i\n        while i < n and not __isspace(char_at(s, i)):\n            i += 1\n        append(r, substr(s, a, i))\n    return r\n\ndef __m_join(sep, xs) -> str:\n    if __tag(xs) != 0 and __tag(xs) != 9:\n        xs = __iter(xs, 0)\n    n: int = __ld(xs, 0)\n    if n == 0:\n        return \"\"\n    parts = list(2 * n - 1)\n    pd = __ld(parts, 2)\n    i: int = 0\n    while i < n:\n        if i > 0:\n            __st(pd, 2 * i - 1, sep)\n        __st(pd, 2 * i, __str(__lst(xs, i)))\n        i += 1\n    return join(parts, 2 * n - 1)\n\ndef replace(s, a, b) -> str:\n    return __m_join(b, split(s, a))\n\ndef __mapcase(s, lo: int, hi: int, d: int) -> str:\n    n: int = __aux(s)\n    r = substr(s, 0, n)\n    i: int = 0\n    while i < n:\n        c: int = char_at(r, i)\n        if c >= lo and c <= hi:\n            set_byte(r, i, c + d)\n        i += 1\n    return r\n\ndef upper(s) -> str:\n    return __mapcase(s, 97, 122, -32)\n\ndef lower(s) -> str:\n    return __mapcase(s, 65, 90, 32)\n\ndef isdigit(s) -> bool:\n    n: int = __aux(s)\n    i: int = 0\n    while i < n:\n        c: int = char_at(s, i)\n        if c < 48 or c > 57:\n            return False\n        i += 1\n    return n > 0\n\ndef isalpha(s) -> bool:\n    n: int = __aux(s)\n    i: int = 0\n    while i < n:\n        c: int = char_at(s, i) | 32\n        if c < 97 or c > 122:\n            return False\n        i += 1\n    return n > 0\n\ndef int(x) -> int:\n    t: int = __tag(x)\n    if t == 12:\n        __iovf(0)\n    if t == 6:\n        v: int = x\n        return v & 1\n    if t == 5:\n        f: int = __ftoi(x, 0)\n        if (f >> 2) == 1152921504606846976:\n            __iovf(0)\n        return f\n    if t != 1:\n        return x\n    s = strip(x)\n    n: int = __aux(s)\n    i: int = 0\n    neg: int = 0\n    if n > 0 and char_at(s, 0) == 45:\n        neg = 1\n        i = 1\n    v: int = 0\n    if i >= n:\n        __err(0, concat(\"invalid literal for int(): \", __repr(x)))\n    while i < n:\n        c: int = char_at(s, i) - 48\n        if c < 0 or c > 9:\n            __err(0, concat(\"invalid literal for int(): \", __repr(x)))\n        if v < -922337203685477580 or (v == -922337203685477580 and c > 8):\n            __iovf(0)\n        v = v * 10 - c\n        i += 1\n    if neg:\n        return v\n    if v == -9223372036854775807 - 1:\n        __iovf(0)\n    v = 0 - v\n    if (v >> 2) == 1152921504606846976:\n    # 2**62 .. 2**62+3 alias the bool/None encodings\n        __iovf(0)\n    return v\n\n# ---- numbers and lists ----\ndef abs(x):\n    t: int = __tag(x)\n    if t == 5:\n        return __math(x, 10)\n    if t == 12:\n        return __bigmk(1, __lst(x, 1))\n    v: int = int(x)\n    if v < 0:\n        return 0 - v\n    return v\n\ndef min(a, b):\n    if __lt(b, a):\n        return b\n    return a\n\ndef max(a, b):\n    if __lt(a, b):\n        return b\n    return a\n\ndef min__1(xs, key=None):\n    xs = __iter(xs, 0)\n    if __ld(xs, 0) == 0:\n        raise ValueError(\"min() arg is an empty sequence\")\n    m = __lst(xs, 0)\n    if key is not None:\n        km = key(m)\n        for x in xs:\n            kx = key(x)\n            if __lt(kx, km):\n                m = x\n                km = kx\n        return m\n    for x in xs:\n        if __lt(x, m):\n            m = x\n    return m\n\ndef max__1(xs, key=None):\n    xs = __iter(xs, 0)\n    if __ld(xs, 0) == 0:\n        raise ValueError(\"max() arg is an empty sequence\")\n    m = __lst(xs, 0)\n    if key is not None:\n        km = key(m)\n        for x in xs:\n            kx = key(x)\n            if __lt(km, kx):\n                m = x\n                km = kx\n        return m\n    for x in xs:\n        if __lt(m, x):\n            m = x\n    return m\n\ndef sum(xs):\n    if __tag(xs) != 0 and __tag(xs) != 9:\n        xs = __iter(xs, 0)\n    s: int = 0\n    n: int = __ld(xs, 0)\n    d = __ld(xs, 2)\n    i: int = 0\n    while i < n:\n        v = __ld(d, i)\n        vi: int = v\n        t: int = s + vi\n        if __tag(v) >= 0 or (vi >= 0 and t < s) or (vi < 0 and t >= s):\n            acc = __add(s, 0, 0)\n            while i < n:\n                acc = acc + __ld(d, i)\n                i += 1\n            return acc\n        s = t\n        i += 1\n    return s\n\ndef __pow(a, b):\n    ta: int = __tag(a)\n    tb: int = __tag(b)\n    if ta == 12 and tb != 5:\n        return __bigpow(a, int(b))\n    if ta != 5 and tb != 5:\n        ia: int = int(a)\n        ib: int = int(b)\n        if ib >= 0:\n            if __powfits(ia, ib):\n                return __ipow(ia, ib)\n            return __bigpow(ia, ib)\n        return __itof(1) / __ipow(ia, 0 - ib)\n    if b == 2:\n        return a * a\n    if a == 0:\n        if b < 0:\n            __err(0, \"0.0 cannot be raised to a negative power\")\n        if b == 0:\n            return __itof(1)\n        return __itof(0)\n    if a > 0:\n        return __math2(b, a, 1)\n    if __math(b, 1) != b:\n        __err(0, \"negative number cannot be raised to a fractional power\")\n    r = __math2(b, 0 - a, 1)\n    if __math(b / 2, 1) != b / 2:\n        return 0 - r\n    return r\n\ndef __ipow(a: int, b: int) -> int:\n    if b > 2 or a > 3037000499 or a < -3037000499:\n        if not __powfits(a, b):\n            __iovf(0)\n    r: int = 1\n    while b > 0:\n        if b & 1:\n            r = r * a\n        b = b >> 1\n        if b > 0:\n            a = a * a\n    return r\n\ndef __powfits(a: int, b: int) -> int:\n    if a < 0:\n        a = 0 - a\n    if a <= 1:\n        return 1\n    k: int = 0\n    while a > 0:\n        k += 1\n        a = a >> 1\n    return k * b <= 62\n\ndef __msort(d, t, lo: int, hi: int):\n    if hi - lo < 2:\n        return 0\n    mid: int = (lo + hi) // 2\n    __msort(d, t, lo, mid)\n    __msort(d, t, mid, hi)\n    i: int = lo\n    j: int = mid\n    k: int = lo\n    while k < hi:\n        if j >= hi or (i < mid and not __lt(__ld(d, j), __ld(d, i))):\n            __st(t, k, __ld(d, i))\n            i += 1\n        else:\n            __st(t, k, __ld(d, j))\n            j += 1\n        k += 1\n    __copy(d + lo * 8, t + lo * 8, (hi - lo) * 8)\n    return 0\n\ndef sort(xs, key=None, reverse=False):\n    n: int = __ld(xs, 0)\n    if key is None and not reverse:\n        __msort(__ld(xs, 2), __new(n * 8 + 8, 4, n * 8), 0, n)\n        return None\n    ps = []\n    i: int = 0\n    while i < n:\n        x = __ld(__ld(xs, 2), i)\n        k = x\n        if key is not None:\n            k = key(x)\n        if reverse:\n            append(ps, [k, 0 - i, x])\n        else:\n            append(ps, [k, i, x])\n        i += 1\n    __msort(__ld(ps, 2), __new(n * 8 + 8, 4, n * 8), 0, n)\n    i = 0\n    while i < n:\n        j: int = i\n        if reverse:\n            j = n - 1 - i\n        __st(__ld(xs, 2), i, ps[j][2])\n        i += 1\n    return None\n\ndef sorted(xs, key=None, reverse=False):\n    r = __listof(xs)\n    sort(r, key, reverse)\n    return r\n\ndef map(f, xs):\n    r = []\n    for x in xs:\n        append(r, f(x))\n    return r\n\ndef filter(f, xs):\n    r = []\n    for x in xs:\n        if f is None:\n            if x:\n                append(r, x)\n        elif f(x):\n            append(r, x)\n    return r\n\ndef __fv_str(x):\n    return str(x)\n\ndef __fv_len(x):\n    return len(x)\n\ndef __fv_chr(x):\n    return chr(x)\n\ndef reverse(xs):\n    d = __ld(xs, 2)\n    i: int = 0\n    j: int = __ld(xs, 0) - 1\n    while i < j:\n        t = __ld(d, i)\n        __st(d, i, __ld(d, j))\n        __st(d, j, t)\n        i += 1\n        j -= 1\n    return 0\n\ndef extend(xs, ys):\n    for y in ys:\n        append(xs, y)\n    return 0\n\ndef range(n: int):\n    return range__3(0, n, 1)\n\ndef range__2(a: int, b: int):\n    return range__3(a, b, 1)\n\ndef range__3(a: int, b: int, s: int):\n    if s == 0:\n        __err(0, \"range() step must not be zero\")\n    r = []\n    i: int = a\n    if s > 0:\n        while i < b:\n            append(r, i)\n            i += s\n    else:\n        while i > b:\n            append(r, i)\n            i += s\n    return r\n\n# ---- helpers the code generator calls ----\ndef __truth(x) -> int:\n    t: int = __tag(x)\n    if t < 0:\n        v: int = x\n        return v != 0\n    if t == 6:\n        w: int = x\n        return w & 1\n    if t == 7:\n        return 0\n    if t == 5:\n        return (__fbits(x) << 1) != 0\n    if t == 1:\n        return __aux(x) != 0\n    if t == 0 or t == 3 or t == 9 or t == 10:\n        return __ld(x, 0) != 0\n    return 1\n\ndef __cmp(a, b) -> int:\n    if __lt(a, b):\n        return -1\n    if __lt(b, a):\n        return 1\n    return 0\n\ndef __strmul(s, k: int) -> str:\n    if k <= 0:\n        return \"\"\n    parts = list(k)\n    d = __ld(parts, 2)\n    i: int = 0\n    while i < k:\n        __st(d, i, s)\n        i += 1\n    return join(parts, k)\n\ndef __listof(x):\n    if __tag(x) < 0:\n        n: int = x\n        return list(n)\n    it = __iter(x, 0)\n    r = __slice(it, 0, __ld(it, 0), 0)\n    set_byte(r, -1, 0)\n    return r\n\ndef get__2(d, k):\n    return get(d, k, None)\n\ndef count(xs, x) -> int:\n    c: int = 0\n    if __tag(xs) == 1:\n        m: int = __aux(x)\n        if m == 0:\n            return __aux(xs) + 1\n        i: int = __find(xs, x, 0)\n        while i >= 0:\n            c += 1\n            i = __find(xs, x, i + m)\n        return c\n    for y in xs:\n        if __eq(y, x):\n            c += 1\n    return c\n\ndef index(xs, x) -> int:\n    i: int = 0\n    if __tag(xs) == 1:\n        i = __find(xs, x, 0)\n        if i < 0:\n            raise ValueError(\"substring not found\")\n        return i\n    for y in xs:\n        if __eq(y, x):\n            return i\n        i += 1\n    __err(0, \"value not in list\")\n\n# ---- float formatting: exact decimal conversion via bignums ----\ndef __bn_shr(a, k: int):\n    w: int = k >> 5\n    b: int = k & 31\n    n: int = len(a)\n    r = []\n    i: int = w\n    while i < n:\n        x: int = a[i]\n        t: int = x >> b\n        if i + 1 < n and b > 0:\n            y: int = a[i + 1]\n            t = t | ((y << (32 - b)) & 4294967295)\n        append(r, t)\n        i += 1\n    return __bn_norm(r)\n\ndef __bn_divs(a, d: int):\n    n: int = len(a)\n    q = __list_mul([0], n)\n    r: int = 0\n    i: int = n - 1\n    while i >= 0:\n        x: int = a[i]\n        cur: int = (r << 32) | x\n        q[i] = cur // d\n        r = cur % d\n        i -= 1\n    return [__bn_norm(q), r]\n\ndef __bn_divmod(a, b):\n    if __bn_cmp(a, b) < 0:\n        return [[], a]\n    if len(b) == 1:\n        y: int = b[0]\n        if y < 2147483648:\n            qr = __bn_divs(a, y)\n            return [qr[0], __bn(qr[1])]\n    nbits: int = __bn_bitlen(a)\n    r = []\n    q = __list_mul([0], len(a))\n    i: int = nbits - 1\n    while i >= 0:\n        r = __bn_shl(r, 1)\n        x: int = a[i >> 5]\n        if (x >> (i & 31)) & 1:\n            if len(r) == 0:\n                r = [1]\n            else:\n                z: int = r[0]\n                r[0] = z | 1\n        if __bn_cmp(r, b) >= 0:\n            r = __bn_sub(r, b)\n            w: int = q[i >> 5]\n            q[i >> 5] = w | (1 << (i & 31))\n        i -= 1\n    return [__bn_norm(q), r]\n\ndef __bn_str(a) -> str:\n    if len(a) == 0:\n        return \"0\"\n    parts = []\n    while len(a) > 0:\n        qr = __bn_divs(a, 1000000000)\n        a = qr[0]\n        s: str = __itos(qr[1])\n        if len(a) > 0:\n            s = concat(__strmul(\"0\", 9 - len(s)), s)\n        append(parts, s)\n    out: str = \"\"\n    i: int = len(parts) - 1\n    while i >= 0:\n        out = concat(out, parts[i])\n        i -= 1\n    return out\n\ndef __fscaled(x, k: int):\n# round-half-even of |x| * 10**k as a bignum\n    bits: int = __fbits(x)\n    er: int = (bits >> 52) & 2047\n    m: int = bits & 4503599627370495\n    e: int = -1074\n    if er > 0:\n        m = m | 4503599627370496\n        e = er - 1075\n    num = __bn(m)\n    den = [1]\n    if e >= 0:\n        num = __bn_shl(num, e)\n    else:\n        den = __bn_shl(den, 0 - e)\n    if k >= 0:\n        num = __bn_mulpow(num, k)\n    else:\n        den = __bn_mulpow(den, 0 - k)\n    if len(num) == 0:\n        return []\n    if e < 0 and k >= 0:\n        q = __bn_shr(num, 0 - e)\n        r = __bn_sub(num, __bn_shl(q, 0 - e))\n    else:\n        qr = __bn_divmod(num, den)\n        q = qr[0]\n        r = qr[1]\n    c: int = __bn_cmp(__bn_shl(r, 1), den)\n    if len(r) == 0:\n        c = -1\n    if c > 0 or (c == 0 and len(q) > 0 and (__lst(q, 0) & 1)):\n        q = __bn_add(q, [1])\n    return q\n\ndef __fspecial(x) -> int:\n    return ((__fbits(x) >> 52) & 2047) == 2047\n\ndef __ffix(x, p: int) -> str:\n    if __fspecial(x):\n        return __frepr(__math(x, 10))\n    d: str = __bn_str(__fscaled(x, p))\n    if p == 0:\n        return d\n    if len(d) <= p:\n        d = concat(__strmul(\"0\", p + 1 - len(d)), d)\n    n: int = len(d)\n    return concat(concat(substr(d, 0, n - p), \".\"), substr(d, n - p, n))\n\ndef __fexpd(x, p: int):\n# [digits (p+1 of them), exponent]\n    if __fbits(x) << 1 == 0:\n        return [__strmul(\"0\", p + 1), 0]\n    ex: int = __ftoi(__math(__math(__math(x, 10), 9), 1), 0)\n    while True:\n        q: str = __bn_str(__fscaled(x, p - ex))\n        if len(q) > p + 1:\n            ex += 1\n        elif len(q) < p + 1:\n            ex -= 1\n        else:\n            return [q, ex]\n\ndef __fexp(x, p: int, alt: int, up: int) -> str:\n    if __fspecial(x):\n        return __frepr(__math(x, 10))\n    de = __fexpd(x, p)\n    q: str = de[0]\n    ex: int = de[1]\n    s: str = substr(q, 0, 1)\n    if p > 0 or alt:\n        s = concat(concat(s, \".\"), substr(q, 1, len(q)))\n    return concat(s, __fexps(ex, up))\n\ndef __fexps(ex: int, up: int) -> str:\n    s: str = \"e\"\n    if up:\n        s = \"E\"\n    if ex < 0:\n        s = concat(s, \"-\")\n        ex = 0 - ex\n    else:\n        s = concat(s, \"+\")\n    if ex < 10:\n        s = concat(s, \"0\")\n    return concat(s, __itos(ex))\n\ndef __strip0(s: str) -> str:\n    if __find(s, \".\", 0) < 0:\n        return s\n    n: int = len(s)\n    while n > 0 and char_at(s, n - 1) == 48:\n        n -= 1\n    if n > 0 and char_at(s, n - 1) == 46:\n        n -= 1\n    return substr(s, 0, n)\n\ndef __fgen(x, p: int, alt: int, up: int) -> str:\n    if __fspecial(x):\n        return __frepr(__math(x, 10))\n    if p == 0:\n        p = 1\n    de = __fexpd(x, p - 1)\n    ex: int = de[1]\n    if ex >= -4 and ex < p:\n        s: str = __ffix(x, p - 1 - ex)\n        if alt:\n            return s\n        return __strip0(s)\n    q: str = de[0]\n    m: str = substr(q, 0, 1)\n    if len(q) > 1:\n        m = concat(concat(m, \".\"), substr(q, 1, len(q)))\n    if not alt:\n        m = __strip0(m)\n    return concat(m, __fexps(ex, up))\n\ndef round(x):\n    if __tag(x) == 5:\n        return __ftoi(x, 2)\n    return int(x)\n\ndef round__2(x, n: int):\n    if __tag(x) == 5:\n        if __fspecial(x) or n > 300:\n            return x\n        if n < -308:\n            return __ffrombits(__fbits(x) & (1 << 63))\n        neg: int = __fbits(x) < 0\n        s: str = \"0\"\n        if n >= 0:\n            s = __ffix(x, n)\n        else:\n            s = concat(__bn_str(__fscaled(x, n)), __strmul(\"0\", 0 - n))\n        v = __fparse(s, 0)\n        if neg:\n            return __neg(v)\n        return v\n    v: int = int(x)\n    if n >= 0:\n        return v\n    p: int = __ipow(10, 0 - n)\n    r: int = v % p\n    b: int = v - r\n    if r * 2 > p or (r * 2 == p and (b // p) % 2 == 1):\n        b += p\n    return b\n\ndef __grp(s: str, sep: str) -> str:\n    n: int = len(s)\n    out: str = \"\"\n    i: int = 0\n    while i < n:\n        if i > 0 and (n - i) % 3 == 0:\n            out = concat(out, sep)\n        out = concat(out, substr(s, i, i + 1))\n        i += 1\n    return out\n\ndef __radix(v: int, b: int, up: int) -> str:\n    if v == 0:\n        return \"0\"\n    dg: str = \"0123456789abcdef\"\n    if up:\n        dg = \"0123456789ABCDEF\"\n    s: str = \"\"\n    while v > 0:\n        s = concat(substr(dg, v % b, v % b + 1), s)\n        v = v // b\n    return s\n\ndef __isdig(c: int) -> int:\n    return c >= 48 and c <= 57\n\ndef format(x):\n    return __str(x)\n\ndef format__2(x, spec):\n    return __format(x, spec)\n\ndef __format(x, spec) -> str:\n    n: int = len(spec)\n    if n == 0:\n        return __str(x)\n    fill: str = \" \"\n    align: int = 0\n    sign: int = 45\n    alt: int = 0\n    width: int = 0\n    grp: str = \"\"\n    prec: int = -1\n    typ: int = 0\n    i: int = 0\n    if n >= 2 and __find(\"<>^=\", substr(spec, 1, 2), 0) >= 0:\n        fill = substr(spec, 0, 1)\n        align = char_at(spec, 1)\n        i = 2\n    elif __find(\"<>^=\", substr(spec, 0, 1), 0) >= 0:\n        align = char_at(spec, 0)\n        i = 1\n    if i < n and (char_at(spec, i) == 43 or char_at(spec, i) == 45 or char_at(spec, i) == 32):\n        sign = char_at(spec, i)\n        i += 1\n    if i < n and char_at(spec, i) == 35:\n        alt = 1\n        i += 1\n    if i < n and char_at(spec, i) == 48:\n        if align == 0:\n            fill = \"0\"\n            align = 61\n        i += 1\n    while i < n and __isdig(char_at(spec, i)):\n        width = width * 10 + char_at(spec, i) - 48\n        i += 1\n    if i < n and (char_at(spec, i) == 44 or char_at(spec, i) == 95):\n        grp = substr(spec, i, i + 1)\n        i += 1\n    if i < n and char_at(spec, i) == 46:\n        i += 1\n        prec = 0\n        while i < n and __isdig(char_at(spec, i)):\n            prec = prec * 10 + char_at(spec, i) - 48\n            i += 1\n    if i < n:\n        typ = char_at(spec, i)\n    t: int = __tag(x)\n    neg: int = 0\n    body: str = \"\"\n    numeric: int = 1\n    if t == 1 or (typ == 0 and t != 5 and t >= 0) or typ == 115:\n        numeric = 0\n        body = __str(x)\n        if prec >= 0:\n            body = substr(body, 0, prec)\n    elif t == 5 or typ == 102 or typ == 70 or typ == 101 or typ == 69 or typ == 103 or typ == 71 or typ == 37:\n        f = float(x)\n        neg = __fbits(f) < 0\n        a = __math(f, 10)\n        if typ == 102 or typ == 70:\n            if prec < 0:\n                prec = 6\n            body = __ffix(a, prec)\n            if alt and prec == 0:\n                body = concat(body, \".\")\n        elif typ == 101 or typ == 69:\n            if prec < 0:\n                prec = 6\n            body = __fexp(a, prec, alt, typ == 69)\n        elif typ == 37:\n            if prec < 0:\n                prec = 6\n            body = concat(__ffix(a * 100.0, prec), \"%\")\n        elif typ == 103 or typ == 71:\n            if prec < 0:\n                prec = 6\n            body = __fgen(a, prec, alt, typ == 71)\n        elif prec >= 0:\n            body = __fgen(a, prec, alt, 0)\n            if __find(body, \".\", 0) < 0 and __find(body, \"e\", 0) < 0 and __find(body, \"n\", 0) < 0:\n                body = concat(body, \".0\")\n        else:\n            body = __frepr(a)\n        if typ == 70 or typ == 69 or typ == 71:\n            body = upper(body)\n        if grp != \"\":\n            k: int = __find(body, \".\", 0)\n            if k < 0:\n                k = __find(body, \"e\", 0)\n            if k < 0:\n                k = len(body)\n            if __isdig(char_at(body, 0)):\n                body = concat(__grp(substr(body, 0, k), grp), substr(body, k, len(body)))\n    else:\n        v: int = int(x)\n        if v < 0:\n            neg = 1\n            v = 0 - v\n        if typ == 120 or typ == 88:\n            body = __radix(v, 16, typ == 88)\n            if alt:\n                body = concat(concat(\"0\", substr(spec, n - 1, n)), body)\n        elif typ == 111:\n            body = __radix(v, 8, 0)\n            if alt:\n                body = concat(\"0o\", body)\n        elif typ == 98:\n            body = __radix(v, 2, 0)\n            if alt:\n                body = concat(\"0b\", body)\n        elif typ == 99:\n            body = chr(v)\n        else:\n            body = __itos(v)\n            if grp != \"\":\n                body = __grp(body, grp)\n    pre: str = \"\"\n    if numeric:\n        if neg:\n            pre = \"-\"\n        elif sign == 43:\n            pre = \"+\"\n        elif sign == 32:\n            pre = \" \"\n    if align == 0:\n        align = 60\n        if numeric:\n            align = 62\n    pad: int = width - len(pre) - len(body)\n    if pad <= 0:\n        return concat(pre, body)\n    if align == 60:\n        return concat(concat(pre, body), __strmul(fill, pad))\n    if align == 62:\n        return concat(__strmul(fill, pad), concat(pre, body))\n    if align == 94:\n        return concat(concat(__strmul(fill, pad // 2), concat(pre, body)), __strmul(fill, pad - pad // 2))\n    return concat(concat(pre, __strmul(fill, pad)), body)\n\ndef __pctfmt(s, args, line) -> str:\n    if __tag(args) != 9 and __tag(args) != 0:\n        args = [args]\n    out: str = \"\"\n    n: int = len(s)\n    i: int = 0\n    j: int = 0\n    while i < n:\n        c: int = char_at(s, i)\n        if c != 37:\n            k: int = __find(s, \"%\", i)\n            if k < 0:\n                k = n\n            out = concat(out, substr(s, i, k))\n            i = k\n            continue\n        i += 1\n        if i < n and char_at(s, i) == 37:\n            out = concat(out, \"%\")\n            i += 1\n            continue\n        st: int = i\n        while i < n and __find(\"-+ #0123456789.\", substr(s, i, i + 1), 0) >= 0:\n            i += 1\n        fl: str = substr(s, st, i)\n        ty: int = char_at(s, i)\n        i += 1\n        if j >= len(args):\n            __err(line, \"not enough arguments for format string\")\n        a = args[j]\n        j += 1\n        if __find(fl, \"-\", 0) >= 0:\n            fl = concat(\"<\", replace(fl, \"-\", \"\"))\n        if ty == 115:\n            out = concat(out, __format(__str(a), fl))\n        elif ty == 114:\n            out = concat(out, __format(__repr(a), fl))\n        elif ty == 100 or ty == 105 or ty == 117:\n            out = concat(out, __format(int(a), concat(fl, \"d\")))\n        else:\n            out = concat(out, __format(a, concat(fl, chr(ty))))\n    if j < len(args):\n        __err(line, \"not all arguments converted during string formatting\")\n    return out\n\n# ---- math module (math.f / from math import f map to __math_f) ----\ndef __fl(x):\n    if __tag(x) == 5:\n        return x\n    return float(x)\n\ndef __math_sqrt(x):\n    f = __fl(x)\n    if f < 0.0:\n        raise ValueError(\"math domain error\")\n    return __math(f, 0)\n\ndef __math_floor(x) -> int:\n    if __tag(x) != 5:\n        return int(x)\n    return __ftoi(x, 1)\n\ndef __math_ceil(x) -> int:\n    if __tag(x) != 5:\n        return int(x)\n    return 0 - __ftoi(__neg(x), 1)\n\ndef __math_trunc(x) -> int:\n    return int(x)\n\ndef __math_sin(x):\n    return __math(__fl(x), 2)\n\ndef __math_cos(x):\n    return __math(__fl(x), 3)\n\ndef __math_tan(x):\n    return __math(__fl(x), 4)\n\ndef __math_atan(x):\n    return __math(__fl(x), 5)\n\ndef __math_atan2(y, x):\n    return __math2(__fl(y), __fl(x), 0)\n\ndef __math_exp(x):\n    return __math(__fl(x), 6)\n\ndef __math_log(x):\n    f = __fl(x)\n    if f <= 0.0:\n        raise ValueError(\"math domain error\")\n    return __math(f, 7)\n\ndef __math_log__2(x, b):\n    return __math_log(x) / __math_log(b)\n\ndef __math_log2(x):\n    f = __fl(x)\n    if f <= 0.0:\n        raise ValueError(\"math domain error\")\n    return __math(f, 8)\n\ndef __math_log10(x):\n    f = __fl(x)\n    if f <= 0.0:\n        raise ValueError(\"math domain error\")\n    return __math(f, 9)\n\ndef __math_fabs(x):\n    return __math(__fl(x), 10)\n\ndef __math_pow(x, y):\n    return __fl(__pow(__fl(x), __fl(y)))\n\ndef __math_hypot(x, y):\n    a = __fl(x)\n    b = __fl(y)\n    return __math(a * a + b * b, 0)\n\ndef __math_isnan(x) -> bool:\n    f = __fl(x)\n    return f != f\n\ndef __math_isinf(x) -> bool:\n    return __fspecial(__fl(x)) and (__fbits(__fl(x)) & 4503599627370495) == 0\n\ndef __math_isfinite(x) -> bool:\n    return not __fspecial(__fl(x))\n\ndef __math_nan():\n    return __ffrombits(9221120237041090560)\n\ndef __math_gcd(a: int, b: int) -> int:\n    if a < 0:\n        a = 0 - a\n    if b < 0:\n        b = 0 - b\n    while b != 0:\n        t: int = a % b\n        a = b\n        b = t\n    return a\n\ndef bool(x) -> bool:\n    return __truth(x) != 0\n\ndef hash(x) -> int:\n    return __hash(x)\n\n# ---- iteration protocol, generators ----\nclass generator:\n    def __init__(self, f):\n        h = __new(80, 4, 80)\n        i: int = 0\n        while i < 10:\n            __st(h, i, 0)\n            i += 1\n        __st(h, 0, f)\n        __st(h, 1, __new(65536, 4, 65536))\n        self.h = h\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        return __gnext(self.h, None)\n\n    def send(self, v):\n        return __gnext(self.h, v)\n\n    def close(self):\n        __st(self.h, 3, 3)\n        __st(self.h, 1, 0)\n        return None\n\ndef __mkgen(f):\n    g = generator(f)\n    if __tag(f) == 99:\n        __gstart(g)\n    return g\n\ndef __gstart(h):\n    r = None\n    try:\n        f = __ld(h, 0)\n        r = f()\n    except:\n        __st(h, 4, __excval())\n        __st(h, 9, __excline())\n        __gfin(None, 4)\n    __gfin(r, 3)\n\ndef __gnext(h, v):\n    s: int = __ld(h, 3)\n    if s >= 3:\n        raise StopIteration()\n    if s == 2:\n        raise ValueError(\"generator already executing\")\n    r = __gresume(h, v)\n    s = __ld(h, 3)\n    if s == 3:\n        __st(h, 1, 0)\n        raise StopIteration()\n    if s == 4:\n        __st(h, 1, 0)\n        __st(h, 3, 3)\n        __raise(__ld(h, 4), __ld(h, 9))\n    return r\n\ndef __yfrom(it):\n    for x in it:\n        __gyield(x)\n    return None\n\nclass __listiter:\n    def __init__(self, xs):\n        self.xs = xs\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        i: int = self.i\n        if i >= len(self.xs):\n            raise StopIteration()\n        self.i = i + 1\n        return self.xs[i]\n\ndef iter(x):\n    if __tag(x) == 2:\n        return x.__iter__()\n    return __listiter(__iter(x, 0))\n\ndef next__1(it):\n    if isinstance(it, generator):\n        return __gnext(it.h, None)\n    return it.__next__()\n\ndef next__2(it, dflt):\n    try:\n        return next__1(it)\n    except StopIteration:\n        return dflt\n\ndef __forit(x, line):\n    if __tag(x) == 2:\n        b = [None, x.__iter__()]\n        __st(b, 0, 0)\n        set_byte(b, -1, 11)\n        return b\n    return __iter(x, line)\n\ndef __inext(b) -> int:\n    if __tag(b) != 11:\n        return 0\n    d = __ld(b, 2)\n    it = __ld(d, 1)\n    r = None\n    if isinstance(it, generator):\n        h = it.h\n        s: int = __ld(h, 3)\n        if s >= 3:\n            return 0\n        r = __gresume(h, None)\n        s = __ld(h, 3)\n        if s == 3:\n            __st(h, 1, 0)\n            return 0\n        if s == 4:\n            __st(h, 1, 0)\n            __st(h, 3, 3)\n            __raise(__ld(h, 4), __ld(h, 9))\n    else:\n        try:\n            r = it.__next__()\n        except StopIteration:\n            return 0\n    __st(d, 0, r)\n    __st(b, 0, 1)\n    return 1\n\ndef __drain(x):\n    b = __forit(x, 0)\n    r = []\n    while __inext(b):\n        append(r, __lst(b, 0))\n    return r\n\n# ---- files ----\nclass OSError(Exception):\n    pass\nclass FileNotFoundError(OSError):\n    pass\n\nclass __File:\n    def __init__(self, path, mode):\n        self.path = path\n        self.mode = mode\n        self.data = \"\"\n        self.pos = 0\n        self.parts = []\n        self.closed = False\n        self.w = __find(mode, \"w\", 0) >= 0 or __find(mode, \"a\", 0) >= 0\n\n    def read(self, n=-1):\n        p: int = self.pos\n        m: int = __aux(self.data)\n        if n < 0 or p + n > m:\n            n = m - p\n        self.pos = p + n\n        return substr(self.data, p, p + n)\n\n    def readline(self):\n        p: int = self.pos\n        m: int = __aux(self.data)\n        q: int = __find(self.data, \"\\n\", p)\n        if q < 0:\n            q = m\n        else:\n            q += 1\n        self.pos = q\n        return substr(self.data, p, q)\n\n    def readlines(self):\n        r = []\n        while self.pos < __aux(self.data):\n            append(r, self.readline())\n        return r\n\n    def write(self, s):\n        append(self.parts, s)\n        return len(s)\n\n    def writelines(self, xs):\n        for s in xs:\n            append(self.parts, s)\n        return None\n\n    def flush(self):\n        return None\n\n    def close(self):\n        if not self.closed and self.w:\n            if not write_file(self.path, join(self.parts, len(self.parts))):\n                raise OSError(concat(\"cannot write \", self.path))\n        self.closed = True\n        return None\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        if self.pos >= __aux(self.data):\n            raise StopIteration()\n        return self.readline()\n\n    def __enter__(self):\n        return self\n\n    def __exit__(self, t, v, tb):\n        self.close()\n        return False\n\ndef open(path, mode=\"r\", encoding=None):\n    f = __File(path, mode)\n    if __find(mode, \"w\", 0) >= 0:\n        return f\n    if __syscall(21, path, 4, 0) != 0:\n        if __find(mode, \"a\", 0) >= 0:\n            return f\n        raise FileNotFoundError(concat(\"No such file or directory: \", __repr(path)))\n    s = read_file(path)\n    if __find(mode, \"a\", 0) >= 0:\n        append(f.parts, s)\n    else:\n        f.data = s\n    return f\n\n# ---- sys / os / time ----\nclass __Stream:\n    def __init__(self, fd):\n        self.fd = fd\n\n    def write(self, s):\n        if self.fd == 2:\n            __flushout()\n            __syscall(1, 2, s, __aux(s))\n        else:\n            __writes(s)\n        return len(s)\n\n    def flush(self):\n        return None\n\n    def read(self, n=-1):\n        parts = []\n        buf = alloc(65536)\n        while True:\n            n: int = __syscall(0, 0, buf, 65536)\n            if n <= 0:\n                break\n            append(parts, substr(buf, 0, n))\n        return join(parts, len(parts))\n\n    def readline(self):\n    # unbuffered so that no state is needed; the kernel keeps the position\n        parts = []\n        buf = alloc(8)\n        while True:\n            n: int = __syscall(0, 0, buf, 1)\n            if n <= 0:\n                break\n            c = substr(buf, 0, 1)\n            append(parts, c)\n            if char_at(buf, 0) == 10:\n                break\n        return join(parts, len(parts))\n\n    def readlines(self):\n        r = []\n        while True:\n            l = self.readline()\n            if __aux(l) == 0:\n                return r\n            append(r, l)\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        l = self.readline()\n        if __aux(l) == 0:\n            raise StopIteration()\n        return l\n\ndef __sys_stdout():\n    return __Stream(1)\n\ndef __sys_stderr():\n    return __Stream(2)\n\ndef __sys_stdin():\n    return __Stream(0)\n\ndef __sys_argv():\n    return __mkargv()\n\ndef __flushout():\n    __flush()\n\ndef __mkargv():\n    r = []\n    i: int = 0\n    while i < argc():\n        append(r, argv(i))\n        i += 1\n    return r\n\ndef __sys_exit(code=0):\n    if __tag(code) == 1:\n        eputs(code)\n        exit(1)\n    if code is None:\n        exit(0)\n    exit(code)\n\ndef __sys_setrecursionlimit(n):\n    return None\n\ndef __sys_getrecursionlimit():\n    return 1000\n\ndef __os_getenv(name, dflt=None):\n    i: int = 0\n    while True:\n        e = __env(i)\n        if __tag(e) != 1:\n            return dflt\n        if startswith(e, name) and char_at(e, __aux(name)) == 61:\n            return substr(e, __aux(name) + 1, __aux(e))\n        i += 1\n\ndef __os_path_exists(p) -> bool:\n    return __syscall(21, p, 0, 0) == 0\n\ndef __os_path_join(a, b):\n    if startswith(b, \"/\"):\n        return b\n    if __aux(a) == 0 or endswith(a, \"/\"):\n        return concat(a, b)\n    return concat(concat(a, \"/\"), b)\n\ndef __os_path_basename(p):\n    i: int = rfind(p, \"/\")\n    return substr(p, i + 1, __aux(p))\n\ndef __os_path_dirname(p):\n    i: int = rfind(p, \"/\")\n    if i < 0:\n        return \"\"\n    if i == 0:\n        return \"/\"\n    return substr(p, 0, i)\n\ndef __os_remove(p):\n    if __syscall(87, p, 0, 0) != 0:\n        raise FileNotFoundError(concat(\"No such file or directory: \", __repr(p)))\n    return None\n\ndef __os_getcwd():\n    buf = alloc(4096)\n    n: int = __syscall(79, buf, 4096, 0)\n    if n <= 0:\n        return \".\"\n    return substr(buf, 0, __find(buf, chr(0), 0))\n\n# ---- directories and processes (raw Linux syscalls; Python os-module names) ----\n# os.listdir returns names in kernel order without \".\" and \"..\": sort the result for stable output.\ndef __os_oserr(r, what, p):\n    if r == -2:\n        raise FileNotFoundError(concat(concat(what, \": No such file or directory: \"), __repr(p)))\n    raise OSError(concat(concat(concat(what, \": errno \"), str(0 - r)), concat(\": \", __repr(p))))\n\ndef __os_listdir(p=\".\"):\n    fd: int = __syscall(2, p, 0x90000, 0)\n    if fd < 0:\n        __os_oserr(fd, \"listdir\", p)\n    out = []\n    buf = alloc(8192)\n    while True:\n        n: int = __syscall(217, fd, buf, 8192)\n        if n < 0:\n            __syscall(3, fd, 0, 0)\n            __os_oserr(n, \"listdir\", p)\n        if n == 0:\n            break\n        i: int = 0\n        while i < n:\n            rl: int = char_at(buf, i + 16) + char_at(buf, i + 17) * 256\n            nm = substr(buf, i + 19, __find(buf, chr(0), i + 19))\n            if not str_eq(nm, \".\") and not str_eq(nm, \"..\"):\n                append(out, nm)\n            i += rl\n    __syscall(3, fd, 0, 0)\n    return out\n\ndef __os_path_isdir(p) -> bool:\n    fd: int = __syscall(2, p, 0x90000, 0)\n    if fd < 0:\n        return False\n    __syscall(3, fd, 0, 0)\n    return True\n\ndef __os_path_isfile(p) -> bool:\n    return __syscall(21, p, 0, 0) == 0 and not __os_path_isdir(p)\n\ndef __os_mkdir(p, mode=511):\n    r: int = __syscall(83, p, mode, 0)\n    if r < 0:\n        __os_oserr(r, \"mkdir\", p)\n    return None\n\ndef __os_chmod(p, mode):\n    r: int = __syscall(90, p, mode, 0)\n    if r < 0:\n        __os_oserr(r, \"chmod\", p)\n    return None\n\ndef __os_chdir(p):\n    r: int = __syscall(80, p, 0, 0)\n    if r < 0:\n        __os_oserr(r, \"chdir\", p)\n    return None\n\ndef __os_getpid() -> int:\n    return __syscall(39, 0, 0, 0)\n\ndef __os_fork() -> int:\n    __flushout()\n    r: int = __syscall(57, 0, 0, 0)\n    if r < 0:\n        __os_oserr(r, \"fork\", \"\")\n    return r\n\ndef __os_pipe():\n    fds = __new(8, 4, 8)\n    r: int = __syscall(293, fds, 0x80000, 0)\n    if r < 0:\n        __os_oserr(r, \"pipe\", \"\")\n    w: int = __ld(fds, 0)\n    return [w & 0xffffffff, w >> 32]\n\ndef __os_dup2(a, b) -> int:\n    return __syscall(33, a, b, 0)\n\ndef __os_close(fd):\n    __syscall(3, fd, 0, 0)\n    return None\n\ndef __os_read(fd, n):\n    buf = alloc(n)\n    r: int = __syscall(0, fd, buf, n)\n    if r < 0:\n        __os_oserr(r, \"read\", \"\")\n    return substr(buf, 0, r)\n\ndef __os_write(fd, s) -> int:\n    return __syscall(1, fd, s, __aux(s))\n\ndef __os__exit(n):\n    __syscall(60, n, 0, 0)\n    return None\n\ndef __os_cvec(xs):\n# NUL-terminated char* vector for execve (strings are already NUL-terminated)\n    n: int = len(xs)\n    v = __new(n * 8 + 8, 4, n * 8 + 8)\n    i: int = 0\n    while i < n:\n        __st(v, i, xs[i])\n        i += 1\n    return v\n\ndef __os_environ_vec():\n    xs = []\n    i: int = 0\n    while True:\n        e = __env(i)\n        if __tag(e) != 1:\n            return __os_cvec(xs)\n        append(xs, e)\n        i += 1\n\ndef __os_execv(path, args):\n# path containing no \"/\" is searched in $PATH like execvp\n    env = __os_environ_vec()\n    av = __os_cvec(args)\n    if __find(path, \"/\", 0) >= 0:\n        r: int = __syscall(59, path, av, env)\n        __os_oserr(r, \"execv\", path)\n    for d in split(__os_getenv(\"PATH\", \"/usr/bin:/bin\"), \":\"):\n        __syscall(59, __os_path_join(d, path), av, env)\n    __os_oserr(-2, \"execv\", path)\n    return None\n\ndef __os_waitpid(pid, opts=0):\n    st = __new(8, 4, 8)\n    r: int = __syscall(61, pid, st, opts)\n    if r < 0:\n        __os_oserr(r, \"waitpid\", \"\")\n    return [r, __ld(st, 0) & 0xffffffff]\n\ndef __os_waitstatus_to_exitcode(st) -> int:\n    if (st & 0x7f) == 0:\n        return (st >> 8) & 0xff\n    return 0 - (st & 0x7f)\n\ndef __os_drain(fd):\n    parts = []\n    while True:\n        s = __os_read(fd, 65536)\n        if __aux(s) == 0:\n            break\n        append(parts, s)\n    __syscall(3, fd, 0, 0)\n    return \"\".join(parts)\n\ndef __os_run(args, cwd=None, merge=False, timeout=0):\n# Forge extension (no Python equivalent): run argv, return [exit code, stdout, stderr]; stdin is /dev/null.\n# timeout=N (whole seconds) arms alarm(N) in the child (it survives execve); a child killed by that\n# SIGALRM reports 124 like timeout(1).\n# merge=True sends stderr into stdout. stderr is drained after stdout, so a child writing >64 KiB to\n# stderr before closing stdout can stall; tools that need that use merge=True.\n    po = __os_pipe()\n    pe = __os_pipe()\n    pid: int = __os_fork()\n    if pid == 0:\n        nul: int = __syscall(2, \"/dev/null\", 0, 0)\n        __syscall(33, nul, 0, 0)\n        __syscall(33, po[1], 1, 0)\n        if merge:\n            __syscall(33, po[1], 2, 0)\n        else:\n            __syscall(33, pe[1], 2, 0)\n        if cwd is not None:\n            if __syscall(80, cwd, 0, 0) < 0:\n                __syscall(60, 126, 0, 0)\n        if timeout > 0:\n            __syscall(37, timeout, 0, 0)\n        try:\n            __os_execv(args[0], args)\n        except OSError:\n            pass\n        __syscall(60, 127, 0, 0)\n    __syscall(3, po[1], 0, 0)\n    __syscall(3, pe[1], 0, 0)\n    out = __os_drain(po[0])\n    err = __os_drain(pe[0])\n    w = __os_waitpid(pid)\n    rc: int = __os_waitstatus_to_exitcode(w[1])\n    if timeout > 0 and rc == -14:\n        rc = 124\n    return [rc, out, err]\n\ndef __time_time():\n    return __clock(0) / 1000000000\n\ndef __time_time_ns() -> int:\n    return __clock(0)\n\ndef __time_perf_counter():\n    return __clock(1) / 1000000000\n\ndef __time_perf_counter_ns() -> int:\n    return __clock(1)\n\ndef __time_monotonic():\n    return __clock(1) / 1000000000\n\ndef __time_sleep(s):\n    ns: int = int(s * 1000000000)\n    ts = __new(16, 4, 16)\n    __st(ts, 0, ns // 1000000000)\n    __st(ts, 1, ns % 1000000000)\n    __syscall(35, ts, 0, 0)\n    return None\n\ndef __exctype():\n    return __excval()\n\ndef dict(xs=None):\n    r = __dict()\n    if xs is None:\n        return r\n    if __tag(xs) == 3:\n        for k in __ld(xs, 5):\n            __dset(r, k, xs[k])\n        return r\n    for p in xs:\n        __dset(r, p[0], p[1])\n    return r\n\ndef zip__2(a, b):\n    a = __iter(a, 0)\n    b = __iter(b, 0)\n    n: int = min(len(a), len(b))\n    r = list(n)\n    i: int = 0\n    while i < n:\n        r[i] = (a[i], b[i])\n        i += 1\n    return r\n\ndef zip__3(a, b, c):\n    a = __iter(a, 0)\n    b = __iter(b, 0)\n    c = __iter(c, 0)\n    n: int = min(min(len(a), len(b)), len(c))\n    r = list(n)\n    i: int = 0\n    while i < n:\n        r[i] = (a[i], b[i], c[i])\n        i += 1\n    return r\n\ndef enumerate__1(xs):\n    return enumerate__2(xs, 0)\n\ndef enumerate__2(xs, start):\n    xs = __iter(xs, 0)\n    n: int = len(xs)\n    r = list(n)\n    i: int = 0\n    while i < n:\n        r[i] = (i + start, xs[i])\n        i += 1\n    return r\n\ndef reversed(xs):\n    xs = __iter(xs, 0)\n    n: int = len(xs)\n    r = list(n)\n    i: int = 0\n    while i < n:\n        r[i] = xs[n - 1 - i]\n        i += 1\n    return r\n\ndef any(xs) -> bool:\n    for x in xs:\n        if x:\n            return True\n    return False\n\ndef all(xs) -> bool:\n    for x in xs:\n        if not x:\n            return False\n    return True\n\ndef divmod(a, b):\n    return (a // b, a % b)\n\ndef __radixp(x, base: int, pre):\n    if x < 0:\n        return concat(concat(\"-\", pre), __radix(-x, base, 0))\n    return concat(pre, __radix(x, base, 0))\n\ndef hex(x):\n    return __radixp(x, 16, \"0x\")\n\ndef bin(x):\n    return __radixp(x, 2, \"0b\")\n\ndef oct(x):\n    return __radixp(x, 8, \"0o\")\n\ndef pow__2(a, b):\n    return a ** b\n\ndef pow__3(a, b, m):\n    r = 1\n    a = a % m\n    while b > 0:\n        if b & 1:\n            r = r * a % m\n        a = a * a % m\n        b = b >> 1\n    return r\n\ndef input__0():\n    return input__1(\"\")\n\ndef input__1(prompt):\n    if __aux(prompt) > 0:\n        __writes(prompt)\n    __flush()\n    l = __Stream(0).readline()\n    if endswith(l, \"\\n\"):\n        return substr(l, 0, __aux(l) - 1)\n    if __aux(l) == 0:\n        raise EOFError(\"EOF when reading a line\")\n    return l\n\nclass EOFError(Exception):\n    pass\n"

