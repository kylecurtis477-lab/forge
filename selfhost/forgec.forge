return None\n    for k in __ld(o, 5):\n        __dset(d, k, __dget(o, k, 0))\n    return None\n\ndef setdefault(d, k, v=None):\n    i: int = __dfind(d, k, __hash(k))\n    if __ld(__ld(d, 2), i) != 0:\n        return __ld(__ld(d, 4), i)\n    __dset(d, k, v)\n    return v\n\ndef pop__2(d, k):\n    if __tag(d) == 0:\n        n: int = __ld(d, 0)\n        j: int = k\n        if j < 0:\n            j = j + n\n        if j < 0 or j >= n:\n            raise IndexError(\"pop index out of range\")\n        v = __lst(d, j)\n        __delidx(d, j, 0)\n        return v\n    i: int = __dfind(d, k, __hash(k))\n    if __ld(__ld(d, 2), i) == 0:\n        raise KeyError(k)\n    v = __ld(__ld(d, 4), i)\n    __ddel(d, k, 0)\n    return v\n\ndef pop__3(d, k, dflt):\n    i: int = __dfind(d, k, __hash(k))\n    if __ld(__ld(d, 2), i) == 0:\n        return dflt\n    v = __ld(__ld(d, 4), i)\n    __ddel(d, k, 0)\n    return v\n\n# ---- sets: dicts tagged 10 whose values are unused ----\ndef set(xs=None):\n    r = __dict()\n    set_byte(r, -1, 10)\n    if xs is not None:\n        for x in __iter(xs, 0):\n            __dset(r, x, 1)\n    return r\n\ndef frozenset(xs=None):\n    return set(xs)\n\ndef add(s, x):\n    __dset(s, x, 1)\n    return None\n\ndef discard(s, x):\n    __ddel(s, x, 0)\n    return None\n\ndef remove(s, x):\n    if __tag(s) == 0:\n        n: int = __ld(s, 0)\n        i: int = 0\n        while i < n:\n            if __eq(__lst(s, i), x):\n                __delidx(s, i, 0)\n                return None\n            i += 1\n        raise ValueError(\"list.remove(x): x not in list\")\n    if not __ddel(s, x, 0):\n        raise KeyError(x)\n    return None\n\ndef __sop(a, b, op: int):\n    # 0 & 1 | 2 ^ 3 -\n    r = set()\n    if op == 1:\n        for x in __ld(a, 5):\n            __dset(r, x, 1)\n        for x in __iter(b, 0):\n            __dset(r, x, 1)\n    elif op == 0:\n        for x in __ld(a, 5):\n            if __contains(b, x):\n                __dset(r, x, 1)\n    elif op == 3:\n        for x in __ld(a, 5):\n            if not __contains(b, x):\n                __dset(r, x, 1)\n    else:\n        for x in __ld(a, 5):\n            if not __contains(b, x):\n                __dset(r, x, 1)\n        for x in __iter(b, 0):\n            if not __contains(a, x):\n                __dset(r, x, 1)\n    return r\n\ndef union(a, b):\n    return __sop(a, set(b), 1)\n\ndef intersection(a, b):\n    return __sop(a, set(b), 0)\n\ndef difference(a, b):\n    return __sop(a, set(b), 3)\n\ndef symmetric_difference(a, b):\n    return __sop(a, set(b), 2)\n\ndef issubset(a, b) -> bool:\n    for x in __ld(a, 5):\n        if not __contains(b, x):\n            return False\n    return True\n\ndef issuperset(a, b) -> bool:\n    for x in __iter(b, 0):\n        if not __contains(a, x):\n            return False\n    return True\n\ndef isdisjoint(a, b) -> bool:\n    for x in __iter(b, 0):\n        if __contains(a, x):\n            return False\n    return True\n\ndef __bitop(a, b, op: int):\n    ta: int = __tag(a)\n    tb: int = __tag(b)\n    if ta == 10 and tb == 10:\n        return __sop(a, b, op)\n    if ta == 3 and tb == 3 and op == 1:\n        r = copy(a)\n        update(r, b)\n        return r\n    if ta == 6 and tb == 6:\n        x: int = int(a)\n        y: int = int(b)\n        if op == 0:\n            return bool(x & y)\n        if op == 1:\n            return bool(x | y)\n        return bool(x ^ y)\n    if (ta < 0 or ta == 6) and (tb < 0 or tb == 6):\n        x: int = int(a)\n        y: int = int(b)\n        if op == 0:\n            return x & y\n        if op == 1:\n            return x | y\n        return x ^ y\n    names = [\"&\", \"|\", \"^\"]\n    raise TypeError(concat(\"unsupported operand type(s) for \", __lst(names, op)))\n\ndef keys(d):\n    return __slice(__ld(d, 5), 0, __ld(__ld(d, 5), 0), 0)\n\ndef values(d):\n    ks = __ld(d, 5)\n    n: int = __ld(ks, 0)\n    r = list(n)\n    i: int = 0\n    while i < n:\n        __st(__ld(r, 2), i, __dget(d, __lst(ks, i), 0))\n        i += 1\n    return r\n\ndef items(d):\n    ks = __ld(d, 5)\n    n: int = __ld(ks, 0)\n    r = list(n)\n    i: int = 0\n    while i < n:\n        k = __lst(ks, i)\n        __st(__ld(r, 2), i, __tup([k, __dget(d, k, 0)]))\n        i += 1\n    return r\n\n# ---- strings ----\ndef __find(s, sub, start: int) -> int:\n    n: int = __aux(s)\n    m: int = __aux(sub)\n    i: int = start\n    while i + m <= n:\n        j: int = 0\n        while j < m and char_at(s, i + j) == char_at(sub, j):\n            j += 1\n        if j == m:\n            return i\n        i += 1\n    return -1\n\ndef find(s, sub, start=0) -> int:\n    if start < 0:\n        start = start + __aux(s)\n        if start < 0:\n            start = 0\n    return __find(s, sub, start)\n\ndef rfind(s, sub) -> int:\n    n: int = __aux(s)\n    m: int = __aux(sub)\n    i: int = n - m\n    while i >= 0:\n        j: int = 0\n        while j < m and char_at(s, i + j) == char_at(sub, j):\n            j += 1\n        if j == m:\n            return i\n        i -= 1\n    return -1\n\ndef rindex(s, sub) -> int:\n    i: int = rfind(s, sub)\n    if i < 0:\n        raise ValueError(\"substring not found\")\n    return i\n\ndef partition(s, sep):\n    i: int = __find(s, sep, 0)\n    if i < 0:\n        return __tup([s, \"\", \"\"])\n    return __tup([substr(s, 0, i), sep, substr(s, i + __aux(sep), __aux(s))])\n\ndef rpartition(s, sep):\n    i: int = rfind(s, sep)\n    if i < 0:\n        return __tup([\"\", \"\", s])\n    return __tup([substr(s, 0, i), sep, substr(s, i + __aux(sep), __aux(s))])\n\ndef __pad(s, w: int, fill, mode: int) -> str:\n    n: int = __aux(s)\n    if w <= n:\n        return s\n    k: int = w - n\n    if mode == 0:\n        return concat(s, __strmul(fill, k))\n    if mode == 1:\n        return concat(__strmul(fill, k), s)\n    left: int = k // 2\n    if k % 2 == 1 and w % 2 == 1:\n        left += 1\n    return concat(concat(__strmul(fill, left), s), __strmul(fill, k - left))\n\ndef ljust(s, w, fill=\" \") -> str:\n    return __pad(s, w, fill, 0)\n\ndef rjust(s, w, fill=\" \") -> str:\n    return __pad(s, w, fill, 1)\n\ndef center(s, w, fill=\" \") -> str:\n    return __pad(s, w, fill, 2)\n\ndef zfill(s, w) -> str:\n    n: int = __aux(s)\n    if w <= n:\n        return s\n    if n > 0 and (char_at(s, 0) == 45 or char_at(s, 0) == 43):\n        return concat(concat(substr(s, 0, 1), __strmul(\"0\", w - n)), substr(s, 1, n))\n    return concat(__strmul(\"0\", w - n), s)\n\ndef __isup(c: int) -> int:\n    return c >= 65 and c <= 90\n\ndef __islo(c: int) -> int:\n    return c >= 97 and c <= 122\n\ndef __chcase(s, mode: int) -> str:\n    # 0 title, 1 capitalize, 2 swapcase\n    n: int = __aux(s)\n    r = substr(s, 0, n)\n    prev: int = 0\n    i: int = 0\n    while i < n:\n        c: int = char_at(r, i)\n        up: int = 0\n        lo: int = 0\n        if mode == 0:\n            up = not prev\n            lo = prev\n        elif mode == 1:\n            up = i == 0\n            lo = i > 0\n        else:\n            up = __islo(c)\n            lo = __isup(c)\n        if up and __islo(c):\n            set_byte(r, i, c - 32)\n        elif lo and __isup(c):\n            set_byte(r, i, c + 32)\n        prev = __isup(c) or __islo(c)\n        i += 1\n    return r\n\ndef title(s) -> str:\n    return __chcase(s, 0)\n\ndef capitalize(s) -> str:\n    return __chcase(s, 1)\n\ndef swapcase(s) -> str:\n    return __chcase(s, 2)\n\ndef __allc(s, k: int) -> int:\n    n: int = __aux(s)\n    if n == 0:\n        return 0\n    cased: int = 0\n    i: int = 0\n    while i < n:\n        c: int = char_at(s, i)\n        if k == 0:\n            if not (__isup(c) or __islo(c) or (c >= 48 and c <= 57)):\n                return 0\n        elif k == 1:\n            if not (__isspace(c) or c == 11 or c == 12):\n                return 0\n        elif k == 2:\n            if __islo(c):\n                return 0\n            if __isup(c):\n                cased = 1\n        else:\n            if __isup(c):\n                return 0\n            if __islo(c):\n                cased = 1\n        i += 1\n    if k >= 2:\n        return cased\n    return 1\n\ndef isalnum(s) -> bool:\n    return __allc(s, 0) == 1\n\ndef isspace(s) -> bool:\n    return __allc(s, 1) == 1\n\ndef isupper(s) -> bool:\n    return __allc(s, 2) == 1\n\ndef islower(s) -> bool:\n    return __allc(s, 3) == 1\n\ndef removeprefix(s, p) -> str:\n    if startswith(s, p):\n        return substr(s, __aux(p), __aux(s))\n    return s\n\ndef removesuffix(s, p) -> str:\n    if __aux(p) > 0 and endswith(s, p):\n        return substr(s, 0, __aux(s) - __aux(p))\n    return s\n\ndef splitlines(s):\n    r = []\n    n: int = __aux(s)\n    a: int = 0\n    i: int = 0\n    while i < n:\n        c: int = char_at(s, i)\n        if c == 10 or c == 13:\n            append(r, substr(s, a, i))\n            if c == 13 and i + 1 < n and char_at(s, i + 1) == 10:\n                i += 1\n            a = i + 1\n        i += 1\n    if a < n:\n        append(r, substr(s, a, n))\n    return r\n\ndef rsplit(s, sep=None, maxsplit=-1):\n    if sep is None:\n        return split__1(s)\n    parts = split(s, sep)\n    k: int = len(parts) - 1 - maxsplit\n    if maxsplit < 0 or k <= 0:\n        return parts\n    head = __m_join(sep, __slice(parts, 0, k + 1, 0))\n    r = [head]\n    extend(r, __slice(parts, k + 1, len(parts), 0))\n    return r\n\ndef __sfmt(s, args) -> str:\n    # str.format: args = [key-or-0, value, ...]\n    pos = []\n    kw = {}\n    i: int = 0\n    while i < len(args):\n        k = args[i]\n        if __tag(k) == 1:\n            kw[k] = args[i + 1]\n        else:\n            append(pos, args[i + 1])\n        i += 2\n    out = []\n    n: int = __aux(s)\n    auto: int = 0\n    i = 0\n    a: int = 0\n    while i < n:\n        c: int = char_at(s, i)\n        if c == 123 or c == 125:\n            if i + 1 < n and char_at(s, i + 1) == c:\n                append(out, substr(s, a, i + 1))\n                i += 2\n                a = i\n                continue\n            if c == 125:\n                raise ValueError(\"Single '}' encountered in format string\")\n            append(out, substr(s, a, i))\n            j: int = __find(s, \"}\", i)\n            if j < 0:\n                raise ValueError(\"Single '{' encountered in format string\")\n            field = substr(s, i + 1, j)\n            spec = \"\"\n            conv: int = 0\n            ci: int = __find(field, \":\", 0)\n            if ci >= 0:\n                spec = substr(field, ci + 1, __aux(field))\n                field = substr(field, 0, ci)\n            bi: int = __find(field, \"!\", 0)\n            if bi >= 0:\n                conv = char_at(field, bi + 1)\n                field = substr(field, 0, bi)\n            v = None\n            if __aux(field) == 0:\n                v = pos[auto]\n                auto += 1\n            elif isdigit(field):\n                v = pos[int(field)]\n            else:\n                v = kw[field]\n            if conv == 114:\n                v = repr(v)\n            elif conv == 115:\n                v = __str(v)\n            append(out, __format(v, spec))\n            i = j + 1\n            a = i\n        else:\n            i += 1\n    append(out, substr(s, a, n))\n    return __m_join(\"\", out)\n\ndef startswith(s, p) -> bool:\n    m: int = __aux(p)\n    if m > __aux(s):\n        return False\n    i: int = 0\n    while i < m:\n        if char_at(s, i) != char_at(p, i):\n            return False\n        i += 1\n    return True\n\ndef endswith(s, p) -> bool:\n    m: int = __aux(p)\n    o: int = __aux(s) - m\n    if o < 0:\n        return False\n    i: int = 0\n    while i < m:\n        if char_at(s, o + i) != char_at(p, i):\n            return False\n        i += 1\n    return True\n\ndef __isspace(c: int) -> int:\n    return c == 32 or c == 10 or c == 9 or c == 13\n\ndef __instr(c: int, chars) -> int:\n    if chars is None:\n        return __isspace(c) or c == 11 or c == 12\n    n: int = __aux(chars)\n    i: int = 0\n    while i < n:\n        if char_at(chars, i) == c:\n            return 1\n        i += 1\n    return 0\n\ndef __strip(s, chars, mode: int) -> str:\n    a: int = 0\n    b: int = __aux(s)\n    if mode & 1:\n        while a < b and __instr(char_at(s, a), chars):\n            a += 1\n    if mode & 2:\n        while b > a and __instr(char_at(s, b - 1), chars):\n            b -= 1\n    return substr(s, a, b)\n\ndef strip(s, chars=None) -> str:\n    return __strip(s, chars, 3)\n\ndef lstrip(s, chars=None) -> str:\n    return __strip(s, chars, 1)\n\ndef rstrip(s, chars=None) -> str:\n    return __strip(s, chars, 2)\n\ndef split(s, sep):\n    r = []\n    n: int = __aux(s)\n    m: int = __aux(sep)\n    if m == 0:\n        __err(0, \"empty separator\")\n    a: int = 0\n    i: int = __find(s, sep, 0)\n    while i >= 0:\n        append(r, substr(s, a, i))\n        a = i + m\n        i = __find(s, sep, a)\n    append(r, substr(s, a, n))\n    return r\n\ndef split__1(s):\n    r = []\n    n: int = __aux(s)\n    i: int = 0\n    while i < n:\n        while i < n and __isspace(char_at(s, i)):\n            i += 1\n        if i >= n:\n            break\n        a: int = i\n        while i < n and not __isspace(char_at(s, i)):\n            i += 1\n        append(r, substr(s, a, i))\n    return r\n\ndef __m_join(sep, xs) -> str:\n    if __tag(xs) != 0 and __tag(xs) != 9:\n        xs = __iter(xs, 0)\n    n: int = __ld(xs, 0)\n    if n == 0:\n        return \"\"\n    parts = list(2 * n - 1)\n    pd = __ld(parts, 2)\n    i: int = 0\n    while i < n:\n        if i > 0:\n            __st(pd, 2 * i - 1, sep)\n        __st(pd, 2 * i, __str(__lst(xs, i)))\n        i += 1\n    return join(parts, 2 * n - 1)\n\ndef replace(s, a, b) -> str:\n    return __m_join(b, split(s, a))\n\ndef __mapcase(s, lo: int, hi: int, d: int) -> str:\n    n: int = __aux(s)\n    r = substr(s, 0, n)\n    i: int = 0\n    while i < n:\n        c: int = char_at(r, i)\n        if c >= lo and c <= hi:\n            set_byte(r, i, c + d)\n        i += 1\n    return r\n\ndef upper(s) -> str:\n    return __mapcase(s, 97, 122, -32)\n\ndef lower(s) -> str:\n    return __mapcase(s, 65, 90, 32)\n\ndef isdigit(s) -> bool:\n    n: int = __aux(s)\n    i: int = 0\n    while i < n:\n        c: int = char_at(s, i)\n        if c < 48 or c > 57:\n            return False\n        i += 1\n    return n > 0\n\ndef isalpha(s) -> bool:\n    n: int = __aux(s)\n    i: int = 0\n    while i < n:\n        c: int = char_at(s, i) | 32\n        if c < 97 or c > 122:\n            return False\n        i += 1\n    return n > 0\n\ndef int(x) -> int:\n    t: int = __tag(x)\n    if t == 12:\n        __iovf(0)\n    if t == 6:\n        v: int = x\n        return v & 1\n    if t == 5:\n        return __ftoi(x, 0)\n    if t != 1:\n        return x\n    s = strip(x)\n    n: int = __aux(s)\n    i: int = 0\n    neg: int = 0\n    if n > 0 and char_at(s, 0) == 45:\n        neg = 1\n        i = 1\n    v: int = 0\n    if i >= n:\n        __err(0, concat(\"invalid literal for int(): \", __repr(x)))\n    while i < n:\n        c: int = char_at(s, i) - 48\n        if c < 0 or c > 9:\n            __err(0, concat(\"invalid literal for int(): \", __repr(x)))\n        v = v * 10 + c\n        i += 1\n    if neg:\n        return 0 - v\n    return v\n\n# ---- numbers and lists ----\ndef abs(x):\n    t: int = __tag(x)\n    if t == 5:\n        return __math(x, 10)\n    if t == 12:\n        return __bigmk(1, __lst(x, 1))\n    v: int = int(x)\n    if v < 0:\n        return 0 - v\n    return v\n\ndef min(a, b):\n    if __lt(b, a):\n        return b\n    return a\n\ndef max(a, b):\n    if __lt(a, b):\n        return b\n    return a\n\ndef min__1(xs, key=None):\n    xs = __iter(xs, 0)\n    if __ld(xs, 0) == 0:\n        raise ValueError(\"min() arg is an empty sequence\")\n    m = __lst(xs, 0)\n    if key is not None:\n        km = key(m)\n        for x in xs:\n            kx = key(x)\n            if __lt(kx, km):\n                m = x\n                km = kx\n        return m\n    for x in xs:\n        if __lt(x, m):\n            m = x\n    return m\n\ndef max__1(xs, key=None):\n    xs = __iter(xs, 0)\n    if __ld(xs, 0) == 0:\n        raise ValueError(\"max() arg is an empty sequence\")\n    m = __lst(xs, 0)\n    if key is not None:\n        km = key(m)\n        for x in xs:\n            kx = key(x)\n            if __lt(km, kx):\n                m = x\n                km = kx\n        return m\n    for x in xs:\n        if __lt(m, x):\n            m = x\n    return m\n\ndef sum(xs):\n    if __tag(xs) != 0 and __tag(xs) != 9:\n        xs = __iter(xs, 0)\n    s: int = 0\n    n: int = __ld(xs, 0)\n    d = __ld(xs, 2)\n    i: int = 0\n    while i < n:\n        v = __ld(d, i)\n        vi: int = v\n        t: int = s + vi\n        if __tag(v) >= 0 or (vi >= 0 and t < s) or (vi < 0 and t >= s):\n            acc = __add(s, 0, 0)\n            while i < n:\n                acc = acc + __ld(d, i)\n                i += 1\n            return acc\n        s = t\n        i += 1\n    return s\n\ndef __pow(a, b):\n    ta: int = __tag(a)\n    tb: int = __tag(b)\n    if ta == 12 and tb != 5:\n        return __bigpow(a, int(b))\n    if ta != 5 and tb != 5:\n        ia: int = int(a)\n        ib: int = int(b)\n        if ib >= 0:\n            if __powfits(ia, ib):\n                return __ipow(ia, ib)\n            return __bigpow(ia, ib)\n        return __itof(1) / __ipow(ia, 0 - ib)\n    if a == 0:\n        if b < 0:\n            __err(0, \"0.0 cannot be raised to a negative power\")\n        if b == 0:\n            return __itof(1)\n        return __itof(0)\n    if a > 0:\n        return __math2(b, a, 1)\n    if __math(b, 1) != b:\n        __err(0, \"negative number cannot be raised to a fractional power\")\n    r = __math2(b, 0 - a, 1)\n    if __math(b / 2, 1) != b / 2:\n        return 0 - r\n    return r\n\ndef __ipow(a: int, b: int) -> int:\n    if b > 2 or a > 3037000499 or a < -3037000499:\n        if not __powfits(a, b):\n            __iovf(0)\n    r: int = 1\n    while b > 0:\n        if b & 1:\n            r = r * a\n        b = b >> 1\n        if b > 0:\n            a = a * a\n    return r\n\ndef __powfits(a: int, b: int) -> int:\n    if a < 0:\n        a = 0 - a\n    if a <= 1:\n        return 1\n    k: int = 0\n    while a > 0:\n        k += 1\n        a = a >> 1\n    return k * b <= 62\n\ndef __msort(d, t, lo: int, hi: int):\n    if hi - lo < 2:\n        return 0\n    mid: int = (lo + hi) // 2\n    __msort(d, t, lo, mid)\n    __msort(d, t, mid, hi)\n    i: int = lo\n    j: int = mid\n    k: int = lo\n    while k < hi:\n        if j >= hi or (i < mid and not __lt(__ld(d, j), __ld(d, i))):\n            __st(t, k, __ld(d, i))\n            i += 1\n        else:\n            __st(t, k, __ld(d, j))\n            j += 1\n        k += 1\n    __copy(d + lo * 8, t + lo * 8, (hi - lo) * 8)\n    return 0\n\ndef sort(xs, key=None, reverse=False):\n    n: int = __ld(xs, 0)\n    if key is None and not reverse:\n        __msort(__ld(xs, 2), __new(n * 8 + 8, 4, n * 8), 0, n)\n        return None\n    ps = []\n    i: int = 0\n    while i < n:\n        x = __ld(__ld(xs, 2), i)\n        k = x\n        if key is not None:\n            k = key(x)\n        if reverse:\n            append(ps, [k, 0 - i, x])\n        else:\n            append(ps, [k, i, x])\n        i += 1\n    __msort(__ld(ps, 2), __new(n * 8 + 8, 4, n * 8), 0, n)\n    i = 0\n    while i < n:\n        j: int = i\n        if reverse:\n            j = n - 1 - i\n        __st(__ld(xs, 2), i, ps[j][2])\n        i += 1\n    return None\n\ndef sorted(xs, key=None, reverse=False):\n    r = __listof(xs)\n    sort(r, key, reverse)\n    return r\n\ndef map(f, xs):\n    r = []\n    for x in xs:\n        append(r, f(x))\n    return r\n\ndef filter(f, xs):\n    r = []\n    for x in xs:\n        if f is None:\n            if x:\n                append(r, x)\n        elif f(x)