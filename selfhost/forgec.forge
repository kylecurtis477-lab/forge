       z: int = r[0]\n                r[0] = z | 1\n        if __bn_cmp(r, b) >= 0:\n            r = __bn_sub(r, b)\n            w: int = q[i >> 5]\n            q[i >> 5] = w | (1 << (i & 31))\n        i -= 1\n    return [__bn_norm(q), r]\n\ndef __bn_str(a) -> str:\n    if len(a) == 0:\n        return \"0\"\n    parts = []\n    while len(a) > 0:\n        qr = __bn_divs(a, 1000000000)\n        a = qr[0]\n        s: str = __itos(qr[1])\n        if len(a) > 0:\n            s = concat(__strmul(\"0\", 9 - len(s)), s)\n        append(parts, s)\n    out: str = \"\"\n    i: int = len(parts) - 1\n    while i >= 0:\n        out = concat(out, parts[i])\n        i -= 1\n    return out\n\ndef __fscaled(x, k: int):\n    # round-half-even of |x| * 10**k as a bignum\n    bits: int = __fbits(x)\n    er: int = (bits >> 52) & 2047\n    m: int = bits & 4503599627370495\n    e: int = -1074\n    if er > 0:\n        m = m | 4503599627370496\n        e = er - 1075\n    num = __bn(m)\n    den = [1]\n    if e >= 0:\n        num = __bn_shl(num, e)\n    else:\n        den = __bn_shl(den, 0 - e)\n    if k >= 0:\n        num = __bn_mulpow(num, k)\n    else:\n        den = __bn_mulpow(den, 0 - k)\n    if len(num) == 0:\n        return []\n    if e < 0 and k >= 0:\n        q = __bn_shr(num, 0 - e)\n        r = __bn_sub(num, __bn_shl(q, 0 - e))\n    else:\n        qr = __bn_divmod(num, den)\n        q = qr[0]\n        r = qr[1]\n    c: int = __bn_cmp(__bn_shl(r, 1), den)\n    if len(r) == 0:\n        c = -1\n    if c > 0 or (c == 0 and len(q) > 0 and (__lst(q, 0) & 1)):\n        q = __bn_add(q, [1])\n    return q\n\ndef __fspecial(x) -> int:\n    return ((__fbits(x) >> 52) & 2047) == 2047\n\ndef __ffix(x, p: int) -> str:\n    if __fspecial(x):\n        return __frepr(__math(x, 10))\n    d: str = __bn_str(__fscaled(x, p))\n    if p == 0:\n        return d\n    if len(d) <= p:\n        d = concat(__strmul(\"0\", p + 1 - len(d)), d)\n    n: int = len(d)\n    return concat(concat(substr(d, 0, n - p), \".\"), substr(d, n - p, n))\n\ndef __fexpd(x, p: int):\n    # [digits (p+1 of them), exponent]\n    if __fbits(x) << 1 == 0:\n        return [__strmul(\"0\", p + 1), 0]\n    ex: int = __ftoi(__math(__math(__math(x, 10), 9), 1), 0)\n    while True:\n        q: str = __bn_str(__fscaled(x, p - ex))\n        if len(q) > p + 1:\n            ex += 1\n        elif len(q) < p + 1:\n            ex -= 1\n        else:\n            return [q, ex]\n\ndef __fexp(x, p: int, alt: int, up: int) -> str:\n    if __fspecial(x):\n        return __frepr(__math(x, 10))\n    de = __fexpd(x, p)\n    q: str = de[0]\n    ex: int = de[1]\n    s: str = substr(q, 0, 1)\n    if p > 0 or alt:\n        s = concat(concat(s, \".\"), substr(q, 1, len(q)))\n    return concat(s, __fexps(ex, up))\n\ndef __fexps(ex: int, up: int) -> str:\n    s: str = \"e\"\n    if up:\n        s = \"E\"\n    if ex < 0:\n        s = concat(s, \"-\")\n        ex = 0 - ex\n    else:\n        s = concat(s, \"+\")\n    if ex < 10:\n        s = concat(s, \"0\")\n    return concat(s, __itos(ex))\n\ndef __strip0(s: str) -> str:\n    if __find(s, \".\", 0) < 0:\n        return s\n    n: int = len(s)\n    while n > 0 and char_at(s, n - 1) == 48:\n        n -= 1\n    if n > 0 and char_at(s, n - 1) == 46:\n        n -= 1\n    return substr(s, 0, n)\n\ndef __fgen(x, p: int, alt: int, up: int) -> str:\n    if __fspecial(x):\n        return __frepr(__math(x, 10))\n    if p == 0:\n        p = 1\n    de = __fexpd(x, p - 1)\n    ex: int = de[1]\n    if ex >= -4 and ex < p:\n        s: str = __ffix(x, p - 1 - ex)\n        if alt:\n            return s\n        return __strip0(s)\n    q: str = de[0]\n    m: str = substr(q, 0, 1)\n    if len(q) > 1:\n        m = concat(concat(m, \".\"), substr(q, 1, len(q)))\n    if not alt:\n        m = __strip0(m)\n    return concat(m, __fexps(ex, up))\n\ndef round(x):\n    if __tag(x) == 5:\n        return __ftoi(x, 2)\n    return int(x)\n\ndef round__2(x, n: int):\n    if __tag(x) == 5:\n        if __fs