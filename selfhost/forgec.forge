ec, i)\n        i += 1\n    if i < n and char_at(spec, i) == 35:\n        alt = 1\n        i += 1\n    if i < n and char_at(spec, i) == 48:\n        if align == 0:\n            fill = \"0\"\n            align = 61\n        i += 1\n    while i < n and __isdig(char_at(spec, i)):\n        width = width * 10 + char_at(spec, i) - 48\n        i += 1\n    if i < n and (char_at(spec, i) == 44 or char_at(spec, i) == 95):\n        grp = substr(spec, i, i + 1)\n        i += 1\n    if i < n and char_at(spec, i) == 46:\n        i += 1\n        prec = 0\n        while i < n and __isdig(char_at(spec, i)):\n            prec = prec * 10 + char_at(spec, i) - 48\n            i += 1\n    if i < n:\n        typ = char_at(spec, i)\n    t: int = __tag(x)\n    neg: int = 0\n    body: str = \"\"\n    numeric: int = 1\n    if t == 1 or (typ == 0 and t != 5 and t >= 0) or typ == 115:\n        numeric = 0\n        body = __str(x)\n        if prec >= 0:\n            body = substr(body, 0, prec)\n    elif t == 5 or typ == 102 or typ == 70 or typ == 101 or typ == 69 or typ == 103 or typ == 71 or typ == 37:\n        f = float(x)\n        neg = __fbits(f) < 0\n        a = __math(f, 10)\n        if typ == 102 or typ == 70:\n            if prec < 0:\n                prec = 6\n            body = __ffix(a, prec)\n            if alt and prec == 0:\n                body = concat(body, \".\")\n        elif typ == 101 or typ == 69:\n            if prec < 0:\n                prec = 6\n            body = __fexp(a, prec, alt, typ == 69)\n        elif typ == 37:\n            if prec < 0:\n                prec = 6\n            body = concat(__ffix(a * 100.0, prec), \"%\")\n        elif typ == 103 or typ == 71:\n            if prec < 0:\n                prec = 6\n            body = __fgen(a, prec, alt, typ == 71)\n        elif prec >= 0:\n            body = __fgen(a, prec, alt, 0)\n            if __find(body, \".\", 0) < 0 and __find(body, \"e\", 0) < 0 and __find(body, \"n\", 0) < 0:\n                body = concat(body, \".0\")\n        else:\n            body = __frepr(a)\n        if typ == 70 or typ == 69 or typ == 71:\n            body = upper(body)\n        if grp != \"\":\n            k: int = __find(body, \".\", 0)\n            if k < 0:\n                k = __find(body, \"e\", 0)\n            if k < 0:\n                k = len(body)\n            if __isdig(char_at(body, 0)):\n                body = concat(__grp(substr(body, 0, k), grp), substr(body, k, len(body)))\n    else:\n        v: int = int(x)\n        if v < 0:\n            neg = 1\n            v = 0 - v\n        if typ == 120 or typ == 88:\n            body = __radix(v, 16, typ == 88)\n            if alt:\n                body = concat(concat(\"0\", substr(spec, n - 1, n)), body)\n        elif typ == 111:\n            body = __radix(v, 8, 0)\n            if alt:\n                body = concat(\"0o\", body)\n        elif typ == 98:\n            body = __radix(v, 2, 0)\n            if alt:\n                body = concat(\"0b\", body)\n        elif typ == 99:\n            body = chr(v)\n        else:\n            body = __itos(v)\n            if grp != \"\":\n                body = __grp(body, grp)\n    pre: str = \"\"\n    if numeric:\n        if neg:\n            pre = \"-\"\n        elif sign == 43:\n            pre = \"+\"\n        elif sign == 32:\n            pre = \" \"\n    if align == 0:\n        align = 60\n        if numeric:\n            align = 62\n    pad: int = width - len(pre) - len(body)\n    if pad <= 0:\n        return concat(pre, body)\n    if align == 60:\n        return concat(concat(pre, body), __strmul(fill, pad))\n    if align == 62:\n        return concat(__strmul(fill, pad), concat(pre, body))\n    if align == 94:\n        return concat(concat(__strmul(fill, pad // 2), concat(pre, body)), __strmul(fill, pad - pad // 2))\n    return concat(concat(pre, __strmul(fill, pad)), body)\n\ndef __pctfmt(s, args, line) -> str:\n    if __tag(args) != 9 and __tag(args) != 0:\n        args = [args]\n    out: str = \"\"\n    n: int = len(s)\n    i: int = 0\n    j: int = 0\n    while i < n:\n        c: int = char_at(s, i)\n        if c != 37:\n            k: int = __find(s, \"%\", i)\n            if k < 0:\n                k = n\n            out = concat(out, substr(s, i, k))\n            i = k\n            continue\n        i += 1\n        if i < n and char_at(s, i) == 37:\n            out = concat(out, \"%\")\n            i += 1\n            continue\n        st: int = i\n        while i < n and __find(\"-+ #0123456789.\", substr(s, i, i + 1), 0) >= 0:\n            i += 1\n        fl: str = substr(s, st, i)\n        ty: int = char_at(s, i)\n        i += 1\n        if j >= len(args):\n            __err(line, \"not enough arguments for format string\")\n        a = args[j]\n        j += 1\n        if __find(fl, \"-\", 0) >= 0:\n            fl = concat(\"<\", replace(fl, \"-\", \"\"))\n        if ty == 115:\n            out = concat(out, __format(__str(a), fl))\n        elif ty == 114:\n            out = concat(out, __format(__repr(a), fl))\n        elif ty == 100 or ty == 105 or ty == 117:\n            out = concat(out, __format(int(a), concat(fl, \"d\")))\n        else:\n            out = concat(out, __format(a, concat(fl, chr(ty))))\n    if j < len(args):\n        __err(line, \"not all arguments converted during string formatting\")\n    return out\n\n# ---- math module (math.f / from math import f map to __math_f) ----\ndef __fl(x):\n    if __tag(x) == 5:\n        return x\n    return float(x)\n\ndef __math_sqrt(x):\n    f = __fl(x)\n    if f < 0.0:\n        raise ValueError(\"math domain error\")\n    return __math(f, 0)\n\ndef __math_floor(x) -> int:\n    if __tag(x) != 5:\n        return int(x)\n    return __ftoi(x, 1)\n\ndef __math_ceil(x) -> int:\n    if __tag(x) != 5:\n        return int(x)\n    return 0 - __ftoi(__neg(x), 1)\n\ndef __math_trunc(x) -> int:\n    return int(x)\n\ndef __math_sin(x):\n    return __math(__fl(x), 2)\n\ndef __math_cos(x):\n    return __math(__fl(x), 3)\n\ndef __math_tan(x):\n    return __math(__fl(x), 4)\n\ndef __math_atan(x):\n    return __math(__fl(x), 5)\n\ndef __math_atan2(y, x):\n    return __math2(__fl(y), __fl(x), 0)\n\ndef __math_exp(x):\n    return __math(__fl(x), 6)\n\ndef __math_log(x):\n    f = __fl(x)\n    if f <= 0.0:\n        raise ValueError(\"math domain error\")\n    return __math(f, 7)\n\ndef __math_log__2(x, b):\n    return __math_log(x) / __math_log(b)\n\ndef __math_log2(x):\n    f = __fl(x)\n    if f <= 0.0:\n        raise ValueError(\"math domain error\")\n    return __math(f, 8)\n\ndef __math_log10(x):\n    f = __fl(x)\n    if f <= 0.0:\n        raise ValueError(\"math domain error\")\n    return __math(f, 9)\n\ndef __math_fabs(x):\n    return __math(__fl(x), 10)\n\ndef __math_pow(x, y):\n    return __fl(__pow(__fl(x), __fl(y)))\n\ndef __math_hypot(x, y):\n    a = __fl(x)\n    b = __fl(y)\n    return __math(a * a + b * b, 0)\n\ndef __math_isnan(x) -> bool:\n    f = __fl(x)\n    return f != f\n\ndef __math_isinf(x) -> bool:\n    return __fspecial(__fl(x)) and (__fbits(__fl(x)) & 4503599627370495) == 0\n\ndef __math_isfinite(x) -> bool:\n    return not __fspecial(__fl(x))\n\ndef __math_nan():\n    return __ffrombits(9221120237041090560)\n\ndef __math_gcd(a: int, b: int) -> int:\n    if a < 0:\n        a = 0 - a\n    if b < 0:\n        b = 0 - b\n    while b != 0:\n        t: int = a % b\n        a = b\n        b = t\n    return a\n\ndef bool(x) -> bool:\n    return __truth(x) != 0\n\ndef hash(x) -> int:\n    return __hash(x)\n"

