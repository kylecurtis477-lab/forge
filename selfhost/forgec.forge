, den) -> int:\n    # correctly rounded double nearest num/den (both > 0)\n    e: int = __bn_bitlen(num) - __bn_bitlen(den) - 53\n    q: int = 0\n    rem = []\n    d2 = []\n    while True:\n        if e < -1074:\n            e = -1074\n        if e >= 0:\n            n2 = num\n            d2 = __bn_shl(den, e)\n        else:\n            n2 = __bn_shl(num, 0 - e)\n            d2 = den\n        q = 0\n        b: int = 56\n        while b >= 0:\n            t = __bn_shl(d2, b)\n            if __bn_cmp(n2, t) >= 0:\n                n2 = __bn_sub(n2, t)\n                q = q | (1 << b)\n            b -= 1\n        rem = n2\n        if q >= 9007199254740992:\n            e += 1\n        elif q < 4503599627370496 and e > -1074:\n            e -= 1\n        else:\n            break\n    c: int = __bn_cmp(__bn_shl(rem, 1), d2)\n    if c > 0 or (c == 0 and (q & 1) == 1):\n        q += 1\n        if q == 9007199254740992:\n            q = q >> 1\n            e += 1\n    if e + 1075 >= 2047:\n        return 9218868437227405312\n    return ((e + 1074) << 52) + q\n\ndef __fparse(s0, line):\n    s = lower(strip(s0))\n    n: int = len(s)\n    i: int = 0\n    neg: int = 0\n    if n > 0 and (char_at(s, 0) == 45 or char_at(s, 0) == 43):\n        neg = char_at(s, 0) == 45\n        i = 1\n    rest = substr(s, i, n)\n    bits: int = 0\n    if str_eq(rest, \"inf\") or str_eq(rest, \"infinity\"):\n        bits = 9218868437227405312\n    elif str_eq(rest, \"nan\"):\n        bits = 9221120237041090560\n    else:\n        mant = []\n        mi: int = 0\n        nd: int = 0\n        e10: int = 0\n        seen: int = 0\n        dot: int = 0\n        while i < n:\n            c: int = char_at(s, i)\n            if c >= 48 and c <= 57:\n                mant = __bn_add(__bn_muls(mant, 10), __bn(c - 48))\n                if len(mant) > 0:\n                    nd += 1\n                    if nd <= 18:\n                        mi = mi * 10 + c - 48\n                if dot:\n                    e10 