# Forge self-hosted compiler (written in Forge).
# forge: wrapping-ints  (this file relies on 64-bit wraparound, e.g. magic-number division)
# usage: forgec <input.forge> <output.s>
# Pipeline: lex (prelude + user source) -> prescan (classes, functions, globals) -> compile passes.
# Code is emitted as GNU as text. Each pass re-runs codegen with refined type facts
# (which variables / params / returns always hold ints) and register choices, until
# no assumption is contradicted. The final pass is the one written out.
# NOTE: this file must stay inside the subset the Rust bootstrap understands
# (no f-strings, dicts, string +, for-in-list, char literals; use ord("x")).

K_NUM = 1
K_STR = 2
K_ID = 3
K_OP = 4
K_NL = 5
K_IND = 6
K_DED = 7
K_EOF = 8
K_FLT = 9

T_INT = 1
T_FLOAT = 5
T_BOOL = 6
B_FALSE = "$4611686018427387904"
B_TRUE = "$4611686018427387905"
B_NONE = "$4611686018427387906"
T_STR = 2
T_LIST = 3
T_DICT = 4

MAXT = 3000000
tk = list(MAXT)
