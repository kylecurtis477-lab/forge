\n        if m == 0:\n            return __aux(xs) + 1\n        i: int = __find(xs, x, 0)\n        while i >= 0:\n            c += 1\n            i = __find(xs, x, i + m)\n        return c\n    for y in xs:\n        if __eq(y, x):\n            c += 1\n    return c\n\ndef index(xs, x) -> int:\n    i: int = 0\n    if __tag(xs) == 1:\n        i = __find(xs, x, 0)\n        if i < 0:\n            raise ValueError(\"substring not found\")\n        return i\n    for y in xs:\n        if __eq(y, x):\n            return i\n        i += 1\n    __err(0, \"value not in list\")\n\n# ---- float formatting: exact decimal conversion via bignums ----\ndef __bn_shr(a, k: int):\n    w: int = k >> 5\n    b: int = k & 31\n    n: int = len(a)\n    r = []\n    i: int = w\n    while i < n:\n        x: int = a[i]\n        t: int = x >> b\n        if i + 1 < n and b > 0:\n            y: int = a[i + 1]\n            t = t | ((y << (32 - b)) & 4294967295)\n        append(r, t)\n        i += 1\n    return __bn_norm(r)\n\ndef __bn_divs(a, d: int):\n    n: int = len(a)\n    q = __list_mul([0], n)\n    r: int = 0\n    i: int = n - 1\n    while i >= 0:\n        x: int = a[i]\n        cur: int = (r << 32) | x\n        q[i] = cur // d\n        r = cur % d\n        i -= 1\n    return [__bn_norm(q), r]\n\ndef __bn_divmod(a, b):\n    if __bn_cmp(a, b) < 0:\n        return [[], a]\n    if len(b) == 1:\n        y: int = b[0]\n        if y < 2147483648:\n            qr = __bn_divs(a, y)\n            return [qr[0], __bn(qr[1])]\n    nbits: int = __bn_bitlen(a)\n    r = []\n    q = __list_mul([0], len(a))\n    i: int = nbits - 1\n    while i >= 0:\n        r = __bn_shl(r, 1)\n        x: int = a[i >> 5]\n        if (x >> (i & 31)) & 1:\n            if len(r) == 0:\n                r = [1]\n            else:\n                z: int = r[0]\n                r[0] = z | 1\n        if __bn_cmp(r, b) >= 0:\n            r = __bn_sub(r, b)\n            w: int = q[i >> 5]\n            q[i >> 5] = w | (1 << (i & 31))\n        i -= 1\n    return [__bn_norm(q), r]\n\ndef __bn_str(a) -> str:\n    if len(a) == 0:\n        return \"0\"\n    parts = []\n    while len(a) > 0:\n        qr = __bn_divs(a, 1000000000)\n        a = qr[0]\n        s: str = __itos(qr[1])\n        if len(a) > 0:\n            s = concat(__strmul(\"0\", 9 - len(s)), s)\n        append(parts, s)\n    out: str = \"\"\n    i: int = len(parts) - 1\n    while i >= 0:\n        out = concat(out, parts[i])\n        i -= 1\n    return out\n\ndef __fscaled(x, k: int):\n    # round-half-even of |x| * 10**k as a bignum\n    bits: int = __fbits(x)\n    er: int = (bits >> 52) & 2047\n    m: int = bits & 4503599627370495\n    e: int = -1074\n    if er > 0:\n        m = m | 4503599627370496\n        e = er - 1075\n    num = __bn(m)\n    den = [1]\n    if e >= 0:\n        num = __bn_shl(num, e)\n    else:\n        den = __bn_shl(den, 0 - e)\n    if k >= 0:\n        num = __bn_mulpow(num, k)\n    else:\n        den = __bn_mulpow(den, 0 - k)\n    if len(num) == 0:\n        return []\n    if e < 0 and k >= 0:\n        q = __bn_shr(num, 0 - e)\n        r = __bn_sub(num, __bn_shl(q, 0 - e))\n    else:\n        qr = __bn_divmod(num, den)\n        q = qr[0]\n        r = qr[1]\n    c: int = __bn_cmp(__bn_shl(r, 1), den)\n    if len(r) == 0:\n        c = -1\n    if c > 0 or (c == 0 and len(q) > 0 and (__lst(q, 0) & 1)):\n        q = __bn_add(q, [1])\n    return q\n\ndef __fspecial(x) -> int:\n    return ((__fbits(x) >> 52) & 2047) == 2047\n\ndef __ffix(x, p: int) -> str:\n    if __fspecial(x):\n        return __frepr(__math(x, 10))\n    d: str = __bn_str(__fscaled(x, p))\n    if p == 0:\n        return d\n    if len(d) <= p:\n        d = concat(__strmul(\"0\", p + 1 - len(d)), d)\n    n: int = len(d)\n    return concat(concat(substr(d, 0, n - p), \".\"), substr(d, n - p, n))\n\ndef __fexpd(x, p: int):\n    # [digits (p+1 of them), exponent]\n    if __fbits(x) << 1 == 0:\n        return [__strmul(\"0\", p + 1), 0]\n    ex: int = __ftoi(__math(__math(__math(x, 10), 9), 1), 0)\n    while True:\n        q: str = __bn_str(__fscaled(x, p - ex))\n        if len(q) > p + 1:\n            ex += 1\n        elif len(q) < p + 1:\n            ex -= 1\n        else:\n            return [q, ex]\n\ndef __fexp(x, p: int, alt: int, up: int) -> str:\n    if __fspecial(x):\n        return __frepr(__math(x, 10))\n    de = __fexpd(x, p)\n    q: str = de[0]\n    ex: int = de[1]\n    s: str = substr(q, 0, 1)\n    if p > 0 or alt:\n        s = concat(concat(s, \".\"), substr(q, 1, len(q)))\n    return concat(s, __fexps(ex, up))\n\ndef __fexps(ex: int, up: int) -> str:\n    s: str = \"e\"\n    if up:\n        s = \"E\"\n    if ex < 0:\n        s = concat(s, \"-\")\n        ex = 0 - ex\n    else:\n        s = concat(s, \"+\")\n    if ex < 10:\n        s = concat(s, \"0\")\n    return concat(s, __itos(ex))\n\ndef __strip0(s: str) -> str:\n    if __find(s, \".\", 0) < 0:\n        return s\n    n: int = len(s)\n    while n > 0 and char_at(s, n - 1) == 48:\n        n -= 1\n    if n > 0 and char_at(s, n - 1) == 46:\n        n -= 1\n    return substr(s, 0, n)\n\ndef __fgen(x, p: int, alt: int, up: int) -> str:\n    if __fspecial(x):\n        return __frepr(__math(x, 10))\n    if p == 0:\n        p = 1\n    de = __fexpd(x, p - 1)\n    ex: int = de[1]\n    if ex >= -4 and ex < p:\n        s: str = __ffix(x, p - 1 - ex)\n        if alt:\n            return s\n        return __strip0(s)\n    q: str = de[0]\n    m: str = substr(q, 0, 1)\n    if len(q) > 1:\n        m = concat(concat(m, \".\"), substr(q, 1, len(q)))\n    if not alt:\n        m = __strip0(m)\n    return concat(m, __fexps(ex, up))\n\ndef round(x):\n    if __tag(x) == 5:\n        return __ftoi(x, 2)\n    return int(x)\n\ndef round__2(x, n: int):\n    if __tag(x) == 5:\n        if __fspecial(x) or n > 300:\n            return x\n        if n < -308:\n            return __ffrombits(__fbits(x) & (1 << 63))\n        neg: int = __fbits(x) < 0\n        s: str = \"0\"\n        if n >= 0:\n            s = __ffix(x, n)\n        else:\n            s = concat(__bn_str(__fscaled(x, n)), __strmul(\"0\", 0 - n))\n        v = __fparse(s, 0)\n        if neg:\n            return __neg(v)\n        return v\n    v: int = int(x)\n    if n >= 0:\n        return v\n    p: int = __ipow(10, 0 - n)\n    r: int = v % p\n    b: int = v - r\n    if r * 2 > p or (r * 2 == p and (b // p) % 2 == 1):\n        b += p\n    return b\n\ndef __grp(s: str, sep: str) -> str:\n    n: int = len(s)\n    out: str = \"\"\n    i: int = 0\n    while i < n:\n        if i > 0 and (n - i) % 3 == 0:\n            out = concat(out, sep)\n        out = concat(out, substr(s, i, i + 1))\n        i += 1\n    return out\n\ndef __radix(v: int, b: int, up: int) -> str:\n    if v == 0:\n        return \"0\"\n    dg: str = \"0123456789abcdef\"\n    if up:\n        dg = \"0123456789ABCDEF\"\n    s: str = \"\"\n    while v > 0:\n        s = concat(substr(dg, v % b, v % b + 1), s)\n        v = v // b\n    return s\n\ndef __isdig(c: int) -> int:\n    return c >= 48 and c <= 57\n\ndef format(x):\n    return __str(x)\n\ndef format__2(x, spec):\n    return __format(x, spec)\n\ndef __format(x, spec) -> str:\n    n: int = len(spec)\n    if n == 0:\n        return __str(x)\n    fill: str = \" \"\n    align: int = 0\n    sign: int = 45\n    alt: int = 0\n    width: int = 0\n    grp: str = \"\"\n    prec: int = -1\n    typ: int = 0\n    i: int = 0\n    if n >= 2 and __find(\"<>^=\", substr(spec, 1, 2), 0) >= 0:\n        fill = substr(spec, 0, 1)\n        align = char_at(spec, 1)\n        i = 2\n    elif __find(\"<>^=\", substr(spec, 0, 1), 0) >= 0:\n        align = char_at(spec, 0)\n        i = 1\n    if i < n and (char_at(spec, i) == 43 or char_at(spec, i) == 45 or char_at(spec, i) == 32):\n        sign = char_at(spec, i)\n        i += 1\n    if i < n and char_at(spec, i) == 35:\n        alt = 1\n        i += 1\n    if i < n and char_at(spec, i) == 48:\n        if align == 0:\n            fill = \"0\"\n            align = 61\n        i += 1\n    while i < n and __isdig(char_at(spec, i)):\n        width = width * 10 + char_at(spec, i) - 48\n        i += 1\n    if i < n and (char_at(spec, i) == 44 or char_at(spec, i) == 95):\n        grp = substr(spec, i, i + 1)\n        i += 1\n    if i < n and char_at(spec, i) == 46:\n        i += 1\n        prec = 0\n        while i < n and __isdig(char_at(spec, i)):\n            prec = prec * 10 + char_at(spec, i) - 48\n            i += 1\n    if i < n:\n        typ = char_at(spec, i)\n    t: int = __tag(x)\n    neg: int = 0\n    body: str = \"\"\n    numeric: int = 1\n    if t == 1 or (typ == 0 and t != 5 and t >= 0) or typ == 115:\n        numeric = 0\n        body = __str(x)\n        if prec >= 0:\n            body = substr(body, 0, prec)\n    elif t == 5 or typ == 102 or typ == 70 or typ == 101 or typ == 69 or typ == 103 or typ == 71 or typ == 37:\n        f = float(x)\n        neg = __fbits(f) < 0\n        a = __math(f, 10)\n        if typ == 102 or typ == 70:\n            if prec < 0:\n                prec = 6\n            body = __ffix(a, prec)\n            if alt and prec == 0:\n                body = concat(body, \".\")\n        elif typ == 101 or typ == 69:\n            if prec < 0:\n                prec = 6\n            body = __fexp(a, prec, alt, typ == 69)\n        elif typ == 37:\n            if prec < 0:\n                prec = 6\n            body = concat(__ffix(a * 100.0, prec), \"%\")\n        elif typ == 103 or typ == 71:\n            if prec < 0:\n                prec = 6\n            body = __fgen(a, prec, alt, typ == 71)\n        elif prec >= 0:\n            body = __fgen(a, prec, alt, 0)\n            if __find(body, \".\", 0) < 0 and __find(body, \"e\", 0) < 0 and __find(body, \"n\", 0) < 0:\n                body = concat(body, \".0\")\n        else:\n            body = __frepr(a)\n        if typ == 70 or typ == 69 or typ == 71:\n            body = upper(body)\n        if grp != \"\":\n            k: int = __find(body, \".\", 0)\n            if k < 0:\n                k = __find(body, \"e\", 0)\n            if k < 0:\n                k = len(body)\n            if __isdig(char_at(body, 0)):\n                body = concat(__grp(substr(body, 0, k), grp), substr(body, k, len(body)))\n    else:\n        v: int = int(x)\n        if v < 0:\n            neg = 1\n            v = 0 - v\n        if typ == 120 or typ == 88:\n            body = __radix(v, 16, typ == 88)\n            if alt:\n                body = concat(concat(\"0\", substr(spec, n - 1, n)), body)\n        elif typ == 111:\n            body = __radix(v, 8, 0)\n            if alt:\n                body = concat(\"0o\", body)\n        elif typ == 98:\n            body = __radix(v, 2, 0)\n            if alt:\n                body = concat(\"0b\", body)\n        elif typ == 99:\n            body = chr(v)\n        else:\n            body = __itos(v)\n            if grp != \"\":\n                body = __grp(body, grp)\n    pre: str = \"\"\n    if numeric:\n        if neg:\n            pre = \"-\"\n        elif sign == 43:\n            pre = \"+\"\n        elif sign == 32:\n            pre = \" \"\n    if align == 0:\n        align = 60\n        if numeric:\n            align = 62\n    pad: int = width - len(pre) - len(body)\n    if pad <= 0:\n        return concat(pre, body)\n    if align == 60:\n        return concat(concat(pre, body), __strmul(fill, pad))\n    if align == 62:\n        return concat(__strmul(fill, pad), concat(pre, body))\n    if align == 94:\n        return concat(concat(__strmul(fill, pad // 2), concat(pre, body)), __strmul(fill, pad - pad // 2))\n    return concat(concat(pre, __strmul(fill, pad)), body)\n\ndef __pctfmt(s, args, line) -> str:\n    if __tag(args) != 9 and __tag(args) != 0:\n        args = [args]\n    out: str = \"\"\n    n: int = len(s)\n    i: int = 0\n    j: int = 0\n    while i < n:\n        c: int = char_at(s, i)\n        if c != 37:\n            k: int = __find(s, \"%\", i)\n            if k < 0:\n                k = n\n            out = concat(out, substr(s, i, k))\n            i = k\n            continue\n        i += 1\n        if i < n and char_at(s, i) == 37:\n            out = concat(out, \"%\")\n            i += 1\n            continue\n        st: int = i\n        while i < n and __find(\"-+ #0123456789.\", substr(s, i, i + 1), 0) >= 0:\n            i += 1\n        fl: str = substr(s, st, i)\n        ty: int = char_at(s, i)\n        i += 1\n        if j >= len(args):\n            __err(line, \"not enough arguments for format string\")\n        a = args[j]\n        j += 1\n        if __find(fl, \"-\", 0) >= 0:\n            fl = concat(\"<\", replace(fl, \"-\", \"\"))\n        if ty == 115:\n            out = concat(out, __format(__str(a), fl))\n        elif ty == 114:\n            out = concat(out, __format(__repr(a), fl))\n        elif ty == 100 or ty == 105 or ty == 117:\n            out = concat(out, __format(int(a), concat(fl, \"d\")))\n        else:\n            out = concat(out, __format(a, concat(fl, chr(ty))))\n    if j < len(args):\n        __err(line, \"not all arguments converted during string formatting\")\n    return out\n\n# ---- math module (math.f / from math import f map to __math_f) ----\ndef __fl(x):\n    if __tag(x) == 5:\n        return x\n    return float(x)\n\ndef __math_sqrt(x):\n    f = __fl(x)\n    if f < 0.0:\n        raise ValueError(\"math domain error\")\n    return __math(f, 0)\n\ndef __math_floor(x) -> int:\n    if __tag(x) != 5:\n        return int(x)\n    return __ftoi(x, 1)\n\ndef __math_ceil(x) -> int:\n    if __tag(x) != 5:\n        return int(x)\n    return 0 - __ftoi(__neg(x), 1)\n\ndef __math_trunc(x) -> int:\n    return int(x)\n\ndef __math_sin(x):\n    return __math(__fl(x), 2)\n\ndef __math_cos(x):\n    return __math(__fl(x), 3)\n\ndef __math_tan(x):\n    return __math(__fl(x), 4)\n\ndef __math_atan(x):\n    return __math(__fl(x), 5)\n\ndef __math_atan2(y, x):\n    return __math2(__fl(y), __fl(x), 0)\n\ndef __math_exp(x):\n    return __math(__fl(x), 6)\n\ndef __math_log(x):\n    f = __fl(x)\n    if f <= 0.0:\n        raise ValueError(\"math domain error\")\n    return __math(f, 7)\n\ndef __math_log__2(x, b):\n    return __math_log(x) / __math_log(b)\n\ndef __math_log2(x):\n    f = __fl(x)\n    if f <= 0.0:\n        raise ValueError(\"math domain error\")\n    return __math(f, 8)\n\ndef __math_log10(x):\n    f = __fl(x)\n    if f <= 0.0:\n        raise ValueError(\"math domain error\")\n    return __math(f, 9)\n\ndef __math_fabs(x):\n    return __math(__fl(x), 10)\n\ndef __math_pow(x, y):\n    return __fl(__pow(__fl(x), __fl(y)))\n\ndef __math_hypot(x, y):\n    a = __fl(x)\n    b = __fl(y)\n    return __math(a * a + b * b, 0)\n\ndef __math_isnan(x) -> bool:\n    f = __fl(x)\n    return f != f\n\ndef __math_isinf(x) -> bool:\n    return __fspecial(__fl(x)) and (__fbits(__fl(x)) & 4503599627370495) == 0\n\ndef __math_isfinite(x) -> bool:\n    return not __fspecial(__fl(x))\n\ndef __math_nan():\n    return __ffrombits(9221120237041090560)\n\ndef __math_gcd(a: int, b: int) -> int:\n    if a < 0:\n        a = 0 - a\n    if b < 0:\n        b = 0 - b\n    while b != 0:\n        t: int = a % b\n        a = b\n        b = t\n    return a\n\ndef bool(x) -> bool:\n    return __truth(x) != 0\n\ndef hash(x) -> int:\n    return __hash(x)\n\n# ---- iteration protocol, generators ----\nclass generator:\n    def __init__(self, f):\n        h = __new(80, 4, 80)\n        i: int = 0\n        while i < 10:\n            __st(h, i, 0)\n            i += 1\n        __st(h, 0, f)\n        __st(h, 1, __new(65536, 4, 65536))\n        self.h = h\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        return __gnext(self.h, None)\n\n    def send(self, v):\n        return __gnext(self.h, v)\n\n    def close(self):\n        __st(self.h, 3, 3)\n        __st(self.h, 1, 0)\n        return None\n\ndef __mkgen(f):\n    g = generator(f)\n    if __tag(f) == 99:\n        __gstart(g)\n    return g\n\ndef __gstart(h):\n    r = None\n    try:\n        f = __ld(h, 0)\n        r = f()\n    except:\n        __st(h, 4, __excval())\n        __st(h, 9, __excline())\n        __gfin(None, 4)\n    __gfin(r, 3)\n\ndef __gnext(h, v):\n    s: int = __ld(h, 3)\n    if s >= 3:\n        raise StopIteration()\n    if s == 2:\n        raise ValueError(\"generator already executing\")\n    r = __gresume(h, v)\n    s = __ld(h, 3)\n    if s == 3:\n        __st(h, 1, 0)\n        raise StopIteration()\n    if s == 4:\n        __st(h, 1, 0)\n        __st(h, 3, 3)\n        __raise(__ld(h, 4), __ld(h, 9))\n    return r\n\ndef __yfrom(it):\n    for x in it:\n        __gyield(x)\n    return None\n\nclass __listiter:\n    def __init__(self, xs):\n        self.xs = xs\n        self.i = 0\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        i: int = self.i\n        if i >= len(self.xs):\n            raise StopIteration()\n        self.i = i + 1\n        return self.xs[i]\n\ndef iter(x):\n    if __tag(x) == 2:\n        return x.__iter__()\n    return __listiter(__iter(x, 0))\n\ndef next__1(it):\n    if isinstance(it, generator):\n        return __gnext(it.h, None)\n    return it.__next__()\n\ndef next__2(it, dflt):\n    try:\n        return next__1(it)\n    except StopIteration:\n        return dflt\n\ndef __forit(x, line):\n    if __tag(x) == 2:\n        b = [None, x.__iter__()]\n        __st(b, 0, 0)\n        set_byte(b, -1, 11)\n        return b\n    return __iter(x, line)\n\ndef __inext(b) -> int:\n    if __tag(b) != 11:\n        return 0\n    d = __ld(b, 2)\n    it = __ld(d, 1)\n    r = None\n    if isinstance(it, generator):\n        h = it.h\n        s: int = __ld(h, 3)\n        if s >= 3:\n            return 0\n        r = __gresume(h, None)\n        s = __ld(h, 3)\n        if s == 3:\n            __st(h, 1, 0)\n            return 0\n        if s == 4:\n            __st(h, 1, 0)\n            __st(h, 3, 3)\n            __raise(__ld(h, 4), __ld(h, 9))\n    else:\n        try:\n            r = it.__next__()\n        except StopIteration:\n            return 0\n    __st(d, 0, r)\n    __st(b, 0, 1)\n    return 1\n\ndef __drain(x):\n    b = __forit(x, 0)\n    r = []\n    while __inext(b):\n        append(r, __lst(b, 0))\n    return r\n\n# ---- files ----\nclass OSError(Exception):\n    pass\nclass FileNotFoundError(OSError):\n    pass\n\nclass __File:\n    def __init__(self, path, mode):\n        self.path = path\n        self.mode = mode\n        self.data = \"\"\n        self.pos = 0\n        self.parts = []\n        self.closed = False\n        self.w = __find(mode, \"w\", 0) >= 0 or __find(mode, \"a\", 0) >= 0\n\n    def read(self, n=-1):\n        p: int = self.pos\n        m: int = __aux(self.data)\n        if n < 0 or p + n > m:\n            n = m - p\n        self.pos = p + n\n        return substr(self.data, p, p + n)\n\n    def readline(self):\n        p: int = self.pos\n        m: int = __aux(self.data)\n        q: int = __find(self.data, \"\\n\", p)\n        if q < 0:\n            q = m\n        else:\n            q += 1\n        self.pos = q\n        return substr(self.data, p, q)\n\n    def readlines(self):\n        r = []\n        while self.pos < __aux(self.data):\n            append(r, self.readline())\n        return r\n\n    def write(self, s):\n        append(self.parts, s)\n        return len(s)\n\n    def writelines(self, xs):\n        for s in xs:\n            append(self.parts, s)\n        return None\n\n    def flush(self):\n        return None\n\n    def close(self):\n        if not self.closed and self.w:\n            if not write_file(self.path, join(self.parts, len(self.parts))):\n                raise OSError(concat(\"cannot write \", self.path))\n        self.closed = True\n        return None\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        if self.pos >= __aux(self.data):\n            raise StopIteration()\n        return self.readline()\n\n    def __enter__(self):\n        return self\n\n    def __exit__(self, t, v, tb):\n        self.close()\n        return False\n\ndef open(path, mode=\"r\", encoding=None):\n    f = __File(path, mode)\n    if __find(mode, \"w\", 0) >= 0:\n        return f\n    if __syscall(21, path, 4, 0) != 0:\n        if __find(mode, \"a\", 0) >= 0:\n            return f\n        raise FileNotFoundError(concat(\"No such file or directory: \", __repr(path)))\n    s = read_file(path)\n    if __find(mode, \"a\", 0) >= 0:\n        append(f.parts, s)\n    else:\n        f.data = s\n    return f\n\n# ---- sys / os / time ----\nclass __Stream:\n    def __init__(self, fd):\n        self.fd = fd\n\n    def write(self, s):\n        if self.fd == 2:\n            __flushout()\n            __syscall(1, 2, s, __aux(s))\n        else:\n            __writes(s)\n        return len(s)\n\n    def flush(self):\n        return None\n\n    def read(self, n=-1):\n        parts = []\n        buf = alloc(65536)\n        while True:\n            n: int = __syscall(0, 0, buf, 65536)\n            if n <= 0:\n                break\n            append(parts, substr(buf, 0, n))\n        return join(parts, len(parts))\n\n    def readline(self):\n        # unbuffered so that no state is needed; the kernel keeps the position\n        parts = []\n        buf = alloc(8)\n        while True:\n            n: int = __syscall(0, 0, buf, 1)\n            if n <= 0:\n                break\n            c = substr(buf, 0, 1)\n            append(parts, c)\n            if char_at(buf, 0) == 10:\n                break\n        return join(parts, len(parts))\n\n    def readlines(self):\n        r = []\n        while True:\n            l = self.readline()\n            if __aux(l) == 0:\n                return r\n            append(r, l)\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        l = self.readline()\n        if __aux(l) == 0:\n            raise StopIteration()\n        return l\n\ndef __sys_stdout():\n    return __Stream(1)\n\ndef __sys_stderr():\n    return __Stream(2)\n\ndef __sys_stdin():\n    return __Stream(0)\n\ndef __sys_argv():\n    return __mkargv()\n\ndef __flushout():\n    __flush()\n\ndef __mkargv():\n    r = []\n    i: int = 0\n    while i < argc():\n        append(r, argv(i))\n        i += 1\n    return r\n\ndef __sys_exit(code=0):\n    if __tag(code) == 1:\n        eputs(code)\n        exit(1)\n    if code is None:\n        exit(0)\n    exit(code)\n\ndef __sys_setrecursionlimit(n):\n    return None\n\ndef __sys_getrecursionlimit():\n    return 1000\n\ndef __os_getenv(name, dflt=None):\n    i: int = 0\n    while True:\n        e = __env(i)\n        if __tag(e) != 1:\n            return dflt\n        if startswith(e, name) and char_at(e, __aux(name)) == 61:\n            return substr(e, __aux(name) + 1, __aux(e))\n        i += 1\n\ndef __os_path_exists(p) -> bool:\n    return __syscall(21, p, 0, 0) == 0\n\ndef __os_path_join(a, b):\n    if startswith(b, \"/\"):\n        return b\n    if __aux(a) == 0 or endswith(a, \"/\"):\n        return concat(a, b)\n    return concat(concat(a, \"/\"), b)\n\ndef __os_path_basename(p):\n    i: int = rfind(p, \"/\")\n    return substr(p, i + 1, __aux(p))\n\ndef __os_path_dirname(p):\n    i: int = rfind(p, \"/\")\n    if i < 0:\n        return \"\"\n    if i == 0:\n        return \"/\"\n    return substr(p, 0, i)\n\ndef __os_remove(p):\n    if __syscall(87, p, 0, 0) != 0:\n        raise FileNotFoundError(concat(\"No such file or directory: \", __repr(p)))\n    return None\n\ndef __os_getcwd():\n    buf = alloc(4096)\n    n: int = __syscall(79, buf, 4096, 0)\n    if n <= 0:\n        return \".\"\n    return substr(buf, 0, __find(buf, chr(0), 0))\n\ndef __time_time():\n    return __clock(0) / 1000000000\n\ndef __time_time_ns() -> int:\n    return __clock(0)\n\ndef __time_perf_counter():\n    return __clock(1) / 1000000000\n\ndef __time_perf_counter_ns() -> int:\n    return __clock(1)\n\ndef __time_monotonic():\n    return __clock(1) / 1000000000\n\ndef __time_sleep(s):\n    ns: int = int(s * 1000000000)\n    ts = __new(16, 4, 16)\n    __st(ts, 0, ns // 1000000000)\n    __st(ts, 1, ns % 1000000000)\n    __syscall(35, ts, 0, 0)\n    return None\n\ndef __exctype():\n    return __excval()\n\ndef dict(xs=None):\n    r = __dict()\n    if xs is None:\n        return r\n    if __tag(xs) == 3:\n        for k in __ld(xs, 5):\n            __dset(r, k, xs[k])\n        return r\n    for p in xs:\n        __dset(r, p[0], p[1])\n    return r\n\ndef zip__2(a, b):\n    a = __iter(a, 0)\n    b = __iter(b, 0)\n    n: int = min(len(a), len(b))\n    r = list(n)\n    i: int = 0\n    while i < n:\n        r[i] = (a[i], b[i])\n        i += 1\n    return r\n\ndef zip__3(a, b, c):\n    a = __iter(a, 0)\n    b = __iter(b, 0)\n    c = __iter(c, 0)\n    n: int = min(min(len(a), len(b)), len(c))\n    r = list(n)\n    i: int = 0\n    while i < n:\n        r[i] = (a[i], b[i], c[i])\n        i += 1\n    return r\n\ndef enumerate__1(xs):\n    return enumerate__2(xs, 0)\n\ndef enumerate__2(xs, start):\n    xs = __iter(xs, 0)\n    n: int = len(xs)\n    r = list(n)\n    i: int = 0\n    while i < n:\n        r[i] = (i + start, xs[i])\n        i += 1\n    return r\n\ndef reversed(xs):\n    xs = __iter(xs, 0)\n    n: int = len(xs)\n    r = list(n)\n    i: int = 0\n    while i < n:\n        r[i] = xs[n - 1 - i]\n        i += 1\n    return r\n\ndef any(xs) -> bool:\n    for x in xs:\n        if x:\n            return True\n    return False\n\ndef all(xs) -> bool:\n    for x in xs:\n        if not x:\n            return False\n    return True\n\ndef divmod(a, b):\n    return (a // b, a % b)\n\ndef __radixp(x, base: int, pre):\n    if x < 0:\n        return concat(concat(\"-\", pre), __radix(-x, base, 0))\n    return concat(pre, __radix(x, base, 0))\n\ndef hex(x):\n    return __radixp(x, 16, \"0x\")\n\ndef bin(x):\n    return __radixp(x, 2, \"0b\")\n\ndef oct(x):\n    return __radixp(x, 8, \"0o