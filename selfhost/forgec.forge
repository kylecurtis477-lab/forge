nfsp = 0
fsg_n = list(8192)
fsg_t = list(8192)
fsg_p = list(8192)
fsg_al = list(8192)
fsg_sec = list(8192)
nfsg = 0
fsl_n = list(4096)
fsl_t = list(4096)
fsl_o = list(4096)
nfsl = 0
fs_frame = 0
fp = 0
fs_ety = 0
fs_mode = 0
fs_moff = 0
fs_mlab = ""
fs_dep = 0
fs_lab = 0
fs_ret = ""
fs_rty = 0
fs_brk = list(256)
fs_cnt = list(256)
nfsloop = 0
fs_chk = 0
fs_rod = list(65536)
nfsrod = 0
fs_cok = 1
fs_dal = 0
fs_dsec = ""
fs_dexp = 0
fs_datt = 0
fs_bchk = 1
fs_bstats = 0
# Phase 4.3 unsafe: fs_unsafe > 0 inside `with unsafe:` / @unsafe / @naked; --unsafe-report lists regions,
# --unsafe-fix lists functions that need @unsafe instead of failing
fs_unsafe = 0
fs_urep = 0
fs_ufix = 0
# provenance lint (v1.3): --provenance-lint lists every integer-to-pointer site; any outside an @unsafe function fails
fs_prov = 0
fs_pbad = 0
fs_pn = 0
fs_uops = 0
fs_utot = 0
fs_ufn = 0
fs_ublk = 0
fs_ucur = -1
fs_ufixed = -1
fs_ubare = 0
# Phase 4.4 ownership: own[T] (ftsg 2) is affine (moved on whole-value use); ref[T] (3) / mut[T] (4)
# are borrows from borrow()/borrow_mut(), live until the end of the declaring block (or the call, for arguments)
fsl_mv = list(4096)
fsl_bf = list(4096)
fsl_bk = list(4096)
fsl_sh = list(4096)
fsl_mu = list(4096)
fsl_bl = list(4096)
fsl_dead = list(4096)
fs_tb = list(4096)
fs_tbk = list(4096)
fs_bpk = 0
nfstb = 0
fs_argd = 0
# SysV argument layout of the current call/prologue: fs_wd[w] is the destination of argument word w
# (0..5 a register, 100 + s stack slot s); fs_sretv marks rax as the address of a struct call result
fs_wd = list(64)
fs_sretv = 0
fs_rslot = -1
fs_bpend = -1
fs_rsrc = -1
fs_term = 0
fs_lbm = list(256)
fs_lb0 = list(256)
fs_safe = 0
fs_sp = 0  # `# forge: stack-protector`: canary below rbp in every function with an array/struct local
fs_spn = 0  # functions protected
# Phase 4.5 defer: `with defer:` blocks at a function's top level run (LIFO) before every return
# Phase 4.5 generics: @generic(T, ...) on a def or struct; instantiated (monomorphized) per type tuple
fsgen_n = list(512)
fsgen_k = list(512)
fsgen_pos = list(512)
fsgen_at = list(512)
fsgen_tp0 = list(512)
