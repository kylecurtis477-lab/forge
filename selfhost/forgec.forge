def prelude_text():
    return "# Forge prelude: library code written in Forge and compiled into every program.\n# Unreferenced functions are dropped from the output. A user function with the same name replaces a public one here.\n# Internals use only __-prefixed helpers so user code cannot change their behaviour.\n\ndef __err(line, msg):\n    eputs(concat(concat(concat(\"error: line \", __itos(line)), \": \"), msg))\n    exit(1)\n\ndef __lst(xs: list, i: int):\n    return __ld(__ld(xs, 2), i)\n\ndef __grow(xs, need: int):\n    cap: int = __ld(xs, 1)\n    if need <= cap:\n        return 0\n    nc: int = cap * 2\n    if nc < need:\n        nc = need\n    d = __new(nc * 8, 4, nc * 8)\n    __copy(d, __ld(xs, 2), __ld(xs, 0) * 8)\n    __st(xs, 2, d)\n    __st(xs, 1, nc)\n    return 0\n\ndef append(xs, v):\n    n: int = __ld(xs, 0)\n    if n >= __ld(xs, 1):\n        __grow(xs, n + 1)\n    __st(__ld(xs, 2), n, v)\n    __st(xs, 0, n + 1)\n    return 0\n\ndef pop(xs):\n    n: int = __ld(xs, 0) - 1\n    if n < 0:\n        __err(0, \"pop from empty list\")\n    __st(xs, 0, n)\n    return __ld(__ld(xs, 2), n)\n\ndef insert(xs, i: int, v):\n    n: int = __ld(xs, 0)\n    if i < 0:\n        i = i + n\n    if i < 0:\n        i = 0\n    if i > n:\n        i = n\n    append(xs, 0)\n    d = __ld(xs, 2)\n    j: int = n\n    while j > i:\n        __st(d, j, __ld(d, j - 1))\n        j -= 1\n    __st(d, i, v)\n    return 0\n\ndef __list_add(a, b):\n    na: int = __ld(a, 0)\n    nb: int = __ld(b, 0)\n    r = list(na + nb)\n    __copy(__ld(r, 2), __ld(a, 2), na * 8)\n    __copy(__ld(r, 2) + na * 8, __ld(b, 2), nb * 8)\n    return r\n\ndef __list_mul(a, k: int):\n    n: int = __ld(a, 0)\n    if k < 0:\n        k = 0\n    r = list(n * k)\n    d = __ld(r, 2)\n    s = __ld(a, 2)\n    i: int = 0\n    while i < k:\n        __copy(d + i * n * 8, s, n * 8)\n        i += 1\n    return r\n\ndef __itos(x) -> str:\n    return __itos_raw(x)\n\ndef __str(x) -> str:\n    t: int = __tag(x)\n    if t == 1:\n        return x\n    if t < 0:\n        return __itos_raw(x)\n    return __repr(x)\n\ndef __repr(x) -> str:\n    t: int = __tag(x)\n    if t == 1:\n        return concat(concat(\"'\", x), \"'\")\n    if t < 0:\n        return __itos_raw(x)\n    parts = []\n    if t == 0:\n        n: int = __ld(x, 0)\n        append(parts, \"[\")\n        i: int = 0\n        while i < n:\n            if i > 0:\n                append(parts, \", \")\n            append(parts, __repr(__lst(x, i)))\n            i += 1\n        append(parts, \"]\")\n    elif t == 3:\n        ks = __ld(x, 5)\n        n: int = __ld(ks, 0)\n        append(parts, \"{\")\n        i: int = 0\n        while i < n:\n            if i > 0:\n                append(parts, \", \")\n            k = __lst(ks, i)\n            append(parts, __repr(k))\n            append(parts, \": \")\n            append(parts, __repr(__dget(x, k, 0)))\n            i += 1\n        append(parts, \"}\")\n    else:\n        return \"<object>\"\n    return join(parts, __ld(parts, 0))\n\ndef __pr(x):\n    t: int = __tag(x)\n    if t == 1:\n        __writes(x)\n    elif t < 0:\n        __wint(x)\n    else:\n        __writes(__repr(x))\n    return 0\n\ndef __add(a, b, line):\n    ta: int = __tag(a)\n    tb: int = __tag(b)\n    if ta < 0 and tb < 0:\n        return a - (0 - b)\n    if ta == 1 and tb == 1:\n        return concat(a, b)\n    if ta == 0 and tb == 0:\n        return __list_add(a, b)\n    __err(line, \"unsupported operand types for +\")\n\ndef __eq(a, b):\n    if a - b == 0:\n        return 1\n    if __tag(a) == 1 and __tag(b) == 1:\n        return str_eq(a, b)\n    return 0\n\ndef __lt(a, b):\n    if __tag(a) == 1 and __tag(b) == 1:\n        return __strcmp(a, b) < 0\n    return a - b < 0\n\ndef __strcmp(a, b):\n    na: int = __aux(a)\n    nb: int = __aux(b)\n    i: int = 0\n    while i < na and i < nb:\n        d: int = char_at(a, i) - char_at(b, i)\n        if d != 0:\n            return d\n        i += 1\n    return na - nb\n\ndef __getidx(o, i: int, line):\n    t: int = __tag(o)\n    if t == 0:\n        n: int = __ld(o, 0)\n        j: int = i\n        if j < 0:\n            j = j + n\n        if j < 0 or j >= n:\n            __err(line, concat(concat(concat(\"list index \", __itos_raw(i)), \" out of range for length \"), __itos_raw(n)))\n        return __lst(o, j)\n    if t == 1:\n        n: int = __aux(o)\n        j: int = i\n        if j < 0:\n            j = j + n\n        if j < 0 or j >= n:\n            __err(line, \"string index out of range\")\n        return chr(char_at(o, j))\n    if t == 3:\n        return __dget(o, i, line)\n    __err(line, \"value is not indexable\")\n\ndef __setidx(o, i: int, v, line):\n    t: int = __tag(o)\n    if t == 0:\n        n: int = __ld(o, 0)\n        j: int = i\n        if j < 0:\n            j = j + n\n        if j < 0 or j >= n:\n            __err(line, concat(concat(concat(\"list assignment index \", __itos_raw(i)), \" out of range for length \"), __itos_raw(n)))\n        __st(__ld(o, 2), j, v)\n        return 0\n    if t == 3:\n        __dset(o, i, v)\n        return 0\n    __err(line, \"value does not support item assignment\")\n\ndef __slice(o, a: int, b: int, line):\n    t: int = __tag(o)\n    n: int = 0\n    if t == 0:\n        n = __ld(o, 0)\n    elif t == 1:\n        n = __aux(o)\n    else:\n        __err(line, \"value cannot be sliced\")\n    if a < 0:\n        a = a + n\n    if b < 0:\n        b = b + n\n    if a < 0:\n        a = 0\n    if b > n:\n        b = n\n    if b < a:\n        b = a\n    if t == 1:\n        return substr(o, a, b)\n    r = list(b - a)\n    __copy(__ld(r, 2), __ld(o, 2) + a * 8, (b - a) * 8)\n    return r\n\ndef __iter(x, line):\n    t: int = __tag(x)\n    if t == 0:\n        return x\n    if t == 3:\n        return __ld(x, 5)\n    if t == 1:\n        n: int = __aux(x)\n        r = list(n)\n        i: int = 0\n        while i < n:\n            __st(__ld(r, 2), i, chr(char_at(x, i)))\n            i += 1\n        return r\n    __err(line, \"value is not iterable\")\n\ndef __contains(c, x):\n    t: int = __tag(c)\n    if t == 3:\n        i: int = __dfind(c, x, __hash(x))\n        return __ld(__ld(c, 2), i) != 0\n    if t == 0:\n        n: int = __ld(c, 0)\n        i: int = 0\n        while i < n:\n            if __eq(__lst(c, i), x):\n                return 1\n            i += 1\n        return 0\n    if t == 1:\n        return __find(c, x, 0) >= 0\n    return 0\n\n# ---- dict: open addressing, insertion-ordered keys ----\n# layout: [count, cap, hashes, keys, values, order(list of keys)]\ndef __zeros(n: int):\n    p = __new(n * 8, 4, n * 8)\n    i: int = 0\n    while i < n:\n        __st(p, i, 0)\n        i += 1\n    return p\n\ndef __dict():\n    d = __new(48, 3, 0)\n    __st(d, 0, 0)\n    __st(d, 1, 8)\n    __st(d, 2, __zeros(8))\n    __st(d, 3, __zeros(8))\n    __st(d, 4, __zeros(8))\n    __st(d, 5, list(0))\n    return d\n\ndef __hash(k) -> int:\n    h: int = 0\n    if __tag(k) == 1:\n        h = 5381\n        n: int = __aux(k)\n        i: int = 0\n        while i < n:\n            h = h * 33 + char_at(k, i)\n            i += 1\n    else:\n        h = k * -7046029254386353131\n        h = h ^ (h >> 29)\n    return h | 1\n\ndef __dfind(d, k, h: int) -> int:\n    m: int = __ld(d, 1) - 1\n    hs = __ld(d, 2)\n    ks = __ld(d, 3)\n    i: int = h & m\n    while 1:\n        x: int = __ld(hs, i)\n        if x == 0:\n            return i\n        if x == h and __eq(__ld(ks, i), k):\n            return i\n        i = (i + 1) & m\n\ndef __dget(d, k, line):\n    i: int = __dfind(d, k, __hash(k))\n    if __ld(__ld(d, 2), i) == 0:\n        __err(line, concat(\"key not found: \", __repr(k)))\n    return __ld(__ld(d, 4), i)\n\ndef get(d, k, dflt):\n    i: int = __dfind(d, k, __hash(k))\n    if __ld(__ld(d, 2), i) == 0:\n        return dflt\n    return __ld(__ld(d, 4), i)\n\ndef __dset(d, k, v):\n    if (__ld(d, 0) + 1) * 4 > __ld(d, 1) * 3:\n        __dresize(d)\n    h: int = __hash(k)\n    i: int = __dfind(d, k, h)\n    hs = __ld(d, 2)\n    if __ld(hs, i) == 0:\n        __st(hs, i, h)\n        __st(__ld(d, 3), i, k)\n        __st(d, 0, __ld(d, 0) + 1)\n        append(__ld(d, 5), k)\n    __st(__ld(d, 4), i, v)\n    return 0\n\ndef __dresize(d):\n    oc: int = __ld(d, 1)\n    ohs = __ld(d, 2)\n    oks = __ld(d, 3)\n    ovs = __ld(d, 4)\n    nc: int = oc * 2\n    __st(d, 1, nc)\n    __st(d, 2, __zeros(nc))\n    __st(d, 3, __zeros(nc))\n    __st(d, 4, __zeros(nc))\n    j: int = 0\n    while j < oc:\n        h: int = __ld(ohs, j)\n        if h != 0:\n            k = __ld(oks, j)\n            i: int = __dfind(d, k, h)\n            __st(__ld(d, 2), i, h)\n            __st(__ld(d, 3), i, k)\n            __st(__ld(d, 4), i, __ld(ovs, j))\n        j += 1\n    return 0\n\ndef keys(d):\n    return __slice(__ld(d, 5), 0, __ld(__ld(d, 5), 0), 0)\n\ndef values(d):\n    ks = __ld(d, 5)\n    n: int = __ld(ks, 0)\n    r = list(n)\n    i: int = 0\n    while i < n:\n        __st(__ld(r, 2), i, __dget(d, __lst(ks, i), 0))\n        i += 1\n    return r\n\ndef items(d):\n    ks = __ld(d, 5)\n    n: int = __ld(ks, 0)\n    r = list(n)\n    i: int = 0\n    while i < n:\n        k = __lst(ks, i)\n        __st(__ld(r, 2), i, [k, __dget(d, k, 0)])\n        i += 1\n    return r\n\n# ---- strings ----\ndef __find(s, sub, start: int) -> int:\n    n: int = __aux(s)\n    m: int = __aux(sub)\n    i: int = start\n    while i + m <= n:\n        j: int = 0\n        while j < m and char_at(s, i + j) == char_at(sub, j):\n            j += 1\n        if j == m:\n            return i\n        i += 1\n    return -1\n\ndef find(s, sub) -> int:\n    return __find(s, sub, 0)\n\ndef startswith(s, p) -> int:\n    m: int = __aux(p)\n    if m > __aux(s):\n        return 0\n    i: int = 0\n    while i < m:\n        if char_at(s, i) != char_at(p, i):\n            return 0\n        i += 1\n    return 1\n\ndef endswith(s, p) -> int:\n    m: int = __aux(p)\n    o: int = __aux(s) - m\n    if o < 0:\n        return 0\n    i: int = 0\n    while i < m:\n        if char_at(s, o + i) != char_at(p, i):\n            return 0\n        i += 1\n    return 1\n\ndef __isspace(c: int) -> int:\n    return c == 32 or c == 10 or c == 9 or c == 13\n\ndef strip(s) -> str:\n    a: int = 0\n    b: int = __aux(s)\n    while a < b and __isspace(char_at(s, a)):\n        a += 1\n    while b > a and __isspace(char_at(s, b - 1)):\n        b -= 1\n    return substr(s, a, b)\n\ndef split(s, sep):\n    r = []\n    n: int = __aux(s)\n    m: int = __aux(sep)\n    if m == 0:\n        __err(0, \"empty separator\")\n    a: int = 0\n    i: int = __find(s, sep, 0)\n    while i >= 0:\n        append(r, substr(s, a, i))\n        a = i + m\n        i = __find(s, sep, a)\n    append(r, substr(s, a, n))\n    return r\n\ndef split__1(s):\n    r = []\n    n: int = __aux(s)\n    i: int = 0\n    while i < n:\n        while i < n and __isspace(char_at(s, i)):\n            i += 1\n        if i >= n:\n            break\n        a: int = i\n        while i < n and not __isspace(char_at(s, i)):\n            i += 1\n        append(r, substr(s, a, i))\n    return r\n\ndef __m_join(sep, xs) -> str:\n    n: int = __ld(xs, 0)\n    if n == 0:\n        return \"\"\n    parts = list(2 * n - 1)\n    pd = __ld(parts, 2)\n    i: int = 0\n    while i < n:\n        if i > 0:\n            __st(pd, 2 * i - 1, sep)\n        __st(pd, 2 * i, __str(__lst(xs, i)))\n        i += 1\n    return join(parts, 2 * n - 1)\n\ndef replace(s, a, b) -> str:\n    return __m_join(b, split(s, a))\n\ndef __mapcase(s, lo: int, hi: int, d: int) -> str:\n    n: int = __aux(s)\n    r = substr(s, 0, n)\n    i: int = 0\n    while i < n:\n        c: int = char_at(r, i)\n        if c >= lo and c <= hi:\n            set_byte(r, i, c + d)\n        i += 1\n    return r\n\ndef upper(s) -> str:\n    return __mapcase(s, 97, 122, -32)\n\ndef lower(s) -> str:\n    return __mapcase(s, 65, 90, 32)\n\ndef isdigit(s) -> int:\n    n: int = __aux(s)\n    i: int = 0\n    while i < n:\n        c: int = char_at(s, i)\n        if c < 48 or c > 57:\n            return 0\n        i += 1\n    return n > 0\n\ndef isalpha(s) -> int:\n    n: int = __aux(s)\n    i: int = 0\n    while i < n:\n        c: int = char_at(s, i) | 32\n        if c < 97 or c > 122:\n            return 0\n        i += 1\n    return n > 0\n\ndef int(x) -> int:\n    if __tag(x) != 1:\n        return x\n    s = strip(x)\n    n: int = __aux(s)\n    i: int = 0\n    neg: int = 0\n    if n > 0 and char_at(s, 0) == 45:\n        neg = 1\n        i = 1\n    v: int = 0\n    if i >= n:\n        __err(0, concat(\"invalid literal for int(): \", __repr(x)))\n    while i < n:\n        c: int = char_at(s, i) - 48\n        if c < 0 or c > 9:\n            __err(0, concat(\"invalid literal for int(): \", __repr(x)))\n        v = v * 10 + c\n        i += 1\n    if neg:\n        return 0 - v\n    return v\n\n# ---- numbers and lists ----\ndef abs(x: int) -> int:\n    if x < 0:\n        return 0 - x\n    return x\n\ndef min(a, b):\n    if __lt(b, a):\n        return b\n    return a\n\ndef max(a, b):\n    if __lt(a, b):\n        return b\n    return a\n\ndef min__1(xs):\n    m = __lst(xs, 0)\n    for x in xs:\n        if __lt(x, m):\n            m = x\n    return m\n\ndef max__1(xs):\n    m = __lst(xs, 0)\n    for x in xs:\n        if __lt(m, x):\n            m = x\n    return m\n\ndef sum(xs) -> int:\n    s: int = 0\n    n: int = __ld(xs, 0)\n    d = __ld(xs, 2)\n    i: int = 0\n    while i < n:\n        s += __ld(d, i)\n        i += 1\n    return s\n\ndef __pow(a: int, b: int) -> int:\n    r: int = 1\n    while b > 0:\n        if b & 1:\n            r = r * a\n        a = a * a\n        b = b >> 1\n    return r\n\ndef __msort(d, t, lo: int, hi: int):\n    if hi - lo < 2:\n        return 0\n    mid: int = (lo + hi) // 2\n    __msort(d, t, lo, mid)\n    __msort(d, t, mid, hi)\n    i: int = lo\n    j: int = mid\n    k: int = lo\n    while k < hi:\n        if j >= hi or (i < mid and not __lt(__ld(d, j), __ld(d, i))):\n            __st(t, k, __ld(d, i))\n            i += 1\n        else:\n            __st(t, k, __ld(d, j))\n            j += 1\n        k += 1\n    __copy(d + lo * 8, t + lo * 8, (hi - lo) * 8)\n    return 0\n\ndef sort(xs):\n    n: int = __ld(xs, 0)\n    __msort(__ld(xs, 2), __new(n * 8 + 8, 4, n * 8), 0, n)\n    return 0\n\ndef sorted(xs):\n    r = __slice(xs, 0, __ld(xs, 0), 0)\n    sort(r)\n    return r\n\ndef reverse(xs):\n    d = __ld(xs, 2)\n    i: int = 0\n    j: int = __ld(xs, 0) - 1\n    while i < j:\n        t = __ld(d, i)\n        __st(d, i, __ld(d, j))\n        __st(d, j, t)\n        i += 1\n        j -= 1\n    return 0\n\ndef extend(xs, ys):\n    for y in ys:\n        append(xs, y)\n    return 0\n\ndef range(n: int):\n    return range__3(0, n, 1)\n\ndef range__2(a: int, b: int):\n    return range__3(a, b, 1)\n\ndef range__3(a: int, b: int, s: int):\n    if s == 0:\n        __err(0, \"range() step must not be zero\")\n    r = []\n    i: int = a\n    if s > 0:\n        while i < b:\n            append(r, i)\n            i += s\n    else:\n        while i > b:\n            append(r, i)\n            i += s\n    return r\n\n# ---- helpers the code generator calls ----\ndef __truth(x) -> int:\n    t: int = __tag(x)\n    if t < 0:\n        v: int = x\n        return v != 0\n    if t == 1:\n        return __aux(x) != 0\n    if t == 0 or t == 3:\n        return __ld(x, 0) != 0\n    return 1\n\ndef __cmp(a, b) -> int:\n    if __lt(a, b):\n        return -1\n    if __lt(b, a):\n        return 1\n    return 0\n\ndef __strmul(s, k: int) -> str:\n    if k <= 0:\n        return \"\"\n    parts = list(k)\n    d = __ld(parts, 2)\n    i: int = 0\n    while i < k:\n        __st(d, i, s)\n        i += 1\n    return join(parts, k)\n\ndef __listof(x):\n    it = __iter(x, 0)\n    return __slice(it, 0, __ld(it, 0), 0)\n\ndef get__2(d, k):\n    return get(d, k, 0)\n\ndef count(xs, x) -> int:\n    c: int = 0\n    for y in xs:\n        if __eq(y, x):\n            c += 1\n    return c\n\ndef index(xs, x) -> int:\n    i: int = 0\n    for y in xs:\n        if __eq(y, x):\n            return i\n        i += 1\n    __err(0, \"value not in list\")\n"

