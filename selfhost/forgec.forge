# Phase 4.2 non-null pointers: per-local "proven non-null" flag for nptr[T] locals
fsl_nn = list(4096)
fs_lhs = 0
fs_lhsl = -1
fs_lastimm = 1
fs_nnl = list(64)
fs_nnc = 0
fsb_v = list(256)
fsb_x = list(256)
fsb_c = list(256)
nfsb = 0
# expanded-line -> (file, line) map built by fs_include, for precise runtime diagnostics
# Phase 7.3 `-g`: DWARF 4 line table + one DW_TAG_subprogram per function. Each statement gets a
# local label .Lfsd<n>; fsd_ln[n] is its include-expanded line. Function k spans labels
# fsgf_a[k]..fsgf_b[k] and starts at symbol fsgf_s[k], ends at .Lfsde<k>.
fs_g = 0
fs_gon = 0
nfsd = 0
fsd_ln = list(262144)
nfsgf = 0
fsgf_s = list(8192)
fsgf_ln = list(8192)
fsgf_a = list(8192)
fsgf_b = list(8192)

def fs_uleb(v):
    r = ""
    while 1:
        b = v % 128
        v = v // 128
        if v != 0:
            b = b + 128
        r = c3(r, ",", str(b))
        if v == 0:
            return c3("    .byte ", substr(r, 1, len(r)), "\n")

def fs_sleb(v):
# n 7-bit groups of v's two's complement (v small: line deltas)
    n = 1
    lim = 64
    if v >= 0:
        while v >= lim:
            n += 1
            lim = lim * 128
        u = v
    else:
        while 0 - v > lim:
            n += 1
            lim = lim * 128
        u = v + lim * 2
    r = ""
    i = 0
    while i < n:
        b = u % 128
        u = u // 128
        if i + 1 < n:
            b = b + 128
        r = c3(r, ",", str(b))
        i += 1
    return c3("    .byte ", substr(r, 1, len(r)), "\n")

def fs_dline(ln):
    if ln >= 1 and ln <= fsx_n:
        return fsx_l[ln - 1]
    return ln

def fs_dfile(ln):
    if ln >= 1 and ln <= fsx_n:
        return fsx_f[ln - 1] + 1
    return 1

def fs_dmark():
# a line-table row at the current address for the statement at fp
    global nfsd
    if fs_gon and nfsd < 262144:
        emit_raw(c3(".Lfsd", str(nfsd), ":\n"))
        fsd_ln[nfsd] = tl[fp]
        nfsd += 1

def fs_dwarf():
    emit_raw(".section .debug_abbrev,\"\",@progbits\n")
    emit_raw("    .byte 1,0x11,1,0x25,0x08,0x13,0x05,0x03,0x08,0x1b,0x08,0x11,0x01,0x55,0x17,0x10,0x17,0,0\n")
    emit_raw("    .byte 2,0x2e,0,0x03,0x08,0x3f,0x19,0x3a,0x05,0x3b,0x06,0x11,0x01,0x12,0x06,0,0\n    .byte 0\n")
    emit_raw(".section .debug_info,\"\",@progbits\n")
    emit_raw("    .long .Ldie - .Ldis\n.Ldis:\n    .2byte 4\n    .long 0\n    .byte 8\n    .byte 1\n")
    emit_raw(c3("    .asciz \"forgec -g\"\n    .2byte 0x0c\n    .asciz \"", fsx_fn[0], "\"\n    .asciz \".\"\n    .quad 0\n    .long 0\n    .long 0\n"))
    k = 0
    while k < nfsgf:
        emit_raw(c3("    .byte 2\n    .asciz \"", fsgf_s[k], "\"\n"))
        emit_raw(c4("    .2byte ", str(fs_dfile(fsgf_ln[k])), "\n    .long ", c3(str(fs_dline(fsgf_ln[k])), "\n    .quad ", fsgf_s[k])))
        emit_raw(c4("\n    .long .Lfsde", str(k), " - ", concat(fsgf_s[k], "\n")))
        k += 1
    emit_raw("    .byte 0\n.Ldie:\n")
    emit_raw(".section .debug_ranges,\"\",@progbits\n")
    k = 0
    while k < nfsgf:
        emit_raw(c4("    .quad ", fsgf_s[k], "\n    .quad .Lfsde", concat(str(k), "\n")))
        k += 1
    emit_raw("    .quad 0\n    .quad 0\n")
    emit_raw(".section .debug_line,\"\",@progbits\n")
    emit_raw("    .long .Ldle - .Ldls\n.Ldls:\n    .2byte 4\n    .long .Ldhe - .Ldhs\n.Ldhs:\n")
    emit_raw("    .byte 1,1,1,0xfb,14,13,0,1,1,1,1,0,0,0,1,0,0,1\n    .byte 0\n")
    i = 0
    while i < fsx_nf:
        emit_raw(c3("    .asciz \"", fsx_fn[i], "\"\n    .byte 0,0,0\n"))
        i += 1
    emit_raw("    .byte 0\n.Ldhe:\n")
    k = 0
    while k < nfsgf:
        emit_raw(c3("    .byte 0,9,2\n    .quad ", fsgf_s[k], "\n"))
        line = 1
        file = 1
        prev = fsgf_s[k]
        j = fsgf_a[k] - 1
        while j < fsgf_b[k]:
            if j < fsgf_a[k]:
                ln = fsgf_ln[k]
                lab = fsgf_s[k]
            else:
                ln = fsd_ln[j]
                lab = concat(".Lfsd", str(j))
            fi = fs_dfile(ln)
            l2 = fs_dline(ln)
            if fi != file:
                emit_raw(concat("    .byte 4\n", fs_uleb(fi)))
                file = fi
            if l2 != line:
                emit_raw(concat("    .byte 3\n", fs_sleb(l2 - line)))
                line = l2
            emit_raw(c4("    .byte 9\n    .2byte ", lab, " - ", concat(prev, "\n    .byte 1\n")))
            prev = lab
            j += 1
        emit_raw(c4("    .byte 9\n    .2byte .Lfsde", str(k), " - ", concat(prev, "\n    .byte 0,1,1\n")))
        k += 1
    emit_raw(".Ldle:\n")

FSXMAX = 262144
fsx_f = list(FSXMAX)
fsx_l = list(FSXMAX)
fsx_n = 0
fsx_fn = list(512)
fsx_lb = list(512)
fsx_nf = 0
fsx_cur = 0

def c3(a, b, c):
    return concat(concat(a, b), c)

def c4(a, b, c, d):
    return concat(concat(concat(a, b), c), d)

def fs_where(ln):
# "file:line" of include-expanded line ln
    fi = 0
    if ln >= 1 and ln <= fsx_n:
        fi = fsx_f[ln - 1]
        ln = fsx_l[ln - 1]
    return c3(fsx_fn[fi], ":", str(ln))

FS_UNSAFE_FNS = ["asm", "load8", "load16", "load32", "load64", "vload8", "vload16", "vload32", "vload64", "store8", "store16", "store32", "store64", "vstore8", "vstore16", "vstore32", "vstore64", "inb", "inw", "inl", "outb", "outw", "outl", "call_ptr", "call_efi", "memcpy", "memset", "lgdt", "lidt", "ltr", "invlpg", "wrmsr", "rdmsr", "cli", "sti", "hlt", "wbinvd", "atomic_load32", "atomic_load64", "atomic_store32", "atomic_store64", "atomic_xchg32", "atomic_xchg64", "atomic_add32", "atomic_add64", "atomic_cas32", "atomic_cas64", "atomic_or32", "atomic_or64", "atomic_and32", "atomic_and64"]

def fs_unsafe_op(what):
# one unsafe operation at fp: allowed only in an unsafe region
    global fs_uops, fs_utot, fs_ufixed
    if fs_unsafe > 0:
        fs_uops += 1
        fs_utot += 1
        return 0
    if fs_ufix:
        if fs_ufixed != fs_ucur:
            fs_ufixed = fs_ucur
            eputs(c3("unsafe-fix: ", fs_where(fsf_ln[fs_ucur]), concat(" ", fsf_n[fs_ucur])))
        return 0
    fs_die(concat(what, " is unsafe: put it in a `with unsafe:` block or mark the function @unsafe"))

def fs_provsite():
# provenance rule: a pointer made from an integer must come from an @unsafe function (not a `with unsafe:` block)
    global fs_pbad, fs_pn
    if not fs_prov:
        return 0
    fs_pn += 1
    ok = fs_bop(fsf_at[fs_ucur], 136, 0)
    k = "ok"
    if not ok:
        k = "OUTSIDE @unsafe"
        fs_pbad += 1
    eputs(c4("prov: ", fs_where(tl[fp]), c3(" ", fsf_n[fs_ucur], " int->ptr "), k))

def fs_die(msg):
# report the original file/line (fs_include splices included files into one token stream)
    ln = tl[fp]
    if ln >= 1 and ln <= fsx_n:
        fi = fsx_f[ln - 1]
        ln = fsx_l[ln - 1]
        if fi != 0:
            msg = c3(fsx_fn[fi], ": ", msg)
    die(ln, msg)

def fs_isop(o):
    return tk[fp] == K_OP and str_eq(tv[fp], o)

def fs_isid(s):
    return tk[fp] == K_ID and str_eq(tv[fp], s)

def fs_expect(o):
    global fp
    if not fs_isop(o):
        fs_die(c3("expected '", o, "'"))
    fp += 1

def fs_ident():
    global fp
    if tk[fp] != K_ID:
        fs_die("expected identifier")
    fp += 1
    return tv[fp - 1]

def fs_newlab():
    global fs_lab
    fs_lab += 1
    return concat(".LF", str(fs_lab))

def fs_push():
    global fs_dep
    e("push %rax")
    fs_dep += 1

def fs_pop(r):
    global fs_dep
    e(concat("pop ", r))
    fs_dep -= 1

# ---- types ----
def ft_add(k, el, sz, al, sg, n, nm):
    global nft
    ftgi[nft] = -1
    fsk[nft] = k
    ftel[nft] = el
    ftsz[nft] = sz
    ftal[nft] = al
    ftsg[nft] = sg
    ftn[nft] = n
    ftname[nft] = nm
    ftf0[nft] = 0
    ftfn[nft] = 0
    ftdef[nft] = 1
    nft += 1
    return nft - 1

def ft_init():
    ft_add(4, 0, 0, 1, 0, 0, "void")
    ft_add(0, 0, 1, 1, 1, 0, "i8")
    ft_add(0, 0, 2, 2, 1, 0, "i16")
    ft_add(0, 0, 4, 4, 1, 0, "i32")
    ft_add(0, 0, 8, 8, 1, 0, "i64")
    ft_add(0, 0, 1, 1, 0, 0, "u8")
    ft_add(0, 0, 2, 2, 0, 0, "u16")
    ft_add(0, 0, 4, 4, 0, 0, "u32")
    ft_add(0, 0, 8, 8, 0, 0, "u64")
    ft_add(0, 0, 1, 1, 0, 0, "bool")
    ft_add(0, 0, 8, 8, 1, 0, "int")
    ft_add(6, 0, 8, 8, 0, 0, "f64")
    ft_add(6, 0, 4, 4, 0, 0, "f32")

def ft_ptr(t):
    i = 0
    while i < nft:
        if fsk[i] == 1 and ftel[i] == t and ftsg[i] == 0:
            return i
        i += 1
    return ft_add(1, t, 8, 8, 0, 0, "ptr")

def ft_nptr(t):
# nptr[T] (= ?ptr[T]): may be null; must be checked before use
    i = 0
    while i < nft:
        if fsk[i] == 1 and ftel[i] == t and ftsg[i] == 1:
            return i
        i += 1
    return ft_add(1, t, 8, 8, 1, 0, "nptr")

def ft_isnptr(t):
    return fsk[t] == 1 and ftsg[t] == 1

def ft_isnn(t):
    return fsk[t] == 1 and ftsg[t] != 1

def ft_bptr(t, sg):
# own[T] (sg 2), ref[T] (3), mut[T] (4): non-null pointers with ownership rules
    i = 0
    while i < nft:
        if fsk[i] == 1 and ftel[i] == t and ftsg[i] == sg:
            return i
        i += 1
    nm = "own"
    if sg == 3:
        nm = "ref"
    elif sg == 4:
        nm = "mut"
    return ft_add(1, t, 8, 8, sg, 0, nm)

def ft_isaff(t):
    return fsk[t] == 1 and ftsg[t] >= 2

def fs_isbname(nm):
    return str_eq(nm, "own") or str_eq(nm, "ref") or str_eq(nm, "mut")

def ft_arr(t, n):
    i = 0
    while i < nft:
        if fsk[i] == 3 and ftel[i] == t and ftn[i] == n:
            return i
        i += 1
    return ft_add(3, t, ftsz[t] * n, ftal[t], 0, n, "array")

def ft_slice(t):
# slice[T]: 16-byte (ptr, len) header
    i = 0
    while i < nft:
        if fsk[i] == 5 and ftel[i] == t:
            return i
        i += 1
    return ft_add(5, t, 16, 8, 0, 0, "slice")

def ft_isint(t):
    return fsk[t] == 0

def ft_agg(t):
    return fsk[t] == 2 or fsk[t] == 3 or fsk[t] == 5

def ft_prim(nm):
    if str_eq(nm, "int") or str_eq(nm, "isize"):
        return FT_I64
    if str_eq(nm, "uint") or str_eq(nm, "usize") or str_eq(nm, "addr"):
        return FT_U64
    if str_eq(nm, "byte") or str_eq(nm, "char"):
        return FT_U8
    if str_eq(nm, "f64"):
        return FT_F64
    if str_eq(nm, "f32"):
        return FT_F32
    i = 0
    while i < 10:
        if str_eq(ftname[i], nm):
            return i
        i += 1
    return -1

def ft_struct(nm):
    i = 11
    while i < nft:
        if fsk[i] == 2 and str_eq(ftname[i], nm):
            return i
        i += 1
    return -1

def fs_type():
    global fp
    nm = fs_ident()
    t = ft_prim(nm)
    b = fs_tbound(nm)
    g = fs_gfind(nm, 1)
    if b >= 0:
        t = b
    elif g >= 0:
        if not fs_isop("["):
            fs_die(c3("generic struct ", nm, " needs type arguments: write Name[T]"))
        fp += 1
        t = fs_ginst(g, fs_targs())
    elif str_eq(nm, "ptr"):
        if fs_isop("["):
            fp += 1
            el = fs_type()
            fs_expect("]")
            t = ft_ptr(el)
        else:
            t = ft_ptr(FT_U8)
    elif str_eq(nm, "nptr"):
        fs_expect("[")
        el = fs_type()
        fs_expect("]")
        t = ft_nptr(el)
    elif str_eq(nm, "slice"):
        fs_expect("[")
        el = fs_type()
        fs_expect("]")
        t = ft_slice(el)
    elif fs_isbname(nm) and fs_isop("["):
        fp += 1
        el = fs_type()
        fs_expect("]")
        sg = 2
        if str_eq(nm, "ref"):
            sg = 3
        elif str_eq(nm, "mut"):
            sg = 4
        t = ft_bptr(el, sg)
    elif t < 0:
        t = ft_struct(nm)
        if t < 0:
            fs_die(concat("unknown type ", nm))
    while fs_isop("["):
        fp += 1
        n = fs_ceval()
        fs_expect("]")
        t = ft_arr(t, n)
    return t

def fs_istype(p):
    if tk[p] != K_ID:
        return 0
    if fs_tbound(tv[p]) >= 0 or fs_gfind(tv[p], 1) >= 0:
        return 1
    if ft_prim(tv[p]) >= 0 or str_eq(tv[p], "ptr") or ((str_eq(tv[p], "slice") or str_eq(tv[p], "nptr") or fs_isbname(tv[p])) and tk[p + 1] == K_OP and str_eq(tv[p + 1], "[")):
        return 1
    return ft_struct(tv[p]) >= 0

def ft_join(a, b):
    if a == FT_LIT:
        return b
    if b == FT_LIT:
        return a
    if fsk[a] != 0 or fsk[b] != 0:
        return a
    if ftsz[a] > ftsz[b]:
        return a
    if ftsz[b] > ftsz[a]:
        return b
    if not ftsg[a]:
        return a
    return b

def ft_sg(t):
    if fsk[t] != 0:
        return 0
    return ftsg[t]

def fs_field(t, nm):
    i = ftf0[t]
    while i < ftf0[t] + ftfn[t]:
        if str_eq(ffn[i], nm):
            return i
        i += 1
    die(tl[fp], c4("no field ", nm, " in struct ", ftname[t]))
    return -1

# ---- compile-time constants ----
def fs_const(nm):
    i = 0
    while i < nfsc:
        if str_eq(fsc_n[i], nm):
            return i
        i += 1
    return -1

def fs_parse_dec(s):
    v = 0
    i = 0
    while i < len(s):
        v = v * 10 + char_at(s, i) - 48
        i += 1
    return v

def fs_cprim():
    global fp
    if tk[fp] == K_NUM:
        fp += 1
        return tv[fp - 1]
    if fs_isid("__bigparse"):
        fp += 2
        v = fs_parse_dec(tv[fp])
        fp += 2
        return v
    if fs_isop("("):
        fp += 1
        v = fs_ceval()
        fs_expect(")")
        return v
    if fs_isop("-"):
        fp += 1
        return 0 - fs_cprim()
    if fs_isop("~"):
        fp += 1
        return -1 - fs_cprim()
    if fs_isid("True"):
        fp += 1
        return 1
    if fs_isid("False") or fs_isid("None"):
        fp += 1
        return 0
    if fs_isid("ord"):
        fp += 2
        v = char_at(tv[fp], 0)
        fp += 2
        return v
    if fs_isid("sizeof"):
        fp += 2
        t = fs_type()
        fs_expect(")")
        return ftsz[t]
    if fs_isid("offsetof"):
        fp += 2
        t = fs_type()
        fs_expect(",")
        k = fs_field(t, fs_ident())
        fs_expect(")")
        return ffo[k]
    if tk[fp] == K_ID:
        c = fs_const(tv[fp])
        if c >= 0:
            fp += 1
            return fsc_v[c]
    fs_die("expected a compile-time constant")
    return 0

def fs_cmul():
    global fp
    v = fs_cprim()
    while fs_isop("*") or fs_isop("//") or fs_isop("/") or fs_isop("%"):
        o = tv[fp]
        fp += 1
        r = fs_cprim()
        if str_eq(o, "*"):
            v = v * r
        elif str_eq(o, "%"):
            v = v % r
        else:
            v = v // r
    return v

def fs_cadd():
    global fp
    v = fs_cmul()
    while fs_isop("+") or fs_isop("-"):
        o = tv[fp]
        fp += 1
        r = fs_cmul()
        if str_eq(o, "+"):
            v = v + r
        else:
            v = v - r
    return v

def fs_cshift():
    global fp
    v = fs_cadd()
    while fs_isop("<<") or fs_isop(">>"):
        o = tv[fp]
        fp += 1
        r = fs_cadd()
        if str_eq(o, "<<"):
            v = fs_shl(v, r)
        else:
            v = fs_shr(v, r)
    return v

def fs_ceval():
    global fp
    v = fs_cshift()
    while fs_isop("&") or fs_isop("|") or fs_isop("^"):
        o = tv[fp]
        fp += 1
        r = fs_cshift()
        if str_eq(o, "&"):
            v = fs_bop(v, r, 0)
        elif str_eq(o, "|"):
            v = fs_bop(v, r, 1)
        else:
            v = fs_bop(v, r, 2)
    return v

# ---- symbol lookup ----
def fs_local(nm):
    i = nfsl - 1
    while i >= 0:
        if str_eq(fsl_n[i], nm):
            return i
        i -= 1
    return -1

def fs_newlocal(nm, t):
    global nfsl, fs_frame
    a = ftal[t]
    if a < 8:
        a = 8
    sz = ftsz[t]
    if sz < 8:
        sz = 8
    fs_frame += sz
    while fs_frame % a != 0:
        fs_frame += 1
    fsl_n[nfsl] = nm
    fsl_t[nfsl] = t
    fsl_o[nfsl] = 0 - fs_frame
    fsl_nn[nfsl] = 0
    fsl_mv[nfsl] = 0
    fsl_bf[nfsl] = -1
    fsl_bk[nfsl] = 0
    fsl_sh[nfsl] = 0
    fsl_mu[nfsl] = 0
    fsl_bl[nfsl] = 0
    fsl_dead[nfsl] = 0
    nfsl += 1
    return nfsl - 1

def fs_func(nm):
    i = 0
    while i < nfsf:
        if str_eq(fsf_n[i], nm):
            return i
        i += 1
    return -1

def fs_glob(nm):
    i = 0
    while i < nfsg:
        if str_eq(fsg_n[i], nm):
            return i
        i += 1
    return -1

# ---- loads / stores / normalization ----
def fs_norm(t):
    if fsk[t] != 0:
        return 0
    sz = ftsz[t]
    if t == FT_BOOL:
        e("test %rax,%rax")
        e("setne %al")
        e("movzbl %al,%eax")
    elif sz == 1 and ftsg[t]:
        e("movsbq %al,%rax")
    elif sz == 1:
        e("movzbl %al,%eax")
    elif sz == 2 and ftsg[t]:
        e("movswq %ax,%rax")
    elif sz == 2:
        e("movzwl %ax,%eax")
    elif sz == 4 and ftsg[t]:
        e("movslq %eax,%rax")
    elif sz == 4:
        e("movl %eax,%eax")
    return 0

def fs_maddr():
# memory operand text for the current lvalue
    if fs_mode == 2:
        return concat(str(fs_moff), "(%rbp)")
    if fs_mode == 3:
        return concat(fs_mlab, "(%rip)")
    return "(%rax)"

def fs_mat():
    global fs_mode
    if fs_mode == 2 or fs_mode == 3:
        e(c3("lea ", fs_maddr(), ",%rax"))
    fs_mode = 1

def fs_load(t):
# load the lvalue (fs_mode) of type t into rax
    global fs_mode
    if ft_agg(t):
        fs_mat()
        fs_mode = 0
        return 0
    m = fs_maddr()
    sz = ftsz[t]
    sg = ft_sg(t)
    if fs_mode == 2:
        e(c3("mov ", m, ",%rax"))
    elif sz == 8:
        e(c3("mov ", m, ",%rax"))
    elif sz == 4 and sg:
        e(c3("movslq ", m, ",%rax"))
    elif sz == 4:
        e(c3("movl ", m, ",%eax"))
    elif sz == 2 and sg:
        e(c3("movswq ", m, ",%rax"))
    elif sz == 2:
        e(c3("movzwl ", m, ",%eax"))
    elif sg:
        e(c3("movsbq ", m, ",%rax"))
    else:
        e(c3("movzbl ", m, ",%eax"))
    fs_mode = 0
    return 0

def fs_m8(m):
# memory operand 8 bytes past m
    if str_eq(m, "(%rcx)"):
        return "8(%rcx)"
    if contains(m, "(%rbp)"):
        return concat(str(fs_parse_int(substr(m, 0, len(m) - 6)) + 8), "(%rbp)")
    return concat(substr(m, 0, len(m) - 6), "+8(%rip)")

def fs_parse_int(s):
    if char_at(s, 0) == 45:
        return 0 - fs_parse_dec(substr(s, 1, len(s)))
    return fs_parse_dec(s)

def fs_store(t, m):
# value in rax -> memory operand m; m == "(%rcx)" or slot/label
    global fs_sretv
    if fsk[t] == 5:
    # slice header copy: rax = address of the source header
        e("mov (%rax),%rdx")
        e(concat("mov %rdx,", m))
        e("mov 8(%rax),%rdx")
        e(concat("mov %rdx,", fs_m8(m)))
        return 0
    if fsk[t] == 2 and fs_sretv:
    # a struct-returning call's result (a frame temporary) is copied into place
        fs_sretv = 0
        e(c3("lea ", m, ",%rdi"))
        e("mov %rax,%rsi")
        e(c3("mov $", str(ftsz[t]), ",%rcx"))
        e("rep movsb")
        return 0
    if ft_agg(t):
        fs_die("cannot assign a whole struct/array (use memcpy)")
    sz = ftsz[t]
    if contains(m, "(%rbp)"):
        sz = 8
    if sz == 8:
        e(c3("mov %rax,", m, ""))
    elif sz == 4:
        e(concat("mov %eax,", m))
    elif sz == 2:
        e(concat("mov %ax,", m))
    else:
        e(concat("mov %al,", m))

def fs_rv():
    if fs_mode != 0:
        fs_load(fs_ety)

def fs_conv(to):
# convert rax (type fs_ety) for assignment/passing to type to
    global fs_ety
    if fsk[to] == 1 and fsk[fs_ety] == 1 and ftel[to] != ftel[fs_ety]:
        fs_pmis(fs_ety, to)
    if (fsk[to] == 6 or fsk[fs_ety] == 6) and fs_ety != to and fsk[to] != 4:
        if fsk[to] == 6 and fs_ety == FT_LIT:
            fs_i2f(to, "%rax")
            fs_ety = to
            return 0
        fs_die("implicit float conversion: use f64(x), f32(x) or i64(x)")
    if (fsk[to] == 5 or fsk[fs_ety] == 5) and fs_ety != to:
        fs_die("slice type mismatch (slices convert only to the same slice[T])")
    if ft_isnn(to) and fs_ety != to:
        if ft_isnptr(fs_ety):
            fs_die("nptr[T] may be null: check it (if p != 0:) before using it as a ptr[T]")
        if fs_ety == FT_LIT and fs_lastimm == 0:
            fs_die("null (0) cannot be a ptr[T]; declare it nptr[T]")
    if fsk[to] == 1 and fs_ety != to and fsk[fs_ety] == 1 and (ftsg[to] >= 2 or ftsg[fs_ety] >= 2):
        fs_bconv(to)
    if fsk[to] == 1 and fsk[fs_ety] == 0 and not (fs_ety == FT_LIT and fs_lastimm == 0):
        fs_unsafe_op("an integer-to-pointer conversion")
        fs_provsite()
    if fsk[to] == 0 and fs_ety != to:
        if not (fsk[fs_ety] == 0 and ftsz[fs_ety] <= ftsz[to] and ft_sg(fs_ety) == ftsg[to] and fs_ety != FT_LIT and to != FT_BOOL):
            fs_norm(to)
    fs_ety = to

def fs_tfull(t):
# full spelling of a type for diagnostics: ptr[ptr[B32]]
    if fsk[t] == 1:
        return c4(ftname[t], "[", fs_tfull(ftel[t]), "]")
    return ftname[t]

def fs_pmis(s, to):
# implicit pointer conversion between different element types (e.g. addr(p) of a ptr[T] gives
# ptr[ptr[T]], which used to pass silently where a ptr[T] was expected); reinterpret with ptr[T](x)
    m = c4("pointer type mismatch: got ", fs_tfull(s), ", expected ", fs_tfull(to))
    if fsk[ftel[s]] == 1 and ftel[ftel[s]] == ftel[to]:
        m = concat(m, " (addr() of a pointer gives a pointer to the pointer: pass the pointer itself)")
    else:
        m = concat(m, " (use an explicit ptr[T](x) cast to reinterpret)")
    fs_die(m)

def fs_bconv(to):
# pointer conversions involving own/ref/mut
    s = fs_ety
    if ftsg[s] == 4 and ftsg[to] == 3 and ftel[s] == ftel[to]:
        return 0
    if ftsg[s] >= 2 and ftsg[to] < 2:
        fs_unsafe_op(c3("converting a ", ftname[s], "[T] to a raw pointer"))
        return 0
    if ftsg[s] < 2:
        fs_unsafe_op(c3("converting a raw pointer to ", ftname[to], "[T]"))
        return 0
    if ftsg[s] == 2:
        fs_die(c3("cannot use an own[T] as a ", ftname[to], "[T]: pass borrow(x) or borrow_mut(x)"))
    fs_die(c4("cannot convert ", ftname[s], "[T] to ", concat(ftname[to], "[T]")))

def fs_lname(l):
    return c3("`", fsl_n[l], "`")

def fs_badd(x, k):
    if k == 1:
        fsl_sh[x] = fsl_sh[x] + 1
    else:
        fsl_mu[x] = fsl_mu[x] + 1
    fsl_bl[x] = tl[fp]

def fs_brel(x, k):
    if k == 1:
        fsl_sh[x] = fsl_sh[x] - 1
    else:
        fsl_mu[x] = fsl_mu[x] - 1

def fs_lchk(l, lh):
# ownership checks for a use of local l; fp is just past its name
    t = fsl_t[l]
    if fsl_dead[l]:
        fs_die(concat(fs_lname(l), " is a borrow whose block has ended"))
    if fsl_mu[l] > 0:
        fs_die(c3(fs_lname(l), " is mutably borrowed (at ", concat(fs_where(fsl_bl[l]), "): use the borrow until its block ends")))
    if not ft_isaff(t):
        return 0
    whole = not (tk[fp] == K_OP and (str_eq(tv[fp], ".") or str_eq(tv[fp], "[")))
    if lh and whole:
        if ftsg[t] >= 3:
            fs_die("a borrow local cannot be reassigned")
        if fsl_sh[l] > 0:
            fs_die(c3("cannot assign to ", fs_lname(l), c3(" while it is borrowed (at ", fs_where(fsl_bl[l]), ")")))
        if not fsl_mv[l]:
            fs_die(concat("assigning to ", concat(fs_lname(l), " would leak the own[T] it holds: move or free it first")))
        fsl_mv[l] = 0
        return 0
    if fsl_mv[l]:
        fs_die(c4("use of moved value ", fs_lname(l), " (moved at ", concat(fs_where(fsl_mv[l]), ")")))
    if not whole:
        return 0
    if ftsg[t] == 2:
        if fsl_sh[l] > 0:
            fs_die(c3("cannot move ", fs_lname(l), c3(" while it is borrowed (at ", fs_where(fsl_bl[l]), ")")))
        fsl_mv[l] = tl[fp - 1]
    elif ftsg[t] == 4 and fs_argd > 0:
    # passing a mut[T] reborrows it for the call: no other use of it in the same call
        fs_tb_push(l, 2)

def fs_tb_push(x, k):
    global nfstb
    fs_badd(x, k)
    fs_tb[nfstb] = x
    fs_tbk[nfstb] = k
    nfstb += 1

def fs_wstore(p0, bare):
# a store through the local named at p0 (x.f = v, x[i] = v)
    if bare or tk[p0] != K_ID:
        return 0
    l = fs_local(tv[p0])
    if l < 0 or not ft_isaff(fsl_t[l]):
        return 0
    if ftsg[fsl_t[l]] == 3:
        fs_die(concat("cannot assign through ", concat(fs_lname(l), ": a ref[T] is a shared borrow (use borrow_mut / mut[T])")))
    if fsl_sh[l] > 0:
        fs_die(c3("cannot assign through ", fs_lname(l), c3(" while it is borrowed (at ", fs_where(fsl_bl[l]), ")")))

def fs_mvsnap():
    sn = list(nfsl + 1)
    i = 0
    while i < nfsl:
        sn[i] = fsl_mv[i]
        i += 1
    sn[nfsl] = nfsl
    return sn

def fs_mvset(sn):
    n = sn[len(sn) - 1]
    i = 0
    while i < n:
        fsl_mv[i] = sn[i]
        i += 1

def fs_mvor(acc, sn):
# union of moved states (acc may be 0 = none yet)
    if acc == 0:
        return sn
    n = sn[len(sn) - 1]
    if acc[len(acc) - 1] < n:
        n = acc[len(acc) - 1]
    r = list(n + 1)
    i = 0
    while i < n:
        r[i] = acc[i]
        if r[i] == 0:
            r[i] = sn[i]
        i += 1
    r[n] = n
    return r

def fs_loopend(e0):
    global fs_term
    if not fs_term:
        fs_mvloop(e0)
    fs_mvset(fs_mvor(e0, e0))
    if fs_lbm[nfsloop] != 0:
        fs_mvset(fs_mvor(fs_lbm[nfsloop], e0))
    fs_term = 0

def fs_mvloop(e0):
# end of a loop body / continue: an outer own local moved here would be moved again next iteration
    n = e0[len(e0) - 1]
    i = 0
    while i < n:
        if fsl_mv[i] and not e0[i]:
            fs_die(c3(fs_lname(i), " is moved inside a loop (moved at ", concat(fs_where(fsl_mv[i]), "); it would be used again on the next iteration")))
        i += 1

def fs_bkill(n0):
# leaving a block: borrows held by locals declared in it end
    i = n0
    while i < nfsl:
        if fsl_bk[i] > 0 and not fsl_dead[i]:
            if fsl_bf[i] >= 0:
                fs_brel(fsl_bf[i], fsl_bk[i])
            fsl_dead[i] = 1
        i += 1

def fs_battach(l, vt):
# a new local l of borrow type vt was just initialized
    global fs_bpend
    if fsk[vt] != 1 or ftsg[vt] < 3:
        if fs_bpend >= 0:
            fs_bpend = -1
        return 0
    fsl_bk[l] = ftsg[vt] - 2
    if fs_bpend >= 0:
        x = fs_bpend
        k = fs_bpk
        fs_bpend = -1
        fsl_bf[l] = x
        fsl_bk[l] = k
        fs_badd(x, k)
        return 0
    if ftsg[vt] == 4:
        fs_die("a mut[T] cannot be copied (that would alias it): pass it directly")
    if fs_rsrc >= 0 and fsl_bf[fs_rsrc] >= 0:
        fsl_bf[l] = fsl_bf[fs_rsrc]
        fs_badd(fsl_bf[l], 1)

def fs_inmain(ln):
    if ln >= 1 and ln <= fsx_n:
        return fsx_f[ln - 1] == 0
    return 1

def fs_safechk(ln, what):
    if fs_safe and fs_inmain(ln):
        fs_die(c3("safe mode (# forge: safe): ", what, " is not allowed here; put unsafe code in a library .fsi"))

# ---- expressions ----
def fs_imm(v):
    global fs_ety, fs_mode, fs_lastimm
    if v >= -2147483648 and v <= 2147483647:
        if v == 0:
            e("xor %eax,%eax")
        else:
            e(c3("mov $", str(v), ",%rax"))
    else:
        e(c3("movabs $", str(v), ",%rax"))
    fs_lastimm = v
    fs_ety = FT_LIT
    fs_mode = 0

def fs_strlit(s):
    global nfsrod, fs_ety, fs_mode
    lb = concat(".LFS", str(nfsrod))
    b = ""
    i = 0
    while i < len(s):
        b = c3(b, str(char_at(s, i)), ",")
        i += 1
    fs_rod[nfsrod] = c4(lb, ": .byte ", b, "0\n")
    nfsrod += 1
    e(c3("lea ", lb, "(%rip),%rax"))
    fs_ety = ft_ptr(FT_U8)
    fs_mode = 0

def fs_args(maxn, ptys):
# evaluate comma-separated args to the stack; returns count
    global fp, fs_argd, nfstb, fs_sretv
    fs_expect("(")
    n = 0
    pi = 0
    fs_argd += 1
    m0 = nfstb
    while not fs_isop(")"):
        fs_rexpr()
        fs_sretv = 0
        sl = 0
        if ptys >= 0 and pi < fsf_np[ptys] and fsf_ext[ptys] and fsk[fs_ety] == 1 and fsk[fsp_t[fsf_p0[ptys] + pi]] == 0:
            fs_die("a pointer passed to C keeps its provenance: declare the extern parameter ptr[T] or nptr[T], not an integer")
        if ptys >= 0 and pi < fsf_np[ptys]:
            fs_conv(fsp_t[fsf_p0[ptys] + pi])
            sl = fsk[fsp_t[fsf_p0[ptys] + pi]] == 5
        st = ptys >= 0 and pi < fsf_np[ptys] and fsk[fsp_t[fsf_p0[ptys] + pi]] == 2
        if st:
        # SysV struct by value: its 8-byte words in order (exact loads, no read past the end)
            t = fsp_t[fsf_p0[ptys] + pi]
            nw = (ftsz[t] + 7) // 8
            e("mov %rax,%rsi")
            w = 0
            while w < nw:
                fs_ldw("%rsi", 8 * w, ftsz[t] - 8 * w)
                fs_push()
                w += 1
            n += nw
        elif sl:
        # a slice argument travels in two registers: ptr, len
            e("mov 8(%rax),%rcx")
            e("mov (%rax),%rax")
            fs_push()
            e("mov %rcx,%rax")
            fs_push()
            n += 2
        else:
            fs_push()
            n += 1
        pi += 1
        if fs_isop(","):
            fp += 1
    fp += 1
    while nfstb > m0:
        nfstb -= 1
        fs_brel(fs_tb[nfstb], fs_tbk[nfstb])
    fs_argd -= 1
    if ptys >= 0 and pi != fsf_np[ptys]:
        fs_die(concat("wrong argument count for ", fsf_n[ptys]))
    if n > maxn:
        fs_die("too many argument words (max 16)")
    return n

def fs_ldw(base, off, rem):
# rax = the word at off(base), reading only rem bytes when rem < 8 (zero-extended); clobbers rdx
    if rem >= 8:
        e(c3("mov ", concat(str(off), c3("(", base, ")")), ",%rax"))
        return 0
    e("xor %eax,%eax")
    b = rem - 1
    while b >= 0:
        e("shl $8,%rax")
        e(c3("movzbl ", concat(str(off + b), c3("(", base, ")")), ",%edx"))
        e("or %rdx,%rax")
        b -= 1
    return 0

def fs_fx(t, r, x):
# move float rax-style register r (64-bit name) into xmm x
    if t == FT_F32:
        e(c4("movd ", fs_r32(r), ",%xmm", str(x)))
    else:
        e(c4("movq ", r, ",%xmm", str(x)))

def fs_xf(t, x, r):
# move xmm x into register r (f32 zero-extended)
    if t == FT_F32:
        e(c4("movd %xmm", str(x), ",", fs_r32(r)))
    else:
        e(c4("movq %xmm", str(x), ",", r))

def fs_r32(r):
    if str_eq(r, "%rax"):
        return "%eax"
    if str_eq(r, "%rcx"):
        return "%ecx"
    return "%edx"

def fs_i2f(t, r):
# signed integer in r -> float t in r
    if t == FT_F32:
        e(c3("cvtsi2ssq ", r, ",%xmm2"))
    else:
        e(c3("cvtsi2sdq ", r, ",%xmm2"))
    fs_xf(t, 2, r)

def fs_fsfx(t):
    if t == FT_F32:
        return "ss"
    return "sd"

def fs_hasflt(t):
# does a struct/array contain a float anywhere (SysV would class it SSE)
    if fsk[t] == 6:
        return 1
    if fsk[t] == 3:
        return fs_hasflt(ftel[t])
    if fsk[t] == 2:
        i = ftf0[t]
        while i < ftf0[t] + ftfn[t]:
            if fs_hasflt(fft[i]):
                return 1
            i += 1
    return 0

def fs_fbin(o, lt, rt):
# float + - * / : left in rax, right in rcx
    global fs_ety
    t = lt
    if fsk[lt] != 6:
        t = rt
    if lt != t:
        if lt != FT_LIT:
            fs_die("mixed float/integer arithmetic: convert with f64(x) / f32(x)")
        fs_i2f(t, "%rax")
    if rt != t:
        if rt != FT_LIT:
            fs_die("mixed float arithmetic: f32 and f64 (or an integer) need an explicit conversion")
        fs_i2f(t, "%rcx")
    op = ""
    if str_eq(o, "+"):
        op = "add"
    elif str_eq(o, "-"):
        op = "sub"
    elif str_eq(o, "*"):
        op = "mul"
    elif str_eq(o, "/"):
        op = "div"
    else:
        fs_die(c3("operator ", o, " is not defined on floats"))
    fs_fx(t, "%rax", 0)
    fs_fx(t, "%rcx", 1)
    e(c3(op, fs_fsfx(t), " %xmm1,%xmm0"))
    fs_xf(t, 0, "%rax")
    fs_ety = t

def fs_fcmp(k, lt, rt):
# float comparison (false when unordered, except !=)
    global fs_ety
    t = lt
    if fsk[lt] != 6:
        t = rt
    if lt != t:
        if lt != FT_LIT:
            fs_die("comparing a float with a non-literal integer: convert with f64(x) / f32(x)")
        fs_i2f(t, "%rax")
    if rt != t:
        if rt != FT_LIT:
            fs_die("comparing different float types: convert explicitly")
        fs_i2f(t, "%rcx")
    fs_fx(t, "%rax", 0)
    fs_fx(t, "%rcx", 1)
    u = concat("ucomi", fs_fsfx(t))
    if k == 2 or k == 3:
        e(concat(u, " %xmm0,%xmm1"))
    else:
        e(concat(u, " %xmm1,%xmm0"))
    if k == 0:
        e("sete %al")
        e("setnp %cl")
        e("and %cl,%al")
    elif k == 1:
        e("setne %al")
        e("setp %cl")
        e("or %cl,%al")
    elif k == 2 or k == 4:
        e("seta %al")
    else:
        e("setae %al")
    e("movzbl %al,%eax")
    fs_ety = FT_BOOL

def fs_fcast(src, t):
# explicit conversions with floats; returns 1 when handled
    global fs_ety
    if fsk[t] == 6:
        if fsk[src] == 6:
            if src != t:
                fs_fx(src, "%rax", 0)
                if t == FT_F32:
                    e("cvtsd2ss %xmm0,%xmm0")
                else:
                    e("cvtss2sd %xmm0,%xmm0")
                fs_xf(t, 0, "%rax")
        elif fsk[src] == 0:
            fs_i2f(t, "%rax")
        else:
            fs_die("only integers and floats convert to a float")
        fs_ety = t
        return 1
    if fsk[src] == 6:
        if fsk[t] != 0:
            fs_die("a float converts only to an integer or a float")
        fs_fx(src, "%rax", 0)
        e(c3("cvtt", fs_fsfx(src), "2si %xmm0,%rax"))
        fs_norm(t)
        fs_ety = t
        return 1
    return 0

def fs_pwords(t):
# argument words of a parameter of type t: slice 2, struct ceil(size / 8), else 1
    if fsk[t] == 5:
        return 2
    if fsk[t] == 2:
        return (ftsz[t] + 7) // 8
    return 1

def fs_cls(t, off, w):
# SysV classification bits of eightbyte w for a value of type t at byte offset off: 1 INTEGER, 2 SSE
    lo = 8 * w
    if off + ftsz[t] <= lo or off >= lo + 8:
        return 0
    if fsk[t] == 6:
        return 2
    c = 0
    if fsk[t] == 3:
        es = ftsz[ftel[t]]
        if es <= 0:
            return 1
        k = 0
        while k * es < ftsz[t]:
            c = c | fs_cls(ftel[t], off + k * es, w)
            k += 1
        return c
    if fsk[t] == 2:
        i = ftf0[t]
        while i < ftf0[t] + ftfn[t]:
            c = c | fs_cls(fft[i], off + ffo[i], w)
            i += 1
        return c
    return 1

def fs_wsse(t, w):
# is eightbyte w of struct t class SSE (only float fields in it); otherwise INTEGER
    return fs_cls(t, 0, w) == 2

def fs_nsse(t):
# number of SSE eightbytes of a register-passed struct
    n = 0
    w = 0
    while w < fs_pwords(t):
        if fs_wsse(t, w):
            n += 1
        w += 1
    return n

def fs_smem(t):
# SysV class MEMORY: a struct over 16 bytes travels on the stack (and is returned via a hidden pointer)
    return fsk[t] == 2 and ftsz[t] > 16

def fs_layout(f):
# fill fs_wd for f's parameters (after a hidden struct-return pointer in rdi); returns the word count
    r = 0
    w = 0
    s = 0
    x = 0
    if fs_smem(fsf_ret[f]):
        fs_wd[0] = 0
        r = 1
        w = 1
    i = 0
    while i < fsf_np[f]:
        t = fsp_t[fsf_p0[f] + i]
        nw = fs_pwords(t)
        j = 0
        if fsk[t] == 6 and x < 8:
        # SysV class SSE: xmm0..xmm7 (destinations 50..57)
            fs_wd[w] = 50 + x
            x += 1
        elif fsk[t] == 6:
            fs_wd[w] = 100 + s
            s += 1
        elif fsk[t] == 2 and not fs_smem(t) and r + nw - fs_nsse(t) <= 6 and x + fs_nsse(t) <= 8:
        # struct <= 16 bytes: each eightbyte in the next xmm (SSE) or GPR (INTEGER)
            while j < nw:
                if fs_wsse(t, j):
                    fs_wd[w + j] = 50 + x
                    x += 1
                else:
                    fs_wd[w + j] = r
                    r += 1
                j += 1
        elif fsk[t] != 2 and r + nw <= 6:
            while j < nw:
                fs_wd[w + j] = r + j
                j += 1
            r += nw
        else:
            while j < nw:
                fs_wd[w + j] = 100 + s + j
                j += 1
            s += nw
        w += nw
        i += 1
    return w

def fs_fcall(f, target):
# a direct call of f: SysV layout, struct results land in a frame temporary whose address ends in rax
    global fs_ety, fs_mode, fs_sretv
    rt = fsf_ret[f]
    tmp = -1
    h = 0
    if fsk[rt] == 2:
        tmp = fs_newlocal("", rt)
        if fs_smem(rt):
            e(c3("lea ", str(fsl_o[tmp]), "(%rbp),%rax"))
            fs_push()
            h = 1
    n = fs_args(16, f) + h
    fs_layout(f)
    fs_sysv_call(n, target, 1)
    fs_ety = rt
    fs_mode = 0
    if fsk[rt] == 6:
        fs_xf(rt, 0, "%rax")
    if tmp >= 0:
        if not fs_smem(rt):
            fs_retw(rt, fsl_o[tmp], 1)
        e(c3("lea ", str(fsl_o[tmp]), "(%rbp),%rax"))
        fs_sretv = 1
    elif fsk[rt] != 6:
    # SysV leaves upper bits of narrow return values unspecified
        fs_norm(fs_ety)
    return 0

FS_RREG = ["%rax", "%rdx"]
def fs_retw(t, o, st):
# struct <= 16 bytes returned in registers: INTEGER eightbytes in rax, rdx and SSE ones in xmm0, xmm1
# (in order); st 1 stores them to o(%rbp) after a call, 0 loads them from o(%rbp) before ret
    ri = 0
    xi = 0
    w = 0
    while w < fs_pwords(t):
        m = c3(str(o + 8 * w), "(%rbp)", "")
        if fs_wsse(t, w):
            if st:
                e(c4("movq %xmm", str(xi), ",", m))
            else:
                e(c4("movq ", m, ",%xmm", str(xi)))
            xi += 1
        else:
            if st:
                e(c4("mov ", FS_RREG[ri], ",", m))
            else:
                e(c4("mov ", m, ",", FS_RREG[ri]))
            ri += 1
        w += 1
    return 0

FS_AREG = ["%rdi", "%rsi", "%rdx", "%rcx", "%r8", "%r9"]
FS_WREG = ["%rcx", "%rdx", "%r8", "%r9"]
def fs_sysv_call(n, target, lay):
# the n argument words are on the stack (word 0 deepest); SysV: words 0-5 in registers, 6.. on the
# stack with word 6 lowest, rsp 16-aligned at the call
    global fs_dep
    if not lay:
        i = 0
        while i < n:
            fs_wd[i] = i
            if i >= 6:
                fs_wd[i] = 94 + i
            i += 1
    k = 0
    i = 0
    while i < n:
        if fs_wd[i] >= 100:
            k += 1
        i += 1
    if k == 0 and n <= 6 and not lay:
        i = n - 1
        while i >= 0:
            fs_pop(FS_AREG[i])
            i -= 1
        fs_callsite(target)
        return 0
    sz = 8 * k
    if (fs_dep + k) % 2:
        sz += 8
    if sz > 0:
        e(c3("sub $", str(sz), ",%rsp"))
    i = 0
    while i < n:
        if fs_wd[i] >= 100:
            e(c3("mov ", str(sz + 8 * (n - 1 - i)), "(%rsp),%rax"))
            e(c3("mov %rax,", str(8 * (fs_wd[i] - 100)), "(%rsp)"))
        i += 1
    i = 0
    nx = 0
    while i < n:
        if fs_wd[i] >= 50 and fs_wd[i] < 100:
            e(c4("movq ", str(sz + 8 * (n - 1 - i)), "(%rsp),%xmm", str(fs_wd[i] - 50)))
            nx += 1
        elif fs_wd[i] < 100:
            e(c4("mov ", str(sz + 8 * (n - 1 - i)), "(%rsp),", FS_AREG[fs_wd[i]]))
        i += 1
    if nx > 0:
    # al = vector registers used (needed by variadic callees, harmless otherwise)
        e(c3("mov $", str(nx), ",%eax"))
    e(concat("call ", target))
    e(c3("add $", str(sz + 8 * n), ",%rsp"))
    fs_dep -= n
    return 0


FS_ATN = ["atomic_load", "atomic_store", "atomic_swap", "atomic_fetch_add", "atomic_cas", "atomic_fence"]
FS_ORDN = ["relaxed", "acquire", "release", "acq_rel", "seq_cst"]

def fs_aord():
# memory-ordering argument: one of relaxed/acquire/release/acq_rel/seq_cst (a bare word)
    global fp
    if tk[fp] != K_ID:
        fs_die("expected a memory ordering: relaxed, acquire, release, acq_rel or seq_cst")
    o = find(FS_ORDN, 5, tv[fp])
    if o < 0:
        fs_die(concat("unknown memory ordering ", tv[fp]))
    fp += 1
    return o

def fs_aptr(wr):
# first argument of a typed atomic: a non-null pointer to an integer of 1/2/4/8 bytes; pushed
    global fp
    fs_rexpr()
    t = fs_ety
    if not ft_isnn(t):
        fs_die("typed atomics need a non-null ptr[T] (or own/ref/mut) to an integer")
    if wr and ftsg[t] == 3:
        fs_die("atomic write through a ref[T]: use mut[T] or ptr[T]")
    el = ftel[t]
    if fsk[el] != 0 or el == FT_BOOL:
        fs_die("typed atomics need an integer element type")
    fs_push()
    return el

def fs_asfx(el):
    sz = ftsz[el]
    if sz == 1:
        return "b"
    if sz == 2:
        return "w"
    if sz == 4:
        return "l"
    return "q"

def fs_areg(el, r):
# sub-register of rax/rcx/rdx for el's width (r: "a", "c", "d")
    sz = ftsz[el]
    if sz == 1:
        return c3("%", r, "l")
    if sz == 2:
        return c3("%", r, "x")
    if sz == 4:
        return c3("%e", r, "x")
    return c3("%r", r, "x")

def fs_atyped(nm):
# Phase 4.6 typed atomics with explicit orderings (safe: the pointer is typed and non-null).
# x86-64 TSO mapping: loads are plain mov (acquire for free); relaxed/release stores are plain mov;
# seq_cst stores use xchg; RMW ops are lock-prefixed (full barriers); atomic_fence(seq_cst) is mfence,
# weaker fences only stop compiler reordering (the backend never reorders memory accesses).
    global fp, fs_ety, fs_mode
    k = find(FS_ATN, 6, nm)
    if k < 0:
        return 0
    fp += 1
    if k == 5:
        o = fs_aord()
        fs_expect(")")
        if o == 0:
            fs_die("atomic_fence(relaxed) orders nothing")
        if o == 4:
            e("mfence")
        fs_ety = FT_VOID
        fs_mode = 0
        return 1
    el = fs_aptr(k != 0)
    fs_expect(",")
    sx = fs_asfx(el)
    if k == 0:
        o = fs_aord()
        if o == 2 or o == 3:
            fs_die("atomic_load cannot be release/acq_rel")
        fs_pop("%rdx")
        e(c4("mov", sx, " (%rdx),", fs_areg(el, "a")))
    else:
        fs_rexpr()
        fs_conv(el)
        if k == 4:
            fs_push()
            fs_expect(",")
            fs_rexpr()
            fs_conv(el)
            e("mov %rax,%rcx")
            fs_pop("%rax")
        else:
            e("mov %rax,%rcx")
        fs_expect(",")
        o = fs_aord()
        fs_pop("%rdx")
        if k == 1:
            if o == 1 or o == 3:
                fs_die("atomic_store cannot be acquire/acq_rel")
            if o == 4:
                e(c4("xchg", sx, c3(" ", fs_areg(el, "c"), ","), "(%rdx)"))
            else:
                e(c4("mov", sx, c3(" ", fs_areg(el, "c"), ","), "(%rdx)"))
            fs_expect(")")
            fs_ety = FT_VOID
            fs_mode = 0
            return 1
        if k == 2:
            e(c4("xchg", sx, c3(" ", fs_areg(el, "c"), ","), "(%rdx)"))
        elif k == 3:
            e(c4("lock xadd", sx, c3(" ", fs_areg(el, "c"), ","), "(%rdx)"))
        else:
            e(c4("lock cmpxchg", sx, c3(" ", fs_areg(el, "c"), ","), "(%rdx)"))
        if k != 4:
            e("mov %rcx,%rax")
    fs_expect(")")
    fs_ety = el
    fs_norm(el)
    fs_mode = 0
    return 1

def fs_callf(f):
    global fs_ety, fs_mode
    fs_fcall(f, fsf_n[f])

def fs_gfind(nm, k):
    i = 0
    while i < nfsgen:
        if fsgen_k[i] == k and str_eq(fsgen_n[i], nm):
            return i
        i += 1
    return -1

def fs_tbound(nm):
    i = fs_bn0
    while i < fs_bn:
        if str_eq(fs_bnm[i], nm):
            return fs_bty[i]
        i += 1
    return -1

def fs_gendef():
# prescan: record a @generic def/struct and skip it
    global fp, nfsgen, nfsgtp, fs_dgn
    g = nfsgen
    fsgen_n[g] = ""
    fsgen_k[g] = -1
    nfsgen += 1
    fsgen_at[g] = fs_datt
    fsgen_tp0[g] = nfsgtp
    fsgen_ntp[g] = fs_dgn
    i = 0
    while i < fs_dgn:
        fsgtp[nfsgtp] = fs_dgen[i]
        nfsgtp += 1
        i += 1
    fs_dgn = 0
    if fs_isid("def"):
        fsgen_k[g] = 0
        fsgen_pos[g] = fp
        if fs_func(tv[fp + 1]) >= 0 or fs_gfind(tv[fp + 1], 0) >= 0:
            fs_die(concat("duplicate function ", tv[fp + 1]))
        fsgen_n[g] = tv[fp + 1]
        while not fs_isop(")"):
            if tk[fp] == K_EOF:
                fs_die("bad generic def")
            fp += 1
        while not fs_isop(":"):
            if tk[fp] == K_EOF or tk[fp] == K_NL:
                fs_die("bad generic def")
            fp += 1
        fs_skip_suite()
        return 0
    if fs_isid("struct") or fs_isid("class"):
        fsgen_k[g] = 1
        if ft_struct(tv[fp + 1]) >= 0 or fs_gfind(tv[fp + 1], 1) >= 0:
            fs_die(concat("duplicate struct ", tv[fp + 1]))
        fsgen_n[g] = tv[fp + 1]
        fp += 2
        fsgen_pos[g] = fp
        fs_skip_suite()
        return 0
    fs_die("@generic(...) must decorate a def or a struct")

def fs_targs():
# type arguments after '[' up to ']' (consumed); returns them as a list with the count in the last slot
    global fp
    a = list(17)
    n = 0
    while not fs_isop("]"):
        if n >= 16:
            fs_die("too many type arguments")
        a[n] = fs_type()
        n += 1
        if fs_isop(","):
            fp += 1
    fp += 1
    a[16] = n
    return a

def fs_tname(t):
    return ftname[t]

def fs_genv(g, a):
# push the binding frame of generic g with arguments a; returns the old frame base
    global fs_bn, fs_bn0
    old = fs_bn0
    nb = fs_bn
    i = 0
    while i < fsgen_ntp[g]:
        fs_bnm[nb + i] = fsgtp[fsgen_tp0[g] + i]
        fs_bty[nb + i] = a[i]
        i += 1
    fs_bn0 = nb
    fs_bn = nb + fsgen_ntp[g]
    return old

def fs_genv_pop(old):
    global fs_bn, fs_bn0
    fs_bn = fs_bn0
    fs_bn0 = old

def fs_ginst(g, a):
# the instance of generic g for type arguments a: a function index (def) or a struct type
    global fp, nfsi, nfsia, fs_signame, fs_datt, nft
    if a[16] != fsgen_ntp[g]:
        fs_die(c4(fsgen_n[g], " takes ", str(fsgen_ntp[g]), " type argument(s)"))
    n = fsgen_ntp[g]
    i = 0
    while i < nfsi:
        if fsi_g[i] == g:
            j = 0
            while j < n and fsia[fsi_a0[i] + j] == a[j]:
                j += 1
            if j == n:
                return fsi_r[i]
        i += 1
    ii = nfsi
    nfsi += 1
    fsi_g[ii] = g
    fsi_a0[ii] = nfsia
    nm = concat(fsgen_n[g], "[")
    j = 0
    while j < n:
        fsia[nfsia] = a[j]
        nfsia += 1
        if j > 0:
            nm = concat(nm, ", ")
        nm = concat(nm, ftname[a[j]])
        j += 1
    nm = concat(nm, "]")
    fp0 = fp
    old = fs_genv(g, a)
    if fsgen_k[g] == 1:
        t = ft_add(2, 0, 0, 1, 0, 0, nm)
        fsi_r[ii] = t
        ftgi[t] = ii
        fp = fsgen_pos[g]
        fs_struct_body(t, fs_bop(fsgen_at[g], 32, 0))
    else:
        fs_signame = c3(fsgen_n[g], "__g", str(ii))
        fs_datt = fsgen_at[g]
        fp = fsgen_pos[g]
        f = fs_sig(0)
        fs_signame = ""
        fsf_gi[f] = ii
        fsi_r[ii] = f
    fs_genv_pop(old)
    fp = fp0
    return fsi_r[ii]

def fs_tskip(p):
# end of the type expression at p
    p += 1
    while fs_isop2(p, "["):
        d = 0
        while 1:
            if fs_isop2(p, "["):
                d += 1
            elif fs_isop2(p, "]"):
                d -= 1
                if d == 0:
                    break
            elif tk[p] == K_EOF:
                return p
            p += 1
        p += 1
    return p

def fs_unify(g, b, p, t):
# match the type written at p (in generic g's source) against concrete type t, filling bindings b
    nm = tv[p]
    j = 0
    while j < fsgen_ntp[g]:
        if str_eq(fsgtp[fsgen_tp0[g] + j], nm) and not fs_isop2(p + 1, "["):
            if b[j] < 0 and t != FT_LIT:
                b[j] = t
            return p + 1
        j += 1
    if fs_isop2(p + 1, "[") and (str_eq(nm, "ptr") or str_eq(nm, "nptr") or str_eq(nm, "slice") or fs_isbname(nm)):
        if (fsk[t] == 1 or fsk[t] == 5) and t != FT_LIT:
            q = fs_unify(g, b, p + 2, ftel[t])
            if fs_isop2(q, "]"):
                return fs_tskip(p)
        return fs_tskip(p)
    sg = fs_gfind(nm, 1)
    if sg >= 0 and fs_isop2(p + 1, "[") and fsk[t] == 2 and t >= 0 and ftgi[t] >= 0 and fsi_g[ftgi[t]] == sg:
        q = p + 2
        k = 0
        while k < fsgen_ntp[sg] and not fs_isop2(q, "]"):
            q = fs_unify(g, b, q, fsia[fsi_a0[ftgi[t]] + k])
            k += 1
            if fs_isop2(q, ","):
                q += 1
        return fs_tskip(p)
    return fs_tskip(p)

def fs_ginfer(g):
# infer generic g's type arguments from the argument types at fp ('('), without emitting code
    global fp, nout, fs_argd, nfstb, fs_bpend, fs_dep, fs_uops, fs_utot, fs_nbc, fs_nbe
    fp0 = fp
    nout0 = nout
    sn = fs_mvsnap()
    d0 = fs_dep
    u0 = fs_uops
    u1 = fs_utot
    c0 = fs_nbc
    c1 = fs_nbe
    tb0 = nfstb
    ats = list(16)
    na = 0
    fp += 1
    fs_argd += 1
    while not fs_isop(")"):
        fs_rexpr()
        if na < 16:
            ats[na] = fs_ety
        na += 1
        if fs_isop(","):
            fp += 1
    fs_argd -= 1
    while nfstb > tb0:
        nfstb -= 1
        fs_brel(fs_tb[nfstb], fs_tbk[nfstb])
    nout = nout0
    fp = fp0
    fs_mvset(sn)
    fs_dep = d0
    fs_uops = u0
    fs_utot = u1
    fs_nbc = c0
    fs_nbe = c1
    fs_bpend = -1
    b = list(17)
    i = 0
    while i < 16:
        b[i] = -1
        i += 1
    # walk the parameter list: def NAME ( p: T, ... )
    p = fsgen_pos[g] + 3
    k = 0
    while not fs_isop2(p, ")") and tk[p] != K_EOF:
        p += 1
        if fs_isop2(p, ":"):
            p += 1
            if k < na:
                p = fs_unify(g, b, p, ats[k])
            else:
                p = fs_tskip(p)
        k += 1
        if fs_isop2(p, ","):
            p += 1
    i = 0
    while i < fsgen_ntp[g]:
        if b[i] < 0:
            k = 0
            while k < na:
                if ats[k] == FT_LIT:
                    b[i] = FT_I64
                k += 1
            if b[i] < 0:
                fs_die(c4("cannot infer type parameter ", fsgtp[fsgen_tp0[g] + i], " of ", concat(fsgen_n[g], ": write f[T](...)")))
        i += 1
    b[16] = fsgen_ntp[g]
    return b

def fs_callsite(target):
    global fs_dep
    odd = fs_dep % 2
    if odd:
        e("sub $8,%rsp")
    e(concat("call ", target))
    if odd:
        e("add $8,%rsp")

def fs_borrow(k):
# borrow(x) -> ref[T], borrow_mut(x) -> mut[T]; x is an own[T] (or, for borrow, a mut[T]) local
    global fp, fs_ety, fs_mode, fs_bpend, fs_bpk
    fp += 1
    x = -1
    if tk[fp] == K_ID:
        x = fs_local(tv[fp])
    if x < 0 or not fs_isop2(fp + 1, ")") or not (ftsg[fsl_t[x]] == 2 or (k == 1 and ftsg[fsl_t[x]] == 4)) or fsk[fsl_t[x]] != 1:
        fs_die("borrow()/borrow_mut() take a local own[T] variable (borrow() also takes a mut[T])")
    fp += 1
    if fsl_dead[x]:
        fs_die(concat(fs_lname(x), " is a borrow whose block has ended"))
    if fsl_mv[x]:
        fs_die(c4("borrow of moved value ", fs_lname(x), " (moved at ", concat(fs_where(fsl_mv[x]), ")")))
    if fsl_mu[x] > 0:
        fs_die(c3("cannot borrow ", fs_lname(x), c3(": it is already mutably borrowed (at ", fs_where(fsl_bl[x]), ")")))
    if k == 2 and fsl_sh[x] > 0:
        fs_die(c3("cannot borrow ", fs_lname(x), c3(" as mutable: it is already borrowed (at ", fs_where(fsl_bl[x]), ")")))
    fs_expect(")")
    e(c3("mov ", str(fsl_o[x]), "(%rbp),%rax"))
    fs_ety = ft_bptr(ftel[fsl_t[x]], 2 + k)
    fs_mode = 0
    if fs_argd > 0:
        fs_tb_push(x, k)
    else:
        fs_bpend = x
        fs_bpk = k
    return 1

def fs_intrin(nm):
# returns 1 if nm( ... ) was compiled as an intrinsic
    global fp, fs_ety, fs_mode, fs_moff, fs_lab
    if find(FS_UNSAFE_FNS, len(FS_UNSAFE_FNS), nm) >= 0:
        fs_unsafe_op(concat(nm, "()"))
    if (str_eq(nm, "borrow") or str_eq(nm, "borrow_mut")) and fs_func(nm) < 0:
        if str_eq(nm, "borrow_mut"):
            return fs_borrow(2)
        return fs_borrow(1)
    one = ["cli", "sti", "hlt", "pause", "int3", "mfence", "lfence", "sfence", "wbinvd", "ud2", "cpu_relax"]
    k = find(one, 11, nm)
    if k >= 0:
        fs_args(0, -1)
        if k == 10:
            e("pause")
        else:
            e(nm)
        e("xor %eax,%eax")
        fs_ety = FT_VOID
        fs_mode = 0
        return 1
    if str_eq(nm, "len") and fs_func("len") < 0:
        fp += 1
        fs_postfix()
        t = fs_ety
        if fsk[t] == 3:
            fs_imm(ftn[t])
            fs_ety = FT_U64
        elif fsk[t] == 5:
            if fs_mode == 0:
                fs_die("len() of a slice needs an lvalue")
            fs_mat()
            e("mov 8(%rax),%rax")
            fs_ety = FT_U64
        else:
            fs_die("len() needs an array or a slice")
        fs_mode = 0
        fs_expect(")")
        return 1
    if str_eq(nm, "slice") and fs_func("slice") < 0:
    # slice(p, n): a slice[T] over n elements at ptr[T] p (the caller vouches for p..p+n)
        fs_unsafe_op("slice(p, n) over a raw pointer")
        fp += 1
        fs_rexpr()
        if fsk[fs_ety] != 1:
            fs_die("slice(p, n) needs a ptr[T] first argument")
        st = ft_slice(ftel[fs_ety])
        fs_push()
        fs_expect(",")
        fs_rexpr()
        fs_expect(")")
        l = fs_newlocal(concat(" sl", str(fs_lab)), st)
        fs_lab += 1
        e(c3("mov %rax,", str(fsl_o[l] + 8), "(%rbp)"))
        fs_pop("%rax")
        e(c3("mov %rax,", str(fsl_o[l]), "(%rbp)"))
        fs_mode = 2
        fs_moff = fsl_o[l]
        fs_ety = st
        return 1
    if str_eq(nm, "asm"):
        fp += 1
        while tk[fp] == K_STR:
            e(tv[fp])
            fp += 1
            if fs_isop(","):
                fp += 1
        fs_expect(")")
        fs_ety = FT_VOID
        fs_mode = 0
        return 1
    ld = ["load8", "load16", "load32", "load64", "vload8", "vload16", "vload32", "vload64"]
    k = find(ld, 8, nm)
    if k >= 0:
        fs_args(1, -1)
        fs_pop("%rax")
        fs_mode = 1
        t = FT_U8 + k % 4
        fs_load(t)
        fs_ety = t
        return 1
    st = ["store8", "store16", "store32", "store64", "vstore8", "vstore16", "vstore32", "vstore64"]
    k = find(st, 8, nm)
    if k >= 0:
        fs_args(2, -1)
        fs_pop("%rax")
        fs_pop("%rcx")
        fs_store(FT_U8 + k % 4, "(%rcx)")
        fs_ety = FT_VOID
        return 1
    if str_eq(nm, "outb") or str_eq(nm, "outw") or str_eq(nm, "outl"):
        fs_args(2, -1)
        fs_pop("%rax")
        fs_pop("%rdx")
        if str_eq(nm, "outb"):
            e("out %al,%dx")
        elif str_eq(nm, "outw"):
            e("out %ax,%dx")
        else:
            e("out %eax,%dx")
        fs_ety = FT_VOID
        return 1
    if str_eq(nm, "inb") or str_eq(nm, "inw") or str_eq(nm, "inl"):
        fs_args(1, -1)
        fs_pop("%rdx")
        e("xor %eax,%eax")
        if str_eq(nm, "inb"):
            e("in %dx,%al")
            fs_ety = FT_U8
        elif str_eq(nm, "inw"):
            e("in %dx,%ax")
            fs_ety = FT_U16
        else:
            e("in %dx,%eax")
            fs_ety = FT_U32
        fs_mode = 0
        return 1
    if str_eq(nm, "lgdt") or str_eq(nm, "lidt") or str_eq(nm, "invlpg"):
        fs_args(1, -1)
        fs_pop("%rax")
        e(concat(nm, " (%rax)"))
        fs_ety = FT_VOID
        return 1
    if str_eq(nm, "ltr"):
        fs_args(1, -1)
        fs_pop("%rax")
        e("ltr %ax")
        fs_ety = FT_VOID
        return 1
    if len(nm) == 8 and str_eq(substr(nm, 0, 7), "read_cr"):
        fs_args(0, -1)
        e(c3("mov %cr", substr(nm, 7, 8), ",%rax"))
        fs_ety = FT_U64
        fs_mode = 0
        return 1
    if len(nm) == 9 and str_eq(substr(nm, 0, 8), "write_cr"):
        fs_args(1, -1)
        fs_pop("%rax")
        e(c3("mov %rax,%cr", substr(nm, 8, 9), ""))
        fs_ety = FT_VOID
        return 1
    if fs_atyped(nm):
        return 1
    # atomics (x86-64 is TSO: plain loads are acquire; xchg/lock ops are full barriers)
    an = ["atomic_load32", "atomic_load64", "atomic_store32", "atomic_store64", "atomic_xchg32", "atomic_xchg64", "atomic_add32", "atomic_add64", "atomic_cas32", "atomic_cas64", "atomic_or32", "atomic_or64", "atomic_and32", "atomic_and64"]
    k = find(an, 14, nm)
    if k >= 0:
        w = k % 2
        rr = "%ecx"
        if w:
            rr = "%rcx"
        op = k // 2
        if op == 0:
            fs_args(1, -1)
            fs_pop("%rax")
            if w:
                e("mov (%rax),%rax")
            else:
                e("movl (%rax),%eax")
        elif op == 4:
            fs_args(3, -1)
            fs_pop("%rcx")
            fs_pop("%rax")
            fs_pop("%rdx")
            e(c3("lock cmpxchg ", rr, ",(%rdx)"))
            if not w:
                e("movl %eax,%eax")
        else:
            fs_args(2, -1)
            fs_pop("%rcx")
            fs_pop("%rdx")
            if op == 1 or op == 2:
                e(c3("xchg ", rr, ",(%rdx)"))
            elif op == 3:
                e(c3("lock xadd ", rr, ",(%rdx)"))
            elif op == 5:
                e(c3("lock or ", rr, ",(%rdx)"))
            else:
                e(c3("lock and ", rr, ",(%rdx)"))
            if w:
                e("mov %rcx,%rax")
            else:
                e("movl %ecx,%eax")
        fs_ety = FT_U64
        if not w:
            fs_ety = FT_U32
        if op == 1 or op == 5 or op == 6:
            fs_ety = FT_VOID
        fs_mode = 0
        return 1
    if str_eq(nm, "rdtsc"):
        fs_args(0, -1)
        e("rdtsc")
        e("shl $32,%rdx")
        e("or %rdx,%rax")
        fs_ety = FT_U64
        fs_mode = 0
        return 1
    if str_eq(nm, "rdmsr"):
        fs_args(1, -1)
        fs_pop("%rcx")
        e("rdmsr")
        e("shl $32,%rdx")
        e("or %rdx,%rax")
        fs_ety = FT_U64
        fs_mode = 0
        return 1
    if str_eq(nm, "wrmsr"):
        fs_args(2, -1)
        fs_pop("%rax")
        fs_pop("%rcx")
        e("mov %rax,%rdx")
        e("shr $32,%rdx")
        e("wrmsr")
        fs_ety = FT_VOID
        return 1
    if str_eq(nm, "memset") or str_eq(nm, "memcpy"):
        fs_args(3, -1)
        fs_pop("%rcx")
        if str_eq(nm, "memset"):
            fs_pop("%rax")
            fs_pop("%rdi")
            e("mov %rdi,%rdx")
            e("rep stosb")
        else:
            fs_pop("%rsi")
            fs_pop("%rdi")
            e("mov %rdi,%rdx")
            e("rep movsb")
        e("mov %rdx,%rax")
        fs_ety = ft_ptr(FT_U8)
        fs_mode = 0
        return 1
    if str_eq(nm, "call_ptr") or str_eq(nm, "call_efi"):
        efi = str_eq(nm, "call_efi")
        if efi:
            fs_efi_call()
        else:
            n = fs_args(7, -1)
            i = n - 1
            while i >= 1:
                fs_pop(FS_AREG[i - 1])
                i -= 1
            fs_pop("%r11")
            fs_callsite("*%r11")
        fs_ety = FT_U64
        fs_mode = 0
        return 1
    return 0

def fs_efi_call():
# Microsoft x64: args 1-4 in rcx/rdx/r8/r9, 5+ on the stack above 32 bytes of shadow space
    global fs_dep
    n = fs_args(10, -1)
    na = n - 1
    k = 0
    if na > 4:
        k = na - 4
    i = 1
    while i <= na and i <= 4:
        e(c3(c3("mov ", str(8 * (n - 1 - i)), "(%rsp),"), FS_WREG[i - 1], ""))
        i += 1
    e(c3("mov ", str(8 * (n - 1)), "(%rsp),%r11"))
    sz = 32 + 8 * k
    if (fs_dep + k) % 2:
        sz += 8
    e(c3("sub $", str(sz), ",%rsp"))
    j = 0
    while j < k:
        e(c3("mov ", str(8 * (n - 1 - (5 + j)) + sz), "(%rsp),%rax"))
        e(c3("mov %rax,", str(32 + 8 * j), "(%rsp)"))
        j += 1
    e("call *%r11")
    e(c3("add $", str(sz + 8 * n), ",%rsp"))
    fs_dep -= n

def fs_primary():
    global fp, fs_ety, fs_mode, fs_moff, fs_mlab, fs_lhs, fs_lhsl
    lh = fs_lhs
    fs_lhs = 0
    if tk[fp] == K_NUM:
        fs_imm(tv[fp])
        fp += 1
        return 0
    if tk[fp] == K_FLT:
    # an f64 literal: its IEEE bits, built from two 32-bit halves
        bits: int = __fbits(float(tv[fp]))
        hi = (bits >> 32) & 4294967295
        lo = bits & 4294967295
        e(c3("mov $", str(hi), ",%eax"))
        e("shl $32,%rax")
        e(c3("mov $", str(lo), ",%ecx"))
        e("or %rcx,%rax")
        fs_ety = FT_F64
        fs_mode = 0
        fp += 1
        return 0
    if tk[fp] == K_STR:
        fs_strlit(tv[fp])
        fp += 1
        return 0
    if fs_isop("("):
        fp += 1
        fs_expr()
        fs_expect(")")
        return 0
    if tk[fp] != K_ID:
        fs_die("unexpected token in expression")
    nm = tv[fp]
    if str_eq(nm, "__bigparse") or str_eq(nm, "True") or str_eq(nm, "False") or str_eq(nm, "None") or str_eq(nm, "ord") or str_eq(nm, "sizeof") or str_eq(nm, "offsetof"):
        fs_imm(fs_cprim())
        if str_eq(nm, "True") or str_eq(nm, "False"):
            fs_ety = FT_BOOL
        return 0
    fp += 1
    gf = fs_gfind(nm, 0)
    if gf >= 0 and fs_local(nm) < 0:
        if fs_isop("["):
            fp += 1
            f = fs_ginst(gf, fs_targs())
        elif fs_isop("("):
            f = fs_ginst(gf, fs_ginfer(gf))
        else:
            fs_die(c3("generic function ", nm, " must be called (its address needs explicit type arguments and a call)"))
        if not fs_isop("("):
            fs_die("expected ( after generic type arguments")
        fs_callf(f)
        return 0
    if fs_isop("(") and fs_tbound(nm) >= 0 and fsk[fs_tbound(nm)] == 0:
        t = fs_tbound(nm)
        fp += 1
        fs_expr()
        fs_rv()
        fs_expect(")")
        fs_norm(t)
        fs_ety = t
        return 0
    if fs_isop("("):
        if fs_intrin(nm):
            return 0
        if str_eq(nm, "addr"):
            fp += 1
            fs_postfix()
            if fs_mode == 0:
                fs_die("addr() needs an lvalue")
            fs_mat()
            fs_ety = ft_ptr(fs_ety)
            fs_mode = 0
            fs_expect(")")
            return 0
        t = ft_prim(nm)
        if t >= 0:
            fp += 1
            fs_expr()
            fs_rv()
            fs_expect(")")
            if fs_fcast(fs_ety, t):
                return 0
            fs_norm(t)
            fs_ety = t
            return 0
        f = fs_func(nm)
        if f < 0:
            fs_die(concat("unknown function ", nm))
        fs_fcall(f, nm)
        return 0
    if (str_eq(nm, "ptr") or str_eq(nm, "nptr") or fs_isbname(nm)) and fs_isop("[") and fs_local(nm) < 0:
        fp -= 1
        t = fs_type()
        fs_expect("(")
        fs_expr()
        fs_rv()
        src = fs_ety
        if src == FT_LIT and fs_lastimm == 0:
            if ft_isnn(t):
                fs_die("ptr[T](0) would be a null ptr[T]: use nptr[T] (0 converts to nptr[T] without a cast)")
        elif fsk[src] == 0:
            fs_unsafe_op("an integer-to-pointer cast")
            fs_provsite()
        elif fsk[src] == 1:
            if ftsg[src] != ftsg[t] and (ftsg[src] >= 2 or ftsg[t] >= 2):
                fs_unsafe_op("a cast to or from own/ref/mut")
            elif ft_isnptr(src) and ft_isnn(t):
                fs_unsafe_op("an nptr-to-ptr cast (check p != 0 instead)")
            elif ftel[src] != ftel[t]:
                fs_unsafe_op("a pointer reinterpret cast")
        fs_expect(")")
        fs_ety = t
        return 0
    c = fs_const(nm)
    if c >= 0:
        fs_imm(fsc_v[c])
        fs_ety = fsc_t[c]
        return 0
    l = fs_local(nm)
    if l >= 0:
        fs_lchk(l, lh)
        fs_mode = 2
        fs_moff = fsl_o[l]
        fs_ety = fsl_t[l]
        if lh:
            fs_lhsl = l
        elif ft_isnptr(fs_ety) and fsl_nn[l]:
            fs_ety = ft_ptr(ftel[fs_ety])
        return 0
    g = fs_glob(nm)
    if g >= 0:
        fs_mode = 3
        fs_mlab = nm
        fs_ety = fsg_t[g]
        return 0
    if fs_func(nm) >= 0:
        e(c3("lea ", nm, "(%rip),%rax"))
        fs_ety = FT_U64
        fs_mode = 0
        return 0
    fp -= 1
    fs_die(concat("unknown name ", nm))

def fs_bfail(lenop):
# bounds-check failure path: index in rcx, length operand lenop; never returns
    global nfsrod
    if fs_func("forge_bounds_fail") >= 0:
        ln = tl[fp]
        fi = 0
        if ln >= 1 and ln <= fsx_n:
            fi = fsx_f[ln - 1]
            ln = fsx_l[ln - 1]
        if len(fsx_lb[fi]) == 0:
            fsx_lb[fi] = concat(".LFB", str(nfsrod))
            nm = fsx_fn[fi]
            b = ""
            i = 0
            while i < len(nm):
                b = c3(b, str(char_at(nm, i)), ",")
                i += 1
            fs_rod[nfsrod] = c4(fsx_lb[fi], ": .byte ", b, "0\n")
            nfsrod += 1
        e(c3("mov ", lenop, ",%rdx"))
        e("mov %rcx,%rsi")
        e(c3("mov $", str(ln), ",%edi"))
        e(c3("lea ", fsx_lb[fi], "(%rip),%rcx"))
        fs_callsite("forge_bounds_fail")
    e("ud2")

def fs_bcheck(lenop):
# trap unless rcx < lenop (unsigned: negative indices fail too)
    global fs_nbc
    fs_nbc += 1
    l = fs_newlab()
    e(c3("cmp ", lenop, ",%rcx"))
    e(concat("jb ", l))
    fs_bfail(lenop)
    emit_raw(concat(l, ":\n"))

def fs_bsafe(base, t):
# 1 if the index at fp+1 (a bare loop variable) is proven in range for base (name) of type t
    if len(base) == 0 or tk[fp + 1] != K_ID or tk[fp + 2] != K_OP or not str_eq(tv[fp + 2], "]"):
        return 0
    v = tv[fp + 1]
    i = nfsb - 1
    while i >= 0:
        if str_eq(fsb_v[i], v):
            if str_eq(fsb_x[i], base):
                return 1
            if fsk[t] == 3 and fsb_c[i] >= 0 and fsb_c[i] <= ftn[t]:
                return 1
            return 0
        i -= 1
    return 0

def fs_rngfact():
# at the first range() argument: recognise range(len(X)), range(K), range(C, len(X)), range(C, K)
# with literal C >= 0.  Stores a candidate fact in slot 255 and returns 255, or -1.
    p = fp
    if tk[p] == K_NUM and fs_isop2(p + 1, ","):
        if tv[p] < 0:
            return -1
        p += 2
    elif tk[p] != K_NUM and fs_isop2(p + 1, ","):
        return -1
    q = -1
    x = " "
    c = -1
    if tk[p] == K_ID and str_eq(tv[p], "len") and fs_isop2(p + 1, "(") and tk[p + 2] == K_ID and fs_isop2(p + 3, ")"):
        nm = tv[p + 2]
        l = fs_local(nm)
        if l >= 0 and fsk[fsl_t[l]] == 5:
            x = nm
        elif l >= 0 and fsk[fsl_t[l]] == 3:
            c = ftn[fsl_t[l]]
        elif l < 0 and fs_glob(nm) >= 0 and fsk[fsg_t[fs_glob(nm)]] == 3:
            c = ftn[fsg_t[fs_glob(nm)]]
        else:
            return -1
        q = p + 4
    elif tk[p] == K_NUM:
        c = tv[p]
        q = p + 1
    elif tk[p] == K_ID and fs_local(tv[p]) < 0 and fs_const(tv[p]) >= 0:
        c = fsc_v[fs_const(tv[p])]
        q = p + 1
    if q < 0 or not fs_isop2(q, ")") and not fs_isop2(q, ","):
        return -1
    fsb_x[255] = x
    fsb_c[255] = c
    return 255

def fs_bodyok(vn, x):
# the loop body (from the ':' after range(...)) never assigns or takes addr() of vn or x
    p = fp
    while tk[p] != K_EOF and not fs_isop2(p, ":"):
        p += 1
    p += 1
    d = 0
    if tk[p] == K_NL:
        p += 1
        if tk[p] != K_IND:
            return 1
    while tk[p] != K_EOF:
        if tk[p] == K_IND:
            d += 1
        elif tk[p] == K_DED:
            d -= 1
            if d <= 0:
                return 1
        elif tk[p] == K_NL and d == 0:
            return 1
        elif tk[p] == K_ID and (str_eq(tv[p], vn) or str_eq(tv[p], x)):
            if tk[p + 1] == K_OP and fs_asgop(tv[p + 1]):
                return 0
            if tk[p - 1] == K_ID and str_eq(tv[p - 1], "for"):
                return 0
            if fs_isop2(p - 1, "(") and tk[p - 2] == K_ID and str_eq(tv[p - 2], "addr"):
                return 0
        p += 1
    return 1

def fs_asgop(o):
    return str_eq(o, "=") or str_eq(o, "+=") or str_eq(o, "-=") or str_eq(o, "*=") or str_eq(o, "//=") or str_eq(o, "%=") or str_eq(o, "|=") or str_eq(o, "^=") or str_eq(o, "<<=") or str_eq(o, ">>=") or str_eq(o, "/=") or str_eq(o, ":") or str_eq(o, "&=")

def fs_postfix():
    global fp, fs_ety, fs_mode, fs_nbe, fs_lastnm
    base = ""
    if tk[fp] == K_ID:
        base = tv[fp]
    fs_primary()
    if fs_mode != 2 and fs_mode != 3:
        base = ""
    while 1:
        if fs_isop("["):
            t = fs_ety
            if (fsk[t] == 3 or fsk[t] == 5) and fs_mode != 0:
                fs_mat()
            elif fsk[t] == 1:
                if ftsg[t] == 1:
                    fs_die("nptr[T] may be null: check it (if p != 0:) before indexing")
                if not (tk[fp + 1] == K_NUM and tv[fp + 1] == 0 and fs_isop2(fp + 2, "]")):
                    fs_unsafe_op("indexing a ptr[T] (unchecked; use a slice)")
                fs_rv()
            else:
                fs_die("indexing needs a pointer, array or slice")
            el = ftel[t]
            chk = fs_bchk and fsk[t] != 1
            if chk and fsk[t] == 3 and tk[fp + 1] == K_NUM and fs_isop2(fp + 2, "]"):
                if tv[fp + 1] >= ftn[t] or tv[fp + 1] < 0:
                    fs_die(c4("index ", str(tv[fp + 1]), " is out of bounds for an array of length ", str(ftn[t])))
                chk = 0
                fs_nbe += 1
            elif chk and fs_bsafe(base, t):
                chk = 0
                fs_nbe += 1
            fp += 1
            fs_push()
            if fsk[t] != 1 and (fs_isop(":") or fs_subsl()):
                fs_subslice(t, el)
                base = ""
                continue
            fs_expr()
            fs_rv()
            e("mov %rax,%rcx")
            fs_pop("%rax")
            if chk:
                if fsk[t] == 5:
                    fs_bcheck("8(%rax)")
                else:
                    fs_bcheck(concat("$", str(ftn[t])))
            if fsk[t] == 5:
                e("mov (%rax),%rax")
            if ftsz[el] != 1:
                e(c3("imul $", str(ftsz[el]), ",%rcx,%rcx"))
            e("add %rcx,%rax")
            fs_expect("]")
            fs_mode = 1
            fs_ety = el
            base = ""
        elif fs_isop("."):
            fp += 1
            t = fs_ety
            if fsk[t] == 2 and fs_mode != 0:
                fs_mat()
            elif fsk[t] == 1 and fsk[ftel[t]] == 2:
                if ftsg[t] == 1:
                    fs_die("nptr[T] may be null: check it (if p != 0:) before a field access")
                fs_rv()
                t = ftel[t]
            else:
                fs_die("field access needs a struct or pointer to struct")
            k = fs_field(t, fs_ident())
            if ffo[k] != 0:
                e(c3("add $", str(ffo[k]), ",%rax"))
            fs_mode = 1
            fs_ety = fft[k]
            base = ""
        else:
            return 0

def fs_subsl():
# is there a depth-0 ':' before the closing ']' (subslice x[a:b])?
    p = fp
    d = 0
    while tk[p] != K_NL and tk[p] != K_EOF:
        if tk[p] == K_OP:
            if str_eq(tv[p], "(") or str_eq(tv[p], "["):
                d += 1
            elif str_eq(tv[p], ")") or str_eq(tv[p], "]"):
                if d == 0:
                    return 0
                d -= 1
            elif d == 0 and str_eq(tv[p], ":"):
                return 1
        p += 1
    return 0

def fs_subslice(t, el):
# x[a:b] on an array or slice (base address pushed): bounds-checked 0 <= a <= b <= len -> new slice temp
    global fp, fs_ety, fs_mode, fs_moff, fs_nbc
    if fs_isop(":"):
        e("xor %eax,%eax")
    else:
        fs_expr()
        fs_rv()
    fs_push()
    fs_expect(":")
    if fs_isop("]"):
        e("mov $-1,%rax")
    else:
        fs_expr()
        fs_rv()
    fs_expect("]")
    e("mov %rax,%rcx")
    fs_pop("%rdx")
    fs_pop("%rax")
    # rax = base addr, rdx = lo, rcx = hi (-1 = len)
    if fsk[t] == 5:
        e("mov 8(%rax),%rsi")
        e("mov (%rax),%rax")
    else:
        e(c3("mov $", str(ftn[t]), ",%rsi"))
    l0 = fs_newlab()
    e("cmp $-1,%rcx")
    e(concat("jne ", l0))
    e("mov %rsi,%rcx")
    emit_raw(concat(l0, ":\n"))
    if fs_bchk:
        fs_nbc += 1
        lok = fs_newlab()
        lbad = fs_newlab()
        e("cmp %rsi,%rcx")
        e(concat("ja ", lbad))
        e("cmp %rcx,%rdx")
        e(concat("jbe ", lok))
        emit_raw(concat(lbad, ":\n"))
        fs_bfail("%rsi")
        emit_raw(concat(lok, ":\n"))
    if ftsz[el] != 1:
        e(c3("imul $", str(ftsz[el]), ",%rdx,%rdi"))
    else:
        e("mov %rdx,%rdi")
    e("add %rdi,%rax")
    e("sub %rdx,%rcx")
    st = ft_slice(el)
    tl2 = fs_newlocal(concat(" sl", str(fs_lab)), st)
    e(c3("mov %rax,", str(fsl_o[tl2]), "(%rbp)"))
    e(c3("mov %rcx,", str(fsl_o[tl2] + 8), "(%rbp)"))
    fs_mode = 2
    fs_moff = fsl_o[tl2]
    fs_ety = st

def fs_unary():
    global fp, fs_ety
    if fs_isop("-") or fs_isop("~") or fs_isop("+"):
        o = tv[fp]
        fp += 1
        fs_unary()
        fs_rv()
        if str_eq(o, "-") and fs_ety == FT_F64:
            e("mov $1,%ecx")
            e("shl $63,%rcx")
            e("xor %rcx,%rax")
        elif str_eq(o, "-") and fs_ety == FT_F32:
            e("xor $-2147483648,%eax")
        elif str_eq(o, "-"):
            e("neg %rax")
            fs_norm(fs_ety)
        elif str_eq(o, "~"):
            e("not %rax")
            fs_norm(fs_ety)
        return 0
    fs_postfix()

def fs_ovf(t, op):
# checked-ints mode: trap (ud2) when the result does not fit t
    if not fs_chk or fsk[t] != 0 or t == FT_BOOL:
        return 0
    l = fs_newlab()
    if ftsz[t] == 8:
        if ftsg[t] or t == FT_LIT:
            e(concat("jno ", l))
        elif str_eq(op, "*"):
            e(concat("jno ", l))
        else:
            e(concat("jnc ", l))
        e("ud2")
        emit_raw(concat(l, ":\n"))
        return 0
    e("mov %rax,%rdx")
    fs_norm(t)
    e("cmp %rax,%rdx")
    e(concat("je ", l))
    e("ud2")
    emit_raw(concat(l, ":\n"))

def fs_binop(o, lt, rt):
# left in rax, right in rcx
    global fs_ety
    if fsk[lt] == 6 or fsk[rt] == 6:
        fs_fbin(o, lt, rt)
        return 0
    if fsk[lt] == 1 and (str_eq(o, "+") or str_eq(o, "-")):
        sz = ftsz[ftel[lt]]
        if fsk[rt] == 1:
            e("sub %rcx,%rax")
            if sz > 1:
                e("cqo")
                e(c3("mov $", str(sz), ",%rcx"))
                e("idiv %rcx")
            fs_ety = FT_I64
            return 0
        if sz > 1:
            e(c3("imul $", str(sz), ",%rcx,%rcx"))
        if str_eq(o, "+"):
            e("add %rcx,%rax")
        else:
            e("sub %rcx,%rax")
        fs_ety = lt
        return 0
    t = ft_join(lt, rt)
    if fsk[t] != 0:
        t = FT_U64
    sg = ft_sg(t)
    if str_eq(o, "+"):
        e("add %rcx,%rax")
        fs_ovf(t, o)
    elif str_eq(o, "-"):
        e("sub %rcx,%rax")
        fs_ovf(t, o)
    elif str_eq(o, "*"):
        if sg or t == FT_LIT:
            e("imul %rcx,%rax")
        else:
            e("mul %rcx")
        fs_ovf(t, o)
    elif str_eq(o, "/") or str_eq(o, "//") or str_eq(o, "%"):
        if sg:
            e("cqo")
            e("idiv %rcx")
        else:
            e("xor %edx,%edx")
            e("div %rcx")
        if str_eq(o, "%"):
            e("mov %rdx,%rax")
    elif str_eq(o, "&"):
        e("and %rcx,%rax")
    elif str_eq(o, "|"):
        e("or %rcx,%rax")
    elif str_eq(o, "^"):
        e("xor %rcx,%rax")
    elif str_eq(o, "<<"):
        e("shl %cl,%rax")
    elif str_eq(o, ">>"):
        if sg:
            e("sar %cl,%rax")
        else:
            e("shr %cl,%rax")
    fs_norm(t)
    fs_ety = t

FS_PREC = ["|", "^", "&", "<<>>", "+-", "*///%"]

def fs_level_has(lv, o):
    if lv == 0:
        return str_eq(o, "|")
    if lv == 1:
        return str_eq(o, "^")
    if lv == 2:
        return str_eq(o, "&")
    if lv == 3:
        return str_eq(o, "<<") or str_eq(o, ">>")
    if lv == 4:
        return str_eq(o, "+") or str_eq(o, "-")
    return str_eq(o, "*") or str_eq(o, "/") or str_eq(o, "//") or str_eq(o, "%")

def fs_bin(lv):
    global fp
    if lv > 5:
        fs_unary()
        return 0
    fs_bin(lv + 1)
    while tk[fp] == K_OP and fs_level_has(lv, tv[fp]):
        o = tv[fp]
        fp += 1
        fs_rv()
        lt = fs_ety
        fs_push()
        fs_bin(lv + 1)
        fs_rv()
        rt = fs_ety
        e("mov %rax,%rcx")
        fs_pop("%rax")
        fs_binop(o, lt, rt)

FS_CMP = ["==", "!=", "<", "<=", ">", ">="]
FS_SCC = ["e", "ne", "l", "le", "g", "ge"]
FS_UCC = ["e", "ne", "b", "be", "a", "ae"]

def fs_cmp():
    global fp, fs_ety
    fs_bin(0)
    k = -1
    if tk[fp] == K_OP:
        k = find(FS_CMP, 6, tv[fp])
    if k < 0:
        return 0
    fp += 1
    fs_rv()
    lt = fs_ety
    fs_push()
    fs_bin(0)
    fs_rv()
    rt = fs_ety
    e("mov %rax,%rcx")
    fs_pop("%rax")
    if fsk[lt] == 6 or fsk[rt] == 6:
        fs_fcmp(k, lt, rt)
        return 0
    e("cmp %rcx,%rax")
    t = ft_join(lt, rt)
    cc = FS_UCC[k]
    if ft_sg(t) or t == FT_LIT:
        cc = FS_SCC[k]
    e(c3("set", cc, " %al"))
    e("movzbl %al,%eax")
    fs_ety = FT_BOOL

def fs_not():
    global fp, fs_ety
    if fs_isid("not"):
        fp += 1
        fs_not()
        fs_rv()
        e("test %rax,%rax")
        e("sete %al")
        e("movzbl %al,%eax")
        fs_ety = FT_BOOL
        return 0
    fs_cmp()

fs_nnend = 0

def fs_nnname(q):
# `x` or `u64(x)` at q with x an nptr local: x's index (fs_nnend = token after it), else -1
    global fs_nnend
    if tk[q] != K_ID:
        return -1
    n = q
    fs_nnend = q + 1
    if str_eq(tv[q], "u64") and fs_isop2(q + 1, "(") and tk[q + 2] == K_ID and fs_isop2(q + 3, ")"):
        n = q + 2
        fs_nnend = q + 4
    l = fs_local(tv[n])
    if l < 0 or not ft_isnptr(fsl_t[l]):
        return -1
    return l

def fs_nnpat(q, e):
# tokens [q, e) are `x` or `x != 0` (x may be written u64(x)) for an nptr local x: returns x's index, else -1
    l = fs_nnname(q)
    if l < 0:
        return -1
    n = fs_nnend
    if e == n and n == q + 1:
        return l
    if e == n + 2 and fs_isop2(n, "!=") and tk[n + 1] == K_NUM and tv[n + 1] == 0:
        return l
    return -1

def fs_nnzero(q, e):
# tokens [q, e) are `x == 0` (or `u64(x) == 0`) for an nptr local x
    l = fs_nnname(q)
    if l < 0:
        return -1
    n = fs_nnend
    if e == n + 2 and fs_isop2(n, "==") and tk[n + 1] == K_NUM and tv[n + 1] == 0:
        return l
    return -1

def fs_nnscan(p):
# conjuncts of the condition at p (up to the depth-0 ':') that prove an nptr local non-null -> fs_nnl[0..fs_nnc)
    global fs_nnc
    fs_nnc = 0
    q = p
    d = 0
    while tk[p] != K_NL and tk[p] != K_EOF:
        if tk[p] == K_OP and (str_eq(tv[p], "(") or str_eq(tv[p], "[")):
            d += 1
        elif tk[p] == K_OP and (str_eq(tv[p], ")") or str_eq(tv[p], "]")):
            d -= 1
        elif d == 0 and tk[p] == K_ID and str_eq(tv[p], "or"):
            fs_nnc = 0
            return 0
        elif d == 0 and ((tk[p] == K_ID and str_eq(tv[p], "and")) or fs_isop2(p, ":")):
            l = fs_nnpat(q, p)
            if l >= 0 and fs_nnc < 64:
                fs_nnl[fs_nnc] = l
                fs_nnc += 1
            if fs_isop2(p, ":"):
                return 0
            q = p + 1
        p += 1
    return 0

def fs_nulltest(p):
# condition at p starts with `x == 0` or is `not x` (x an nptr local) -> x's index, else -1
    if tk[p] != K_ID:
        return -1
    if str_eq(tv[p], "not") and fs_isop2(p + 2, ":"):
        return fs_nnpat(p + 1, p + 2)
    l = fs_nnname(p)
    if l < 0:
        return -1
    n = fs_nnend + 2
    if fs_nnzero(p, n) >= 0 and (fs_isop2(n, ":") or (tk[n] == K_ID and str_eq(tv[n], "or"))):
        return l
    return -1

def fs_exits(p):
# the block whose ':' is at or after p ends in return/break/continue/panic at its own level
    while tk[p] != K_EOF and not (fs_isop2(p, ":") and (tk[p + 1] == K_NL or tk[p + 1] == K_ID)):
        p += 1
    p += 1
    if tk[p] == K_ID:
        return fs_exitstmt(p)
    p += 1
    if tk[p] != K_IND:
        return 0
    p += 1
    d = 1
    st = 1
    while tk[p] != K_EOF and d > 0:
        if tk[p] == K_IND:
            d += 1
        elif tk[p] == K_DED:
            d -= 1
        elif tk[p] == K_NL:
            st = 1
            p += 1
            continue
        elif st and d == 1 and fs_exitstmt(p):
            return 1
        st = 0
        p += 1
    return 0

def fs_exitstmt(p):
    if tk[p] != K_ID:
        return 0
    if str_eq(tv[p], "return") or str_eq(tv[p], "break") or str_eq(tv[p], "continue"):
        return 1
    return (str_eq(tv[p], "panic") or str_eq(tv[p], "qemu_exit")) and fs_isop2(p + 1, "(")

def fs_loopkill():
# entering a loop: forget non-null facts for locals the loop assigns (the back edge may bring a null)
    i = 0
    while i < nfsl:
        if fsl_nn[i] and not fs_bodyok(fsl_n[i], " "):
            fsl_nn[i] = 0
        i += 1

def fs_andor(isand):
    global fp, fs_ety
    q0 = fp
    if isand:
        fs_not()
    else:
        fs_andor(1)
    kw = "or"
    if isand:
        kw = "and"
    if not fs_isid(kw):
        return 0
    l = fs_newlab()
    sn = fs_nnsnap()
    while fs_isid(kw):
        if isand:
        # `x != 0 and <rhs>`: x is non-null while compiling rhs
            x = fs_nnpat(q0, fp)
            if x >= 0:
                fsl_nn[x] = 1
        else:
        # `x == 0 or <rhs>`: x is non-null while compiling rhs
            x = fs_nnzero(q0, fp)
            if x >= 0:
                fsl_nn[x] = 1
        fp += 1
        fs_rv()
        e("test %rax,%rax")
        if isand:
            e(concat("je ", l))
            q0 = fp
            fs_not()
        else:
            e(concat("jne ", l))
            q0 = fp
            fs_andor(1)
        fs_rv()
        e("test %rax,%rax")
    fs_nnjoin(sn)
    emit_raw(concat(l, ":\n"))
    e("setne %al")
    e("movzbl %al,%eax")
    fs_ety = FT_BOOL

def fs_expr():
    fs_andor(0)

def fs_rexpr():
    fs_expr()
    fs_rv()

# ---- statements ----
def fs_eol():
    global fp
    if tk[fp] == K_NL:
        fp += 1
    elif tk[fp] != K_DED and tk[fp] != K_EOF:
        fs_die("expected end of line")

def fs_nnsnap():
    sn = list(nfsl + 1)
    i = 0
    while i < nfsl:
        sn[i] = fsl_nn[i]
        i += 1
    sn[nfsl] = nfsl
    return sn

def fs_nnjoin(sn):
# leaving a block: a local stays proven non-null only if it was on entry and still is
    n = sn[len(sn) - 1]
    i = 0
    while i < nfsl:
        if i >= n or not sn[i]:
            fsl_nn[i] = 0
        i += 1

def fs_suite():
    global fs_sdep
    fs_sdep += 1
    fs_suite1()
    fs_sdep -= 1

def fs_suite1():
    global fp
    sn = fs_nnsnap()
    n0 = nfsl
    fs_expect(":")
    if tk[fp] != K_NL:
        fs_stmt()
        fs_nnjoin(sn)
        fs_bkill(n0)
        return 0
    fp += 1
    if tk[fp] != K_IND:
        fs_die("expected an indented block")
    fp += 1
    while tk[fp] != K_DED and tk[fp] != K_EOF:
        fs_stmt()
    fp += 1
    fs_nnjoin(sn)
    fs_bkill(n0)

def fs_skip_suite():
    global fp
    fs_expect(":")
    if tk[fp] != K_NL:
        while tk[fp] != K_NL and tk[fp] != K_EOF:
            fp += 1
        fp += 1
        return 0
    fp += 1
    if tk[fp] != K_IND:
        fs_die("expected an indented block")
    d = 0
    while 1:
        if tk[fp] == K_IND:
            d += 1
        elif tk[fp] == K_DED:
            d -= 1
            if d == 0:
                fp += 1
                return 0
        elif tk[fp] == K_EOF:
            return 0
        fp += 1

def fs_assign_at():
# index of a depth-0 assignment operator in this logical line, or -1
    p = fp
    d = 0
    while tk[p] != K_NL and tk[p] != K_EOF and tk[p] != K_DED:
        if tk[p] == K_OP:
            s = tv[p]
            if str_eq(s, "(") or str_eq(s, "["):
                d += 1
            elif str_eq(s, ")") or str_eq(s, "]"):
                d -= 1
            elif d == 0 and (str_eq(s, "=") or (len(s) >= 2 and char_at(s, len(s) - 1) == 61 and not str_eq(s, "==") and not str_eq(s, "!=") and not str_eq(s, "<=") and not str_eq(s, ">="))):
                return p
        p += 1
    return -1

def fs_lhs_store(vt):
# value in rax (type vt); compile target at fp (before '=') and store
    global fp, fs_ety, fs_lhs, fs_lhsl
    if tk[fp] == K_ID and tk[fp + 1] == K_OP and str_eq(tv[fp + 1], "=") and fs_local(tv[fp]) < 0 and fs_glob(tv[fp]) < 0:
        if fs_const(tv[fp]) >= 0:
            fs_die("cannot assign to a constant")
        t = vt
        if t == FT_LIT:
            t = FT_I64
        if t == FT_VOID or (ft_agg(t) and fsk[t] != 5 and not (fsk[t] == 2 and fs_sretv)):
            fs_die("cannot copy a void/struct/array value into a new local")
        l = fs_newlocal(tv[fp], t)
        fs_store(t, concat(str(fsl_o[l]), "(%rbp)"))
        fs_battach(l, t)
        fp += 1
        return 0
    if fs_bpend >= 0:
        fs_die("a borrow can only initialize a new local (r: ref[T] = borrow(x))")
    fs_ety = vt
    fs_push()
    fs_lhs = tk[fp] == K_ID and fs_isop2(fp + 1, "=")
    fs_lhsl = -1
    p0 = fp
    fs_postfix()
    fs_lhs = 0
    bare = fp == p0 + 1
    fs_wstore(p0, bare)
    tl0 = fs_lhsl
    t = fs_ety
    if fs_mode == 0:
        fs_die("cannot assign to this expression")
    if fs_mode == 1:
        e("mov %rax,%rcx")
        m = "(%rcx)"
    else:
        m = fs_maddr()
    fs_pop("%rax")
    fs_ety = vt
    fs_conv(t)
    fs_store(t, m)
    if bare and tl0 >= 0:
    # assigning a proven non-null value narrows an nptr local; anything else clears it
        fsl_nn[tl0] = ft_isnn(vt)

def fs_stmt():
    global fs_term, fs_bpend, fs_rsrc
    if tk[fp] == K_NL:
        fs_stmt1()
        return 0
    fs_term = 0
    fs_bpend = -1
    fs_rsrc = -1
    fs_dmark()
    fs_stmt1()
    fs_bpend = -1

def fs_stmt1():
    global fp, nfsloop, fs_ety, fs_mode, fs_dep, nfsb, fs_ublk, fs_uops, fs_unsafe, fs_term, fs_rsrc, nfsdf
    if tk[fp] == K_NL:
        fp += 1
        return 0
    if fs_isid("pass"):
        fp += 1
        fs_eol()
        return 0
    if fs_isid("return"):
        if fs_indef:
            fs_die("return inside a `with defer:` block")
        fp += 1
        if tk[fp] != K_NL and tk[fp] != K_DED:
            fs_rexpr()
            fs_conv(fs_rty)
            if fsk[fs_rty] == 2:
            # struct result: copy into the return slot (rax:rdx) or the caller's hidden-pointer buffer
                e("mov %rax,%rsi")
                if fs_smem(fs_rty):
                    e(c3("mov ", str(fsl_o[fs_rslot]), "(%rbp),%rdi"))
                else:
                    e(c3("lea ", str(fsl_o[fs_rslot]), "(%rbp),%rdi"))
                e(c3("mov $", str(ftsz[fs_rty]), ",%rcx"))
                e("rep movsb")
        elif fsk[fs_rty] == 2:
            fs_die("a function returning a struct must return a value")
        fs_rundefers()
        e(concat("jmp ", fs_ret))
        fs_eol()
        fs_term = 1
        return 0
    if fs_isid("break") or fs_isid("continue"):
        if nfsloop == 0:
            fs_die("break/continue outside a loop")
        if fs_isid("break"):
            e(concat("jmp ", fs_brk[nfsloop - 1]))
            fs_lbm[nfsloop - 1] = fs_mvor(fs_lbm[nfsloop - 1], fs_mvsnap())
        else:
            e(concat("jmp ", fs_cnt[nfsloop - 1]))
            fs_mvloop(fs_lb0[nfsloop - 1])
        fp += 1
        fs_eol()
        fs_term = 1
        return 0
    if fs_isid("with") and tk[fp + 1] == K_ID and str_eq(tv[fp + 1], "defer") and fs_isop2(fp + 2, ":"):
    # Phase 4.5: `with defer:` registers its block to run before every later return / the end of the function
        if fs_indef:
            fs_die("`with defer:` inside a `with defer:` block")
        if fs_sdep != 1:
            fs_die("`with defer:` must be at the top level of a function body")
        if nfsdf >= 64:
            fs_die("too many `with defer:` blocks in one function")
        fs_dfp[nfsdf] = fp + 2
        fs_dfu[nfsdf] = fs_unsafe
        nfsdf += 1
        fp += 2
        fs_skip_suite()
        return 0
    if fs_isid("with") and tk[fp + 1] == K_ID and str_eq(tv[fp + 1], "unsafe") and fs_isop2(fp + 2, ":"):
    # Phase 4.3: `with unsafe:` block
        ln0 = tl[fp]
        fs_safechk(ln0, "a `with unsafe:` block")
        fp += 2
        fs_ublk += 1
        o0 = fs_uops
        fs_uops = 0
        fs_unsafe += 1
        fs_suite()
        fs_unsafe -= 1
        if fs_urep:
            eputs(c4("unsafe: ", fs_where(ln0), " block in ", c3(fsf_n[fs_ucur], " ops=", str(fs_uops))))
        fs_uops = o0 + fs_uops
        return 0
    if fs_isid("if"):
        lend = fs_newlab()
        nt = fs_nulltest(fp + 1)
        if nt >= 0 and not fs_exits(fp + 1):
            nt = -1
        macc = 0
        alldone = 1
        while 1:
            fp += 1
            lnext = fs_newlab()
            fs_nnscan(fp)
            nc = fs_nnc
            nl0 = list(nc + 1)
            k = 0
            while k < nc:
                nl0[k] = fs_nnl[k]
                k += 1
            fs_rexpr()
            e("test %rax,%rax")
            e(concat("je ", lnext))
            csn = fs_mvsnap()
            sv = fs_nnsnap()
            k = 0
            while k < nc:
                fsl_nn[nl0[k]] = 1
                k += 1
            fs_suite()
            fs_nnjoin(sv)
            if not fs_term:
                macc = fs_mvor(macc, fs_mvsnap())
                alldone = 0
            fs_mvset(csn)
            e(concat("jmp ", lend))
            emit_raw(concat(lnext, ":\n"))
            if not fs_isid("elif"):
                break
            nt = -1
        if fs_isid("else"):
            nt = -1
            fp += 1
            fs_suite()
            if not fs_term:
                macc = fs_mvor(macc, fs_mvsnap())
                alldone = 0
        else:
            macc = fs_mvor(macc, fs_mvsnap())
            alldone = 0
        if macc != 0:
            fs_mvset(macc)
        fs_term = alldone
        emit_raw(concat(lend, ":\n"))
        if nt >= 0:
        # `if x == 0: return` (or break/continue/panic): x is non-null after the if
            fsl_nn[nt] = 1
        return 0
    if fs_isid("while"):
        fp += 1
        fs_loopkill()
        fs_nnscan(fp)
        nc = fs_nnc
        nl0 = list(nc + 1)
        k = 0
        while k < nc:
            nl0[k] = fs_nnl[k]
            k += 1
        lt = fs_newlab()
        lb = fs_newlab()
        emit_raw(concat(lt, ":\n"))
        fs_rexpr()
        e("test %rax,%rax")
        e(concat("je ", lb))
        fs_brk[nfsloop] = lb
        fs_cnt[nfsloop] = lt
        e0 = fs_mvsnap()
        fs_lb0[nfsloop] = e0
        fs_lbm[nfsloop] = 0
        nfsloop += 1
        sv = fs_nnsnap()
        k = 0
        while k < nc:
            fsl_nn[nl0[k]] = 1
            k += 1
        fs_suite()
        fs_nnjoin(sv)
        nfsloop -= 1
        fs_loopend(e0)
        e(concat("jmp ", lt))
        emit_raw(concat(lb, ":\n"))
        return 0
    if fs_isid("for"):
        fp += 1
        vn = fs_ident()
        if not fs_isid("in") or not str_eq(tv[fp + 1], "range"):
            fs_die("freestanding for supports only range()")
        fp += 2
        fs_loopkill()
        fs_expect("(")
        fx = fs_rngfact()
        fs_rexpr()
        ty = fs_ety
        st = 1
        if fs_isop(","):
            fp += 1
            fs_push()
            fs_rexpr()
            ty = ft_join(ty, fs_ety)
            if fs_isop(","):
                fp += 1
                st = fs_ceval()
        else:
            e("mov %rax,%rcx")
            e("xor %eax,%eax")
            fs_push()
            e("mov %rcx,%rax")
        if ty == FT_LIT:
            ty = FT_I64
        fs_expect(")")
        l = fs_local(vn)
        if l < 0:
            l = fs_newlocal(vn, ty)
        lim = fs_newlocal(concat(" lim", str(fs_lab)), ty)
        e(c3("mov %rax,", str(fsl_o[lim]), "(%rbp)"))
        fs_pop("%rax")
        e(c3("mov %rax,", str(fsl_o[l]), "(%rbp)"))
        lt = fs_newlab()
        lc = fs_newlab()
        lb = fs_newlab()
        emit_raw(concat(lt, ":\n"))
        e(c3("mov ", str(fsl_o[l]), "(%rbp),%rax"))
        e(c3("cmp ", str(fsl_o[lim]), "(%rbp),%rax"))
        cc = "ge"
        if st < 0:
            cc = "le"
        if not ft_sg(ty):
            cc = "ae"
            if st < 0:
                cc = "be"
        e(c3("j", cc, concat(" ", lb)))
        fs_brk[nfsloop] = lb
        fs_cnt[nfsloop] = lc
        e0 = fs_mvsnap()
        fs_lb0[nfsloop] = e0
        fs_lbm[nfsloop] = 0
        nfsloop += 1
        nb0 = nfsb
        if fx >= 0 and st > 0 and fs_bodyok(vn, fsb_x[fx]):
            fsb_v[nfsb] = vn
            fsb_x[nfsb] = fsb_x[fx]
            fsb_c[nfsb] = fsb_c[fx]
            nfsb += 1
        elif fx < 0 or st <= 0:
        # a loop variable shadows any outer fact for the same name
            fsb_v[nfsb] = vn
            fsb_x[nfsb] = " "
            fsb_c[nfsb] = -1
            nfsb += 1
        else:
            fsb_v[nfsb] = vn
            fsb_x[nfsb] = " "
            fsb_c[nfsb] = -1
            nfsb += 1
        fs_suite()
        nfsb = nb0
        nfsloop -= 1
        fs_loopend(e0)
        emit_raw(concat(lc, ":\n"))
        e(c4("addq $", str(st), ",", concat(str(fsl_o[l]), "(%rbp)")))
        e(concat("jmp ", lt))
        emit_raw(concat(lb, ":\n"))
        return 0
    if tk[fp] == K_ID and tk[fp + 1] == K_OP and str_eq(tv[fp + 1], ":") and fs_istype(fp + 2):
        nm = tv[fp]
        fp += 2
        t = fs_type()
        if fs_local(nm) >= 0:
            fs_die(concat("redeclared local ", nm))
        l = fs_newlocal(nm, t)
        if fs_isop("="):
            fp += 1
            fs_rsrc = fs_rsrcat(fp)
            fs_rexpr()
            vt = fs_ety
            fs_conv(t)
            fs_store(t, concat(str(fsl_o[l]), "(%rbp)"))
            fsl_nn[l] = ft_isnn(vt)
            fs_battach(l, t)
        elif ft_isnn(t):
            fs_die("a ptr[T] local needs an initializer (it cannot be null; use nptr[T])")
        elif ft_agg(t):
            e(c3("lea ", str(fsl_o[l]), "(%rbp),%rdi"))
            e("xor %eax,%eax")
            e(c3("mov $", str(ftsz[t]), ",%rcx"))
            e("rep stosb")
        else:
            e(c3("movq $0,", str(fsl_o[l]), "(%rbp)"))
        fs_eol()
        return 0
    a = fs_assign_at()
    if a >= 0:
        st = fp
        op = tv[a]
        if str_eq(op, "="):
            fp = a + 1
            fs_rsrc = fs_rsrcat(fp)
            fs_rexpr()
            vt = fs_ety
            en = fp
            fp = st
            fs_lhs_store(vt)
            if fp != a:
                fs_die("bad assignment target")
            fp = en
            fs_eol()
            return 0
        # augmented assignment: target address, current value, rhs, op, store
        fs_wstore(fp, a == fp + 1)
        fs_postfix()
        t = fs_ety
        if fs_mode == 0:
            fs_die("cannot assign to this expression")
        if fp != a:
            fs_die("bad assignment target")
        m = fs_maddr()
        if fs_mode == 1:
            fs_push()
            m = "(%rcx)"
        fs_load(t)
        fs_push()
        fp = a + 1
        fs_rexpr()
        rt = fs_ety
        e("mov %rax,%rcx")
        fs_pop("%rax")
        fs_binop(substr(op, 0, len(op) - 1), t, rt)
        fs_conv(t)
        if str_eq(m, "(%rcx)"):
            fs_pop("%rcx")
        fs_store(t, m)
        fs_eol()
        return 0
    if fs_isid("panic") and fs_isop2(fp + 1, "("):
        fs_term = 1
    fs_rexpr()
    fs_eol()

def fs_rundefers():
# emit the registered defer blocks (newest first); %rax (the return value) is preserved
    global fp, nfsloop, fs_indef, fs_term, fs_unsafe
    if nfsdf == 0:
        return 0
    e("push %rax")
    e("push %rax")
    fp0 = fp
    nl0 = nfsloop
    t0 = fs_term
    u0 = fs_unsafe
    n = nfsl
    sh = list(n + 1)
    mu = list(n + 1)
    dd = list(n + 1)
    i = 0
    while i < n:
        sh[i] = fsl_sh[i]
        mu[i] = fsl_mu[i]
        dd[i] = fsl_dead[i]
        i += 1
    # the function is ending: its block-scoped borrows are over
    fs_bkill(0)
    nfsloop = 0
    fs_indef = 1
    i = nfsdf - 1
    while i >= 0:
        sn = fs_mvsnap()
        fp = fs_dfp[i]
        fs_unsafe = fs_dfu[i]
        fs_suite()
        fs_mvset(sn)
        i -= 1
    i = 0
    while i < n:
        fsl_sh[i] = sh[i]
        fsl_mu[i] = mu[i]
        fsl_dead[i] = dd[i]
        i += 1
    fs_indef = 0
    fs_unsafe = u0
    nfsloop = nl0
    fs_term = t0
    fp = fp0
    e("pop %rax")
    e("pop %rax")

def fs_rsrcat(p):
# the local named by a bare `NAME` right-hand side at p, else -1
    if tk[p] == K_ID and (tk[p + 1] == K_NL or tk[p + 1] == K_DED or tk[p + 1] == K_EOF):
        return fs_local(tv[p])
    return -1

# ---- program ----
def fs_decos():
# parse @name / @name(args) lines; sets fs_datt bits, fs_dal, fs_dsec
    global fp, fs_datt, fs_dal, fs_dsec, fs_dgn
    fs_datt = 0
    fs_dal = 0
    fs_dsec = ""
    fs_dgn = 0
    while fs_isop("@"):
        fp += 1
        nm = fs_ident()
        if str_eq(nm, "generic"):
            fs_expect("(")
            while not fs_isop(")"):
                if fs_dgn >= 16:
                    fs_die("too many type parameters")
                fs_dgen[fs_dgn] = fs_ident()
                fs_dgn += 1
                if fs_isop(","):
                    fp += 1
            fp += 1
        elif str_eq(nm, "export"):
            fs_datt = fs_bop(fs_datt, 1, 1)
        elif str_eq(nm, "interrupt"):
            fs_datt = fs_bop(fs_datt, 2, 1)
        elif str_eq(nm, "interrupt_err"):
            fs_datt = fs_bop(fs_datt, 4, 1)
        elif str_eq(nm, "naked"):
            fs_datt = fs_bop(fs_datt, 8, 1)
        elif str_eq(nm, "efiapi"):
            fs_datt = fs_bop(fs_datt, 16, 1)
        elif str_eq(nm, "packed"):
            fs_datt = fs_bop(fs_datt, 32, 1)
        elif str_eq(nm, "patchable"):
            fs_datt = fs_bop(fs_datt, 64, 1)
        elif str_eq(nm, "unsafe"):
            fs_datt = fs_bop(fs_datt, 128, 1)
        elif str_eq(nm, "align"):
            fs_expect("(")
            fs_dal = fs_ceval()
            fs_expect(")")
        elif str_eq(nm, "section"):
            fs_expect("(")
            fs_dsec = tv[fp]
            fp += 1
            fs_expect(")")
        else:
            fs_die(concat("unknown attribute @", nm))
        if tk[fp] == K_NL:
            fp += 1

def fs_struct_def(packed):
    nm = fs_ident()
    fs_struct_body(ft_struct(nm), packed)

def fs_struct_body(t, packed):
    global fp, nff
    fs_expect(":")
    if tk[fp] != K_NL:
        fs_die("struct body must be an indented block")
    fp += 2
    ftf0[t] = nff
    off = 0
    al = 1
    while tk[fp] != K_DED and tk[fp] != K_EOF:
        if tk[fp] == K_NL or fs_isid("pass"):
            fp += 1
            continue
        fnm = fs_ident()
        fs_expect(":")
        ft = fs_type()
        if ft_isaff(ft):
            fs_die("struct fields cannot be own/ref/mut yet")
        fa = ftal[ft]
        if packed:
            fa = 1
        while off % fa != 0:
            off += 1
        if fa > al:
            al = fa
        ffn[nff] = fnm
        fft[nff] = ft
        ffo[nff] = off
        nff += 1
        off += ftsz[ft]
        fs_eol()
    fp += 1
    while off % al != 0:
        off += 1
    ftfn[t] = nff - ftf0[t]
    ftsz[t] = off
    ftal[t] = al

def fs_sig(ext):
# def name(params) [-> T]; registers a function, leaves fp at ':' (or line end)
    global fp, nfsf, nfsp
    fp += 1
    nm = fs_ident()
    if len(fs_signame) > 0:
        nm = fs_signame
    if fs_func(nm) >= 0 or fs_gfind(nm, 0) >= 0:
        fs_die(concat("duplicate function ", nm))
    f = nfsf
    fsf_gi[f] = -1
    nfsf += 1
    fsf_n[f] = nm
    fsf_ln[f] = tl[fp - 1]
    fsf_p0[f] = nfsp
    fsf_at[f] = fs_datt
    fsf_ext[f] = ext
    fsf_sec[f] = fs_dsec
    fs_expect("(")
    n = 0
    while not fs_isop(")"):
        fsp_n[nfsp] = fs_ident()
        t = FT_I64
        if fs_isop(":"):
            fp += 1
            t = fs_type()
        fsp_t[nfsp] = t
        nfsp += 1
        n += 1
        if fs_isop(","):
            fp += 1
    fp += 1
    fsf_np[f] = n
    nr = 0
    i = 0
    while i < n:
        nr += fs_pwords(fsp_t[fsf_p0[f] + i])
        if fsk[fsp_t[fsf_p0[f] + i]] == 6 and fs_bop(fs_datt, 22, 0):
            fs_die("float parameters are not supported with @efiapi / @interrupt")
        if fsk[fsp_t[fsf_p0[f] + i]] == 2 and fs_bop(fs_datt, 22, 0):
            fs_die("struct parameters by value are not supported with @efiapi / @interrupt (pass a pointer)")
        i += 1
    # SysV: words 7..16 travel on the stack (11.2); a slice (2 words) must still fit in registers
    if nr > 16:
        fs_die("more than 16 parameter words are not supported (a slice uses 2)")
    if nr > 6 and fs_bop(fs_datt, 22, 0):
        fs_die("stack parameters (more than 6 words) are not supported with @efiapi / @interrupt")
    fsf_ret[f] = FT_VOID
    if fs_isop("->"):
        fp += 1
        if fs_isid("None"):
            fp += 1
        else:
            fsf_ret[f] = fs_type()
            if fsk[fsf_ret[f]] == 1 and ftsg[fsf_ret[f]] >= 3:
                fs_die("a function cannot return a borrow (ref[T]/mut[T])")
            if fsk[fsf_ret[f]] == 6 and fs_bop(fs_datt, 22, 0):
                fs_die("@efiapi / @interrupt functions cannot return a float")
            if fsk[fsf_ret[f]] == 2 and fs_bop(fs_datt, 22, 0):
                fs_die("@efiapi / @interrupt functions cannot return a struct")
            if ft_agg(fsf_ret[f]) and fsk[fsf_ret[f]] != 2:
                fs_die("functions cannot return an array or slice yet (pass a pointer or slice out-parameter)")
            if fs_smem(fsf_ret[f]) and nr > 15:
                fs_die("more than 15 parameter words with a hidden struct-return pointer")
    fsf_pos[f] = fp
    if ext:
        fsf_pos[f] = -1
    return f

def fs_prescan():
    global fp, nfsc, nfsg, nft
    # pass A: struct names
    fp = 0
    gn = 0
    while tk[fp] != K_EOF:
        if fs_isop("@") and tk[fp + 1] == K_ID and str_eq(tv[fp + 1], "generic"):
            gn = 1
        elif fs_isid("def"):
            gn = 0
        if (fs_isid("struct") or fs_isid("class")) and tk[fp + 1] == K_ID and gn:
            gn = 0
        elif (fs_isid("struct") or fs_isid("class")) and tk[fp + 1] == K_ID:
            nm = tv[fp + 1]
            if ft_struct(nm) >= 0:
                fs_die(concat("duplicate struct ", nm))
            ft_add(2, 0, 0, 1, 0, 0, nm)
        fp += 1
    # pass B: everything else, in order
    fp = 0
    while tk[fp] != K_EOF:
        if tk[fp] == K_NL:
            fp += 1
            continue
        fs_decos()
        if fs_dgn > 0:
            fs_gendef()
        elif fs_isid("struct") or fs_isid("class"):
            fp += 1
            fs_struct_def(fs_bop(fs_datt, 32, 0))
        elif fs_isid("extern"):
            fp += 1
            fs_sig(1)
            fs_eol()
        elif fs_isid("def"):
            fs_sig(0)
            fs_skip_suite()
        elif fs_isid("asm"):
            while tk[fp] != K_NL and tk[fp] != K_EOF:
                fp += 1
        elif fs_isid("import") or fs_isid("from"):
            fs_die("imports are not available in freestanding mode")
        elif tk[fp] == K_ID and fs_isop2(fp + 1, "="):
            nm = tv[fp]
            fp += 2
            fsc_n[nfsc] = nm
            fsc_v[nfsc] = fs_ceval()
            fsc_t[nfsc] = FT_LIT
            nfsc += 1
            fs_eol()
        elif tk[fp] == K_ID and fs_isop2(fp + 1, ":"):
            nm = tv[fp]
            fp += 2
            g = nfsg
            nfsg += 1
            fsg_n[g] = nm
            fsg_t[g] = fs_type()
            if ft_isaff(fsg_t[g]):
                fs_die("globals cannot be own/ref/mut")
            if ft_isnn(fsg_t[g]) and (not fs_isop("=") or (tk[fp + 1] == K_NUM and tv[fp + 1] == 0)):
                fs_die("a ptr[T] global needs a non-null initializer (use nptr[T])")
            fsg_al[g] = fs_dal
            fsg_sec[g] = fs_dsec
            fsg_p[g] = -1
            if fs_isop("="):
                fp += 1
                fsg_p[g] = fp
                while tk[fp] != K_NL and tk[fp] != K_EOF:
                    fp += 1
            fs_eol()
        else:
            fs_die("unsupported top-level statement in freestanding mode")

def fs_isop2(p, o):
    return tk[p] == K_OP and str_eq(tv[p], o)

def fs_dirw(t):
    sz = ftsz[t]
    if sz == 1:
        return ".byte"
    if sz == 2:
        return ".short"
    if sz == 4:
        return ".long"
    return ".quad"

def fs_gdata(g):
    global fp, nfsrod
    t = fsg_t[g]
    al = ftal[t]
    if fsg_al[g] > al:
        al = fsg_al[g]
    sec = fsg_sec[g]
    if len(sec) == 0:
        if fsg_p[g] < 0:
            sec = ".bss"
        else:
            sec = ".data"
    emit_raw(c3(".section ", sec, "\n"))
    emit_raw(c3(".balign ", str(al), "\n"))
    emit_raw(c3(".globl ", fsg_n[g], "\n"))
    emit_raw(concat(fsg_n[g], ":\n"))
    if fsg_p[g] < 0:
        emit_raw(c3("    .zero ", str(ftsz[t]), "\n"))
        return 0
    fp = fsg_p[g]
    if fs_isop("["):
        if fsk[t] != 3:
            fs_die("list initializer needs an array type")
        fp += 1
        n = 0
        while not fs_isop("]"):
            emit_raw(c4("    ", fs_dirw(ftel[t]), " ", concat(str(fs_ceval()), "\n")))
            n += 1
            if fs_isop(","):
                fp += 1
        if n < ftn[t]:
            emit_raw(c3("    .zero ", str((ftn[t] - n) * ftsz[ftel[t]]), "\n"))
        return 0
    if tk[fp] == K_ID and (fs_func(tv[fp]) >= 0 or fs_glob(tv[fp]) >= 0):
        emit_raw(c4("    ", fs_dirw(t), " ", concat(tv[fp], "\n")))
        return 0
    if tk[fp] == K_STR and fsk[t] == 1:
        lb = concat(".LFS", str(nfsrod))
        s = tv[fp]
        b = ""
        i = 0
        while i < len(s):
            b = c3(b, str(char_at(s, i)), ",")
            i += 1
        fs_rod[nfsrod] = c4(lb, ": .byte ", b, "0\n")
        nfsrod += 1
        emit_raw(c3("    .quad ", lb, "\n"))
        return 0
    if tk[fp] == K_STR:
        s = tv[fp]
        i = 0
        while i < len(s):
            emit_raw(c3("    .byte ", str(char_at(s, i)), "\n"))
            i += 1
        rest = ftsz[t] - len(s)
        if rest > 0:
            emit_raw(c3("    .zero ", str(rest), "\n"))
        return 0
    if ft_agg(t):
        fs_die("aggregate globals take a [..] list or no initializer")
    emit_raw(c4("    ", fs_dirw(t), " ", concat(str(fs_ceval()), "\n")))

def fs_function(f):
    global fs_unsafe, fs_uops, fs_ufn, fs_ucur
    fs_ucur = f
    at = fsf_at[f]
    fs_unsafe = 0
    fs_uops = 0
    if fs_bop(at, 136, 0):
        fs_unsafe = 1
        fs_ufn += 1
        fs_safechk(fsf_ln[f], c3("@unsafe function ", fsf_n[f], ""))
    fs_function1(f)
    if fs_unsafe and fs_urep:
        k = "fn"
        if fs_bop(at, 8, 0):
            k = "naked fn"
        eputs(c4("unsafe: ", fs_where(fsf_ln[f]), c3(" ", k, " "), c3(fsf_n[f], " ops=", str(fs_uops))))
    fs_unsafe = 0

def fs_function1(f):
    global fp, nfsl, fs_frame, fs_ret, fs_rty, fs_dep, nfsloop, nfsdf, fs_sdep, fs_term
    gi = fsf_gi[f]
    if gi < 0:
        fs_function2(f)
        return 0
    a = list(17)
    j = 0
    while j < fsgen_ntp[fsi_g[gi]]:
        a[j] = fsia[fsi_a0[gi] + j]
        j += 1
    a[16] = j
    old = fs_genv(fsi_g[gi], a)
    fs_function2(f)
    fs_genv_pop(old)

def fs_function2(f):
    global fp, nfsl, fs_frame, fs_ret, fs_rty, fs_dep, nfsloop, nfsdf, fs_sdep, fs_term, fs_spn, fs_gon, nfsgf, fs_rslot
    at = fsf_at[f]
    nm = fsf_n[f]
    sec = fsf_sec[f]
    if len(sec) == 0:
        sec = ".text"
    emit_raw(c3(".section ", sec, ",\"ax\",@progbits\n"))
    if fs_bop(at, 1, 0):
        emit_raw(c3(".globl ", nm, "\n"))
    if fs_bop(at, 8, 0):
    # naked: only asm() statements, no prologue/epilogue
        emit_raw(concat(nm, ":\n"))
        fp = fsf_pos[f]
        fs_suite()
        return 0
    body = nm
    if fs_bop(at, 22, 0):
        body = concat(nm, "__body")
        fs_wrapper(f, nm, body)
    emit_raw(".p2align 4\n")
    emit_raw(concat(body, ":\n"))
    if fs_g and nfsgf < 8192:
        fs_gon = 1
        fsgf_s[nfsgf] = body
        fsgf_ln[nfsgf] = fsf_ln[f]
        fsgf_a[nfsgf] = nfsd
    if fs_bop(at, 64, 0):
    # @patchable: one 5-byte nop at entry, which a live patch replaces by a jmp rel32 atomically
        emit_raw("    .byte 0x0f,0x1f,0x44,0x00,0x00\n")
    e("push %rbp")
    e("mov %rsp,%rbp")
    pidx = nout
    e("sub $0,%rsp")
    nfsl = 0
    fs_frame = 0
    if fs_sp:
        fs_frame = 8
    fs_dep = 0
    nfsloop = 0
    fs_ret = fs_newlab()
    fs_rty = fsf_ret[f]
    nfsdf = 0
    fs_sdep = 0
    nw = fs_layout(f)
    i = 0
    w = 0
    while i < fsf_np[f]:
        l = fs_newlocal(fsp_n[fsf_p0[f] + i], fsp_t[fsf_p0[f] + i])
        i += 1
    if fsk[fs_rty] == 2:
        fs_rslot = fs_newlocal("", fs_rty)
        if fs_smem(fs_rty):
        # the hidden struct-return pointer (rdi) is kept in the slot's first word
            e(c3("mov %rdi,", str(fsl_o[fs_rslot]), "(%rbp)"))
            w = 1
    i = 0
    while i < fsf_np[f]:
        t = fsp_t[fsf_p0[f] + i]
        o = fsl_o[i]
        j = 0
        while j < fs_pwords(t):
            d = fs_wd[w + j]
            src = ""
            if d >= 100:
            # SysV stack word s at 16 + 8 * s above the frame pointer
                e(c3("mov ", str(16 + 8 * (d - 100)), "(%rbp),%rax"))
            elif d >= 50:
                fs_xf(t, d - 50, "%rax")
            else:
                e(c3("mov ", FS_AREG[d], ",%rax"))
            if fsk[t] == 2 or fsk[t] == 5:
                e(c3("mov %rax,", str(o + 8 * j), "(%rbp)"))
            else:
            # SysV leaves upper bits of narrow args unspecified: normalize on entry
                fs_norm(t)
                e(c3("mov %rax,", str(o), "(%rbp)"))
            j += 1
        w += fs_pwords(t)
        i += 1
    # array parameters are passed by address and are copies: once every argument is spilled, copy each
    # one into its own frame slot (the slot's first word holds the caller's address)
    i = 0
    while i < fsf_np[f]:
        if fsk[fsl_t[i]] == 3:
            e(c3("mov ", str(fsl_o[i]), "(%rbp),%rsi"))
            e(c3("lea ", str(fsl_o[i]), "(%rbp),%rdi"))
            e(c3("mov $", str(ftsz[fsl_t[i]]), ",%rcx"))
            e("rep movsb")
        i += 1
    fp = fsf_pos[f]
    fs_term = 0
    fs_suite()
    if not fs_term:
        fp1 = fp
        e("xor %eax,%eax")
        fs_rundefers()
        fp = fp1
    e("xor %eax,%eax")
    emit_raw(concat(fs_ret, ":\n"))
    if fsk[fs_rty] == 6:
        fs_fx(fs_rty, "%rax", 0)
    if fsk[fs_rty] == 2:
        if fs_smem(fs_rty):
            e(c3("mov ", str(fsl_o[fs_rslot]), "(%rbp),%rax"))
        else:
            fs_retw(fs_rty, fsl_o[fs_rslot], 0)
    guard = fs_sp and not str_eq(nm, "stack_smashed") and fs_hasbuf()
    if guard:
        ok = fs_newlab()
        e("mov -8(%rbp),%r11")
        e("xor stack_canary(%rip),%r11")
        e(concat("jz ", ok))
        e("call stack_smashed")
        emit_raw(concat(ok, ":\n"))
    e("leave")
    e("ret")
    if fs_gon:
        fs_gon = 0
        fsgf_b[nfsgf] = nfsd
        emit_raw(c3(".Lfsde", str(nfsgf), ":\n"))
        nfsgf += 1
    while fs_frame % 16 != 0:
        fs_frame += 1
    if fs_frame == 0:
        out[pidx] = ""
    else:
        out[pidx] = c3("    sub $", str(fs_frame), ",%rsp\n")
    if guard:
        fs_spn += 1
        out[pidx] = concat(out[pidx], "    mov stack_canary(%rip),%r11\n    mov %r11,-8(%rbp)\n")

def fs_hasbuf():
# a local or parameter wider than a word (array, struct) is what a stray write overflows
    i = 0
    while i < nfsl:
        if ftsz[fsl_t[i]] > 8:
            return 1
        i += 1
    return 0

FS_SAVE = ["%rax", "%rcx", "%rdx", "%rsi", "%rdi", "%r8", "%r9", "%r10", "%r11"]

def fs_wrapper(f, nm, body):
    at = fsf_at[f]
    emit_raw(".p2align 4\n")
    emit_raw(concat(nm, ":\n"))
    if fs_bop(at, 16, 0):
    # UEFI / Microsoft x64 entry: rcx, rdx, r8, r9 -> SysV; rdi/rsi are callee-saved there
        e("push %rdi")
        e("push %rsi")
        e("sub $8,%rsp")
        e("mov %rcx,%rdi")
        e("mov %rdx,%rsi")
        e("mov %r8,%rdx")
        e("mov %r9,%rcx")
        if fsf_np[f] > 4:
            e("mov 64(%rsp),%r8")
        if fsf_np[f] > 5:
            e("mov 72(%rsp),%r9")
        e(concat("call ", body))
        e("add $8,%rsp")
        e("pop %rsi")
        e("pop %rdi")
        e("ret")
        return 0
    i = 0
    while i < 9:
        e(concat("push ", FS_SAVE[i]))
        i += 1
    e("cld")
    e("lea 72(%rsp),%rdi")
    if fs_bop(at, 4, 0):
        e("sub $8,%rsp")
    e(concat("call ", body))
    if fs_bop(at, 4, 0):
        e("add $8,%rsp")
    i = 8
    while i >= 0:
        e(concat("pop ", FS_SAVE[i]))
        i -= 1
    if fs_bop(at, 4, 0):
        e("add $8,%rsp")
    e("iretq")

def fs_main(src):
    global fp, fs_chk, fs_bchk, fs_bstats, fs_urep, fs_prov, fs_ufix, fs_ubare, fs_safe, fs_sp, fs_g
    if contains(src, concat("# forge: ", "checked-ints")):
        fs_chk = 1
    if contains(src, concat("# forge: ", "no-bounds-checks")):
        fs_bchk = 0
    if contains(src, concat("# forge: ", "safe\n")):
        fs_safe = 1
    if contains(src, concat("# forge: ", "stack-protector")):
        fs_sp = 1
    ai = 3
    while ai < argc():
        if str_eq(argv(ai), "--no-bounds"):
            fs_bchk = 0
        if str_eq(argv(ai), "--bounds-stats"):
            fs_bstats = 1
        if str_eq(argv(ai), "--unsafe-report"):
            fs_urep = 1
        if str_eq(argv(ai), "--provenance-lint"):
            fs_prov = 1
        if str_eq(argv(ai), "--unsafe-fix"):
            fs_ufix = 1
        if str_eq(argv(ai), "-g"):
            fs_g = 1
        ai += 1
    ft_init()
    fs_prescan()
    emit_raw("# generated by forgec --freestanding\n")
    # top-level asm blocks, in source order
    fp = 0
    d = 0
    while tk[fp] != K_EOF:
        if tk[fp] == K_IND:
            d += 1
            fp += 1
        elif tk[fp] == K_DED:
            d -= 1
            fp += 1
        elif d == 0 and fs_isid("asm") and (fp == 0 or tk[fp - 1] == K_NL or tk[fp - 1] == K_DED):
            fs_ubare += 1
            fs_safechk(tl[fp], "top-level asm")
            if fs_urep:
                eputs(c3("unsafe: ", fs_where(tl[fp]), " top-level asm"))
            fp += 2
            while tk[fp] == K_STR:
                emit_raw(concat(tv[fp], "\n"))
                fp += 1
                if fs_isop(","):
                    fp += 1
            fs_expect(")")
        else:
            fp += 1
    f = 0
    while f < nfsf:
        if fsf_pos[f] >= 0:
            fs_function(f)
        f += 1
    g = 0
    while g < nfsg:
        fs_gdata(g)
        g += 1
    emit_raw(".section .rodata\n")
    i = 0
    while i < nfsrod:
        emit_raw(fs_rod[i])
        i += 1
    if fs_g:
        fs_dwarf()
    emit_raw(".section .note.GNU-stack,\"\",@progbits\n")
    if fs_urep:
        eputs(c4("unsafe: ", str(fs_ufn), c3(" functions, ", str(fs_ublk), " blocks, "), c3(str(fs_utot), " ops, ", concat(str(fs_ubare), " top-level asm blocks"))))
    if fs_bstats:
        eputs(c4("bounds: ", str(fs_nbc + fs_nbe), c3(" sites, ", str(fs_nbc), " checked, "), concat(str(fs_nbe), " elided")))
    write_file(argv(2), join(out, nout))
    if fs_prov:
        eputs(c4("provenance: ", str(fs_pn), " int->ptr sites, ", concat(str(fs_pbad), " outside @unsafe")))
        if fs_pbad > 0:
            fs_die("provenance lint failed: integer-to-pointer conversions belong in @unsafe functions")

FS_MIN = -9223372036854775807 - 1

def fs_bits(v, bits):
# 64 two's-complement bits of v, LSB first
    top = 0
    if v < 0:
        top = 1
        v = v - FS_MIN
    i = 0
    while i < 63:
        bits[i] = v % 2
        v = v // 2
        i += 1
    bits[63] = top

def fs_unbits(bits):
    v = 0
    i = 62
    while i >= 0:
        v = v * 2 + bits[i]
        i -= 1
    if bits[63]:
        v = v + FS_MIN
    return v

def fs_bop(x, y, k):
    bx = list(64)
    by = list(64)
    fs_bits(x, bx)
    fs_bits(y, by)
    i = 0
    while i < 64:
        if k == 0:
            bx[i] = bx[i] * by[i]
        elif k == 1:
            bx[i] = bx[i] + by[i] - bx[i] * by[i]
        else:
            bx[i] = (bx[i] + by[i]) % 2
        i += 1
    return fs_unbits(bx)

def fs_shl(x, r):
    if r >= 64 or r < 0:
        return 0
    bx = list(64)
    fs_bits(x, bx)
    by = list(64)
    i = 0
    while i < 64:
        by[i] = 0
        if i >= r:
            by[i] = bx[i - r]
        i += 1
    return fs_unbits(by)

def fs_shr(x, r):
# arithmetic shift (signed constants)
    if r >= 63:
        if x < 0:
            return -1
        return 0
    bx = list(64)
    fs_bits(x, bx)
    by = list(64)
    i = 0
    while i < 64:
        by[i] = bx[63]
        if i + r < 64:
            by[i] = bx[i + r]
        i += 1
    return fs_unbits(by)

def fs_include(src, dir, depth):
# top-level lines `include "file.forge"` are replaced by that file (relative to the includer)
    if depth > 16:
        diag_file_err("include nesting too deep")
        exit(1)
    global fsx_n, fsx_nf, fsx_cur
    if depth == 0:
        fsx_fn[0] = argv(1)
        fsx_lb[0] = ""
        fsx_nf = 1
        fsx_cur = 0
    me = fsx_cur
    k = 0
    parts = list(4096)
    np = 0
    n = len(src)
    i = 0
    st = 0
    while i <= n:
        if i == n or char_at(src, i) == 10:
            ln = substr(src, st, i)
            if len(ln) > 10 and str_eq(substr(ln, 0, 9), "include \""):
                q = 9
                while q < len(ln) and char_at(ln, q) != 34:
                    q += 1
                f = substr(ln, 9, q)
                if char_at(f, 0) != 47:
                    f = concat(dir, f)
                sub = read_file(f)
                if sub is None:
                    diag_file_err(concat("cannot read include file ", f))
                    exit(1)
                sl = len(f) - 1
                while sl >= 0 and char_at(f, sl) != 47:
                    sl -= 1
                if fsx_nf < 511:
                    fsx_fn[fsx_nf] = f
                    fsx_lb[fsx_nf] = ""
                    fsx_cur = fsx_nf
                    fsx_nf += 1
                parts[np] = fs_include(sub, substr(f, 0, sl + 1), depth + 1)
                fsx_cur = me
                np += 1
                parts[np] = "\n"
                np += 1
            else:
                parts[np] = concat(ln, "\n")
                np += 1
            k += 1
            if fsx_n < FSXMAX:
                fsx_f[fsx_n] = me
                fsx_l[fsx_n] = k
                fsx_n += 1
            if np > 4090:
                parts[0] = join(parts, np)
                np = 1
            st = i + 1
        i += 1
    return join(parts, np)

