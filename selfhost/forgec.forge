n        x: int = __ld(hs, i)\n        if x == 0:\n            return i\n        if x == h and __eq(__ld(ks, i), k):\n            return i\n        i = (i + 1) & m\n\ndef __dget(d, k, line):\n    i: int = __dfind(d, k, __hash(k))\n    if __ld(__ld(d, 2), i) == 0:\n        __raise_rt(KeyError(k), line, concat(\"key not found: \", __repr(k)))\n    return __ld(__ld(d, 4), i)\n\ndef get(d, k, dflt):\n    i: int = __dfind(d, k, __hash(k))\n    if __ld(__ld(d, 2), i) == 0:\n        return dflt\n    return __ld(__ld(d, 4), i)\n\ndef __dset(d, k, v):\n    if (__ld(d, 0) + __ld(d, 6) + 1) * 4 > __ld(d, 1) * 3:\n        __dresize(d)\n    h: int = __hash(k)\n    i: int = __dfind(d, k, h)\n    hs = __ld(d, 2)\n    if __ld(hs, i) == 0:\n        __st(hs, i, h)\n        __st(__ld(d, 3), i, k)\n        __st(d, 0, __ld(d, 0) + 1)\n        append(__ld(d, 5), k)\n    __st(__ld(d, 4), i, v)\n    return 0\n\ndef __dresize(d):\n    oc: int = __ld(d, 1)\n    ohs = __ld(d, 2)\n    oks = __ld(d, 3)\n    ovs = __ld(d, 4)\n    nc: int = oc\n    if (__ld(d, 0) + 1) * 2 > oc:\n        nc = oc * 2\n    __st(d, 6, 0)\n    __st(d, 1, nc)\n    __st(d, 2, __zeros(nc))\n    __st(d, 3, __zeros(nc))\n    __st(d, 4, __zeros(nc))\n    j: int = 0\n    while j < oc:\n        h: int = __ld(ohs, j)\n        if h != 0 and h != 2:\n            k = __ld(oks, j)\n            i: int = __dfind(d, k, h)\n            __st(__ld(d, 2), i, h)\n            __st(__ld(d, 3), i, k)\n            __st(__ld(d, 4), i, __ld(ovs, j))\n        j += 1\n    return 0\n\ndef __ddel(d, k, line) -> int:\n    # remove k; returns 1 if it was present\n    i: int = __dfind(d, k, __hash(k))\n    hs = __ld(d, 2)\n    if __ld(hs, i) == 0:\n        return 0\n    __st(hs, i, 2)\n    __st(__ld(d, 3), i, 0)\n    __st(__ld(d, 4), i, 0)\n    __st(d, 0, __ld(d, 0) - 1)\n    __st(d, 6, __ld(d, 6) + 1)\n    ks = __ld(d, 5)\n    n: int = __ld(ks, 0)\n    kd: int = __ld(ks, 2)\n    j: int = n - 1\n    while j >= 0:\n        x = __ld(kd, j)\n        if _