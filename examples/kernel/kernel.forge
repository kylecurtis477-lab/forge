# forge: no-runtime
# Minimal x86-64 kernel in Forge: serial + VGA console, own GDT/IDT, exception handlers, multiboot2 info.
include "boot.fsi"

COM1 = 0x3F8
VGA = 0xB8000
MB2_MAGIC = 0x36D76289

@packed
struct GdtDesc:
    limit: u16
    base: u64

@packed
struct IdtEntry:
    off_lo: u16
    sel: u16
    ist: u8
    attr: u8
    off_mid: u16
    off_hi: u32
    zero: u32

gdt: u64[3] = [0, 0x00AF9A000000FFFF, 0x00CF92000000FFFF]
gdtr: GdtDesc
idt: IdtEntry[256]
idtr: GdtDesc
vga_pos: u32
ticks: u64

def serial_init():
    outb(COM1 + 1, 0x00)
    outb(COM1 + 3, 0x80)
    outb(COM1 + 0, 0x03)
    outb(COM1 + 1, 0x00)
    outb(COM1 + 3, 0x03)
    outb(COM1 + 2, 0xC7)
    outb(COM1 + 4, 0x0B)

def putc(c: u8):
    while (inb(COM1 + 5) & 0x20) == 0:
        cpu_relax()
    outb(COM1, c)
    v = ptr[u16](VGA)
    if c == 10:
        vga_pos = (vga_pos / 80 + 1) * 80
    else:
        vstore16(VGA + u64(vga_pos) * 2, u16(c) | 0x0F00)
        vga_pos += 1
    if vga_pos >= 80 * 25:
        vga_pos = 0

def puts(s: ptr[u8]):
    i = 0
    while s[i] != 0:
        putc(s[i])
        i += 1

def put_hex(v: u64):
    puts("0x")
    i = 60
    while i >= 0:
        d = u8((v >> i) & 15)
        if d < 10:
            putc(48 + d)
        else:
            putc(87 + d)
        i -= 4

def put_u64(v: u64):
    buf: u8[24]
    i = 23
    while 1:
        i -= 1
        buf[i] = u8(48 + v % 10)
        v = v / 10
        if v == 0:
            break
    puts(addr(buf[i]))

def qemu_exit(code: u32):
    # isa-debug-exit device (iobase 0xf4): qemu exits with (code << 1) | 1
    outl(0xF4, code)
    while 1:
        cli()
        hlt()

def idt_set(n: u32, handler: u64):
    e = addr(idt[n])
    e.off_lo = u16(handler)
    e.sel = 8
    e.ist = 0
    e.attr = 0x8E
    e.off_mid = u16(handler >> 16)
    e.off_hi = u32(handler >> 32)
    e.zero = 0

@interrupt
def on_breakpoint(frame: ptr[u64]):
    ticks += 1
    puts("[int3] rip=")
    put_hex(frame[0])
    puts(" cs=")
    put_hex(frame[1])
    putc(10)

@interrupt_err
def on_page_fault(frame: ptr[u64]):
    puts("[#PF] err=")
    put_hex(frame[0])
    puts(" cr2=")
    put_hex(read_cr2())
    putc(10)
    puts("KERNEL OK\n")
    qemu_exit(0x10)

@interrupt_err
def on_gp(frame: ptr[u64]):
    puts("[#GP] err=")
    put_hex(frame[0])
    putc(10)
    qemu_exit(0x11)

def gdt_init():
    gdtr.limit = u16(sizeof(u64[3]) - 1)
    gdtr.base = u64(addr(gdt))
    lgdt(addr(gdtr))
    asm("push $8", "lea 1f(%rip),%rax", "push %rax", "lretq", "1:", "mov $16,%ax", "mov %ax,%ds", "mov %ax,%es", "mov %ax,%ss")

def idt_init():
    idt_set(3, u64(on_breakpoint))
    idt_set(13, u64(on_gp))
    idt_set(14, u64(on_page_fault))
    idtr.limit = u16(sizeof(IdtEntry) * 256 - 1)
    idtr.base = u64(addr(idt))
    lidt(addr(idtr))

def mb2_scan(info: u64):
    total = load32(info)
    puts("multiboot2 info bytes=")
    put_u64(total)
    putc(10)
    p = info + 8
    while p < info + total:
        typ = load32(p)
        size = load32(p + 4)
        if typ == 0:
            break
        if typ == 2:
            puts("bootloader: ")
            puts(ptr[u8](p + 8))
            putc(10)
        if typ == 4:
            puts("mem upper KiB=")
            put_u64(load32(p + 12))
            putc(10)
        if typ == 12:
            puts("booted via UEFI (EFI64 system table tag)\n")
        p = (p + size + 7) & ~u64(7)

@export
def kmain(magic: u32, info: u32):
    serial_init()
    vga_pos = 0
    puts("Forge kernel: hello from long mode\n")
    if magic != MB2_MAGIC:
        puts("bad multiboot2 magic\n")
        qemu_exit(0x12)
    mb2_scan(u64(info))
    gdt_init()
    idt_init()
    puts("GDT/IDT loaded, cr0=")
    put_hex(read_cr0())
    putc(10)
    t0 = rdtsc()
    int3()
    int3()
    puts("breakpoints handled: ")
    put_u64(ticks)
    putc(10)
    if rdtsc() > t0:
        puts("tsc advancing\n")
    puts("touching unmapped 0x40000000...\n")
    x = vload64(0x40000000)
    puts("unreachable\n")
    qemu_exit(0x13)
