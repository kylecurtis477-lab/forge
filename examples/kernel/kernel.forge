# forge: no-runtime
# Forge x86-64 kernel: higher half, own 4-level page tables, frame allocator, heap, GOP/VBE framebuffer
# console, TSS/IST, ACPI MADT, LAPIC timer, IOAPIC. Boots via GRUB multiboot2 (BIOS or UEFI) or via the
# native Forge UEFI loader (examples/efi/loader.forge) after ExitBootServices.
include "boot.fsi"
include "bootinfo.fsi"
include "console.fsi"
include "sync.fsi"
include "mm.fsi"
include "cpu.fsi"
include "acpi.fsi"
include "apic.fsi"
include "sched.fsi"
include "smp.fsi"
include "user.fsi"

MB2_MAGIC = 0x36D76289

bi: BootInfo

@naked
def read_rsp() -> u64:
    asm("lea 8(%rsp),%rax", "ret")

def add_region(base: u64, len: u64, typ: u64):
    if bi.nregions < MAX_REGIONS and len != 0:
        r = addr(bi.regions[bi.nregions])
        r.base = base
        r.len = len
        r.typ = typ
        bi.nregions += 1

def mb2_parse(info: u64):
    total = u64(load32(info))
    bi.info_base = info
    bi.info_len = total
    p = info + 8
    while p < info + total:
        typ = load32(p)
        size = u64(load32(p + 4))
        if typ == 0:
            break
        if typ == 2:
            puts("bootloader: ")
            puts(ptr[u8](p + 8))
            putc(10)
        if typ == 6:
            esz = u64(load32(p + 8))
            q = p + 16
            while q < p + size:
                t = u64(load32(q + 16))
                mt = MEM_RESERVED
                if t == 1:
                    mt = MEM_USABLE
                elif t == 3:
                    mt = MEM_ACPI_RECLAIM
                elif t == 4:
                    mt = MEM_ACPI_NVS
                elif t == 5:
                    mt = MEM_BAD
                add_region(load64(q), load64(q + 8), mt)
                q += esz
        if typ == 8:
            fbt = load8(p + 29)
            if fbt == 1 and load8(p + 28) == 32:
                bi.fb_addr = load64(p + 8)
                bi.fb_pitch = u64(load32(p + 16))
                bi.fb_width = u64(load32(p + 20))
                bi.fb_height = u64(load32(p + 24))
                bi.fb_bpp = 32
                bi.fb_format = FB_RGBX
                if load8(p + 32) == 0:
                    bi.fb_format = FB_BGRX
            elif fbt == 2:
                vga_base = load64(p + 8)
        if typ == 12:
            bi.method = BOOT_MB2_UEFI
        if typ == 14 and bi.rsdp == 0:
            bi.rsdp = p + 8
        if typ == 15:
            bi.rsdp = p + 8
        p = (p + size + 7) & ~u64(7)

def kernel_start():
    puts("boot method: ")
    if bi.method == BOOT_MB2_BIOS:
        puts("multiboot2 (BIOS)\n")
    elif bi.method == BOOT_MB2_UEFI:
        puts("multiboot2 (UEFI)\n")
    else:
        puts("Forge UEFI loader (ExitBootServices done)\n")
    kdelta = bi.kdelta
    usable: u64 = 0
    i = 0
    while i < bi.nregions:
        if bi.regions[i].typ == MEM_USABLE:
            usable += bi.regions[i].len
        i += 1
    puts("memory map: ")
    put_u64(bi.nregions)
    puts(" regions, ")
    put_u64(usable / 1048576)
    puts(" MiB usable\n")
    pmm_init(addr(bi))
    puts("frames: ")
    put_u64(frames_free)
    puts(" free of ")
    put_u64(frames_total)
    puts(", phys top ")
    put_hex(phys_top)
    puts(", kernel phys ")
    put_hex(ksym(6) + kdelta)
    putc(10)
    fb_len = bi.fb_pitch * bi.fb_height
    pml4 = paging_init(bi.fb_addr, fb_len)
    puts("page tables built: pml4 at ")
    put_hex(pml4)
    puts(", frames used ")
    put_u64(frames_total - frames_free)
    putc(10)
    paging_activate(pml4)
    switch_stack(KSTACK_TOP, u64(kmain_high))

def check_mapping(name: ptr[u8], va: u64, expect_mapped: u64):
    pa = virt_to_phys(kernel_pml4, va)
    puts("  ")
    puts(name)
    puts(" ")
    put_hex(va)
    if pa == 1:
        puts(" -> unmapped")
        if expect_mapped:
            panic("expected mapping")
    else:
        puts(" -> ")
        put_hex(pa)
        if expect_mapped == 0:
            panic("expected no mapping")
    putc(10)

def heap_test():
    ptrs: u64[64]
    before = frames_free
    round = 0
    while round < 3:
        i: u64 = 0
        while i < 64:
            n = (i * 37) % 1500 + 1
            if i % 16 == 15:
                n = 20000 + i * 100
            p = kmalloc(n)
            memset(p, u8(i), n)
            ptrs[i] = p
            i += 1
        i = 0
        while i < 64:
            n = (i * 37) % 1500 + 1
            if i % 16 == 15:
                n = 20000 + i * 100
            if vload8(ptrs[i] + n - 1) != u8(i) or vload8(ptrs[i]) != u8(i):
                panic("heap corruption")
            kfree(ptrs[i])
            i += 1
        if round == 0:
            before = frames_free
        round += 1
    puts("heap: 3 rounds x 64 blocks (slabs 32..4096 + page-backed large), live=")
    put_u64(heap_live)
    puts(", frames after round1/round3: ")
    put_u64(before)
    puts("/")
    put_u64(frames_free)
    putc(10)
    if before != frames_free or heap_live != 0:
        panic("heap leak")

def demand_test():
    a = DEMAND_BASE
    vstore64(a + 0x10, 0x1111)
    vstore64(a + 0x5008, 0x2222)
    vstore64(a + 0xFFFFF0, 0x3333)
    s = vload64(a + 0x10) + vload64(a + 0x5008) + vload64(a + 0xFFFFF0)
    puts("demand paging: ")
    put_u64(demand_faults)
    puts(" faults, sum ")
    put_hex(s)
    putc(10)

def recurse(n: u64) -> u64:
    pad: u64[32]
    pad[n & 31] = n
    return recurse(n + 1) + pad[3]

@export
def kmain_high():
    # now on the guarded kernel stack, identity map gone, physical memory via HHDM
    if bi.fb_addr != 0:
        fb_attach(p2v(bi.fb_addr), bi.fb_width, bi.fb_height, bi.fb_pitch)
        puts("Forge kernel: framebuffer console ")
        put_u64(fb_w)
        puts("x")
        put_u64(fb_h)
        puts(" (8x16 font)\n")
    elif vga_base != 0:
        vga_base = p2v(vga_base)
    puts("higher half: rip ")
    put_hex(u64(kmain_high))
    puts(", rsp ")
    put_hex(read_rsp())
    putc(10)
    check_mapping("identity", 0x100000, 0)
    check_mapping("hhdm", HHDM + 0x100000, 1)
    check_mapping("kernel .text", ksym(0), 1)
    check_mapping("stack guard", KSTACK_TOP - (KSTACK_PAGES + 1) * PAGE, 0)
    gdt_init()
    idt_init()
    puts("GDT+TSS loaded (IST1 ")
    put_hex(IST1_TOP)
    puts(", IST2 ")
    put_hex(IST2_TOP)
    puts("), IDT loaded\n")
    int3()
    int3()
    puts("breakpoints handled: ")
    put_u64(bp_count)
    putc(10)
    heap_test()
    demand_test()
    if acpi_init(bi.rsdp) == 0:
        panic("ACPI/MADT not found")
    before = frames_free
    pmm_reclaim(addr(bi))
    puts("memory reclaimed: loader ")
    put_u64(reclaimed_loader * 4)
    puts(" KiB, ACPI ")
    put_u64(reclaimed_acpi * 4)
    puts(" KiB; frames free ")
    put_u64(before)
    puts(" -> ")
    put_u64(frames_free)
    putc(10)
    if frames_free != before + reclaimed_loader + reclaimed_acpi:
        panic("reclaim accounting")
    puts("stack overflow test: recursing into the guard page...\n")
    df_recover = u64(after_overflow)
    recurse(0)
    panic("recursion returned")

NWORKERS = 8
shared_counter: u64
counter_lock: u64
done_count: u64
work_until: u64

def worker(arg: u64):
    t = cur_thread()
    while atomic_load64(u64(addr(lapic_ticks))) < work_until:
        f = irq_save()
        spin_lock(u64(addr(counter_lock)))
        shared_counter += 1
        spin_unlock(u64(addr(counter_lock)))
        irq_restore(f)
        t.iters += 1
    atomic_add64(u64(addr(done_count)), 1)

def popcount(v: u64) -> u64:
    n: u64 = 0
    while v != 0:
        n += v & 1
        v = v >> 1
    return n

def sched_test():
    ths: u64[8]
    work_until = lapic_ticks + 30
    i = 0
    while i < NWORKERS:
        ths[i] = u64(thread_spawn(u64(worker), i))
        i += 1
    while atomic_load64(u64(addr(done_count))) < NWORKERS:
        hlt()
    total: u64 = 0
    seen: u64 = 0
    minsw: u64 = 0xFFFFFFFF
    i = 0
    while i < NWORKERS:
        t = ptr[Thread](ths[i])
        while atomic_load64(u64(addr(t.state))) != T_DEAD:
            yield_cpu()
        total += t.iters
        seen = seen | t.cpus_seen
        if t.switches < minsw:
            minsw = t.switches
        thread_free(t)
        i += 1
    puts("scheduler: ")
    put_u64(NWORKERS)
    puts(" threads, counter ")
    put_u64(shared_counter)
    puts(" = sum ")
    put_u64(total)
    puts(", min switches/thread ")
    put_u64(minsw)
    puts(", cpus used ")
    put_u64(popcount(seen))
    puts("/")
    put_u64(ncpu_online)
    puts(", heap live ")
    put_u64(heap_live)
    putc(10)
    if shared_counter != total or minsw < 2:
        panic("scheduler test failed")
    if popcount(seen) != ncpu_online:
        panic("not all CPUs ran threads")
    puts("preemptive SMP scheduler OK\n")

asm(".section .rodata",
    ".balign 16",
    "user_hello_elf: .incbin \"hello.elf\"",
    "user_hello_end:",
    ".balign 16",
    "user_fault_elf: .incbin \"fault.elf\"",
    "user_fault_end:",
    ".text")

@naked
def uimg(i: u64) -> u64:
    asm("lea user_hello_elf(%rip), %rax", "cmp $1, %rdi", "jb 1f",
        "lea user_hello_end(%rip), %rax", "je 1f",
        "lea user_fault_elf(%rip), %rax", "cmp $3, %rdi", "jb 1f",
        "lea user_fault_end(%rip), %rax", "1: ret")

def user_test():
    f0 = frames_free
    h0 = heap_live
    hi = uimg(0)
    hl = uimg(1) - hi
    fi = uimg(2)
    fl = uimg(3) - fi
    bad = proc_spawn(hi + 1, hl - 1)
    if u64(bad) != 0:
        panic("ELF loader accepted a corrupt image")
    a = proc_spawn(hi, hl)
    b = proc_spawn(hi, hl)
    c = proc_spawn(fi, fl)
    d = proc_spawn(hi, hl)
    ida = a.id
    idb = b.id
    idd = d.id
    ca = proc_reap(a)
    cb = proc_reap(b)
    cc = proc_reap(c)
    cd = proc_reap(d)
    puts("user mode: 4 processes, exit codes ")
    put_u64(ca)
    puts(" ")
    put_u64(cb)
    puts(" ")
    put_hex(cc)
    puts(" ")
    put_u64(cd)
    puts(", syscalls ")
    put_u64(syscalls)
    puts(", frames leaked ")
    put_u64(f0 - frames_free)
    puts(", heap leaked ")
    put_u64(heap_live - h0)
    putc(10)
    if ca != (ida & 0xFF) or cb != (idb & 0xFF) or cd != (idd & 0xFF) or cc != 0x10E:
        panic("user mode test: wrong exit codes")
    if frames_free != f0 or heap_live != h0:
        panic("user mode test: leak")
    puts("ring 3 + syscall/sysret + ELF loader OK\n")

@export
def after_overflow():
    puts("recovered from #DF on a fresh stack\n")
    pic_disable()
    lapic_init()
    ioapic_init()
    idt_set(VEC_TIMER, u64(on_lapic_timer), 0)
    idt_set(VEC_PIT, u64(on_pit), 0)
    idt_set(VEC_SPURIOUS, u64(on_spurious), 0)
    # IOAPIC: ISA IRQ0 (PIT channel 0) via its interrupt source override, one-shot ~1 ms
    ioapic_route(0, VEC_PIT)
    outb(0x43, 0x30)
    outb(0x40, 0xA9)
    outb(0x40, 0x04)
    sti()
    while lapic_ticks < 20:
        hlt()
    cli()
    ioapic_mask(0)
    puts("LAPIC timer ticks: ")
    put_u64(lapic_ticks)
    puts(", PIT IRQ0 via IOAPIC gsi ")
    put_u64(irq_gsi[0])
    puts(": ")
    put_u64(pit_irqs)
    puts(" irq(s)\n")
    if pit_irqs == 0:
        panic("no IOAPIC interrupt")
    cpu_syscall_init(0)
    smp_init()
    puts("SMP: ")
    put_u64(ncpu_online)
    puts(" cpus online\n")
    sched_cpu_init(0, 0)
    sched_on = 1
    sti()
    sched_test()
    user_test()
    cli()
    puts("KERNEL OK\n")
    # test harness: wait up to 5 s (LAPIC ticks) for 'q' on COM1 so it can take a screenshot first
    t_end = lapic_ticks + 500
    sti()
    while lapic_ticks < t_end:
        if serial_poll() == 113:
            break
        hlt()
    cli()
    qemu_exit(0x10)

@export
def kmain_mb2(magic: u32, info: u32):
    serial_init()
    vga_base = 0
    puts("Forge kernel (multiboot2 entry)\n")
    if magic != MB2_MAGIC:
        panic("bad multiboot2 magic")
    bi.magic = BI_MAGIC
    bi.method = BOOT_MB2_BIOS
    bi.kdelta = 0
    p2v_base = 0
    mb2_parse(u64(info))
    kernel_start()

@export
def kmain_efi(info: u64):
    serial_init()
    puts("Forge kernel (UEFI loader entry)\n")
    p2v_base = 0
    if load64(info) != BI_MAGIC:
        panic("bad BootInfo magic")
    memcpy(u64(addr(bi)), info, sizeof(BootInfo))
    kernel_start()
