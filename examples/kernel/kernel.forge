include "cpux.fsi"
include "sched.fsi"
include "smp.fsi"
include "user.fsi"
include "pci.fsi"
include "virtio.fsi"
include "nvme.fsi"
include "ahci.fsi"
include "xhci.fsi"
include "net.fsi"
include "hw.fsi"
include "ffs.fsi"
# object-store capacities (obj.fsi takes them from the includer)
OB_NT = 32
OB_NO = 256
OB_NV = 2048
OB_NB = 1024
OB_NW = 16384
OB_NL = 32768
OB_HB = 2048
OB_NX = 8192
OB_HX = 16384
include "crypt.fsi"
include "obj.fsi"
include "objfs.fsi"
include "objd.fsi"
