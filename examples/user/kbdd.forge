# forge: safe
# forge: no-runtime
# forge: caps(drv)
# kbdd v1: the keyboard/serial input driver as a supervised ring-3 service (kernel side: kbd.fsi).
# It takes batches from the kernel's input journal (411), decodes PS/2 scan codes (set 1, shift,
# E0 prefix) and serial bytes (CR -> LF), and commits each batch with its characters and its decoder
# state (412). It keeps no state of its own between batches that the kernel does not hold, so a
# restarted or swapped-in instance (v1 or v2) continues from the last commit (413).
include "ulib.fsi"

SC_MAP: u8[58] = [0, 27, 49, 50, 51, 52, 53, 54, 55, 56, 57, 48, 45, 61, 8, 9, 113, 119, 101, 114, 116, 121, 117, 105, 111, 112, 91, 93, 10, 0, 97, 115, 100, 102, 103, 104, 106, 107, 108, 59, 39, 96, 0, 92, 122, 120, 99, 118, 98, 110, 109, 44, 46, 47, 0, 42, 0, 32]
SC_SHIFT: u8[58] = [0, 27, 33, 64, 35, 36, 37, 94, 38, 42, 40, 41, 95, 43, 8, 9, 81, 87, 69, 82, 84, 89, 85, 73, 79, 80, 123, 125, 10, 0, 65, 83, 68, 70, 71, 72, 74, 75, 76, 58, 34, 126, 0, 124, 90, 88, 67, 86, 66, 78, 77, 60, 62, 63, 0, 42, 0, 32]
MAGIC = 0x4B4244
trap: u64[1]

@export
def _start():
    st = syscall3(413, 0, 0, 0)
    shift: u64 = 0
    if (st & 5) != 0:
        shift = 1
    e0 = (st >> 1) & 1
    m: u64[33]
    ch: u8[64]
    while 1:
        n = syscall3(411, u64(addr(m[0])), 32, 0)
        if n == 0:
            sys_exit(0)
        if is_err(n) or n > 32:
            sys_exit(2)
        k: u64 = 0
        i: u64 = 0
        while i < n:
            e = m[1 + i]
            if (e & 0x10000) != 0:
            # injected fault (syscall 408): an out-of-range index traps with the batch uncommitted
                trap[e >> 16] = 1
            b = e & 0xFF
            if ((e >> 8) & 0xFF) == 1:
                if b == 13:
                    b = 10
                ch[k] = u8(b)
                k += 1
            elif b == 0xE0:
                e0 = 1
            elif e0 != 0:
                e0 = 0
            elif b == 0x2A or b == 0x36:
                shift = 1
            elif b == 0xAA or b == 0xB6:
                shift = 0
            elif b < 58:
                c = u64(SC_MAP[b])
                if shift != 0:
                    c = u64(SC_SHIFT[b])
                if c != 0:
                    ch[k] = u8(c)
                    k += 1
            i += 1
        syscall4(412, m[0] + n, u64(addr(ch[0])), k, (MAGIC << 8) | shift | (e0 << 1))
