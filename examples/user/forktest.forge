# forge: no-runtime
# fork/wait/exit, brk, mmap/munmap and exec, checked from user space.
include "ulib.fsi"

x: u64

def fail(s: ptr[u8]):
    out("forktest FAIL: ")
    out(s)
    out("\n")
    flush()
    sys_exit(1)

@export
def _start():
    x = 1
    st: u64 = 0
    pid = sys_fork()
    if pid == 0:
        x = 2
        sys_exit(42)
    if is_err(pid):
        fail("fork")
    w = sys_wait(pid, addr(st))
    if w != pid or st != 42 or x != 1:
        fail("fork/wait")
    # five children at once, reaped in any order
    k: u64 = 0
    while k < 5:
        c = sys_fork()
        if c == 0:
            sys_exit(10 + k)
        k += 1
    sum: u64 = 0
    k = 0
    while k < 5:
        if is_err(sys_wait(0xFFFFFFFFFFFFFFFF, addr(st))):
            fail("wait any")
        sum += st
        k += 1
    if sum != 60 or sys_wait(0xFFFFFFFFFFFFFFFF, addr(st)) != 0xFFFFFFFFFFFFFFF6:
        fail("wait any / ECHILD")
    out("forktest: fork ok (child exit 42, parent x=1), 5 children reaped, ECHILD\n")
    flush()
    b0 = sys_brk(0)
    b1 = sys_brk(b0 + 100000)
    if b1 != b0 + 100000:
        fail("brk grow")
    p = ptr[u8](b0)
    p[0] = 7
    p[99999] = 9
    if sys_brk(b0) != b0:
        fail("brk shrink")
    m = sys_mmap(3 * 4096 + 5)
    if is_err(m):
        fail("mmap")
    q = ptr[u64](m)
    q[0] = 0x1234
    q[2047] = 0x5678
    if q[0] + q[2047] != 0x68AC or sys_munmap(m, 4 * 4096) != 0:
        fail("mmap rw / munmap")
    out("forktest: brk +100000 ok, mmap 16KiB rw ok, munmap ok\n")
    flush()
    c2 = sys_fork()
    if c2 == 0:
        sys_exec("/efi/forge/bin/hello", "from-exec 1 2 3")
        sys_exit(77)
    sys_wait(c2, addr(st))
    if st != 0:
        fail("exec")
    out("forktest: exec ok\nforktest: PASS\n")
    flush()
    sys_exit(0)
