# forge: safe
# forge: no-runtime
# forge: caps(fs)
# Phase 6.2: declares only the fs capability. Opening a file is allowed; fork (spawn) and the probe
# syscall are undeclared and must be refused at the syscall boundary.
include "ulib.fsi"

def say(ok: u64):
    if ok:
        out("allowed")
    else:
        out("denied")

@export
def _start():
    fd = sys_open("/efi/forge/docs/big.bin")
    ok_fs = fd < 0x8000000000000000
    if ok_fs:
        sys_close(fd)
    f = sys_fork()
    if f == 0:
        sys_exit(77)
    pr = syscall3(SYS_PROBE, 0, 0, 0)
    out("capdeny: open ")
    say(ok_fs)
    out(", fork ")
    say(f < 0x8000000000000000)
    out(", probe ")
    say(pr < 0x8000000000000000)
    out("\n")
    flush()
    if ok_fs and f >= 0x8000000000000000 and pr >= 0x8000000000000000:
        sys_exit(0)
    sys_exit(1)
