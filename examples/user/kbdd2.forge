# forge: safe
# forge: no-runtime
# forge: caps(drv)
# kbdd v2: a second implementation of the input driver, hot-swapped with v1 while the shell runs.
# It tracks the left and right shift keys separately (state bits 0 and 2; v1 keeps one shift bit in
# bit 0) and derives upper-case letters arithmetically instead of from the shifted table. Both
# versions read and write the same state word, so either can take over from the other.
include "ulib.fsi"

SC_MAP: u8[58] = [0, 27, 49, 50, 51, 52, 53, 54, 55, 56, 57, 48, 45, 61, 8, 9, 113, 119, 101, 114, 116, 121, 117, 105, 111, 112, 91, 93, 10, 0, 97, 115, 100, 102, 103, 104, 106, 107, 108, 59, 39, 96, 0, 92, 122, 120, 99, 118, 98, 110, 109, 44, 46, 47, 0, 42, 0, 32]
SC_SHIFT: u8[58] = [0, 27, 33, 64, 35, 36, 37, 94, 38, 42, 40, 41, 95, 43, 8, 9, 81, 87, 69, 82, 84, 89, 85, 73, 79, 80, 123, 125, 10, 0, 65, 83, 68, 70, 71, 72, 74, 75, 76, 58, 34, 126, 0, 124, 90, 88, 67, 86, 66, 78, 77, 60, 62, 63, 0, 42, 0, 32]
MAGIC = 0x4B4244
trap: u64[1]

def decode(b: u64, sh: u64) -> u64:
    c = u64(SC_MAP[b])
    if sh == 0:
        return c
    if c >= 97 and c <= 122:
        return c - 32
    return u64(SC_SHIFT[b])

@export
def _start():
    st = syscall3(413, 0, 0, 0)
    flags = st & 7
    m: u64[33]
    ch: u8[64]
    while 1:
        n = syscall3(411, u64(addr(m[0])), 32, 0)
        if n == 0:
            sys_exit(0)
        if is_err(n) or n > 32:
            sys_exit(2)
        k: u64 = 0
        i: u64 = 0
        while i < n:
            e = m[1 + i]
            if (e & 0x10000) != 0:
                trap[e >> 16] = 1
            b = e & 0xFF
            kind = (e >> 8) & 0xFF
            if kind == 1:
                ch[k] = u8(b)
                if b == 13:
                    ch[k] = 10
                k += 1
            elif (flags & 2) != 0:
                flags = flags & 5
            elif b == 0xE0:
                flags = flags | 2
            elif b == 0x2A:
                flags = flags | 1
            elif b == 0x36:
                flags = flags | 4
            elif b == 0xAA:
                flags = flags & 6
            elif b == 0xB6:
                flags = flags & 3
            elif b < 58:
                c = decode(b, flags & 5)
                if c != 0:
                    ch[k] = u8(c)
                    k += 1
            i += 1
        syscall4(412, m[0] + n, u64(addr(ch[0])), k, (MAGIC << 8) | flags)
