# forge: no-runtime
# A Forge user program: runs in ring 3 in its own address space, talks to the kernel only through syscalls.
include "ulib.fsi"

marker: u64

def count_primes(n: u64) -> u64:
    c: u64 = 0
    i: u64 = 2
    while i < n:
        d: u64 = 2
        prime = 1
        while d * d <= i:
            if i % d == 0:
                prime = 0
                break
            d += 1
        c += prime
        i += 1
    return c

@export
def _start():
    pid = sys_getpid()
    marker = pid * 1000 + 7
    out("hello from ring 3: Forge user program, pid ")
    out_u64(pid)
    out(", cpl ")
    out_u64(read_cs() & 3)
    out("\n")
    flush()
    n = count_primes(30000)
    i = 0
    while i < 5:
        sys_yield()
        i += 1
    if marker != pid * 1000 + 7:
        out("pid ")
        out_u64(pid)
        out(": ISOLATION BROKEN\n")
        flush()
        sys_exit(99)
    out("pid ")
    out_u64(pid)
    out(": primes below 30000 = ")
    out_u64(n)
    out(", private data intact after yields\n")
    flush()
    sys_exit(pid)
