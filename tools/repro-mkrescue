#!/bin/sh
# grub-mkrescue wrapper: with SOURCE_DATE_EPOCH set, produce a byte-reproducible
# BIOS+UEFI hybrid ISO without hooking the clock. This grub-mkrescue 2.12 does
# not honour SOURCE_DATE_EPOCH and stamps a wall-clock UUID into .disk/, the
# GRUB core images, and --modification-date=. The wrapper runs grub-mkrescue,
# then replaces that UUID (same-length YYYY-MM-DD-HH-MM-SS-00, derived from the
# epoch) in the extracted tree, remakes the El Torito FAT with tools/repro-mformat
# (-N serial), and rebuilds the ISO with tools/repro-xorriso (--modification-date
# and --set_all_file_dates). Without SOURCE_DATE_EPOCH, exec grub-mkrescue
# unchanged. Used by examples/kernel/build.sh and build.forge.
set -e
ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
MKRESCUE=${GRUB_MKRESCUE:-/usr/bin/grub-mkrescue}
if [ -z "${SOURCE_DATE_EPOCH:-}" ]; then
    exec "$MKRESCUE" "$@"
fi

quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

OUT=
EXTRA=
while [ $# -gt 0 ]; do
    case "$1" in
        -o|--output)
            if [ $# -lt 2 ]; then
                echo "repro-mkrescue: $1 needs an argument" >&2
                exit 2
            fi
            OUT=$2
            shift 2
            ;;
        --output=*)
            OUT=${1#--output=}
            shift
            ;;
        *)
            EXTRA="$EXTRA $(quote "$1")"
            shift
            ;;
    esac
done
if [ -z "$OUT" ]; then
    echo "repro-mkrescue: -o/--output is required when SOURCE_DATE_EPOCH is set" >&2
    exit 2
fi
eval "set -- $EXTRA"

DATE=$(TZ=UTC date -u -d "@$SOURCE_DATE_EPOCH" +%Y%m%d%H%M%S00)
UUID=$(TZ=UTC date -u -d "@$SOURCE_DATE_EPOCH" +%Y-%m-%d-%H-%M-%S-00)

WORKDIR=$(mktemp -d)
trap 'chmod -R u+w "$WORKDIR" 2>/dev/null; rm -rf "$WORKDIR"' EXIT

"$MKRESCUE" -o "$WORKDIR/raw.iso" "$@"
mkdir "$WORKDIR/x"
xorriso -osirrox on -indev "$WORKDIR/raw.iso" -extract / "$WORKDIR/x" >/dev/null 2>&1
chmod -R u+w "$WORKDIR/x"

diskdir=$WORKDIR/x/.disk
if [ ! -d "$diskdir" ]; then
    echo "repro-mkrescue: no .disk/ in grub-mkrescue ISO" >&2
    exit 1
fi
oldf=$(ls "$diskdir"/*.uuid 2>/dev/null || true)
if [ -z "$oldf" ] || [ ! -f "$oldf" ]; then
    echo "repro-mkrescue: no .disk/*.uuid in grub-mkrescue ISO" >&2
    exit 1
fi
OLD=$(basename "$oldf" .uuid)
if [ "$OLD" != "$UUID" ]; then
    if [ ${#OLD} -ne ${#UUID} ]; then
        echo "repro-mkrescue: UUID length mismatch: $OLD vs $UUID" >&2
        exit 1
    fi
    python3 - "$OLD" "$UUID" "$WORKDIR/x" << 'PY'
import pathlib, sys
old, new, root = sys.argv[1], sys.argv[2], sys.argv[3]
ob, nb = old.encode(), new.encode()
for p in pathlib.Path(root).rglob("*"):
    if not p.is_file():
        continue
    d = p.read_bytes()
    if ob in d:
        p.write_bytes(d.replace(ob, nb))
PY
    mv "$diskdir/$OLD.uuid" "$diskdir/$UUID.uuid"
fi

# Recreate the El Torito FAT so its volume serial is pinned (mformat -N).
if [ -d "$WORKDIR/x/efi" ]; then
    rm -f "$WORKDIR/x/efi.img"
    "$ROOT/tools/repro-mformat" -C -f 2880 -L 16 -i "$WORKDIR/x/efi.img" ::
    mcopy -s -i "$WORKDIR/x/efi.img" "$WORKDIR/x/efi" ::/.
fi

# Same hybrid layout grub-mkrescue uses; dates come from --modification-date and
# tools/repro-xorriso's --set_all_file_dates.
"$ROOT/tools/repro-xorriso" -as mkisofs -graft-points --modification-date="$DATE" \
    -b boot/grub/i386-pc/eltorito.img -no-emul-boot -boot-load-size 4 -boot-info-table \
    --grub2-boot-info --grub2-mbr /usr/lib/grub/i386-pc/boot_hybrid.img \
    -hfsplus -apm-block-size 2048 \
    -hfsplus-file-creator-type chrp tbxj /System/Library/CoreServices/.disk_label \
    -hfs-bless-by i /System/Library/CoreServices/boot.efi \
    --efi-boot efi.img -efi-boot-part --efi-boot-image --protective-msdos-label \
    -o "$OUT" -r "$WORKDIR/x" --sort-weight 0 / --sort-weight 1 /boot
