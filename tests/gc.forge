# GC stress: ~1 GB of garbage must run in bounded memory while live data survives.
class Node:
    def __init__(self, v, nxt):
        self.v = v
        self.nxt = nxt

def make_adder(n):
    def add(x):
        return x + n
    return add

keep = []
d = {}
adders = []
i = 0
while i < 50:
    adders.append(make_adder(i))
    i += 1
round = 0
while round < 1500:
# garbage: strings, lists, objects, cycles, floats
    junk = []
    j = 0
    while j < 2000:
        s = concat("item-", str(j))
        n = Node(s, None)
        n.nxt = n
        junk.append([s, n, j * 1.5])
        j += 1
    big = list(20000)
    big[19999] = round
    try:
        if round % 7 == 0:
            raise ValueError(concat("boom ", str(round)))
    except ValueError as e:
        keep.append(str(e))
    d[str(round)] = Node(round, junk[round])
    round += 1
total = 0
for k in d:
    total += d[k].v + len(d[k].nxt[0])
print(len(keep), keep[0], keep[len(keep) - 1])
print(total)
print(adders[10](5), adders[49](1))
print(d["150"].nxt[1].nxt.v, d["150"].nxt[2])
release(0)
print(mark() < 64000000)
