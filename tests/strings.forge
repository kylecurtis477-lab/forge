s = "  Hello, World  "
print("[" + s.strip() + "]", "[" + s.lstrip() + "]", "[" + s.rstrip() + "]")
print("xxhixx".strip("x"), "xxhixx".lstrip("x"), "xxhixx".rstrip("x"))
print(s.find("o"), s.find("o", 7), s.find("zz"), s.rfind("o"), s.index("W"), s.count("l"))
print(s.replace("l", "L"), "a-b-c".split("-"), "a b  c".split(), "a-b-c".rsplit("-", 1))
print("a,b".partition(","), "a,b,c".rpartition(","), "ab".partition("x"))
print("x".zfill(3), "-5".zfill(4), "ab".center(7, "*"), "ab".ljust(5, "."), "ab".rjust(5))
print("hello world".title(), "hello World".capitalize(), "Hello".swapcase())
print("abc".isalnum(), "a c".isalnum(), "  ".isspace(), "ABC".isupper(), "abc".islower(), "Ab".isupper())
print("prefix_x".removeprefix("prefix_"), "x.py".removesuffix(".py"), "a\nb\r\nc".splitlines())
print("{} + {} = {}".format(1, 2, 3), "{0}{1}{0}".format("a", "b"), "{name}={v:>5}".format(name="x", v=42))
print("{:.2f}|{:<6}|{:^7}|{!r}|{{x}}".format(3.14159, "ab", "mid", "q"))
print("-".join(["a", "b"]), "abc".upper(), "ABC".lower(), "a1".isdigit(), "ab".startswith("a"), "ab".endswith("b"))
print("%s is %d" % ("x", 5), "%5.1f" % 2.25, "%-4s|" % "a")
