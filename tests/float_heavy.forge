import math
def integrate(n: int) -> float:
    h = 1.0 / n
    s = 0.0
    i = 0
    while i < n:
        x = (i + 0.5) * h
        s += 4.0 / (1.0 + x * x)
        i += 1
    return s * h
def stats(xs: list[float]) -> float:
    m = sum(xs) / len(xs)
    v = 0.0
    for x in xs:
        v += (x - m) * (x - m)
    return v / len(xs)
pi = integrate(100000)
print(round(pi, 6), abs(pi - math.pi) < 1e-8)
xs = [math.sin(i * 0.1) * 3.0 + 1.5 for i in range(1000)]
print(round(stats(xs), 6), round(min(xs), 4), round(max(xs), 4))
a = 1.0
b = 0.0
for i in range(50):
    a, b = a * 0.5 + b, a - b * 0.25
print(round(a, 9), round(b, 9), a > b, -a < b, int(a * 1000000), float(7) / 2, 7 // 2.0, 7.5 % 2)
print(math.sqrt(2.0), math.floor(2.7), math.ceil(2.1), 1e300 * 10, -1e300 * 10)
