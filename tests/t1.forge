# basic test
class Point:
    x: int
    y: int

def fib(n: int) -> int:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

def total(p):
    return p.x + p.y

print(fib(20))
s = 0
for i in range(10):
    if i == 3:
        continue
    elif i == 8:
        break
    s += i
print(s)
p = Point(3, 4)
p.y = 10
print(total(p))
