# Generate the tests/ed25519 vectors: Forge port of tests/ed25519/gen.py.
#   gen OUT.forge SIGNER    writes the verifier test program to OUT.forge and prints the expected
#                           1/0 string (one digit per vector)
# SIGNER is a build of tools/ed25519.forge (`public SEED` / `sign SEED MSG`). The output must be
# byte-identical to gen.py's; gen.py stays as the independent cross-check (its signatures come from
# the `cryptography` package), run by tests/ed25519/run.sh when FORGE_ED25519_PY=1.
# (the "no-runtime" pragma below is split so this host tool is not compiled freestanding)
import os
import sys

TMP = "/tmp/forge-edgen-" + str(os.getpid())

def bstr(xs) -> str:
# list of byte values -> string
    out = []
    for x in xs:
        out.append(chr(x))
    return "".join(out)

def tool(args):
# run the signer, return its stdout as a list of byte values
    r = os.run([sys.argv[2]] + args)
    if r[0] != 0:
        print("gen: signer failed: " + " ".join(args))
        sys.exit(1)
    out = []
    for c in r[1]:
        out.append(ord(c))
    return out

def public(seed):
    write_file(TMP + ".seed", bstr(seed))
    return tool(["public", TMP + ".seed"])

def sign(seed, m):
    write_file(TMP + ".seed", bstr(seed))
    write_file(TMP + ".msg", bstr(m))
    return tool(["sign", TMP + ".seed", TMP + ".msg"])

def flip(b, i: int, x: int):
    c = list(b)
    c[i] = c[i] ^ x
    return c

def add_l(sig):
# sig with its S half (little-endian bytes 32..63) increased by the group order L: non-canonical S
    L = [0xed, 0xd3, 0xf5, 0x5c, 0x1a, 0x63, 0x12, 0x58, 0xd6, 0x9c, 0xf7, 0xa2, 0xde, 0xf9, 0xde, 0x14]
    while len(L) < 31:
        L.append(0)
    L.append(0x10)
    out = list(sig)
    carry: int = 0
    i: int = 0
    while i < 32:
        t: int = out[32 + i] + L[i] + carry
        out[32 + i] = t & 255
        carry = t >> 8
        i += 1
    return out

def arr(name, b, n: int) -> str:
    vals = []
    for x in b:
        vals.append(str(x))
    while len(vals) < n:
        vals.append("0")
    return name + ": u8[" + str(n) + "] = [" + ", ".join(vals) + "]\n"

def main():
    if len(sys.argv) != 3:
        print("usage: gen OUT.forge SIGNER")
        sys.exit(2)
    vec = []
    sizes = [0, 1, 31, 64, 95, 96]
    k: int = 0
    while k < 6:
        seed = []
        i: int = 0
        while i < 32:
            seed.append((k * 37 + i) & 255)
            i += 1
        pk = public(seed)
        m = []
        i = 0
        while i < sizes[k]:
            m.append((k * 11 + i * 7) & 255)
            i += 1
        sig = sign(seed, m)
        vec.append([pk, sig, m, 1])
        if k == 1:
            vec.append([pk, flip(sig, 5, 1), m, 0])
            vec.append([pk, flip(sig, 40, 4), m, 0])
        if k == 3:
            vec.append([pk, sig, flip(m, 0, 1), 0])
            vec.append([pk, add_l(sig), m, 0])
            zero = []
            i = 0
            while i < 32:
                zero.append(0)
                i += 1
            vec.append([public(zero), sig, m, 0])
            vec.append([[2] + zero[1:], sig, m, 0])
        k += 1
    os.remove(TMP + ".seed")
    os.remove(TMP + ".msg")
    out = ["# forge: safe\n# forge: " + "no-runtime\n# generated by tests/ed25519/gen.py\ninclude \"../../examples/user/ulib.fsi\"\ninclude \"../../examples/kernel/ed25519.fsi\"\n"]
    n: int = len(vec)
    i = 0
    while i < n:
        v = vec[i]
        out.append(arr("pk" + str(i), v[0], 32) + arr("sg" + str(i), v[1], 64) + arr("ms" + str(i), v[2], 96))
        i += 1
    out.append("\npkb: B32\nsgb: EdSig\nmsb: EdMsg\n")
    i = 0
    while i < n:
        s = str(i)
        out.append("\ndef setv" + s + "():\n    i: u64 = 0\n    while i < 32:\n        pkb.b[i] = pk" + s + "[i]\n        sgb.r.b[i] = sg" + s + "[i]\n        sgb.s.b[i] = sg" + s + "[i + 32]\n        i += 1\n    i = 0\n    while i < 96:\n        msb.b[i] = ms" + s + "[i]\n        i += 1\n")
        i += 1
    out.append("\n@export\ndef _start():\n")
    want = []
    i = 0
    while i < n:
        v = vec[i]
        out.append("    setv" + str(i) + "()\n    out_u64(ed25519_verify(addr(sgb), addr(pkb), addr(msb), " + str(len(v[2])) + "))\n")
        want.append(str(v[3]))
        i += 1
    out.append("    out(\"\\n\")\n    flush()\n    sys_exit(0)\n")
    write_file(sys.argv[1], "".join(out))
    print("".join(want))

main()
