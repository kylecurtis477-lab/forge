# forge: no-runtime
# optimizer gate (build-plan item 3 part c): a frame array read more than 4096 times in one function. Every
# a[...] read is a `lea N(%rbp)` line, and --fs-opt pins each offset such a line names (fsp_pin, 4096 entries),
# so this function fills the pin table: fs_ra_pin returns -1 and fs_regalloc leaves the function unpromoted
# (tools/optcov.forge reports the two blocks; before this program no corpus program reached them).
# Output must match pins.expected under every optimizer configuration (run_tests.sh optgate check).
include "../fs/linux.fsi"

