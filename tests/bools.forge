# bools: True/False values, bool arithmetic, chained comparisons
def is_even(n: int):
    return n % 2 == 0

def classify(x: int) -> str:
    if 0 <= x < 10:
        return "digit"
    elif 10 <= x <= 99:
        return "two"
    return "big"

print(True, False, not True, not 0, not "")
print(1 < 2, 2 < 1, 3 == 3, 3 != 3)
print(is_even(4), is_even(7))
b = 5 > 3
print(b, [b, not b], str(b) + "!")
print(True + True, True * 10, False - 1, -True)
print(1 < 2 < 3, 1 < 3 < 2, 3 > 2 > 1 > 0, 1 == 1 == 1, 1 < 2 > 0)
print(classify(5), classify(42), classify(1000))
n = 0
for i in range(20):
    if 2 < i <= 6:
        n += i
print(n)
print(True == 1, False == 0, True is True)
d = {True: "yes", False: "no"}
print(d[1 > 0], d[1 < 0])
flags = [x > 2 for x in [1, 2, 3, 4]]
print(flags, sum(flags))
print(True and 5, False or "x", 0 or False, 3 and True)
print(int(True), abs(-3), max(True, 0))
k = 7
print(k > 3 and k < 10, k < 3 or k == 7)
