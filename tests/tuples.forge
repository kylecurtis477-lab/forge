    return 1, "x"
print(f(), sorted((3, 1, 2)), list(d.items()))
for k, v in d.items():
    print(k, v)
print(min([3, 1, 2], key=lambda v: -v), max(["aa", "b", "ccc"], key=len), min((4, 2)))
print(str((1, "a")), [(1, 2)], hash((1, 2)) == hash((1, 2)))
