t = (1, 2)
print(t, (5,), (), tuple([3, 4]), list(t))
a, b = t
print(a, b, len(t), t[0], t[-1], t[0:1])
d = {(1, 2): 5, ("a", 3): 6}
print(d[(1, 2)], d[("a", 3)], (1, 2) in d)
print(t + (3,), t * 2, t == (1, 2), t < (1, 3), 2 in t)
