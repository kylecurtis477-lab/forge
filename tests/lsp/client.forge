# tests/lsp/client.forge: Forge port of tests/lsp/client.py (kept as the reference; tests/lsp/run.sh runs
# the Forge client, FORGE_LSP_PY=1 runs the Python one too). A scripted LSP session against `forge lsp`
# (Phase 7.5): copies tests/lsp/proj to a scratch directory, starts the server on two pipes, and prints the
# same PASS/FAIL lines in the same order as the Python client; exit 1 on any failure. The JSON reader and
# writer are copied from tools/lsp.forge. There is no receive timeout: tests/lsp/run.sh runs the client
# under timeout(1) instead, and a stalled session fails as a whole.
# usage: client ROOT   (ROOT = the repo, whose ./forge starts the server)
import os
import sys

# ---------------- JSON ----------------
def jskip(s, i):
    while i < len(s) and (s[i] == " " or s[i] == "\n" or s[i] == "\r" or s[i] == "\t"):
        i += 1
    return i

def hexv(c):
    o = ord(c)
    if o >= 48 and o <= 57:
        return o - 48
    if o >= 97 and o <= 102:
        return o - 87
    return o - 55

def utf8(cp):
    if cp < 128:
        return chr(cp)
    if cp < 2048:
        return chr(192 | (cp >> 6)) + chr(128 | (cp & 63))
    if cp < 65536:
        return chr(224 | (cp >> 12)) + chr(128 | ((cp >> 6) & 63)) + chr(128 | (cp & 63))
    return chr(240 | (cp >> 18)) + chr(128 | ((cp >> 12) & 63)) + chr(128 | ((cp >> 6) & 63)) + chr(128 | (cp & 63))

def jparse(s, i):
# -> [value, next index]
    i = jskip(s, i)
    c = s[i]
    if c == "{":
        d = {}
        i = jskip(s, i + 1)
        if s[i] == "}":
            return [d, i + 1]
        while True:
            k = jparse(s, i)
            i = jskip(s, k[1])
            v = jparse(s, i + 1)
            d[k[0]] = v[0]
            i = jskip(s, v[1])
            if s[i] == ",":
                i += 1
            else:
                return [d, i + 1]
    if c == "[":
        a = []
        i = jskip(s, i + 1)
        if s[i] == "]":
            return [a, i + 1]
        while True:
            v = jparse(s, i)
            a.append(v[0])
            i = jskip(s, v[1])
            if s[i] == ",":
                i += 1
            else:
                return [a, i + 1]
    if c == "\"":
        parts = []
        i += 1
        st = i
        while s[i] != "\"":
            if s[i] == "\\":
                parts.append(s[st:i])
                e = s[i + 1]
                if e == "n":
                    parts.append("\n")
                elif e == "t":
                    parts.append("\t")
                elif e == "r":
                    parts.append("\r")
                elif e == "b":
                    parts.append(chr(8))
                elif e == "f":
                    parts.append(chr(12))
                elif e == "u":
                    cp = 0
                    for k in range(4):
                        cp = cp * 16 + hexv(s[i + 2 + k])
                    i += 4
                    if cp >= 0xD800 and cp < 0xDC00 and s[i + 2] == "\\" and s[i + 3] == "u":
                        lo = 0
                        for k in range(4):
                            lo = lo * 16 + hexv(s[i + 4 + k])
                        cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00)
                        i += 6
                    parts.append(utf8(cp))
                else:
                    parts.append(e)
                i += 2
                st = i
            else:
                i += 1
        parts.append(s[st:i])
        return ["".join(parts), i + 1]
    if s[i:i + 4] == "true":
        return [True, i + 4]
    if s[i:i + 5] == "false":
        return [False, i + 5]
    if s[i:i + 4] == "null":
        return [None, i + 4]
    j = i
    while j < len(s) and (s[j] == "-" or s[j] == "+" or s[j] == "." or s[j] == "e" or s[j] == "E" or s[j].isdigit()):
        j += 1
    t = s[i:j]
    if "." in t or "e" in t or "E" in t:
        return [float(t), j]
    return [int(t), j]

def jstr(s):
    parts = ["\""]
    st = 0
    i = 0
    while i < len(s):
        c = s[i]
        o = ord(c)
        if c == "\"" or c == "\\" or o < 32:
            parts.append(s[st:i])
            if c == "\"":
                parts.append("\\\"")
            elif c == "\\":
                parts.append("\\\\")
            elif c == "\n":
                parts.append("\\n")
            elif c == "\t":
                parts.append("\\t")
            elif c == "\r":
                parts.append("\\r")
            else:
                parts.append("\\u00" + "0123456789abcdef"[o >> 4] + "0123456789abcdef"[o & 15])
            st = i + 1
        i += 1
    parts.append(s[st:])
    parts.append("\"")
    return "".join(parts)

def jdump(v):
    if v == None:
        return "null"
    if v is True:
        return "true"
    if v is False:
        return "false"
    if isinstance(v, str):
        return jstr(v)
    if isinstance(v, int) or isinstance(v, float):
        return str(v)
    if isinstance(v, list):
        r = []
        for x in v:
            r.append(jdump(x))
        return "[" + ",".join(r) + "]"
    r = []
    for k in v:
        r.append(jstr(k) + ":" + jdump(v[k]))
    return "{" + ",".join(r) + "}"


# ---------------- session ----------------
S = {"fails": 0, "buf": "", "nid": 0, "pid": 0, "win": 0, "rout": 0}

def uri(p):
    return "file://" + p

def send(obj):
    b = jdump(obj)
    m = "Content-Length: " + str(len(b)) + "\r\n\r\n" + b
    off = 0
    while off < len(m):
        k = os.write(S["win"], m[off:])
        if k <= 0:
            raise RuntimeError("server closed stdin")
        off += k

def recv():
    while True:
        b = S["buf"]
        i = b.find("\r\n\r\n")
        if i >= 0:
            n = -1
            for l in b[:i].split("\r\n"):
                if l.lower().startswith("content-length"):
                    n = int(l.split(":")[1].strip())
            if len(b) >= i + 4 + n:
                S["buf"] = b[i + 4 + n:]
                return jparse(b[i + 4:i + 4 + n], 0)[0]
        chunk = os.read(S["rout"], 65536)
        if len(chunk) == 0:
            raise RuntimeError("server closed stdout")
        S["buf"] = b + chunk

def request(method, params):
    S["nid"] = S["nid"] + 1
    send({"jsonrpc": "2.0", "id": S["nid"], "method": method, "params": params})
    while True:
        m = recv()
        if m.get("id") == S["nid"]:
            return m

def notify(method, params):
    send({"jsonrpc": "2.0", "method": method, "params": params})

def diags_for(u):
    while True:
        m = recv()
        if m.get("method") == "textDocument/publishDiagnostics" and m["params"]["uri"] == u:
            return m["params"]["diagnostics"]

def check(name, cond, detail=""):
    if cond:
        print("PASS lsp/" + name)
    else:
        S["fails"] = S["fails"] + 1
        d = detail
        if not isinstance(d, str):
            d = jdump(d)
        print("FAIL lsp/" + name + " " + d[:400])

def deq(a, b):
# structural equality of decoded JSON values (dict key order ignored)
    if isinstance(a, dict) and isinstance(b, dict):
        if len(a) != len(b):
            return False
        for k in a:
            if k not in b or not deq(a[k], b[k]):
                return False
        return True
    if isinstance(a, list) and isinstance(b, list):
        if len(a) != len(b):
            return False
        i = 0
        while i < len(a):
            if not deq(a[i], b[i]):
                return False
            i += 1
        return True
    if isinstance(a, dict) or isinstance(a, list) or isinstance(b, dict) or isinstance(b, list):
        return False
    if a is None or b is None:
        return a is None and b is None
    return a == b

def u16len(s):
# UTF-16 code units of a UTF-8 byte string: one per lead byte, two for a 4-byte sequence
    n = 0
    for k in range(len(s)):
        o = ord(s[k])
        if o < 0x80 or o >= 0xc0:
            n += 1
            if o >= 0xf0:
                n += 1
    return n

def pos_of(text, needle, nth=0, off=0):
# LSP position (UTF-16 code units) of the nth occurrence of needle, plus off characters
    i = -1
    for _ in range(nth + 1):
        i = text.find(needle, i + 1)
        if i < 0:
            raise ValueError("substring not found")
    i += off
    line = 0
    k = 0
    while k < i:
        if text[k] == "\n":
            line += 1
        k += 1
    st = i
    while st > 0 and text[st - 1] != "\n":
        st -= 1
    pre = text[st:i]
    return {"line": line, "character": u16len(pre)}

def rng(text, needle, nth=0, off=0, n=None):
    a = pos_of(text, needle, nth, off)
    w = len(needle) - off
    if n is not None:
        w = n
    return {"start": a, "end": {"line": a["line"], "character": a["character"] + w}}

def stats():
    return request("forge/stats", None)["result"]["compiles"]

def res(r):
    if "result" in r:
        return r["result"]
    return None

def copy_tree(src, dst):
    os.mkdir(dst)
    for n in os.listdir(src):
        if os.path.isdir(src + "/" + n):
            copy_tree(src + "/" + n, dst + "/" + n)
        else:
            write_file(dst + "/" + n, read_file(src + "/" + n))

def rm_tree(p):
    for n in os.listdir(p):
        if os.path.isdir(p + "/" + n):
            rm_tree(p + "/" + n)
        else:
            os.remove(p + "/" + n)
    os.run(["rmdir", p])

def start(root):
    a = os.pipe()
    b = os.pipe()
    pid = os.fork()
    if pid == 0:
        os.dup2(a[0], 0)
        os.dup2(b[1], 1)
        try:
            os.execv(root + "/forge", [root + "/forge", "lsp"])
        except OSError:
            pass
        os._exit(127)
    os.close(a[0])
    os.close(b[1])
    S["pid"] = pid
    S["win"] = a[1]
    S["rout"] = b[0]

def keyed(locs, withch):
    out = []
    for x in locs:
        k = x["uri"] + ":" + str(100000 + x["range"]["start"]["line"])
        if withch:
            k += ":" + str(100000 + x["range"]["start"]["character"])
        out.append(k)
    return sorted(out)

def pkey(u, p, withch):
    k = u + ":" + str(100000 + p["line"])
    if withch:
        k += ":" + str(100000 + p["character"])
    return k

def session(proj, MAIN, UTIL):
    r = request("initialize", {"processId": None, "rootUri": uri(proj), "capabilities": {}})
    caps = r.get("result", {}).get("capabilities", {})
    check("initialize", caps.get("definitionProvider") and caps.get("hoverProvider") and caps.get("textDocumentSync", {}).get("change") == 2 and caps.get("referencesProvider") and caps.get("renameProvider") and "." in caps.get("completionProvider", {}).get("triggerCharacters", []), r)
    notify("initialized", {})
    text = read_file(MAIN)
    notify("textDocument/didOpen", {"textDocument": {"uri": uri(MAIN), "languageId": "forge", "version": 1, "text": text}})
    d = diags_for(uri(MAIN))
    check("clean-file-no-diagnostics", len(d) == 0, d)

    # a type error in the unsaved buffer
    bad = text.replace("total = a + b", "total: int = \"oops\"")
    notify("textDocument/didChange", {"textDocument": {"uri": uri(MAIN), "version": 2}, "contentChanges": [{"text": bad}]})
    d = diags_for(uri(MAIN))
    want = pos_of(bad, "\"oops\"")
    check("type-error-diagnostic", len(d) == 1 and d[0]["code"] == "E0302" and deq(d[0]["range"]["start"], want) and d[0]["severity"] == 1 and "incompatible types" in d[0]["message"], d)
    check("no-temp-files-left", ",".join(sorted(os.listdir(proj))) == "main.forge,util.forge", os.listdir(proj))
    check("disk-file-untouched", read_file(MAIN) == text)

    # a syntax error, then an undefined name
    bad = text.replace("def add(a: int, b: int)", "def add(: int, b: int)")
    notify("textDocument/didChange", {"textDocument": {"uri": uri(MAIN), "version": 3}, "contentChanges": [{"text": bad}]})
    d = diags_for(uri(MAIN))
    check("syntax-error-diagnostic", len(d) == 1 and d[0]["code"] == "E0105" and deq(d[0]["range"]["start"], pos_of(bad, ": int, b")), d)
    bad = text.replace("print(add(i, 1))", "print(addd(i, 1))")
    notify("textDocument/didChange", {"textDocument": {"uri": uri(MAIN), "version": 4}, "contentChanges": [{"text": bad}]})
    d = diags_for(uri(MAIN))
    check("undefined-name-diagnostic", len(d) == 1 and d[0]["code"] == "E0201" and d[0]["range"]["start"]["line"] == pos_of(bad, "addd")["line"], d)
    notify("textDocument/didChange", {"textDocument": {"uri": uri(MAIN), "version": 5}, "contentChanges": [{"text": text}]})
    d = diags_for(uri(MAIN))
    check("fixed-clears-diagnostics", len(d) == 0, d)

    def defn(needle, nth=0, off=1):
        return res(request("textDocument/definition", {"textDocument": {"uri": uri(MAIN)}, "position": pos_of(text, needle, nth, off)}))

    def at(r, u, p):
        return r is not None and r["uri"] == u and deq(r["range"]["start"], p)

    r = defn("add(i", 0, 1)
    check("definition-function", at(r, uri(MAIN), pos_of(text, "add(a")), r)
    r = defn("total", 1, 2)
    check("definition-local-variable", r is not None and deq(r["range"]["start"], pos_of(text, "total =")), r)
    r = defn("a + b", 0, 0)
    check("definition-parameter", r is not None and deq(r["range"]["start"], pos_of(text, "a: int")), r)
    r = defn("i, 1", 0, 0)
    check("definition-loop-variable", r is not None and deq(r["range"]["start"], pos_of(text, "i in")), r)
    ut = read_file(UTIL)
    r = defn("shout(\"hi", 0, 2)
    check("definition-from-import", at(r, uri(UTIL), pos_of(ut, "shout(")), r)
    r = defn("shout(\"x", 0, 2)
    check("definition-module-attribute", at(r, uri(UTIL), pos_of(ut, "shout(")), r)
    r = defn("Counter()", 0, 3)
    check("definition-class", at(r, uri(UTIL), pos_of(ut, "Counter:")), r)
    r = defn("print(add", 0, 2)
    check("definition-builtin-none", r is None, r)

    def hover(needle, nth=0, off=1):
        r = res(request("textDocument/hover", {"textDocument": {"uri": uri(MAIN)}, "position": pos_of(text, needle, nth, off)}))
        if r is None:
            return ""
        return r["contents"]["value"]

    h = hover("add(i")
    check("hover-function-signature-doc", "def add(a: int, b: int) -> int" in h and "Add two ints." in h, h)
    h = hover("shout(\"hi", 0, 2)
    check("hover-imported-function", "def shout(s: str) -> str" in h and "Upper-case s" in h and "util.forge:1" in h, h)
    h = hover("a + b", 0, 0)
    check("hover-parameter-type", "(parameter) a: int" in h, h)

    # attributes: self.x / self.m inside a class, obj.m on an annotated parameter or C() variable
    r = defn("inc(2", 0, 1)
    check("definition-attr-constructed-var", at(r, uri(UTIL), pos_of(ut, "inc(")), r)
    r = defn("inc(1", 0, 1)
    check("definition-attr-annotated-param", at(r, uri(UTIL), pos_of(ut, "inc(")), r)
    h = hover("inc(2", 0, 1)
    check("hover-method", "def inc(self, k: int) -> int" in h and "Add k and return" in h, h)
    notify("textDocument/didOpen", {"textDocument": {"uri": uri(UTIL), "languageId": "forge", "version": 1, "text": ut}})
    d = diags_for(uri(UTIL))
    r = res(request("textDocument/definition", {"textDocument": {"uri": uri(UTIL)}, "position": pos_of(ut, "self.n + k", 0, 5)}))
    check("definition-self-attribute", at(r, uri(UTIL), pos_of(ut, "n = 0")), r)

    # UTF-16 positions: a name after non-ASCII text (e-acute = 1 unit / 2 bytes, emoji = 2 units / 4 bytes)
    r = defn("add(1, 2", 0, 1)
    check("utf16-definition-after-emoji", r is not None and deq(r["range"]["start"], pos_of(text, "add(a")), r)
    r = res(request("textDocument/references", {"textDocument": {"uri": uri(MAIN)}, "position": pos_of(text, "greet,", 0, 1), "context": {"includeDeclaration": True}}))
    ok = r is not None and len(r) == 2
    if ok:
        chs = sorted([r[0]["range"]["start"]["character"], r[1]["range"]["start"]["character"]])
        ok = chs[0] == 0 and chs[1] == pos_of(text, "greet,")["character"]
        for x in r:
            if x["range"]["end"]["character"] - x["range"]["start"]["character"] != 5:
                ok = False
    check("utf16-reference-ranges", ok, r)

    # references and rename across modules
    r = res(request("textDocument/references", {"textDocument": {"uri": uri(MAIN)}, "position": pos_of(text, "add(i", 0, 1), "context": {"includeDeclaration": True}}))
    got = keyed(r or [], True)
    want = sorted([pkey(uri(MAIN), pos_of(text, "add(a"), True), pkey(uri(MAIN), pos_of(text, "add(i"), True), pkey(uri(MAIN), pos_of(text, "add(1, 2"), True)])
    check("references-function", ",".join(got) == ",".join(want), r)
    r = res(request("textDocument/references", {"textDocument": {"uri": uri(MAIN)}, "position": pos_of(text, "add(i", 0, 1), "context": {"includeDeclaration": False}}))
    check("references-exclude-declaration", r is not None and len(r) == 2, r)
    r = res(request("textDocument/references", {"textDocument": {"uri": uri(MAIN)}, "position": pos_of(text, "inc(2", 0, 1), "context": {"includeDeclaration": True}}))
    got = keyed(r or [], False)
    want = sorted([pkey(uri(UTIL), pos_of(ut, "inc("), False), pkey(uri(MAIN), pos_of(text, "inc(2"), False), pkey(uri(MAIN), pos_of(text, "inc(1"), False)])
    check("references-method-cross-module", ",".join(got) == ",".join(want), r)
    r = res(request("textDocument/references", {"textDocument": {"uri": uri(MAIN)}, "position": pos_of(text, "a + b", 0, 0), "context": {"includeDeclaration": True}}))
    ok = r is not None and len(r) == 2
    if ok:
        ls = sorted([r[0]["range"]["start"]["line"], r[1]["range"]["start"]["line"]])
        ok = ls[0] == pos_of(text, "a: int")["line"] and ls[1] == pos_of(text, "a + b")["line"]
    check("references-parameter-scoped", ok, r)
    r = res(request("textDocument/rename", {"textDocument": {"uri": uri(MAIN)}, "position": pos_of(text, "shout(\"hi", 0, 2), "newName": "yell"}))
    ch = {}
    if r is not None and "changes" in r:
        ch = r["changes"]
    em = ch.get(uri(MAIN), [])
    eu = ch.get(uri(UTIL), [])
    ok = len(em) == 3 and len(eu) == 1
    for u in ch:
        for e in ch[u]:
            if e["newText"] != "yell":
                ok = False
    found = False
    for e in eu:
        if deq(e, {"range": rng(ut, "shout", 0, 0), "newText": "yell"}):
            found = True
    check("rename-cross-module", ok and found, r)
    r = request("textDocument/rename", {"textDocument": {"uri": uri(MAIN)}, "position": pos_of(text, "add(i", 0, 1), "newName": "9bad"})
    check("rename-invalid-name-error", r.get("error", {}).get("code") == -32602, r)

    # completion
    def comp(needle, off):
        r = res(request("textDocument/completion", {"textDocument": {"uri": uri(MAIN)}, "position": pos_of(text, needle, 0, off)}))
        out = []
        if r is not None:
            for i in r.get("items", []):
                out.append(i["label"])
        return out
    c = comp("util.shout(", 5)
    check("completion-module-members", "shout" in c and "Counter" in c and "add" not in c, c)
    c = comp("inc(2", 0)
    check("completion-instance-members", "inc" in c and "n" in c and "__init__" in c, c)
    c = comp("total = a", 2)
    ok = "total" in c and "to" not in c
    for x in c:
        if not x.startswith("to"):
            ok = False
    check("completion-scope-prefix", ok, c)
    c = comp("x.inc(1", 0)
    check("completion-params-and-globals", "x" in c and "add" in c and "bump" in c and "util" in c and "print" in c, c)

    # incremental sync: range edits; incremental re-check: unchanged text is not recompiled
    n0 = stats()
    notify("textDocument/didChange", {"textDocument": {"uri": uri(MAIN), "version": 6}, "contentChanges": [{"range": rng(text, "add(i, 1)", 0, 0, 3), "text": "addd"}]})
    d = diags_for(uri(MAIN))
    check("incremental-edit-diagnostic", len(d) == 1 and d[0]["code"] == "E0201" and d[0]["range"]["start"]["line"] == pos_of(text, "add(i")["line"], d)
    t2 = text.replace("print(add(i, 1))", "print(addd(i, 1))")
    e = pos_of(t2, "greet,")
    notify("textDocument/didChange", {"textDocument": {"uri": uri(MAIN), "version": 7}, "contentChanges": [{"range": {"start": e, "end": {"line": e["line"], "character": e["character"] + 5}}, "text": "greet"}, {"range": rng(t2, "addd(i", 0, 0, 4), "text": "add"}]})
    d = diags_for(uri(MAIN))
    check("incremental-multi-edit-utf16", len(d) == 0, d)
    n1 = stats()
    check("recheck-once-per-changed-version", n1 - n0 == 2, [n0, n1])
    notify("textDocument/didChange", {"textDocument": {"uri": uri(MAIN), "version": 8}, "contentChanges": [{"range": rng(text, "add(i", 0, 0, 3), "text": "add"}]})
    d = diags_for(uri(MAIN))
    s = stats()
    check("recheck-skips-identical-text", len(d) == 0 and s == n1, [d, s])
    notify("textDocument/didSave", {"textDocument": {"uri": uri(MAIN)}})
    d = diags_for(uri(MAIN))
    s = stats()
    check("save-unchanged-no-recompile", len(d) == 0 and s == n1, s)
    r = defn("shout(\"x", 0, 2)
    r = defn("Counter()", 0, 3)
    s = stats()
    check("module-ast-cached", s == n1, s)
    # saving an imported module rechecks its open importers
    write_file(UTIL, ut.replace("def shout(", "def holler("))
    notify("textDocument/didSave", {"textDocument": {"uri": uri(UTIL)}, "text": ut.replace("def shout(", "def holler(")})
    seen = {}
    while len(seen) < 2:
        m = recv()
        if m.get("method") == "textDocument/publishDiagnostics":
            seen[m["params"]["uri"]] = m["params"]["diagnostics"]
    s = stats()
    check("dependent-rechecked-on-save", uri(UTIL) in seen and len(seen[uri(UTIL)]) == 0 and len(seen.get(uri(MAIN), [])) >= 1 and s == n1 + 2, [seen, s])
    write_file(UTIL, ut)

    r = request("textDocument/formatting", {"textDocument": {"uri": uri(MAIN)}, "options": {}})
    check("unknown-method-error", r.get("error", {}).get("code") == -32601, r)
    r = request("shutdown", None)
    check("shutdown", "result" in r and r["result"] is None, r)
    notify("exit", None)
    w = os.waitpid(S["pid"], 0)
    S["pid"] = 0
    rc = os.waitstatus_to_exitcode(w[1])
    check("exit-code-0", rc == 0, str(rc))

def main():
    root = sys.argv[1]
    tmp = "/tmp/forge-lsp-client." + str(os.getpid())
    os.mkdir(tmp)
    proj = tmp + "/proj"
    copy_tree(root + "/tests/lsp/proj", proj)
    start(root)
    try:
        session(proj, proj + "/main.forge", proj + "/util.forge")
    except Exception as e:
        check("session", False, repr(e))
        if S["pid"] != 0:
            os.run(["kill", "-9", str(S["pid"])])
    rm_tree(tmp)
    if S["fails"] > 0:
        return 1
    return 0

exit(main())
