def churn():
    st = []
    for i in range(4):
        st.append([i] * 1000000)
    while len(st) > 0:
        st.pop()
    d = {}
    for i in range(3):
        d[i] = [i] * 1000000
    del d[0]
    d.clear()
    xs = [[1] * 1000000, [2] * 1000000]
    del xs[0:2]
    return 0
churn()
release(0)
print(mark() < 1000000)
