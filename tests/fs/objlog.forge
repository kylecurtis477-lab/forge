# forge: no-runtime
# Phase 9.2 object-store log: replay rebuilds the store, a crash (log cut) at every word or a corrupt
# word anywhere leaves a consistent prefix of history, and writes continue after recovery
include "linux.fsi"
include "../../examples/kernel/obj.fsi"

reffp: u64[256]

def show(s: ptr[u8], v: u64):
    puts(s)
    put_u64(v)
    nl()

def fp(ts: u64) -> u64:
# fingerprint of the whole store as of ts
    h: u64 = 0xcbf29ce484222325
    o: u64 = 0
    while o < ob_nobj:
        n = obj_read_at(o, ts)
        if n != OB_ERR:
            i: u64 = 0
            while i < n:
                h = (h ^ ob_out[i]) * 0x100000001b3
                i += 1
            h = (h ^ o) * 0x100000001b3
        o += 1
    return h

def work():
    ob_type_def(1, 3)
    ob_type_def(2, 5)
    a = obj_new(1)
    b = obj_new(2)
    i: u64 = 0
    while i < 40:
        ob_in[0] = i % 7
        ob_in[1] = i * 3
        ob_in[2] = 5
        ob_in[3] = i
        ob_in[4] = 1
        obj_write(a, 3)
        if i % 3 == 0:
            obj_write(b, 5)
        if i == 20:
            obj_new(1)
        i += 1

def ob_ntypes() -> u64:
    return u64(ob_tf[1] != 0) + u64(ob_tf[2] != 0)

def consistent() -> u64:
    return u64(fp(ob_clock) == reffp[ob_clock])

def main() -> i64:
    ob_reset()
    ob_log_clear()
    work()
    L = ob_lp
    T = ob_clock
    t: u64 = 0
    while t <= T:
        reffp[t] = fp(t)
        t += 1
    show("records: ", ob_replay(L))
    show("full replay same: ", u64(ob_clock == T and ob_lp == L and consistent() == 1))
    bad: u64 = 0
    shorter: u64 = 0
    k: u64 = 0
    while k < L:
        ob_replay(k)
        if consistent() == 0 or ob_lp > k:
            bad += 1
        if ob_clock < T:
            shorter += 1
        k += 1
    show("cuts tried: ", u64(L > 300))
    show("cuts inconsistent: ", bad)
    show("cuts all lose the tail: ", u64(shorter == L))
    bad = 0
    shorter = 0
    k = 0
    while k < L:
        w = ob_log[k]
        ob_log[k] = w ^ 0x40
        ob_replay(L)
        if consistent() == 0 or ob_lp > k:
            bad += 1
        if ob_clock < T or ob_nobj < 3 or ob_ntypes() < 2:
            shorter += 1
        ob_log[k] = w
        k += 1
    show("corruptions inconsistent: ", bad)
    show("corruptions all detected: ", u64(shorter == L))
    ob_replay(L)
    ob_in[0] = 77
    ob_in[1] = 88
    ob_in[2] = 99
    t2 = obj_write(0, 3)
    L2 = ob_lp
    ob_replay(L2)
    show("write after recovery survives: ", u64(ob_clock == t2 and obj_field(0, 2) == 99))
    show("old history intact: ", u64(fp(T) == reffp[T]))
    return 0
