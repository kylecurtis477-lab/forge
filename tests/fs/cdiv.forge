    bad += c_i16_1000(x, i16(1000))
    bad += c_i16_4096(x, i16(4096))
    return bad

def sweep(x: u64) -> i64:
    bad: i64 = 0
    bad += run_i64(i64(x))
    bad += run_u64(u64(x))
    bad += run_i32(i32(x))
    bad += run_u32(u32(x))
    bad += run_i8(i8(x))
    bad += run_u8(u8(x))
    bad += run_i16(i16(x))
    return bad

def main() -> i64:
    edges: u64 = 0
    bad: i64 = 0
    n: i64 = 0
    bad += sweep(0)
    bad += sweep(1)
    bad += sweep(0xFFFFFFFFFFFFFFFF)
    bad += sweep(0x8000000000000000)
    bad += sweep(0x7FFFFFFFFFFFFFFF)
    bad += sweep(0x8000000000000001)
    bad += sweep(0xFFFFFFFF)
    bad += sweep(0x80000000)
    bad += sweep(0x7FFFFFFF)
    bad += sweep(0xFF)
    bad += sweep(0x80)
    bad += sweep(0x7F)
    bad += sweep(0xFFFF)
    bad += sweep(0x8000)
    i: i64 = -300
    while i <= 300:
        bad += sweep(u64(i))
        n += 1
        i += 1
    s: u64 = 0x9E3779B97F4A7C15
    j: i64 = 0
    while j < 2000:
        s = s * 6364136223846793005 + 1442695040888963407
        bad += sweep(s)
        bad += sweep(s >> (u64(j) % 64))
        n += 2
        j += 1
    puts("constant division mismatches: ")
    put_i64(bad)
    nl()
    puts("values: ")
    put_i64(n + 14)
    nl()
    return 0
