# forge: no-runtime
# --fs-opt constant division (Phase 12.1): x / d, x // d and x % d with a literal d must equal the same
# operation with d in a variable (div/idiv), for signed and unsigned types of every width, over edge values
# (0, +-1, min, max, near powers of two) and a pseudo-random sweep. Generated function per (type, d).
include "linux.fsi"

def c_i64_1(x: i64, dv: i64) -> i64:
    bad: i64 = 0
    if x / 1 != x / dv:
        bad += 1
    if x // 1 != x // dv:
        bad += 1
    if x % 1 != x % dv:
        bad += 1
    return bad

