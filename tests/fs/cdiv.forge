def c_i16_100(x: i16, dv: i16) -> i64:
    bad: i64 = 0
    if x / 100 != x / dv:
        bad += 1
    if x // 100 != x // dv:
        bad += 1
    if x % 100 != x % dv:
        bad += 1
    return bad

