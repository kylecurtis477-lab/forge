# forge: no-runtime
# Phase 12.1 steps 1-2 (--fs-opt): leaf functions whose scalar locals move into caller-saved registers,
# functions with calls whose locals move into callee-saved ones (ra_calls, ra_rec), and the cases that must
# stay in memory. run_tests.sh runs every tests/fs program with and without the flag (same output), and checks
# that ra_leaf is fully promoted, ra_calls uses %rbx, and ra_addr is not promoted.
# Step 4a: functions with frame arrays, structs or addr() promote their scalar locals too (ra_arr, ra_cpy,
# ra_mix); the aggregates and any address-taken scalar stay in memory (ra_mix's x).
include "linux.fsi"

struct RaPair:
    a: i64
    b: i64

def ra_leaf(n: i64, k: i64) -> i64:
# loop counter, accumulator and bound all in registers; shifts use %cl, % and / use %rdx
    s: i64 = 0
    i: i64 = 0
    while i < n:
        s += (i * k) % 13 + (i << (k % 5)) / 3
        i += 1
    return s

def ra_narrow(a: u8, b: i8, c: u32) -> i64:
# narrow types wrap the same in a register as in a slot
    x: u8 = a
    x += 100
    y: i8 = b
    y += 1
    z: u32 = c
    z -= 1
    return i64(x) * 1000000 + i64(y) * 1000 + i64(z % 1000)

def ra_many(a: i64) -> i64:
# more live locals than free registers: the most-used ones get registers, the rest stay in slots
    v1: i64 = a + 1
    v2: i64 = a + 2
    v3: i64 = a + 3
    v4: i64 = a + 4
    v5: i64 = a + 5
    v6: i64 = a + 6
    v7: i64 = a + 7
    v8: i64 = a + 8
    t: i64 = 0
    j: i64 = 0
    while j < 10:
        t += v1 * v2 - v3 + v4 * v5 - v6 + v7 * v8 + j
        j += 1
    return t

def ra_six(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64:
# all six argument registers are named by the prologue, so none is free
    s: i64 = a * b + c * d + e * f
    u: u64 = u64(s) >> 1
    return i64(u) - a

def ra_addr(n: i64) -> i64:
# x's address is taken, so the function keeps every local in memory
    x: i64 = n
    p: ptr[i64] = addr(x)
    p[0] = p[0] + 5
    return x

def ra_cmp(a: u64, b: u64) -> i64:
    r: i64 = 0
    if a > b:
        r += 1
    if a == b:
        r += 10
    if a < b and b != 0:
        r += 100
    return r

def ra_calls(n: i64) -> i64:
# step 2: locals live across calls go to callee-saved registers (saved in the frame, restored before leave)
    acc: i64 = 0
    i: i64 = 0
    w: i64 = 3
    while i < n:
        acc += ra_leaf(i, w) - ra_cmp(u64(i), 5)
        w += 1
        i += 1
    return acc + w

def ra_rec(n: i64) -> i64:
# recursion: each frame's locals must survive the nested calls
    if n < 2:
        return n
    a: i64 = n * 3
    b: i64 = ra_rec(n - 1)
    c: i64 = ra_rec(n - 2)
    a += b - c
    a += b + c
    return a % 1000003

def ra_arr(n: i64) -> i64:
# step 4a: a frame array (lea of the frame) no longer stops i, s and t from moving to registers
    v: i64[16]
    i: i64 = 0
    while i < 16:
        v[i] = i * i - n
        i += 1
    s: i64 = 0
    t: i64 = 1
    i = 0
    while i < 16:
        s += v[i] * t
        t = (t * 3) % 101
        i += 1
    return s

def ra_cpy(w: i64[4], n: i64) -> i64:
# step 4a: an array parameter is copied into the frame with rep movsb (which names rsi/rdi implicitly, so a
# leaf keeps r8-r11 only); the struct's fields stay in memory, k and acc move to registers
    p: RaPair
    p.a = n
    p.b = n + 1
    acc: i64 = 0
    k: i64 = 0
    while k < 10:
        w[k % 4] = w[k % 4] + k
        p.a = p.a + w[k % 4]
        acc += p.a - p.b
        k += 1
    return acc + w[3]

def ra_mix(n: i64) -> i64:
# step 4a: x's address is taken, so x stays in memory; j and acc may still be promoted
    x: i64 = n
    p: ptr[i64] = addr(x)
    acc: i64 = 0
    j: i64 = 0
    while j < 7:
        p[0] = p[0] + j
        acc += x * 2
        j += 1
    return acc + x

def main() -> i64:
    put_i64(ra_leaf(1000, 7))
    nl()
    put_i64(ra_narrow(200, 127, 0))
    nl()
    put_i64(ra_many(3))
    nl()
    put_i64(ra_six(1, 2, 3, 4, 5, 6))
    nl()
    put_i64(ra_addr(37))
    nl()
    put_i64(ra_cmp(0xFFFFFFFFFFFFFFFF, 1) + ra_cmp(5, 5) + ra_cmp(1, 2))
    nl()
    put_i64(ra_calls(40))
    nl()
    put_i64(ra_rec(20))
    nl()
    put_i64(ra_arr(5))
    nl()
    wv: i64[4]
    wv[0] = 1
    wv[1] = 2
    wv[2] = 3
    wv[3] = 4
    put_i64(ra_cpy(wv, 9) + wv[0])
    nl()
    put_i64(ra_mix(4))
    nl()
    return 0
