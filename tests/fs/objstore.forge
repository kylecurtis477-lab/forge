# forge: no-runtime
# Phase 9.1 object store: typed writes, copy-on-write versions, content-addressed dedup, read-at,
# per-object and whole-system rewind, diff, field search
include "linux.fsi"
# object-store capacities (obj.fsi takes them from the includer)
OB_NT = 32
OB_NO = 256
OB_NV = 2048
OB_NB = 1024
OB_NW = 16384
OB_NL = 32768
OB_HB = 2048
OB_NX = 8192
OB_HX = 16384
include "../../examples/kernel/obj.fsi"

def show(s: ptr[u8], v: u64):
    puts(s)
    put_u64(v)
    nl()

def put3(a: u64, b: u64, c: u64):
    ob_in[0] = a
    ob_in[1] = b
    ob_in[2] = c

def main() -> i64:
    ob_reset()
    show("type ok: ", ob_type_def(1, 3) + 1)
    show("bad type: ", u64(ob_type_def(0, 3) == OB_ERR))
    a = obj_new(1)
    b = obj_new(1)
    show("untyped new refused: ", u64(obj_new(7) == OB_ERR))
    put3(10, 20, 30)
    t1 = obj_write(a, 3)
    show("wrong shape refused: ", u64(obj_write(a, 2) == OB_ERR))
    put3(10, 21, 30)
    t2 = obj_write(a, 3)
    put3(10, 20, 30)
    t3 = obj_write(b, 3)
    show("dedup blobs: ", ob_nblob)
    show("dedup hits: ", ob_dedup)
    show("a.f1 now: ", obj_field(a, 1))
    obj_read_at(a, t1)
    show("a.f1 at t1: ", ob_out[1])
    show("a absent before t1: ", u64(obj_read_at(a, t1 - 1) == OB_ERR))
    show("diff t1 t2: ", obj_diff(a, t1, t2))
    show("diff t1 t1: ", obj_diff(a, t1, t1))
    show("find 21: ", obj_find(1, 1, 21, 0))
    show("find 20: ", obj_find(1, 1, 20, 0))
    obj_rewind(a, t1)
    show("a.f1 after rewind: ", obj_field(a, 1))
    show("a versions: ", obj_nversions(a))
    obj_read_at(a, t2)
    show("t2 kept in history: ", ob_out[1])
    # many bad changes, then rewind the whole system to t3
    i: u64 = 0
    while i < 100:
        put3(i, i * 2, 99)
        obj_write(a, 3)
        obj_write(b, 3)
        i += 1
    show("system rewind changed: ", sys_rewind(t3))
    show("a.f2: ", obj_field(a, 2))
    show("b.f2: ", obj_field(b, 2))
    show("diff b t3 now: ", obj_diff(b, t3, ob_clock))
    show("blobs: ", ob_nblob)
    return 0
