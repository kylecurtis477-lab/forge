import math
from math import sqrt, floor
xs = [0.0, 1.5, -2.25, 3.14159265358979, 1e-7, 123456789.125, 2.5, -0.5, 1e15, 0.1 + 0.2]
for x in xs:
    print(x, round(x), round(x, 2), f"{x:.3f}", f"{x:e}", f"{x:g}", f"{x:10.2f}|", f"{x:<12.4e}|")
print(round(2.675, 2), round(0.5), round(1.5), round(-1.5), round(1234, -2), round(1250, -2))
print(format(3.14159, ".2f"), format(42, "05d"), format(1234567, ","), format(1234567.891, ",.2f"))
print(f"{255:x} {255:#X} {5:b} {8:o} {'hi':>6}| {'hi':^7}| {'hi':*<5}")
print(f"{-3.5:+.1f} {3.5:+.1f} {0.25:%} {0.125:.1%} {12:+d}")
print(f"{'q'!r} {[1, 2]!r} {1/3:.17g} {1e100:.3g} {123.0:g}")
print("%d items, %.2f each, %s" % (3, 1.5, "ok"), "%5.1f|%-4d|" % (2.25, 7), "%x" % 255)
print(math.sqrt(2.0), sqrt(16), math.floor(-2.5), floor(2.5), math.ceil(2.1), math.ceil(-2.1))
print(math.pi, math.e, math.sin(0.5), math.cos(0.5), math.atan2(1.0, 2.0), math.exp(1.0))
print(math.log(10.0), math.log(8.0, 2.0), math.log2(1024.0), math.log10(0.001), math.fabs(-3.0))
print(math.hypot(3.0, 4.0), math.pow(2.0, 10.0), math.isnan(math.nan), math.isinf(math.inf), math.isfinite(1.0))
print(math.trunc(-3.7), math.gcd(12, 18), 7 / 2, 7 // 2, -7 // 2, 7.5 // 2, 2 ** 0.5, 10 ** -2)
print(float("1e-5"), float("inf"), -float("inf"), 1e300 * 1e10, abs(-2.5), int(3.99), int(-3.99))
try:
    math.sqrt(-1.0)
except ValueError as e:
    print("ValueError", e)
total = 0.0
for i in range(1, 1001):
    total += 1.0 / (i * i)
print(total, f"{total:.10f}", total > 1.64)
print(min(2.5, 1), max(2.5, 3), sum([0.5, 0.25]), 1.0 == 1, 0.1 + 0.2 == 0.3, 3.0 < 4)
