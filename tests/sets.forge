s = {3, 1, 2}
print(sorted(s), {5}, {"x"})
print(len(s), 2 in s, 5 in s)
s.add(4)
s.add(1)
print(sorted(s))
s.discard(10)
s.remove(3)
print(sorted(s))
e = set()
print(e, len(e), bool(e), bool(s))
a = set([1, 2, 3, 4])
b = {3, 4, 5}
print(sorted(a | b), sorted(a & b), sorted(a - b), sorted(a ^ b))
print(sorted(a.union([9])), sorted(a.intersection(b)), sorted(a.difference(b)))
print({1, 2} <= a, {1, 2} < a, a >= {1}, a == {4, 3, 2, 1}, a != b)
print({1, 2}.issubset(a), a.issuperset([1, 2]), a.isdisjoint({7}))
w = set("hello")
print(sorted(w))
c = a.copy()
c.add(100)
print(len(a), len(c))
for x in sorted(b):
    print(x)
try:
    b.remove(42)
except KeyError:
    print("keyerror")
t = {(1, 2), (1, 2), (3, 4)}
print(len(t), (1, 2) in t)
u = set()
for i in range(1000):
    u.add(i % 37)
print(len(u))
for i in range(30):
    u.discard(i)
print(sorted(u))
# del / dict ops
d = {"a": 1, "b": 2, "c": 3}
del d["b"]
print(d, len(d), "b" in d)
d["b"] = 9
print(d)
print(d.pop("a"), d.pop("zz", -1), d)
print(d.setdefault("q", 5), d)
d.update({"x": 1})
print(d)
d.clear()
print(d, len(d))
big = {}
for i in range(500):
    big[i] = i
for i in range(0, 500, 2):
    del big[i]
print(len(big), big[499], 498 in big)
xs = [0, 1, 2, 3, 4, 5, 6]
del xs[1]
print(xs)
del xs[-1]
print(xs)
del xs[1:3]
print(xs)
print(xs.pop(0), xs)
xs.remove(4)
print(xs)
print(5 | 3, 5 & 3, 5 ^ 3, True | False, True & False, True ^ True)
m = {"a": 1} | {"b": 2}
print(m)
