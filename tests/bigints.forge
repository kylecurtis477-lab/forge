def mul(a, b):
    return a * b
def add(a, b):
    return a + b
def sub(a, b):
    return a - b
print(2 ** 100, 3 ** 50, (-7) ** 23)
x = [1]
for i in range(1, 31):
    x[0] = mul(x[0], i)
print(x[0])
f = 1
for i in range(1, 26):
    f = mul(f, i)
print(f, f // 1000000007, f % 1000000007, -f // 12345, -f % 12345)
print(f // (2 ** 70), f % (2 ** 70), divmod(f, 3 ** 40))
big = 123456789012345678901234567890
print(big, -big, big + 1, big - big, big * big, abs(-big))
L = [9223372036854775807, -9223372036854775807, 4294967296, -3037000500, 3037000500]
print(add(L[0], 1), sub(L[1], 10), L[0] + L[0], L[1] - L[0])
print(mul(L[2], L[2]), mul(L[3], L[4]), L[2] * L[2] * L[2])
print(big > 5, big < -5, -big < 5, big == big + 0, big == 123456789012345678901234567890, big != 1)
print(float(2 ** 80), 2 ** 80 / 2 ** 70, 2 ** 64 + 0.5)
d = {2 ** 100: "a"}
print(d[2 ** 100], 2 ** 100 in {2 ** 100}, hash(2 ** 64) == hash(2 ** 64))
print(sorted([2 ** 70, -(2 ** 65), 5, 0]), max(2 ** 66, 3), min(-(2 ** 66), 3))
print(str(2 ** 200), repr(2 ** 65), [10 ** 20])
print(sum([2 ** 62, 2 ** 62 + 7, 2 ** 62 + 1]))
print(isinstance(2 ** 70, int), int(2 ** 61))
print(10 ** 30 // 10 ** 29, (10 ** 30) // (10 ** 30 + 1), 2 ** 100 - 2 ** 100 + 7)
print(f"{2 ** 70}", 2 ** 70 * 0, (2 ** 70) ** 2)
fib = [0, 1]
for i in range(150):
    fib.append(fib[-1] + fib[-2])
print(fib[-1])
def fact(n):
    if n <= 1:
        return 1
    return n * fact(n - 1)
F = [40]
print(fact(F[0]))
print(2 ** 62, 2 ** 62 + 1, 2 ** 62 - 1 + 1, [2 ** 62 + 2])
Q = [2 ** 31, -(2 ** 31), 3]
print(Q[0] * Q[0], Q[0] * Q[1], Q[1] * Q[2], 2 ** 62 - 1 + 1)
