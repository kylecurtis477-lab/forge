# expect: use of moved value `q.buf`
# forge: no-runtime
include "../fs/linux.fsi"
struct Node:
    id: u64
struct Queue:
    count: u64
    head: own[Node]
    buf: own[u64]
cell1: Node
cellw: u64
@unsafe
def node1() -> own[Node]:
    return own[Node](ptr[Node](addr(cell1)))
@unsafe
def word1() -> own[u64]:
    return own[u64](ptr[u64](addr(cellw)))
def sink(n: own[Node]) -> u64:
    return n.id
def sinkw(n: own[u64]) -> u64:
    return n[0]
def peek(r: ref[Node]) -> u64:
    return r.id
def main() -> u64:
    q: Queue
    q.buf = word1()
    x = q.buf
    q.buf[0] = 5
    return sinkw(x)
