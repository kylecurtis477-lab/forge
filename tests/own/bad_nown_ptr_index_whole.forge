# expect: reading or writing an own/ref/mut through a pointer (p[i]) is unsafe: put it in a `with unsafe:` block or mark the function @unsafe
# forge: no-runtime
include "../fs/linux.fsi"
struct Node:
    id: u64
struct Holder:
    n: u64
    slot: nown[Node]
cell: Node
cell2: Node
hmem: u64[2]
@unsafe
def make() -> own[Node]:
    return own[Node](ptr[Node](addr(cell)))
@unsafe
def make2() -> own[Node]:
    return own[Node](ptr[Node](addr(cell2)))
@unsafe
def mkh() -> own[Holder]:
    return own[Holder](ptr[Holder](addr(hmem)))
def consume(x: own[Node]) -> u64:
    return x.id
def drop(x: nown[Node]) -> u64:
    return 0
def peek(x: ref[Node]) -> u64:
    return x.id
def pair(a: own[Node], b: own[Node]) -> u64:
    return a.id + b.id
def inspect(p: ptr[nown[Node]]) -> u64:
    return drop(p[0])
