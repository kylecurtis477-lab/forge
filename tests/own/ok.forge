# forge: no-runtime
include "../fs/linux.fsi"
struct Box:
    v: u64
    w: u64

cell: Box

@unsafe
def box_new(v: u64) -> own[Box]:
    b: own[Box] = own[Box](ptr[Box](addr(cell)))
    b.v = v
    b.w = 0
    return b

def box_free(b: own[Box]) -> u64:
    return b.v

def peek(r: ref[Box]) -> u64:
    return r.v

def bump(m: mut[Box]):
    m.v = m.v + 1

def both(a: ref[Box], b: ref[Box]) -> u64:
    return a.v + b.v

def pair(a: mut[Box], b: ref[Box]):
    a.w = b.v

def main() -> u64:
    b = box_new(40)
    bump(borrow_mut(b))
    s = peek(borrow(b)) + both(borrow(b), borrow(b))
    if s > 0:
        r: ref[Box] = borrow(b)
        t = r.v
        r2: ref[Box] = r
        t = t + r2.v
    if s > 0:
        m: mut[Box] = borrow_mut(b)
        bump(m)
        m.w = 1
    k: u64 = 0
    while k < 3:
        b.v = b.v + 1
        k += 1
    v = 0
    if k == 3:
        v = box_free(b)
    else:
        v = box_free(b)
    b = box_new(v)
    v = box_free(b)
    if v == 45:
        puts("own ok\n")
    return 0
