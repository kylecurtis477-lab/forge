# forge: no-runtime
# Stage 3c: take/replace/swap are built-ins only when no function of the program has that name; these user
# functions keep their meaning (and swap(i, 1) in a loop still is an ordinary call).
include "../fs/linux.fsi"
def take(x: u64) -> u64:
    return x + 1
def replace(a: u64, b: u64) -> u64:
    return a * 100 + b
def swap(a: u64, b: u64) -> u64:
    return a * 10 + b
def main() -> u64:
    i = 0
    s = 0
    while i < 3:
        s = s + swap(i, 1)
        i += 1
    put_u64(take(41) + replace(2, 3) + s)
    puts(" user take/replace/swap\n")
    return 0
