# forge: no-runtime
# Stage 3a: an own field behind own/mut/ref pointers used as a place. The owner is made once in unsafe
# code (the raw-to-own conversion promises head is initialised); after that everything is safe code.
include "../fs/linux.fsi"
struct Node:
    id: u64
    arr: u64[4]
struct Queue:
    n: u64
    head: own[Node]
node: Node
qmem: u64[2]
@unsafe
def make() -> own[Queue]:
    qmem[1] = u64(addr(node))
    return own[Queue](ptr[Queue](addr(qmem)))
def view(p: ref[Queue]) -> u64:
    return p.head.id + p.head.arr[2] + p.head[0].arr[3]
def update(p: mut[Queue]):
    p.head.id = p.head.id + 1
    p.head.arr[2] = 100
    p.head[0].arr[3] = 1000
def own_rw(q: own[Queue]) -> u64:
    q.head.id = q.head.id * 2
    return q.head.id
def run(q: own[Queue]) -> u64:
    q.head.id = 40
    update(borrow_mut(q))
    if view(borrow(q)) == 1141 and own_rw(q) == 82 and node.id == 82:
        puts("pointer owner place ok\n")
    return 0
@unsafe
def main() -> u64:
    return run(make())
