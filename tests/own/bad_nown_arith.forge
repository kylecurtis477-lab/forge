# expect: pointer arithmetic on an own/ref/mut[T] is unsafe
# forge: no-runtime
include "../fs/linux.fsi"
struct Node:
    id: u64
struct Holder:
    n: u64
    slot: nown[Node]
cell: Node
@unsafe
def make() -> own[Node]:
    return own[Node](ptr[Node](addr(cell)))
def consume(x: own[Node]) -> u64:
    return x.id
def peek(x: ref[Node]) -> u64:
    return x.id
def f(o: nown[Node]) -> u64:
    x = o + 8
    if x != 0:
        return x.id
    return 0
