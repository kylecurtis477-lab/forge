# expect: by-value owner-bearing struct
# forge: no-runtime
include "../fs/linux.fsi"
struct Node:
    id: u64
struct Queue:
    head: own[Node]
    tail: own[Node]
cell: Node
@unsafe
def make() -> own[Node]:
    return own[Node](ptr[Node](addr(cell)))
def use(x: own[Node]) -> u64:
    return x.id
def peek(x: ref[Node]) -> u64:
    return x.id
def bump(x: mut[Node]):
    x.id = x.id + 1
def take(q: Queue) -> u64:
    return 0
def main() -> u64:
    q: Queue
    q.head = make()
    a = take(q)
    return take(q)
