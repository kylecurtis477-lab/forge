# expect: globals/arrays containing own fields need definite initialisation
# forge: no-runtime
include "../fs/linux.fsi"
struct Node:
    id: u64
struct Holder:
    n: u64
    slot: nown[Node]
cell: Node
@unsafe
def make() -> own[Node]:
    return own[Node](ptr[Node](addr(cell)))
def consume(x: own[Node]) -> u64:
    return x.id
def peek(x: ref[Node]) -> u64:
    return x.id
gh: Holder
def f() -> u64:
    return 0
