def f(n):
    s = 0
    i = 0
    while i < n:
        s += i
        i += 1
    return s

def g(a, b):
    t = a
    t += b
    t *= 2
    return t

def h(k):
    v = 1
    if k > 2:
        v = "big"
    else:
        v = k * 10
    return v


print(f(100))
print(g(3, 4))
print(g("ab", "c"))
print(g(1.5, 2))
print(h(5), h(1))
