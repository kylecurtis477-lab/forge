def nothing():
    pass

def maybe(x):
    if x > 0:
        return x
    return

def find_idx(xs, v):
    for i in range(len(xs)):
        if xs[i] == v:
            return i

def classify(n):
    if n % 2 == 0:
        return "even"
    else:
        return "odd"

class Box:
    def __init__(self):
        self.v = None

print(None, nothing(), maybe(3), maybe(-1), find_idx([4, 5], 5), find_idx([4], 9))
x = None
print(x is None, x is not None, x == None, not x, [None, 1], {"a": None})
b = Box()
print(b.v, b.v is None)
d = {"k": 1}
print(d.get("z"), d.get("k"), str(None) + "!", repr(None), classify(3), classify(4))
if find_idx([1, 2], 3) is None:
    print("missing")
r = maybe(0)
print(r or "default", bool(None), None if False else 7)
